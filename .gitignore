# Rust
# Unanchored: the workspace root is not the only crate root. The reference
# probes under benchmarks/, agent worktrees, and crates/rspice-core all grow
# their own target/ directory.
target/
# Local per-task build directories produced by Codex and ad-hoc qualification
# runs. They contain only rebuildable Cargo artifacts.
/target-codex-*/

# Standalone benchmark probes are throwaway harnesses rebuilt on demand, so
# their lockfiles are not part of the reproducible build. The probes live in
# tools/perf-probes/archive/, which owns their README and is the path cited by
# crates/rspice-veriloga/src/canonical_ir/schedule.rs.
tools/perf-probes/*/*/Cargo.lock

# Benchmark runs. benchmarks/README.md says nothing in results/ is committed;
# without this rule that was a convention rather than a guarantee, and one
# `git add benchmarks/` would have carried a machine's timings into the
# repository. The directory itself is tracked through its .gitkeep.
/benchmarks/results/*
!/benchmarks/results/.gitkeep

# IDE
.idea/
.vscode/
*.swp
*.swo

# Node (for Tauri web frontend)
node_modules/
dist/
.vite/

# Separately versioned local prototypes
/mockups/

# Tauri
src-tauri/target/

# OS
.DS_Store
Thumbs.db

# Build artifacts
*.exe
*.dll
*.so
*.dylib

# Python tooling caches and environments
.venv/
.mypy_cache/
.pytest_cache/

# Test outputs
*.raw
# tests/xyce is a vendored upstream corpus, not generated output. The global
# *.raw rule above silently withheld 43 of its reference files from git — the
# whole of OutputData/Certification_Tests/BUG_746_SON/ among them — so a fresh
# clone got a smaller corpus than the machine that vendored it. Re-include the
# corpus wholesale rather than one directory at a time.
!tests/xyce/**/*.raw
*.log
*.pyc
__pycache__/
/*.out
*.osdi
*.zip
# The browser Python runtime ships its standard library as a zip. It is an
# execution asset that the runtime manifest digests and CI verifies, not a
# build output, and the browser cannot start Python without it.
!crates/rspice-ui/web/python/pyodide-*/python_stdlib.zip
/rtlinv_*.csv
/rtlinv_*.json
/rtlinv_*.cir
/diagnostics/
/design/
/docs/
/.codex-tools/
/tmp/
.agent/
.worktrees/
/_site
/_site-*/
/_site-source/
/.codex-candidates/
/.qualification-worktrees/
/_codex_perf_tmp/
# Scratch directories an agent lane opens at the repository root for one task.
/.tmp-*/
*.pdb

# Claude Code session state. Previously carried only in .git/info/exclude, which
# is local to one clone and so never travelled with the repository.
.claude/

# Working notes. Audits, implementation plans, and agent task contracts are
# session scratch, not product documentation, and go stale the moment the code
# moves. Shipped docs live in README.md, SECURITY.md, the per-crate READMEs,
# and security/.
/*_AUDIT.md
/*_IMPLEMENTATION_PLAN.md
/*_IMPLEMENTATION_PROMPT.md
/PYTHON_AUTOMATION_RUNTIME_ARCHITECTURE.md
/DEVICE_SUPPORT_RELEASE_MATRIX.md
