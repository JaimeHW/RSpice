# Byte-level generation fingerprints must be stable across Windows and Unix checkouts.
crates/rspice-core/build.rs text eol=lf
crates/rspice-veriloga/build.rs text eol=lf
crates/rspice-veriloga/Cargo.toml text eol=lf
crates/rspice-veriloga/src/** text eol=lf
models/veriloga/** -text

# The SPICE model tree must materialize identically on every platform. Its
# generated indexes are compared byte-for-byte by `build_manifest.py --check`,
# and `foundation/lib/` is include_str!'d into the binary, so translation there
# would make the compiled output differ by build host. Everything authored or
# generated is pinned to LF; the tools emit LF to match.
models/spice/** text eol=lf

# The vendored Xyce regression identities were pinned from the upstream CRLF
# artifacts. Materialize detected text files identically on every runner while
# leaving binary fixtures untouched.
tests/xyce/** text=auto eol=crlf
# This generated provenance manifest is parsed and fingerprinted as canonical
# LF text on every platform; a more-specific rule must follow the corpus-wide
# CRLF materialization rule above.
tests/xyce/RSPICE-UPSTREAM-EXCLUSIONS.tsv text eol=lf

# Publication-contract golden fixtures are compared byte-for-byte against the
# canonical serializer's LF output and include_str!'d into the test binary, so
# CRLF materialization on Windows would fail the byte-exactness gate.
crates/rspice-publication-contract/tests/fixtures/** text eol=lf

# The hydration loader is include_str!'d and emitted byte-for-byte into
# deterministic bundles; its subresource-integrity digest is computed from
# exactly these bytes, so CRLF materialization would change every bundle.
crates/rspice-publish/src/assets/** text eol=lf

# The browser Python runtime is integrity-pinned: automation-worker.js records
# the exact byte length and sha256 of the bootstrap and of every Pyodide
# execution asset, and rspice-runtime-manifest.json digests the same bytes.
# With core.autocrlf=true and no attribute here, a Windows checkout inflated
# rspice_browser_bootstrap.py by its 1018 CRs and pyodide.mjs by 4, so the
# worker rejected its own runtime — invisibly, because Linux CI checks out LF.
# Verbatim rather than eol=lf: the tree holds .wasm and .zip payloads too.
crates/rspice-ui/web/python/** -text

# Regenerated built-in Rust must stay clean after generator rewrites. The
# manifest records a blake3 over each generated file's exact bytes and
# `build.rs` re-derives it from the checkout, so an end-of-line translation
# here does not merely churn the diff — it fails the build on the platform
# that translated. Package markers and manifest included.
#
# Only this crate needs the pin. `rspice-core/src/device/veriloga_builtins`
# used to hold the generated tree and carried the same rule; it is hand-written
# adapter code now, fingerprinted by nothing, so it follows the ordinary
# whitespace policy like the rest of rspice-core.
crates/rspice-veriloga-models/** text eol=lf

# Vendored RSpice Cloud client trees are fingerprinted by
# tools/cloud/vendor-manifest.json (LF bytes); a CRLF checkout would fail the
# integrity gate.
crates/rspice-cloud-domain/** text eol=lf
crates/rspice-cloud-contract/** text eol=lf
crates/rspice-cloud-client/** text eol=lf
testdata/** text eol=lf
