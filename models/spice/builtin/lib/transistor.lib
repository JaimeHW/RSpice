* RSpice BJT Transistor Library
* Common bipolar junction transistor models
*
* Usage: .INCLUDE transistor.lib
*        Q1 collector base emitter 2N2222
*
* Models included:
*   2N2222   - NPN general purpose/switching
*   2N2222A  - NPN improved version
*   2N3904   - NPN general purpose (TO-92)
*   2N3906   - PNP general purpose (TO-92)
*   BC547    - NPN low noise (Europe)
*   BC557    - PNP low noise (Europe)
*   2N2907   - PNP switching
*   BC337    - NPN medium power
*   BC327    - PNP medium power
*   TIP31C   - NPN power transistor
*   TIP32C   - PNP power transistor
*   MPSA42   - NPN high voltage (300V)
*   MPSA92   - PNP high voltage (300V)
*

*=============================================================================
* General Purpose NPN Transistors
*=============================================================================

* 2N2222 - NPN switching transistor
* hFE = 100-300, Vceo = 40V, Ic = 600mA
.MODEL 2N2222 NPN(
+ IS=14.34E-15   ; Saturation current
+ BF=255.9       ; Forward beta
+ NF=1.0         ; Forward emission coefficient
+ VAF=74.03      ; Forward Early voltage
+ IKF=0.2847     ; High current roll-off
+ ISE=14.34E-15  ; B-E leakage saturation
+ NE=1.307       ; B-E leakage emission coefficient
+ BR=6.092       ; Reverse beta
+ NR=1.0         ; Reverse emission coefficient
+ VAR=28.0       ; Reverse Early voltage
+ IKR=0.0         
+ ISC=0          ; B-C leakage saturation
+ NC=2.0         ; B-C leakage emission coefficient
+ RC=1.0         ; Collector resistance
+ RE=0.227       ; Emitter resistance
+ RB=10.0        ; Base resistance
+ CJE=22.01E-12  ; B-E zero-bias capacitance
+ VJE=0.75       ; B-E built-in potential
+ MJE=0.377      ; B-E grading coefficient
+ CJC=7.306E-12  ; B-C zero-bias capacitance
+ VJC=0.75       ; B-C built-in potential
+ MJC=0.3416     ; B-C grading coefficient
+ TF=411.1E-12   ; Forward transit time
+ TR=46.91E-9    ; Reverse transit time
+ XTB=1.5        ; Beta temperature coefficient
+ EG=1.11        ; Bandgap
+ XTI=3.0        ; IS temperature coefficient
+ )

* 2N2222A - Improved 2N2222
.MODEL 2N2222A NPN(
+ IS=14.34E-15 BF=280 NF=1.0 VAF=74.03 IKF=0.3
+ ISE=14.34E-15 NE=1.307 BR=6.092 NR=1.0 VAR=28.0
+ RC=1.0 RE=0.227 RB=10.0
+ CJE=22.01E-12 VJE=0.75 MJE=0.377
+ CJC=7.306E-12 VJC=0.75 MJC=0.3416
+ TF=411.1E-12 TR=46.91E-9
+ XTB=1.5 EG=1.11 XTI=3.0
+ )

* 2N3904 - NPN general purpose (very popular TO-92)
* hFE = 100-300, Vceo = 40V, Ic = 200mA
.MODEL 2N3904 NPN(
+ IS=6.734E-15   ; Saturation current
+ BF=416.4       ; Forward beta
+ NF=1.0         ; Forward emission coefficient
+ VAF=74.03      ; Forward Early voltage
+ IKF=66.78E-3   ; High current roll-off
+ ISE=6.734E-15  ; B-E leakage saturation
+ NE=1.259       ; B-E leakage emission coefficient
+ BR=0.7371      ; Reverse beta
+ NR=1.0         ; Reverse emission coefficient
+ VAR=28.0       ; Reverse Early voltage
+ IKR=0          
+ ISC=0          ; B-C leakage saturation
+ NC=2.0         ; B-C leakage emission coefficient
+ RC=1.0         ; Collector resistance
+ RE=0.1         ; Emitter resistance
+ RB=10.0        ; Base resistance
+ CJE=4.493E-12  ; B-E zero-bias capacitance
+ VJE=0.75       ; B-E built-in potential
+ MJE=0.2593     ; B-E grading coefficient
+ CJC=3.638E-12  ; B-C zero-bias capacitance
+ VJC=0.75       ; B-C built-in potential
+ MJC=0.3085     ; B-C grading coefficient
+ TF=301.2E-12   ; Forward transit time
+ TR=239.5E-9    ; Reverse transit time
+ XTB=1.5 EG=1.11 XTI=3.0
+ )

*=============================================================================
* General Purpose PNP Transistors
*=============================================================================

* 2N3906 - PNP general purpose (complement to 2N3904)
* hFE = 100-300, Vceo = -40V, Ic = -200mA
.MODEL 2N3906 PNP(
+ IS=1.41E-15    ; Saturation current
+ BF=180.7       ; Forward beta
+ NF=1.0         ; Forward emission coefficient
+ VAF=115.7      ; Forward Early voltage
+ IKF=80E-3      ; High current roll-off
+ ISE=1.41E-15   ; B-E leakage saturation
+ NE=1.5         ; B-E leakage emission coefficient
+ BR=4.977       ; Reverse beta
+ NR=1.0         ; Reverse emission coefficient
+ VAR=18.0       ; Reverse Early voltage
+ RC=2.5         ; Collector resistance
+ RE=0.1         ; Emitter resistance
+ RB=10.0        ; Base resistance
+ CJE=9.726E-12  ; B-E zero-bias capacitance
+ VJE=0.65       ; B-E built-in potential
+ MJE=0.33       ; B-E grading coefficient
+ CJC=8.293E-12  ; B-C zero-bias capacitance
+ VJC=0.65       ; B-C built-in potential
+ MJC=0.33       ; B-C grading coefficient
+ TF=500E-12     ; Forward transit time
+ TR=67.6E-9     ; Reverse transit time
+ XTB=1.5 EG=1.11 XTI=3.0
+ )

* 2N2907 - PNP switching transistor
.MODEL 2N2907 PNP(
+ IS=0.65E-15 BF=150 NF=1.0 VAF=100 IKF=0.2
+ ISE=1E-15 NE=1.5 BR=3 NR=1.0 VAR=20
+ RC=1.5 RE=0.2 RB=10.0
+ CJE=10E-12 VJE=0.7 MJE=0.33
+ CJC=8E-12 VJC=0.7 MJC=0.33
+ TF=600E-12 TR=50E-9
+ XTB=1.5 EG=1.11 XTI=3.0
+ )

*=============================================================================
* European Series (BC5xx)
*=============================================================================

* BC547 - NPN low noise, general purpose
* hFE = 110-800 (B=200-450), Vceo = 45V, Ic = 100mA
.MODEL BC547 NPN(
+ IS=1.8E-14     ; Saturation current
+ BF=400         ; Forward beta (B grade)
+ NF=0.9955      ; Forward emission coefficient
+ VAF=80.0       ; Forward Early voltage
+ IKF=0.1        ; High current roll-off
+ ISE=5.0E-14    ; B-E leakage saturation
+ NE=1.46        ; B-E leakage emission coefficient
+ BR=35.5        ; Reverse beta
+ NR=1.0         ; Reverse emission coefficient
+ VAR=12.5       ; Reverse Early voltage
+ RC=0.4         ; Collector resistance
+ RE=0.6         ; Emitter resistance
+ RB=2.0         ; Base resistance (low noise)
+ CJE=11.5E-12   ; B-E zero-bias capacitance
+ VJE=0.65       ; B-E built-in potential
+ MJE=0.33       ; B-E grading coefficient
+ CJC=6.0E-12    ; B-C zero-bias capacitance
+ VJC=0.65       ; B-C built-in potential
+ MJC=0.33       ; B-C grading coefficient
+ TF=400E-12     ; Forward transit time
+ TR=60E-9       ; Reverse transit time
+ XTB=1.5 EG=1.11 XTI=3.0
+ )

* BC547B - BC547 B grade (mid-range hFE)
.MODEL BC547B NPN(
+ IS=1.8E-14 BF=330 NF=0.9955 VAF=80.0 IKF=0.1
+ ISE=5.0E-14 NE=1.46 BR=35.5 NR=1.0 VAR=12.5
+ RC=0.4 RE=0.6 RB=2.0
+ CJE=11.5E-12 VJE=0.65 MJE=0.33
+ CJC=6.0E-12 VJC=0.65 MJC=0.33
+ TF=400E-12 TR=60E-9
+ XTB=1.5 EG=1.11 XTI=3.0
+ )

* BC557 - PNP complement to BC547
.MODEL BC557 PNP(
+ IS=1.8E-14 BF=400 NF=0.995 VAF=80.0 IKF=0.1
+ ISE=5.0E-14 NE=1.46 BR=35.5 NR=1.0 VAR=12.5
+ RC=0.4 RE=0.6 RB=2.0
+ CJE=11.5E-12 VJE=0.65 MJE=0.33
+ CJC=6.0E-12 VJC=0.65 MJC=0.33
+ TF=400E-12 TR=60E-9
+ XTB=1.5 EG=1.11 XTI=3.0
+ )

*=============================================================================
* Medium Power Transistors
*=============================================================================

* BC337 - NPN medium power
* hFE = 100-600, Vceo = 45V, Ic = 800mA
.MODEL BC337 NPN(
+ IS=1.5E-14 BF=200 NF=1.0 VAF=100 IKF=0.5
+ ISE=1E-13 NE=1.5 BR=5 NR=1.0 VAR=20
+ RC=0.3 RE=0.3 RB=5.0
+ CJE=20E-12 VJE=0.7 MJE=0.33
+ CJC=10E-12 VJC=0.7 MJC=0.33
+ TF=350E-12 TR=50E-9
+ XTB=1.5 EG=1.11 XTI=3.0
+ )

* BC327 - PNP medium power (complement to BC337)
.MODEL BC327 PNP(
+ IS=1.5E-14 BF=200 NF=1.0 VAF=100 IKF=0.5
+ ISE=1E-13 NE=1.5 BR=5 NR=1.0 VAR=20
+ RC=0.3 RE=0.3 RB=5.0
+ CJE=20E-12 VJE=0.7 MJE=0.33
+ CJC=10E-12 VJC=0.7 MJC=0.33
+ TF=350E-12 TR=50E-9
+ XTB=1.5 EG=1.11 XTI=3.0
+ )

*=============================================================================
* Power Transistors
*=============================================================================

* TIP31C - NPN power transistor
* hFE = 10-50, Vceo = 100V, Ic = 3A
.MODEL TIP31C NPN(
+ IS=1E-12 BF=30 NF=1.0 VAF=60 IKF=3
+ ISE=1E-11 NE=1.5 BR=2 NR=1.0 VAR=10
+ RC=0.1 RE=0.05 RB=2.0
+ CJE=200E-12 VJE=0.75 MJE=0.4
+ CJC=100E-12 VJC=0.75 MJC=0.4
+ TF=1E-9 TR=200E-9
+ XTB=1.5 EG=1.11 XTI=3.0
+ )

* TIP32C - PNP power transistor (complement to TIP31C)
.MODEL TIP32C PNP(
+ IS=1E-12 BF=30 NF=1.0 VAF=60 IKF=3
+ ISE=1E-11 NE=1.5 BR=2 NR=1.0 VAR=10
+ RC=0.1 RE=0.05 RB=2.0
+ CJE=200E-12 VJE=0.75 MJE=0.4
+ CJC=100E-12 VJC=0.75 MJC=0.4
+ TF=1E-9 TR=200E-9
+ XTB=1.5 EG=1.11 XTI=3.0
+ )

*=============================================================================
* High Voltage Transistors
*=============================================================================

* MPSA42 - NPN high voltage
* hFE = 40-120, Vceo = 300V, Ic = 500mA
.MODEL MPSA42 NPN(
+ IS=1E-15 BF=80 NF=1.0 VAF=200 IKF=0.2
+ ISE=1E-14 NE=1.5 BR=3 NR=1.0 VAR=50
+ RC=1.0 RE=0.5 RB=20.0
+ CJE=5E-12 VJE=0.8 MJE=0.4
+ CJC=3E-12 VJC=0.8 MJC=0.4
+ TF=1E-9 TR=100E-9
+ XTB=1.5 EG=1.11 XTI=3.0
+ )

* MPSA92 - PNP high voltage (complement to MPSA42)
.MODEL MPSA92 PNP(
+ IS=1E-15 BF=80 NF=1.0 VAF=200 IKF=0.2
+ ISE=1E-14 NE=1.5 BR=3 NR=1.0 VAR=50
+ RC=1.0 RE=0.5 RB=20.0
+ CJE=5E-12 VJE=0.8 MJE=0.4
+ CJC=3E-12 VJC=0.8 MJC=0.4
+ TF=1E-9 TR=100E-9
+ XTB=1.5 EG=1.11 XTI=3.0
+ )

.END
