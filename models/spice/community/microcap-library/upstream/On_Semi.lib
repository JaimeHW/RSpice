*
**********
.SUBCKT NCP1217 skip FB CS GND DRV VCC HV params: Fswitch=65k Conso=960u
* Pinout        Adj  FB CS Gnd Drv Vcc HV

X1x 1 2 Q 4 LATCH
*
C8 49 rst 1n
R21 rst 0 100
C1 CMP 15 1n
R2 15 0 100
D10 0 15 Dclp
D11 0 rst Dclp
*
R1 4 0 100k
X16 cmp 49 INV
Rskip skip 48 22k
X4 skip 19 21 COMPAR
X17 45 rst 38 OR2
Vlatch 19 0 DC=3V ; latch voltage
X18 21 0 Qlatch Qblatch LATCH
Ssource Vcc Drv 20 0 SP ; source
Ssink Drv Gnd 20 0 SN; sink
XOscillator CMP 6 oscillator params: fsw={Fswitch} swing=3
Rramp 6 CS 19k ; ramp compensation resistor
EBsetp setpoint 0 Value = { IF ( V(FB)/3.3 > 1V, 1V, V(FB)/3 ) }
X5 13 setpoint 16 COMPAR
XLEB Q LEB UTD params: TD=250n; LEB time constant
EBiMeas 13 0 Value = { IF ( V(LEB) > 3.5V, V(CS), 0 ) }
RdumCS CS 0 1Meg
XPROP 16 44 UTD params: TD=90n ; CS prop delay
EBdrive 20 0 Value = { IF ( (V(Q) > 3.5) & (V(Qlatch) < 3), 0, V(Vcc) ) }
Desd1 0 skip _D5_mod
* UVLO section
X8 Vcc UVLO1 UVLO params: VON=12.8 VOFF=7.6
X11 Vcc UVLO2 UVLO params: VON=12.8 VOFF=3.5
*
D6 0 FB _D5_mod
GBstartup HV Vcc value = { IF ( V(UVLO2) > 3.5, 35u, 5m ) }
X14 44 46 38 2 OR3
GBCons1 Vcc 0 Value = { IF ( V(UVLO2) > 3.5, ({conso}+I(VFBM)), 300u ) }
X15 UVLO1 46 INV
D7 0 CS _D5_mod
D8 0 Vcc _D8_mod
EBskip 48 0 Value = { IF ( V(UVLO1) > 3.5, 1.1V, 0 ) }
* FB section
EBFB 3 0 Value = { IF ( V(UVLO1) > 3.5, 4.8V, 0 ) }
Rfb REF1 FB 20k ; feedback resistor
VFBM REF1 3; feedback current measure
*
X13 skip FB 45 COMPAR
X2 15 53 1 AND2
X3 2 53 INV
*
.MODEL _D8_mod D BV=20 CJO=10p N=0.8 RS=100m TT=100n
.MODEL _D5_mod D BV=10 CJO=10p N=0.8 RS=100m TT=100n
.model DCLP D rs=100m n=0.01 Cjo=10p
.model SN VSWITCH RON=10 VON=3 VOFF=1
.model SP VSWITCH RON=20 VON=1 VOFF=3
*
.ENDS
*
*
.subckt oscillator out rampo params: dc=0.8 fsw=65k valley=0.5 swing=2.5
*
.PARAM I1=100u
.PARAM I2={ (I1*{DC})/(1-{DC}) }
.PARAM TSW={1/FSW}
.PARAM Ct={ (TSW/SWING)*((I1*I2)/(I1+I2)) }
*
EBbuf rampo 0 Value = { V(ramp) }
Ct ramp 0 {Ct}
GB3 0 ramp Value = { IF ( V(CMP) < 3.5, {I1}, 0 ) }
X1 cmp OUT INVOSC
X4 ramp 4 cmp COMPAR params: VHIGH=5
EB1 4 0 Value = { IF ( V(CMP) > 3V, {valley}, {valley+swing} ) }
GB2 ramp 0 Value = { IF ( V(CMP) > 3.5, {I2}, 0 ) }
Rdum ramp 0 10Meg


***************
.IC  V(ramp)=0V
***************

.ENDS
*
*
.SUBCKT INVOSC 1 2
EB1 4 0 Value = { IF ( V(1)>800mV, 0, 10V ) }
RD 4 2 100
CD 2 0 10P
.ENDS INVOSC
*
*
.SUBCKT LATCH 6 8 2 1 params: VHIGH=10 VLOW=100m
*             S R Q Q\
EBQB   10 0 Value = { IF ( (V(8)<800M) & (V(2)>800M), {VLOW}, {VHIGH} ) }
EBQ    20 0 Value = { IF ( (V(6)<800M) & (V(1)>800M), {VLOW}, {VHIGH} ) }
RD1   10 1 100
CD1   1 0 10p IC={VHIGH}
RD2   20 2 100
CD2   2 0 10p IC={VLOW}
.ENDS LATCH
*
*
.SUBCKT INV 1 2
EB1 4 0 Value = { IF ( V(1)>3.5, 0, 10V ) }
RD 4 2 100
CD 2 0 10P
.ENDS INV
*
*
.SUBCKT OR2 1 2 3
EB1 4 0 Value = { IF ( (V(1)>2.5V) | (V(2)>2.5V), 5V, 100m ) }
RD 4 3 100
CD 3 0 10P
.ENDS OR2
*
*
.SUBCKT OR3 1 2 3 5
EB1 4 0 Value = { IF ( (V(1)>800mV) | (V(2)>800mV) | (V(3)>800mV), 10V, 100m ) }
RD 4 5 100
CD 5 0 10P
.ENDS
*
*
.SUBCKT AND2 1 2 3
EB1 4 0 Value = { IF ( (V(1)>800mV) & (V(2)>800mV), 10V, 100m ) }
RD 4 3 100
CD 3 0 10P
.ENDS AND2
*
*
.SUBCKT COMPAR NINV INV OUT params: VHIGH=12 VLOW=100m
EB1 4 0 Value = { IF (  V(NINV,INV) > 0,  {VHIGH},  {VLOW} ) }
RO 4 OUT 100
CO OUT 0 10PF
.ENDS COMPAR
*
*
.SUBCKT UTD 1 2 params: TD=250n
*
*Parameters K=GAIN TD=DELAY
RIN 1 0 1E15
E1 3 0 1 0 1
T1 3 0 2 0 Z0=1 TD={TD}
R1 2 0 1
.ENDS
*
*
.SUBCKT UVLO  1   3 params: VON=12 VOFF=10
*            VIN OUT
Vref 10 0 10V
X1 10 3 1 0 SWhyste params: RON=1 ROFF=1MEG VT={((VON-VOFF)/2) + VOFF} VH={(VON-VOFF)/2}
RUV 3 0 1k
.ENDS UVLO
*
*
.SUBCKT SWhyste NodeMinus NodePlus Plus Minus PARAMS: RON=1 ROFF=1MEG VT=5 VH=2
S5 NodePlus NodeMinus 8 0 smoothSW
EBcrtl 8 0 Value = { IF ( V(plus)-V(minus) > V(ref), 1, 0 ) }
EBref ref1 0 Value = { IF ( V(8) > 0.5, {VT-VH}, {VT+VH} ) }
Rdel ref1 ref 100
Cdel ref 0 100p  IC={VT+VH}
Rconv1 8 0 10Meg
Rconv2 plus 0 10Meg
Rconv3 minus 0 10Meg
.model smoothSW VSWITCH (RON={RON} ROFF={ROFF} VON=1 VOFF=0)
.ends SWhyste
*
******************************************************************************
* ON Semiconductor                                                           *
* NCP1217 model developed by Christophe BASSO, Toulouse (FRANCE)             *
* e-mail: christophe.basso@onsemi.com                                        *
* OrCAD PSpice compatible                                                    *
*                                                                            *
* Last modified: January 25th 2003                                           *
* NCP1217 average FLYBACK AC model DCM and CCM modes                         *
* FLYBACK average model made by Ben-Gurion University (ISRAEL)               *
* http://www.ee.bgu.ac.il/~pel                                               *
******************************************************************************
.SUBCKT NCP1217_AV In Out Gnd FB CTRL PARAMS: FS=65k L=2.7m MC=1 RI=2.7
GIN IN GND VALUE = { I(VLM)*V(DON)/(V(DON)+V(DOFF)) }
ELM OUT1 GND VALUE = { V(IN)*V(DON)-V(OUT)*V(DOFF) }
RM OUT1 5 1M
LM 5 8 {L}
VLM 8 GND
GOUT GND OUT VALUE = { I(VLM)*V(DOFF)/(V(DON)+V(DOFF)) }
VCLP VC 0 9M
D2 VC DOFF DBREAK
D1 DOFF 6 DBREAK
R4 DOFF 7 10
EDOFFM 6 GND VALUE = { 1-V(DON)-9M }
EDOFF 7 GND VALUE = { 2*I(VLM)*{FS}*{L}/(V(DON))/(V(IN))-V(DON) }
EDON  DON GND TABLE { ((V(CONTROL)-I(VLM)*{RI})*{FS})/({MC}+((0.5*{RI}*V(IN))/{L})) }
+ ( (10m,10m) (.999,.999) )
EB1 CONTROL 0 VALUE = { IF ( V(CTRL)/4 > 1, 1, V(CTRL)/4 ) }
Vref 50 GND DC=4.3V
Rfb 50 FB 20k
.MODEL DBREAK D (TT=1N CJO=10P N=0.01)
.ENDS


*



*** From file ncp1230.lib
* ==========================================================
* NCP1216 Transient model
* ON Semiconductor model developed by Christophe BASSO, Toulouse (FRANCE)
* VHV PWM Controllers
