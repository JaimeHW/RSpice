+ EPS_SI=1.035939974589e-10
+ cox={((EPS_OX)/tox)}
+ vj={((((QQ_NIST2004)*nsub)*(EPS_SI))*(tox**2))/(2*((EPS_OX)**2))}
+ nsubnorm=1e20
+ anorm=1.0e-12
+ n1={nsub}
+ n2={nsub/nsubred}
+ b={n2-(n2-n1)*(1+tr1)/2/tr1}
+ slope={(n2-n1)/vp/2/tr1}
