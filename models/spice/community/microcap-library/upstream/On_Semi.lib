*
.subckt S1 1 2 3 4
S_S1         3 4 1 2 _S1
RS_S1         1 2 1G
.MODEL         _S1 VSWITCH Roff=1e6 Ron=1.0 Voff=3V Von=0V
.ends S1
*
**** SR Flip Flop (RESET Dominant)****
.SUBCKT SRFFLOP 1 2 3 4
*                S R Q Qbar
E_Qbar 10 0 VALUE { IF ((V(2) < 800mV) & (V(3)>800mV) , 10mV ,5V)}
E_Q 20 0 VALUE { IF ((V(1) < 800mV) & (V(4)>800mV)|(V(2)>800mV), 10mV ,5V)}
RD1 10 4 100
CD1 4 0 10p IC=5
RD2 20 3 100
CD2 3 0 10p IC = 0

;Rreset 2 0 1Meg

.ENDS SRFFLOP
*
.SUBCKT 125ms 2  4
*             Tout  cout
D_D2         2 1 D1N4148
V_V3         3 0 4Vdc
E_U9         4 0 VALUE {LIMIT(V(2,3)*1E6,0V,+5V)}
RD	     4 5 100
CD	     5 0 10p
I_I1         1 2 DC 20uAdc
V_V2         1 0 5Vdc
C_C1         0 2 630n  IC=0
.ENDS 125ms
*
.SUBCKT PFC 1 2 3 13 14
* (1)skipout V2<0.75V, (2) errorflag, (3) skipin V2>1.25V, (13) Q(GTS enable
X_U31         5	6	 125MS
X_U28         11 12 13 14 SRFFLOP
X_U33         3 9 INV_B
X_S1          4 0 5 0 S1
X_U21         1 2 4 OR2_A
X_U30         9 10 11 AND2_A
X_U29         2 10 INV_B
X_U25         7 8 12 OR2_A
X_U23         1 6 7 AND2_A
X_U26         6 2 8 AND2_A
.ENDS PFC

*
.SUBCKT NCP1230P065 PFC FB CS GND DRV VCC HV
X1 PFC FB CS GND DRV VCC HV  NCP1230 params: Fsw=65k Conso=1800u
.ENDS
*
**********
.SUBCKT NCP1230P100 skip FB CS GND DRV VCC HV
X1 skip FB CS GND DRV VCC HV NCP1230 params: Fsw=100k Conso=980u
.ENDS
*
**********
.SUBCKT NCP1230P133 skip FB CS GND DRV VCC HV
X1 skip FB CS GND DRV VCC HV NCP1230 params: Fsw=133k Conso=1000u
.ENDS
*
**********
.SUBCKT NCP1230 1 2 3 4 5 6 8 params: Fsw=65k Conso=1100u
*	1 PFC		HV  8
*	2 FB		NC  -
*	3 CS		Vcc 6
*	4 Gnd           Drv 5

***ESD NETWORK ****
D1 4 1 DCLAMP1
D2 4 2 DCLAMP1
D3 4 3 DCLAMP1
D4 4 5 DCLAMP2
D5 4 6 DCLAMP2

**** SELF-SUPPLY ****
GB2		8	6	Value = { IF ( V(11) > 3.5, 0, 7m ) } ; DSS current capability
XCOMP1	6	10	UVLO	COMPNCP1230
EB5		10	4	Value = { IF ( V(UVLO) < 3.5, 12.6, 7.7 ) } ; DSS operating levels
X2 		UVLO	OVERLATCH	11	OR2_A
XUVLO6	100	6	110	COMPNCP1230
X50		110	OVERLATCH	UVLO6	AND2_A
VUVLO6	100	4	6.5

**** OUTPUT PULSE VALIDATION ****
XPULS UVLO OVER PULSOK NC4 TFFLOP; turns the pulses on at UVLOh
*     S    R    Q      Q\

**** CURRENT CONSUMPTION ****
ISUPP1	6	4	{Conso} ; minimum static current consumption
GBSUPP2	6	4	Value = { IF ( V(PULSOK) > 3.5, (300u + I(VFBM)), 0 ) } ; internal operating + FB current

**** CLOCK SECTION ****
*********************************************************************
** Fsw={Fsw} @ Vcc=11V    }
** Fsw={Fsw}+4% @ Vcc=12V }
** Fsw={Fsw}-4% @ Vcc=10V } => DeltaV=1V, Jittering=0.04, Vref=11V
*********************************************************************
XCLOCK clk1 ramp 6 mduty CLOCK1230 params: DC=0.75 Fsw_ref={Fsw} Vref=11V Valley=0V Swing=2.9V DeltaV=1V Jittering=0.04
RRAMP		RAMPCOMP	3	18k 	; Internal ramp comp resistor
Rrampdum	ramp		4	100Meg
EBRAMP 	RAMPCOMP	4	Value = { IF ( V(PULSOK)>3.5, V(RAMP), 0 ) }; validates the ramp during Ton only
XRESET2 	MDUTY		IMAX	SKIP	RST	OR3_A
XRESET1 	clk1		200	clk2	AND2_A
EBINVRST 	200		4	Value = { IF ( V(SKIP)<750mV, 3.5, 0 ) }
XFFLOP 	clk2		RST	Q	NC1	TFFLOP
RNC1		NC1		4	100k

**** CURRENT SENSE ****
EBVREF	REF1		4	Value = { IF ( V(6) > 6.5V, 6.5, V(6) ) } ; internal FB reference
VFBM		REF1		REF		; feedback current measure
RFB		REF		2	20k 	; FB pull-up resistor
EBCLIP	ISET		4	Value = { IF ( V(2)/3.2 > 1V, 1V, V(2)/3.2 ) }; internal 1V clamping diode no SS
EBFLAG	EFLG		4	Value = { IF (V(ISET)>0.99V, 5V, 0 )}; set clamp flag
XCOMP2	LEBO		ISET	OVERI	COMPNCP1230
XPROPDEL	OVERI		IMAX	UTD	params: TD=90ns	; propagation delay
XDEL3		Q		30	UTD	params: TD=200ns
EBLEB		LEBO		4	Value = { IF ( V(30) > 3V, V(3), 0 ) }

**** OVERLOAD SECTION ****
EBOVER	50		4	Value = { IF ( (V(ISET)>990mV) & (V(PULSOK)>3.5), 10, 0 ) }
XOVER		UVLO		50	OVER	AND2I_A		; UVLO low and OVL, latches off the pulses
XLATCH	OVER		UVLO6	OVERLATCH	NC5	TFFLOP; latches off the current source
RNC5		NC5		4	100k

**** SKIP CYCLE SECTION Modified for the NCP1230****
ESKIP	SKIP		4	Value = { IF (V(2)<0.75, 1V, 0)};NCP1230 Skip no longer uses the Adj pin
EBHYST	150		4	Value = { IF ( V(SKIP) < 3.5, 750mV, 750mV+100m ) }
EBSKIPIN SINFLG		4	Value = { IF (V(2)<0.85V, 5V,0V)}; Set go into skip mode flag
EBSKIPO	SOFLG		4	Value = { IF (V(2)>1.25V, 0V,5V)}; Set come out of Skip Flag

**** PFC Enable/Disable Section************************
X5	SINFLG EFLG SOFLG PFCOUT QBAR PFC
EBPFCE		160		4	Value = { IF (V(PFCOUT)>4.9V, 5V, 0V )}; Turn on PFC_Vcc
SPFCCon	1		6	160	4	S2; PFC Switch
D_PFC	1		6	D1N4148		  ;Diode in parallel with the PFC Switch
**** DRIVER SECTION ****
* BDRVU		90		0	V=(V(PULSOK)>3V) & (V(Q)>3V) & (V(OVPOK)>3V) ? 100mV : 5V ; original
EBDRVU	90		0	Value = { IF ( (V(PULSOK)>3V) & (V(Q)>3V), 100mV, 5V ) }
SdrvOFF	5		4	90	0	SN ; sink impedance
SdrvON	6		5	90	0	SP ; source impedance

****
.MODEL DSTD D RS=100M CJO=15pF N=0.2
.MODEL DCLAMP1 D BV=10
.MODEL DCLAMP2 D BV=20
.MODEL QRSS NPN BF=200
.model SN VSWITCH RON=7.5 VON=3 VOFF=1
.model SP VSWITCH RON=11.7 VON=1 VOFF=3
.Model S2 Vswitch Roff=1e6 Ron=11.7 Voff=0.5V Von=4.5V
.ENDS
