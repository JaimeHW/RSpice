********* NCP1205 MODELS ********
*
**** Error amplifier ****
.SUBCKT AMPSIMP 1 5 2  PARAMS: POLE=30 GAIN=30000 VHIGH=4V VLOW=100mV
*               + - OUT
G1 0 4 1 5 100u
R1 4 0 {GAIN/100U}
C1 4 0 {1/(6.28*(GAIN/100U)*POLE)}
E1 2 0 4 0 1
VLOW 3 0 DC={VLOW}
VHIGH 6 0 DC={VHIGH}
DHIGH 4 6 DCLP
DLOW 3 4 DCLP
.MODEL DCLP D N=0.01
.ENDS AMPSIMP
**** DRIVER STAGE ****
.SUBCKT DRIVER InDrv Out Vcc
* In Out Vcc Ground
Cboot VccBoot Out 100p
RgU 3 20 150 ; modified for PSpice
VDUM 20 2 ; modified for PSpice
D1 Vint VccBoot 1N4148
M2 Out 6 0 0 NCHAN
M1 Vcc 2 Out 0 NCHAN
RgLow 6 9 150
D2 0 VccBoot DzBoot
EB2 9 0 VALUE = { IF ( V(InDrv)>800mV, 0, V(Vint) ) }
EB1 3 0 VALUE = { IF ( V(InDrv)>800mV, V(VccBoot), 0 ) }
EBint Vint 0 VALUE = { IF ( V(Vcc)>9V, 9V, V(Vcc) ) }
GB3 VccBoot 0 VALUE = { IF ( I(Vdum)> 0, I(Vdum), 0 ) }
Rdum3 InDrv 0 100k
.ENDS DRIVER
**** Comparator ****
.SUBCKT COMPAR NINV INV OUT
EB1 4 0 VALUE = { IF ( V(NINV,INV) > 0, 10, 100m ) }
RO 4 OUT 100
CO OUT 0 100pF
.ENDS COMPAR
**** Discrete models ****
.MODEL Dmag D BV=10V CJO=15p IS=7E-09 M=.45 N=2 RS=.8
+ TT=6E-09 VJ=.6V
.MODEL DOVP D BV=35V Cjo=10pF TT=100n Rs=150m
.MODEL 1N4148 D BV=100V CJO=4PF IS=7E-09 M=.45 N=2 RS=.8
+ TT=6E-09 VJ=.6V
.MODEL 2N2222 NPN BF=105 BR=4 CJC=12.2P CJE=35.5P IKF=.5
+ IKR=.225 IS=15.2F ISE=8.2P NE=2 NF=1 NR=1 RB=1.49 RC=.149
+ RE=.373 TF=500P TR=85N VAF=98.5 VAR=20 XTB=1.5
.MODEL NCHAN NMOS Level=1 CBD=69.2P CBS=83P CGBO=334N
+ CGDO=30N CGSO=36N GAMMA=2.17U IS=35.4F KP=.27 LAMBDA=1.25M
+ MJ=.46 PB=.8 PHI=.75 RD=1.7 RS=1.1 VTO=2.3
.MODEL DzBoot D BV=16 CJO=2pF IBV=8.3333M IS=1E-9 N=2
+ RS=8.7297 TT=20N
**** D-FFLOP ****
.SUBCKT FFLOP 1  2 11 12 5  6
*             CLK D R  S  QB Q
X1 7 4 2 8 NAND30
X2 8 3 10 9 NAND30
X3 1 8 10 7 NAND31
X4 4 9 1 10 NAND30
X5 4 7 6 5 NAND31
X6 5 10 3 6 NAND30
X7 11 4 INV
X8 12 3 INV
.ENDS FFLOP
***** INTERNAL FFLOP DEFINITION ****
.SUBCKT NAND30 1 2 3 4
E1 5 0 VALUE = { IF ( (V(1)>800mV) & (V(2)>800mV) & (V(3)>800mV), 100m, 10 ) }
R1 5 4 10
C1 4 0 10P IC=100m
.ENDS NAND30
.SUBCKT NAND31 1 2 3 4
E1 5 0 VALUE = { IF ( (V(1)>800mV) & (V(2)>800mV) & (V(3)>800mV), 100m, 10 ) }
R1 5 4 10
C1 4 0 10P IC=10
.ENDS NAND31
.SUBCKT INV 1 2
E1 3 0 VALUE = { IF ( V(1)>800mV, 100m, 10 ) }
R1 3 2 10
C1 2 0 10P IC=10
.ENDS INV
**** 2 input AND ****
.SUBCKT AND2 1 2 3 PARAMS: VHIGH=10
EB1 4 0 VALUE = { IF ( (V(1)>800M) & (V(2)>800M), {VHIGH}, 0 ) }
RD 4 3 100
CD 3 0 100P
.ENDS AND2
**** Simple Latch ****
.SUBCKT LATCH 6 8 2 1 PARAMS: VHIGH=10 VLOW=100m
*             S R Q Q\
EBQB   10 0 VALUE = { IF ( (V(8)<800M) & (V(2)>800M), {VLOW}, {VHIGH} ) }
EBQ    20 0 VALUE = { IF ( (V(6)<800M) & (V(1)>800M), {VLOW}, {VHIGH} ) }
RD1   10 1 100
CD1   1 0 100p IC={VHIGH}
RD2   20 2 100
CD2   2 0 100p IC={VLOW}
.ENDS LATCH
**** 2 Input OR gate ****
.SUBCKT OR2 1 2 3 PARAMS: VHIGH=10
EB1 4 0 VALUE = { IF ( (V(1)>800M) | (V(2)>800M), {VHIGH}, 0 ) }
RD 4 3 100
CD 3 0 100P
.ENDS OR2
**** 3 Input, 1 normal 2 bar (2&3) OR gate ****
.SUBCKT OR3B 1 2 3 6 PARAMS: VHIGH=10
EB1 4 0 VALUE = { IF ( (V(1)>800M) | (V(2)<3V) | (V(3)<3V), {VHIGH}, 0 ) }
RD 4 6 100
CD 6 0 100P
.ENDS OR3B
**** Gain Block ****
.SUBCKT GAIN  1  2 PARAMS: K=1
*Connections: In Out
*Parameters: K Gain
E1 2 0 VALUE = {V(1,0)*K} ; modified for PSpice compatibility
.ENDS
**** Delay line ****
.SUBCKT UTD 1 2 PARAMS: K=1 TD=200n
*
*Parameters K=GAIN TD=DELAY
RIN 1 0 1E15
E1 3 0 VALUE = {V(1,0)*K}
T1 3 0 2 0 Z0=1 TD={TD}
R1 2 0 1
.ENDS
*
**** UVLO CIRCUIT ****
.SUBCKT UVLO  1   3
*            VIN OUT
Vref 10 0 5V
X1 10 3 1 0 SWhyste params: RON=1 ROFF=1MEG VT=11.25 VH=3.75 ; VON = VT+VH = 15.0 VOFF = VT-VH = 7.5V
RUV 3 0 1k
.ENDS UVLO
****
* PSpice hysteresis switch made by Chris Basso
.subckt SWhyste NodeMinus NodePlus Plus Minus PARAMS: RON=1 ROFF=1MEG VT=5 VH=2
S5 NodePlus NodeMinus 8 0 smoothSW
EBcrtl 8 0 Value = { IF ( V(plus)-V(minus) > V(ref), 1, 0 ) }
EBref ref1 0 Value = { IF ( V(8) > 0.5, {VT-VH}, {VT+VH} ) }
Rdel ref1 ref 100
Cdel ref 0 100p  IC={VT+VH}
Rconv1 8 0 10Meg
Rconv2 plus 0 10Meg
Rconv3 minus 0 10Meg
.model smoothSW VSWITCH (RON={RON} ROFF={ROFF} VON=1 VOFF=0)
.ends SWhyste
****
****
**** MULTI-WINDING TRANSFORMER ****
.SUBCKT XFMR2 1 2 3 4 10 11 PARAMS: RATIO1=1 RATIO2=1
RP 1 2 1MEG
E1 5 4 VALUE = { V(1,2)*RATIO1 }
G1 1 2 VALUE = { I(VM1)*RATIO1 }
RS1 6 3 1U
VM1 5 6
E2 20 11 VALUE = { V(2,1)*RATIO2 }
G2 2 1 VALUE = { I(VM2)*RATIO2 }
RS2 21 10 1U
VM2 20 21
.ENDS XFMR2
**** MOC8101 OPTOCOUPLER ****
.SUBCKT MOC8101 1 2 3   5
* ISOLATOR      A C COL EMITTER
RB 4 0 100Meg
VM 1 6
D1 6 2 LED
H1 7 0 VM .0055
R1 7 8 1K
C1 8 0 3.35nF
G1 3 4 8 0 1
Q1 3 4 5 MPSA06
.MODEL LED D(N=1.7 RS=.7 CJO=23.9P IS=85.3p BV=6 IBV=10U
+ VJ=0.75 M=0.333 TT=4.32U)
.MODEL MPSA06 NPN (IS=15.2F NF=1 BF=589 VAF=98.6 IKF=90M ISE=3.34P NE=2
+ BR=4 NR=1 VAR=16 IKR=0.135 RE=0.343 RB=1.37 RC=0.137 XTB=1.5
+ CJE=9.67P VJE=1.1 MJE=0.5 CJC=7.34P VJC=0.3 MJC=0.3 TF=10.29n TR=276N)
.ENDS MOC8101
