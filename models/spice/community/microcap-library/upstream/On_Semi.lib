*** From file FDS8433A.mod
*FDS8433A at Temp. Electrical Model
*-------------------------------------
.SUBCKT FDS8433A 20 10 30 50
*20=DRAIN 10=GATE 30=SOURCE 50=VTEMP
Rg 10 11x 1
Rdu 12x 1 1u
M1 2 1 4x 4x DMOS L=1u W=1u
.MODEL DMOS PMOS(VTO=-0.45 KP=1.6E+1
+THETA=.25 VMAX=9.5E5 LEVEL=3)
Cgs 1 5x 1057p
Rd 20 4 3.25E-3
Dds 4 5x DDS
.MODEL DDS D(M=4.1139E-1 VJ=7.2939E-1 CJO=1082p)
Dbody 20 5x DBODY
.MODEL DBODY D(IS=3.94E-7 N=1.572814 RS=.00064 TT=36.86n)
Ra 4 2 3.25E-3
Rs 5x 5 0.5m
Ls 5 30 0.5n
M2 1 8 6 6 INTER
E2 8 6 4 1 2
.MODEL INTER PMOS(VTO=0 KP=10 LEVEL=1)
Cgdmax 7 4 3000p
Rcgd 7 4 10meg
Dgd 4 6 DGD
Rdgd 4 6 10meg
.MODEL DGD D(M=5E-1 VJ=6.03E-3 CJO=3000p)
M3 7 9 1 1 INTER
E3 9 1 4 1 -2
*ZX SECTION
EOUT 4x 6x poly(2) (1x,0) (3x,0) 0 0 0 0 1
FCOPY 0 3x VSENSE 1
RIN 1x 0 1G
VSENSE 6x 5x 0
RREF 3x 0 10m
*TEMP SECTION
ED 101 0 VALUE {V(50,100)}
VAMB 100 0 25
EKP 1x 0 101 0 .018
*VTO TEMP SECTION
EVTO 102 0 101 0 .001
EVT 11x 12x 102 0 1
*DIODE THEMO BREAKDOWN SECTION
EBL VB1 VB2 101 0 .08
VBLK VB2 0 20
D DB1 20 DBLK
.MODEL DBLK D(IS=1E-14 CJO=.1p RS=.1)
EDB 0 DB1 VB1 0 1
.ENDS FDS8433A
*FDS8433A (Rev.A)  8/21/01 **ST




