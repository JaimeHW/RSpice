*** From file ncp1216.lib
* ==========================================================
* NCP1216 Transient model
* ON Semiconductor model developed by Christophe BASSO, Toulouse (FRANCE)
* VHV PWM Controllers
*
* This model is subject to change without notice.
* Users may not directly or indirectly re-sell or
* re-distribute this model. This model may not
* be used, modified, or altered
* without the consent of ON Semiconductor.
*
* This simplified models accounts for propagation delays
* and includes the complete overcharge detection scheme
* EMI jittering, internal ramp comp.
* OrCAD's PSpice compatible
*
* Revision: January 26th 2003
*
*==========================================================
**********
*
.SUBCKT NCP1216P065 skip FB CS GND DRV VCC HV
X1 skip FB CS GND DRV VCC HV NCP1216 params: Fsw=65k Conso=940u
.ENDS
*
**********
.SUBCKT NCP1216P100 skip FB CS GND DRV VCC HV
X1 skip FB CS GND DRV VCC HV NCP1216 params: Fsw=100k Conso=980u
.ENDS
*
**********
.SUBCKT NCP1216P133 skip FB CS GND DRV VCC HV
X1 skip FB CS GND DRV VCC HV NCP1216 params: Fsw=133k Conso=1000u
.ENDS
*
**********
.SUBCKT NCP1216 1 2 3 4 5 6 8 params: Fsw=65k Conso=940u
*	1 Adj		HV  8
*	2 FB		NC  -
*	3 CS		Vcc 6
*	4 Gnd           Drv 5

***ESD NETWORK ****
D1 4 1 DCLAMP1
D2 4 2 DCLAMP1
D3 4 3 DCLAMP1
D4 4 5 DCLAMP2
D5 4 6 DCLAMP2

**** SELF-SUPPLY ****
GB2		8	6	Value = { IF ( V(11) > 3.5, 0, 7m ) } ; DSS current capability
XCOMP1	6	10	UVLO	COMPNCP1216
EB5		10	4	Value = { IF ( V(UVLO) < 3.5, 12, 10 ) } ; DSS operating levels
X2 		UVLO	OVERLATCH	11	OR2_A
XUVLO6	100	6	110	COMPNCP1216
X50		110	OVERLATCH	UVLO6	AND2_A
VUVLO6	100	4	6.5

**** OUTPUT PULSE VALIDATION ****
XPULS UVLO OVER PULSOK NC4 TFFLOP; turns the pulses on at UVLOh
*     S    R    Q      Q\

**** CURRENT CONSUMPTION ****
ISUPP1	6	4	{Conso} ; minimum static current consumption
GBSUPP2	6	4	Value = { IF ( V(PULSOK) > 3.5, (300u + I(VFBM)), 0 ) } ; internal operating + FB current

**** CLOCK SECTION ****
*********************************************************************
** Fsw={Fsw} @ Vcc=11V    }
** Fsw={Fsw}+4% @ Vcc=12V }
** Fsw={Fsw}-4% @ Vcc=10V } => DeltaV=1V, Jittering=0.04, Vref=11V
*********************************************************************
XCLOCK clk1 ramp 6 mduty CLOCK1216 params: DC=0.75 Fsw_ref={Fsw} Vref=11V Valley=0V Swing=2.9V DeltaV=1V Jittering=0.04
RRAMP		RAMPCOMP	3	19k 	; Internal ramp comp resistor
* Rrampdum	ramp		0	100Meg	;original
Rrampdum	ramp		4	100Meg
EBRAMP 	RAMPCOMP	4	Value = { IF ( V(PULSOK)>3.5, V(RAMP), 0 ) }; validates the ramp during Ton only
XRESET2 	MDUTY		IMAX	SKIP	RST	OR3_A
XRESET1 	clk1		200	clk2	AND2_A
EBINVRST 	200		4	Value = { IF ( V(SKIP)<800mV, 3.5, 0 ) }
XFFLOP 	clk2		RST	Q	NC1	TFFLOP
RNC1		NC1		4	100k

**** CURRENT SENSE ****
EBVREF	REF1		4	Value = { IF ( V(6) > 4.8V, 4.8, V(6) ) } ; internal FB reference
VFBM		REF1		REF		; feedback current measure
RFB		REF		2	20k 	; FB pull-up resistor
* BCLIP		ISET		4	V=V(2)/3.3 > V(901) ? V(901) : V(2)/3.3	; internal 1V clamping diode + SS
EBCLIP	ISET		4	Value = { IF ( V(2)/3.3 > 1, 1, V(2)/3.3 ) }; internal 1V clamping diode no SS
XCOMP2	LEBO		ISET	OVERI	COMPNCP1216
XPROPDEL	OVERI		IMAX	UTD	params: TD=90ns	; propagation delay
XDEL3		Q		30	UTD	params: TD=250ns
EBLEB		LEBO		4	Value = { IF ( V(30) > 3V, V(3), 0 ) }

**** OVERLOAD SECTION ****
EBOVER	50		4	Value = { IF ( (V(ISET)>990mV) & (V(PULSOK)>3.5), 10, 0 ) }
XOVER		UVLO		50	OVER	AND2I_A		; UVLO low and OVL, latches off the pulses
XLATCH	OVER		UVLO6	OVERLATCH	NC5	TFFLOP; latches off the current source
RNC5		NC5		4	100k

**** SKIP CYCLE SECTION ****
RADJU		REF		1	120k
RADJL		1		4	31.5k
XSKIP		150		2	SKIP	COMPNCP1216
EBHYST	150		4	Value = { IF ( V(SKIP) < 3.5, V(1), V(1)+100m ) }

**** DRIVER SECTION ****
* BDRVU		90		0	V=(V(PULSOK)>3V) & (V(Q)>3V) & (V(OVPOK)>3V) ? 100mV : 5V ; original
EBDRVU	90		0	Value = { IF ( (V(PULSOK)>3V) & (V(Q)>3V), 100mV, 5V ) }
SdrvOFF	5		4	90	0	SN ; sink impedance
SdrvON	6		5	90	0	SP ; source impedance

****
.MODEL DSTD D RS=100M CJO=15pF N=0.2
.MODEL DCLAMP1 D BV=10
.MODEL DCLAMP2 D BV=20
.MODEL QRSS NPN BF=200
.model SN VSWITCH RON=10 VON=3 VOFF=1
.model SP VSWITCH RON=20 VON=1 VOFF=3
.ENDS
*
*********************************************************************
* ON Semiconductor                                                  *
* NCP1216 model developed by Christophe BASSO, Toulouse (FRANCE)    *
* e-mail: christophe.basso@onsemi.com                               *
* OrCAD PSpice compatible                                           *
*                                                                   *
* Last modified: January 25th 2003                                  *
* NCP1216 average FLYBACK AC model DCM and CCM modes                *
* FLYBACK average model made by Ben-Gurion University (ISRAEL)      *
* http://www.ee.bgu.ac.il/~pel                                      *
*********************************************************************

.SUBCKT NCP1216_Av In Out Gnd FB CTRL PARAMS: FS=65k L=2.7m MC=1 RI=2.7
GIN IN GND VALUE = { I(VLM)*V(DON)/(V(DON)+V(DOFF)) }
ELM OUT1 GND VALUE = { V(IN)*V(DON)-V(OUT)*V(DOFF) }
RM OUT1 5 1M
LM 5 8 {L}
VLM 8 GND
GOUT GND OUT VALUE = { I(VLM)*V(DOFF)/(V(DON)+V(DOFF)) }
VCLP VC 0 9M
D2 VC DOFF DBREAK
D1 DOFF 6 DBREAK
R4 DOFF 7 10
EDOFFM 6 GND VALUE = { 1-V(DON)-9M }
EDOFF 7 GND VALUE = { 2*I(VLM)*{FS}*{L}/(V(DON))/(V(IN))-V(DON) }
EDON  DON GND TABLE { ((V(CONTROL)-I(VLM)*{RI})*{FS})/({MC}+((0.5*{RI}*V(IN))/{L})) }
+ ( (10m,10m) (.999,.999) )
EB1 CONTROL 0 VALUE = { IF ( V(CTRL)/4 > 1, 1, V(CTRL)/4 ) }
Vref 50 GND DC=4.3V
Rfb 50 FB 20k
.MODEL DBREAK D (TT=1N CJO=10P N=0.01)
.ENDS
*
*
**** SUBCIRCUIT MODELS ****
*
.SUBCKT UTD 1 2 params: TD=1n
*
*Parameters K=GAIN TD=DELAY
RIN 1 0 1E15
E1 3 0 1 0 1
T1 3 0 2 0 Z0=1 TD={TD}
R1 2 0 1
.ENDS
*
**** 2 INPUT COMPARATOR ****
.SUBCKT COMPNCP1216 1 2 3
*             + - S
EB1 4 0 Value = { IF ( V(1) > V(2), 5V, 0 ) }
RD 4 3 100
CD 3 0 10P
.ENDS

*
**** 3 INPUT OR GATE ****
.SUBCKT OR3_A 1 2 3  6
* EB1 5 0 Value = { IF ( (V(1)>2.5) | (V(2)>2.5) | (V(3)>2.5), 5, 0 ) }
EB1 5 0 Value = { IF ( (V(1)>800m) | (V(2)>800m) | (V(3)>800m), 5, 0 ) }
* comparison voltage raised to 3 to lower the noise
RD 5 6 100
CD 6 0 10P
.ENDS OR3_A
*
**** 2 INPUT OR GATE ****
.SUBCKT OR2_A 1 2 3
EB1 4 0 Value = { IF ( (V(1)>800M) | (V(2)>800M), 5V, 0 ) }
RD 4 3 100
CD 3 0 10P
.ENDS OR2_A
*
**** 2 INPUT AND CIRCUIT ****
.SUBCKT AND2_A 1 2 3
EB1 4 0 Value = { IF ( (V(1)>800M) & (V(2)>800M), 5V, 0 ) }
RD 4 3 100
CD 3 0 10P
.ENDS AND2_A
*
**** 2 INPUT INVERTED AND CIRCUIT ****
.SUBCKT AND2I_A 1 2 3
EB1 4 0 Value = { IF ( (V(1)<800M) & (V(2)>800M), 5V, 0 ) }
RD 4 3 100
CD 3 0 10P
.ENDS AND2I_A
*
**** 2 INPUT NOR CIRCUIT ****
.SUBCKT NOR2_A 1 2 3
EB1 4 0 Value = { IF ( (V(1)>800M) | (V(2)>800M), 0V, 5 ) }
RD 4 3 100
CD 3 0 10P
.ENDS NOR2_A
*
****
.SUBCKT INV_B 1 2
EB1 4 0 Value = { IF ( V(1)>800mV, 0, 10V ) }
RD 4 2 100
CD 2 0 10P
.ENDS INV_B
*
*
.SUBCKT TFFLOP 6 8 2 1
*              S R Q Q\
EBQB   10 0 Value = { IF ( (V(8)<800M) & (V(2)>800M), 0, 10V ) }
EBQ    20 0 Value = { IF ( (V(6)<800M) & (V(1)>800M), 0, 10V ) }
RD1   10 1 100
CD1   1 0 10p IC=5
RD2   20 2 100
CD2   2 0 10p IC=0
.ENDS TFFLOP
*
*
.SUBCKT UVLO  1   3 params: VON=12 VOFF=10
*            VIN OUT
Vref 10 0 10V
X1 10 3 1 0 SWhyste params: RON=1 ROFF=1MEG VT={((VON-VOFF)/2) + VOFF} VH={(VON-VOFF)/2}
RUV 3 0 1k
.ENDS UVLO
*
*
.SUBCKT SWhyste NodeMinus NodePlus Plus Minus PARAMS: RON=1 ROFF=1MEG VT=5 VH=2
S5 NodePlus NodeMinus 8 0 smoothSW
EBcrtl 8 0 Value = { IF ( V(plus)-V(minus) > V(ref), 1, 0 ) }
EBref ref1 0 Value = { IF ( V(8) > 0.5, {VT-VH}, {VT+VH} ) }
Rdel ref1 ref 100
Cdel ref 0 100p  IC={VT+VH}
Rconv1 8 0 10Meg
Rconv2 plus 0 10Meg
Rconv3 minus 0 10Meg
.model smoothSW VSWITCH (RON={RON} ROFF={ROFF} VON=1 VOFF=0)
.ends SWhyste
*
.SUBCKT CLOCK1216 out12 ramp vcc maxduty2 params: DC=0.8 Fsw_ref=65k Vref=11V Valley=0V Swing=2.9V DeltaV=1V
+ Jittering=0.04

** Fsw @ Vref
** At Vcc=Vref+DeltaV then Fsw_Vcc=Fsw_ref*(1+Jittering)

.PARAM I1=100uA
.PARAM I2={ (I1*{DC})/(1-{DC}) }
.PARAM Tsw_ref={1/Fsw_ref}
.PARAM Ct={ (Tsw_ref/Swing)*((I1*I2)/(I1+I2)) }

*** coeff : frequency jittering based on Vcc level : {1+((V(vcc)-Vref)/DeltaV)*Jittering}
*** the jittering depth is (0.04 = +/- 4%)
*
* Vcc input is for jittering
* SET/RESET pulses for clock gen.
*
X100	out		outb		INV_B
Cmd	outb		maxduty	1n
Rmd 	maxduty	0		100
Dmd1	0		maxduty 	DCLP
Cpuls out		out1		1n
Rpuls out1		0		100
Dmd2	0		out1		DCLP
*
Xbuf1 out1		out12		BUF_A ; formats the pulses
Xbuf2 maxduty	maxduty2	BUF_A
*
X4	ramp	4	cmp		COMPNCP1216
Ct	ramp	0	{Ct}		IC=0V
X1 	cmp	OUT	INVOSC
EB1	4	0	Value = { IF ( V(CMP) > 3V	, (valley), (valley+swing) ) }
GB2	ramp	0	Value = { IF ( V(CMP) > 3.5V	, (I1*DC*(1+((V(vcc)-Vref)/DeltaV)*Jittering))/(1-DC), 0 ) }
GB3x 	0	ramp	Value = { IF ( V(CMP) < 3.5V	, (I1*(1+((V(vcc)-Vref)/DeltaV)*Jittering)), 0 ) }
*
.model DCLP D (Cjo=10p Rs=100m N=0.01)
.ENDS CLOCK1216


*
*
.SUBCKT INVOSC 1 2
EB1 4 0 Value = { IF ( V(1)>800mV, 0, 5V ) }
RD 4 2 100
CD 2 0 10P
.ENDS INVOSC
*
*
.SUBCKT BUF_A 1 2
EB1 4 0 Value = { IF (  V(1)>0.5V, 5V, 0V ) }
RD 4 2 10
CD 2 0 10P
.ENDS BUF_A
*
*



