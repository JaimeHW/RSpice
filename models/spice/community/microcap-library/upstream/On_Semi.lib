.SUBCKT SPD02N60S5_L1 drain gate source PARAMS: dVth=0 dRdson=0

.PARAM Rs=2.78m     Rg=7.7       Ls=7n        Ld=1n        Lg=7n
.PARAM act=1.5      Inn=1.1      Unn=10       Rmax=3

X1  dd g s Tj Tj cool_600_s_var PARAMS: act={act} dVth={dVth} dR={dRdson} Inn={Inn} Unn={Unn}
                                        +Rmax={Rmax} Rs={Rs} heat=0
L_Ld         drain  dd    {Ld}
R_Ld         drain  dd    10

L_Ls         source lsrs  {Ls}
R_Ls         source lsrs  10
R_Rs         s      lsrs  {Rs}

