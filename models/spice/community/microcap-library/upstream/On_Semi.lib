R34 61 80 7K
Q16 62 61 18 QP
C12 62 80 5N
Q17 62 63 80 QN
Q18 62 64 63 QN
R35 64 80 1K
Q1 1 1 18 QP
.ENDS LOGIC
*
.SUBCKT VID4 6 1 3 4 2 5 11
* V(1)=VID4 V(3)=VID3
* V(4)=VID2  V(2)=VID1
* V(5)=VID0
R1 6 3 50K
R2 6 1 50K
R3 6 4 50K
R4 6 2 50K
R5 6 5 50K
BDAC 7 0 V=V(1) < 1.25 ? 2.09 : V(5) > 1.25 ? V(2) > 1.25 ? V(4) > 1.25 ? V(3) > 1.25 ? 2.747 : 3.54
BV1 7 8 V=V(1) > 1.25 ? V(5) > 1.25 ? .1 : V(1) < 1.25 ? V(5) > 1.25 ? .05  : 0
B2 8 9 V=V(1) > 1.25 ? V(2) > 1.25 ? .2 : V(1) < 1.25 ? V(2) > 1.25 ? .1  : 0
B3 9 10 V=V(1) > 1.25 ? V(4) > 1.25 ? .4 : V(1) < 1.25 ? V(4) > 1.25 ? .2  : 0
B4 10 11 V=V(1) > 1.25 ? V(3) > 1.25 ? .8 : V(1) < 1.25 ? V(3) > 1.25 ? .4  : 0
.ENDS
*
.SUBCKT FFLOP2 1  2 11 12 5  6
*            CLK D R  S  QB Q
X1 7 4 2 8 NAND3_0
X2 8 3 10 9 NAND3_0
X3 1 8 10 7 NAND3_1
X4 4 9 1 10 NAND3_0
X5 4 7 6 5 NAND3_1
X6 5 10 3 6 NAND3_0
X7 11 4 INV
X8 12 3 INV
.ENDS FFLOP2
*
.SUBCKT NAND3_0 1 2 3 4
B1 5 0 V= (V(1)>800M) & (V(2)>800M) & (V(3)>800M) ? 0V : 5V
R1 5 4 400
C1 4 0 20P IC=0
.ENDS NAND3_0
.SUBCKT NAND3_1 1 2 3 4
B1 5 0 V= (V(1)>800M) & (V(2)>800M) & (V(3)>800M) ? 0V : 5V
R1 5 4 400
C1 4 0 20P IC=5
.ENDS NAND3_1
.SUBCKT INV 1 2
B1 3 0 V= V(1)>800M ? 0 : 5V
R1 3 2 100
C1 2 0 10P IC=5
.ENDS INV
*
.SUBCKT COMP 6 7 9 2
.MODEL SCOMP SW (VT=5 RON=.1 ROFF=1MEG)
S1 5 4 8 9 SCOMP
COUT 2 9 1.0000P
VSAT 4 9 100.000M
RSAT 5 2 10.0000
R3 1 3 1.386
CDELAY 3 9 10.0000N
E1 8 0 3 0 1
VOS 7 12 1.0000P
IBIAS 6 14 1.0000P
V5 14 0
F1 12 0 V5 1
IOS 12 0 1.0000P
B1 1 9 V=V(12) > V(6) ? 10 : 0
.ENDS
