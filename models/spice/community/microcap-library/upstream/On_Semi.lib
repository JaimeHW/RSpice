.SUBCKT DLAT_RESET D LAT R S Q Qbar
X_U1	R N565256  $G_DPWR $G_DGND 				INV
X_U2	N565256 S N565274  $G_DPWR $G_DGND 		AND2
X_U3	D LAT R N565274 Q QBAR $G_DPWR $G_DGND	DLATRSH
.ENDS DLAT_RESET

