*** From file NCV890103_04_tranaverage.LIB
* ON Semiconductor
*
* NCV8901xx average model for tran simulations
*
* Revision history:
*	- Rev. 1.0: initial rev - 04/18/2013
*
*
.SUBCKT NCV8901XX_TRANAVERAGE COMP FB GND IN OUT  PARAMS: L=4.7u RL=40m
V_V2         N7613450 GND 0.8
E_E2         N7613510 GND VALUE { (V(COMP, GND) - 0.86) }
G_ABMI1         GND COMP VALUE {
+  if(i(V_v4)>75u,75u,if(i(V_v4)<-75u,-75u,i(V_v4)))    }
R_Ro         GND COMP  1.4MEG TC=0,0
R_rl1         N7614060 OUT  {rL} TC=0,0
C_C1         GND COMP  15pF  TC=0,0
R_rclamp         COMP N7613480  1 TC=0,0
E_LIMIT1         N7613480 0 VALUE {LIMIT(V(COMP),0.86,1.6)}
V_V4         B GND 0Vdc
X_U2         IN N7613912 GND N7613510 DUTY_CYCLE PWMCM PARAMS:  L={L} FS=2000k
+  RI=0.31 SE=700k
G_G1         GND B N7613450 FB 0.001
L_L1         N7613912 N7614060  {L}
.ENDS
********
.SUBCKT PWMCM a c p vc dc params: L=35u Fs=200k Ri=1 Se=100m
*
* auto toggling between DCM and CCM, current-mode
*
Edc dcx 0 value = { v(d2)*v(cx,p)/(v(a,p)-v(cx,p)+1u) }
Xdc dcx dc limit params: clampH=0.86 clampL=0.14
Ed2 d2X 0 value = { (2*{L}*{Fs}*I(VM)/(V(dc)*V(a,cx)+1u)) - V(dc) }
Xd2 d2X dc d2 limit2
GIap a p value = { (V(dc)/(V(dc)+V(d2)+1u))*I(VM) }
GIpc p cx value = { V(vc)/{Ri} }
GImju cx p value = { {Se}*V(dc)/({Ri}*{Fs}) + (v(cx,p)/{L})*V(d2)*{1/Fs}*(1-(V(dc)+V(d2))/2) }
VM cx c
Rdum1 dc 0 1Meg
Rdum2 vc 0 1Meg
.ENDS
********
.subckt limit d dc params: clampH=0.99 clampL=16m
Gd 0 dcx VALUE = { V(d)*100u }
Rdc dcx 0 10k
V1 clpn 0 {clampL}
V2 clpp 0 {clampH}
D1 clpn dcx dclamp
D2 dcx clpp dclamp
Edc dc 0 value={ V(dcx) }
.model dclamp d n=0.01 rs=100m
.ENDS
********
.subckt limit2 d2nc d d2c
*
Gd 0 d2cx d2nc 0 100u
Rdc d2cx 0 10k
V1 clpn 0 7m
E2 clpp 0 Value = { 1-V(d)-6.687m }
D1 clpn d2cx dclamp
D2 d2cx clpp dclamp
Edc d2c 0 value={ V(d2cx) }
.model dclamp d n=0.01 rs=100m
.ENDS
********



*** From file NCV8901xx_ACaverage.rev2.1.lib
* ON Semiconductor
*
* NCV8901xx average model for ac simulations
*
* Revision history:
*	- Rev. 1.0: 04/16/2013
*			initial rev
*	- Rev. 2.0: 04/28/2014
*			added params
*			encapsulated other sub-circuits in main sub-circuit
*			changed to old-fashioned expressions for compatibility with various spice simulators
*	- Rev. 2.1: 05/15/2014
*			changed from ROUND() to INT() function for compatibility with more spice simulators
*
*
.SUBCKT NCV8901XX_ACAVERAGE IN COMP GND FB OUT PARAMS: L=4.7u RL=30m
* with L the value of the inductor and rL the series resistance of the inductor
.PARAM FS=2000k
V_V4           B GND 0Vdc
R_rl2          N7612171 N7612211  1m
V_V2           N7611469 GND 0.8
V_V5           GND N7612183 DC 0Vdc AC 1Vac
L_L2           N7612211 COMP  1000kh
L_L1           C N7612311  {L}
R_rl1          N7612311 OUT  {rL}
G_ABMI1        GND COMP VALUE={LIMIT(i(V_V4),-75u,75u)}
G_G1           GND B N7611469 FB 0.001
C_C1           GND COMP  15pF
R_rclamp       COMP N7611483  1
E_E2           VC GND VALUE={(V(N7612171,GND)-1.1)}
R_Ro           GND COMP  1.4MEG
C_C3           N7612183 N7612171  1000kf
E_LIMIT1       N7611483 0 VALUE={LIMIT(V(COMP),1.1,1.55)}
********
E_dc           dcx 0 value={v(d2)*v(cx,GND)/(v(IN,GND)-v(cx,GND)+1u)}
E_d            d2X 0 value={(2*{L}*{Fs}*I(VM)/(V(dc)*V(IN,cx)+1u))-V(dc)}
G_Iap          IN GND value={(V(dc)/(V(dc)+V(d2)+1u))*I(VM)}
G_Ipc          GND cx value={V(vc)/0.2919}
G_Imju         cx GND value={291900*V(dc)/(0.2919*2000000)+(v(cx,GND)/{L})*V(d2)*(1-(V(dc)+V(d2))/2)/{Fs}}
Rdum1          dc 0 1Meg
Rdum2          vc 0 1Meg
VM             cx c 0Vdc
Emode mode 0 Value={(INT(SGN((2*{L}*{Fs}*I(VM)/(V(dc)*V(IN,cx)+1u))-1)*0.5-0.1)+1+1p)*4/({L}*(6.28*{Fs})**2+1p)}
********
G_d1            0 dcx1int VALUE={V(dcx)*100u}
Rdc1            dcx1int 0 10k
Vd11            clpn1 0 0.14
Vd12            clpp1 0 0.86
D11             clpn1 dcx1int dclamp
D12             dcx1int clpp1 dclamp
E_dc1           dc 0 value={V(dcx1int)}
********
G_d2             0 d2cx d2x 0 100u
Rdc2            d2cx 0 10k
Vd21             clpn2 0 7m
E_d2            clpp2 0 Value={1-V(dc)-6.687m}
D21             clpn2 d2cx dclamp
D22             d2cx clpp2 dclamp
E_dc2           d2 0 value={V(d2cx)}
********
RC1 cx 3 1u
VC1 3 4 0Vdc
E_BC1           4 GND Value={(1/v(mode))*v(int)}
G_INT          0 INT Value={I(VC1)}
CINT           INT 0 1
Rdum           INT 0 10E10
********
.model dclamp D(n=0.01 rs=100m)
********
.ENDS
*



