*************************************
.SUBCKT NCP1351_av A C P FB CS CCM Ts params: Lpri=33u Rsense=0.27 Rcs=3.9k Ct=100p ICt=10u
X5 9 9 0 NPNV params: le=20 we=40
VIfb FB 9 DC=0
G1 0 13 value={IF (I(VIfb)<42u,0.4u,I(VIfb)-41.1u)}
Voffset Vfb 13 DC=0.5
G2 Vdd 21 value={IF (I(VIfb)<80u,790u-9*I(VIfb),70u)}
G3 Vdd CS value={IF (I(VIfb)>60u,I(V6),250u)}
V6 21 0
*C4 13 0 80p
R7 13 0 45k
D2 13 7 DN4148
Vcl_Vfb 7 0 DC=6
Rc CS 0 {Rcs}
Vdd Vdd 0 DC=6
*
*PWMS section begins
*
GIa A P value={I(VM)*V(d1)/(V(d1)+V(d2)+1u)}
Estate CCM 0 value={IF (V(d2x)<(1-V(d1)),0,1)}
Estate2 state 0 value={IF (V(CCM)>0.5,(4*V(Ts)^2/({Lpri}*6.28^2)),1p)}
Xc1 C P state varicap
GIpk P cx value={V(CS)/{Rsense}}
GIu cx P value={(1-(V(d1)+V(d2))/2)*V(c,p)*V(d2)*V(Ts)/{Lpri}}
VM cx C DC=0
Ed1x 17 0 value={V(d2)*V(c,p)/(V(a,c)+1u)}
Ed2x d2x 0 value={2*I(VM)*{Lpri}/(V(d1)*V(Ts)*V(a,c)+1u)-V(d1)}
ETs Ts 0 value={{Ct}*V(Vfb)/{ICt}}
X3 17 d1 cl_d1
X2 d2x d1 d2 cl_d2
***
.MODEL DN4148 D BV=100V CJO=4PF IS=7E-09 M=.45 N=2 RS=.8
+ TT=6E-09 VJ=.6V
***
.ENDS
***
.SUBCKT VARICAP 1 2 CTRL
R1 1 3 1u
VC 3 4
EBC 4 2 value={(1/V(CTRL))*V(INT)}
GINT 0 INT value={I(VC)}
CINT INT 0 1
Rdum INT 0 10E10
.ENDS
