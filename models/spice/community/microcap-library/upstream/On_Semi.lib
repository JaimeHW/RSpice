*** From file ncp1606.lib
* ------------------------------------------------------------ *
*
* PSpice implementation of the NCP1606 PFC controller
* ON Semiconductor France
* Made by Chris Basso
* Last modified: September 16th 2009
*
* ------------------------------------------------------------ *
*
.SUBCKT PWMBCMVM a c p vc dc fsw ip params: L=1.2m Ct=1.5n
* Borderline Conduction Mode, voltage-mode
* --> 1V for vc = 1us for ton
.PARAM ichg=270u
EGPWM ctrl 0 Value = { ((V(vc)-2)*{Ct}/{ICHG})*1Meg }
EBdc dcx 0 Value = { V(ctrl)*1u/(V(ctrl)*1u + V(toff)) }
Xd dcx dc limit params: clampH=0.99 clampL=16m
EBVcp 6 p Value = { V(dc)*V(a,p) }
GBIap a p Value = { V(dc)*I(VM) }
EBtoff toff 0 Value = { IF ( 2*I(VM)*{L}/V(c,p) < 0, 0,
+ 2*I(VM)*{L}/(V(c,p)+10n) ) }
EBfsw fsw 0 Value = { (1/(V(ctrl)*1u + V(toff)))/1k }
EBip ip 0 Value = { abs(V(a,c)*V(ctrl)*1u)/{L} }
VM 6 c
*
.ENDS PWMBCMVM
*
.subckt limit d dc params: clampH=0.99 clampL=16m
Gd 0 dcx VALUE = { V(d)*100u }
Rdc dcx 0 10k
V1 clpn 0 {clampL}
V2 clpp 0 {clampH}
D1 clpn dcx dclamp
D2 dcx clpp dclamp
Edc dc 0 value={ V(dcx) }
.model dclamp d n=0.01 rs=100m
.ENDS
*
**** Application subcircuits ****
**** SINGLE WINDING TRANSFORMER ****
.SUBCKT XFMR1 1 2 3 4 PARAMS: RATIO=1
RP 1 2 1MEG
E 5 4 VALUE = { V(1,2)*RATIO }
G 1 2 VALUE = { I(VM)*RATIO }
RS 6 3 1U
VM 5 6
.ENDS XFMR1
***********
.SUBCKT AMP1606 1 5 7 params: POLE=100 GAIN=10k VHIGH=5.3V VLOW=2.6V
* + - OUT
G1 0 4 1 5 100u
R1 4 0 {GAIN/100u}
C1 4 0 {1/(6.28*(GAIN/100u)*POLE)}
E1 2 0 4 0 1
Rp2 2 20 1k
Cp2 20 0 100p
E2 40 0 20 0 1
Ro 40 7 10
Vlow 3 0 DC={VLOW}
Vhigh 8 0 DC={VHIGH}
Dlow 3 4 DCLP
Dhigh 4 8 DCLP
.MODEL DCLP D N=0.01
.ENDS
**************





