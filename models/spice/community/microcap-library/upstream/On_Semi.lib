+(
+ n=0.01
+ rs=100m
+)
.ENDS limit_a

*
********
.SUBCKT limit2_a d2nc d d2c
G_d 	0 d2cx d2nc 0	100u
R_dc 	d2cx 0 			10k
V_1 	clpn 0 			7m
E_2 	clpp 0 			Value = { 1-V(d)-6.687m }
D_1 	clpn d2cx 		dclamp
D_2 	d2cx clpp 		dclamp
E_dc 	d2c 0 			value={ V(d2cx) }
.model 	dclamp d
+(
+ n=0.01
+ rs=100m
+)
.ENDS limit2_a

*
********
.SUBCKT VARICAP 1 2 CTRL
R_1 	1 3 	1u
VM_C 	3 4
E_BC 	4 2 	Value = { (1/v(ctrl))*v(int) }
G_INT 	0 INT 	Value = { I( VM_C ) }
C_INT 	INT 0 	1
R_dum	INT 0 	10E10
.ENDS VARICAP

*******
*
********
*
* auto toggling between DCM and CCM, current-mode
*
.SUBCKT PWMCM a c p vc Vdc PARAMS: L=35u Fs=200k Ri=1 Se=100m
E_dc 	dcx 0 		value = { v(d2)*v(cx,p)/(v(a,p)-v(cx,p)+1u) }
X_dc 	dcx Vdc 		limit_a  PARAMS: clampH=0.99 clampL=7m
E_d2 	d2X 0 		value = { (2*{L}*{Fs}*I( VM_1 )/(V(Vdc)*V(a,cx)+1u)) - V(Vdc) }
X_d2 	d2X Vdc d2 	limit2_a
G_Iap 	a p 		value = { (V(Vdc)/(V(Vdc)+V(d2)+1u))*I( VM_1 ) }
G_Ipc 	p cx 		value = { V(vc)/{Ri} }
G_Imju 	cx p 		value = { {Se}*V(Vdc)/({Ri}*{Fs}) + (v(cx,p)/{L})*V(d2)*{1/Fs}*(1-(V(Vdc)+V(d2))/2) }
R_dum1 	Vdc 0 		1Meg
R_dum2 	vc 0 		1Meg
VM_1	cx c
X_C1 	c p mode 	varicap
E_mode 	mode 0 		value =
+{
+	IF ( (2*{L}*{Fs}*I( VM_1 )/(V(Vdc)*V(a,cx)+1u)) < 1, 1p , {4/((L)*(6.28*Fs)^2)}	)
+} ; connect or disconnects the resonating capacitor

.ENDS PWMCM

