RD 4 3 100
CD 3 0 10P
.ENDS NAND2
*
.SUBCKT oscillator out rampo params: dc=0.8 fsw=60k valley=0.5 swing=2.5
*
.PARAM I1=100u
.PARAM I2={ (I1*{DC})/(1-{DC}) }
.PARAM TSW={1/FSW}
.PARAM Ct={ (TSW/SWING)*((I1*I2)/(I1+I2)) }
*
EBbuf rampo 0 Value = { V(ramp) }
Ct ramp 0 {Ct}
RdumCt ramp 0 1G
GB3 0 ramp Value = { IF ( V(CMP) < 3.5, {I1}, 0 ) }
X1 cmp OUT INV
X4 ramp 4 cmp COMPAR params: VHIGH=5
EB1 4 0 Value = { IF ( V(CMP) > 3V, {valley}, {valley+swing} ) }
GB2 ramp 0 Value = { IF ( V(CMP) > 3.5, {I2}, 0 ) }
.ENDS
*
.SUBCKT INVOSC 1 2
EB1 4 0 Value = { IF (  V(1)>800mV, 0, 10V ) }
RD 4 2 100
CD 2 0 10P
.ENDS
*
.SUBCKT COMPAROSC NINV INV OUT params: VHIGH=12 VLOW=100m
EB1 4 0 Value = { IF (  V(NINV,INV) > 0  ?  {VHIGH}  :  {VLOW} ) }
RO 4 OUT 100
CO OUT 0 10P
.ENDS
*
.SUBCKT INVO 1 2
E1 4 0 Value = { IF (  V(1)>800mV, 0, 10V ) }
RD 4 2 100
CD 2 0 10P
.ENDS INVO
*
.SUBCKT BS170 10 20 30
* TERMINALS: D G S
M1 1 2 3 3 DMOS L=1U W=1U
RD 10 1 2.37
RS 40 3 0.126
RG 20 2 938
CGS 2 3 19P
EGD 12 0 2 1 1
VFB 14 0 0
FFB 2 1 VFB 1
CGD 13 14 42.3P
R1 13 0 1
D1 12 13 DLIM
DDG 15 14 DCGD
R2 12 15 1
D2 15 0 DLIM
DSD 3 10 DSUB
LS 30 40 7.5N
.MODEL DMOS NMOS (LEVEL=3 VMAX=125K THETA=80M ETA=2M VTO=1.9 KP=0.593)
.MODEL DCGD D (CJO=42.3P VJ=0.6 M=0.68)
.MODEL DSUB D (IS=2.08N N=1.5 RS=0.76 BV=60 CJO=47.7P VJ=0.8 M=0.42 TT=115N)
.MODEL DLIM D (IS=100U)
.ENDS
*
.SUBCKT AMPSIMP 1 5 7 params: POLE=30 GAIN=30000 VHIGH=4V VLOW=100mV
* + - OUT
G1 0 4 1 5 100u
R1 4 0 {GAIN/100u}
