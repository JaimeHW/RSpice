.SUBCKT NCP1205P1 HV Dem FB Ct Gnd Isense Out Vcc
*                 1  2   3  4  5   6      7   8
**** IC Consumption ****
ISUPP Vcc Gnd 1.5mA
**** STARTUP AND UVLO ****
XUVLO Vcc UVLOIn UVLO
GSTRT HV Vcc VALUE = { IF ( V(UVLOIn)<3.5, 3mA, 70U ) }
Ctm1 UVLOIn 52 100p
Rtm1 52 0 4.7k
X17 52 OVPIn UVLO UVLOB LATCH PARAMS: VHIGH=10 VLOW=100m
**** OVP Section ****
DOVP 120 Vcc DOVP
ROVP 120 0 18k
XOVP 120 28 OVPIn COMPAR
**** Internal OPAMP ****
X16 28 VG Err2 AMPSIMP PARAMS: POLE=30 GAIN=3k VHIGH=3V VLOW=10mV
Vref 28 0 DC=2.5V
R14 VG Err2 150k
CInt Err2 VG 10pF
R19 VG FB 50k
**** Driving section ****
X14 17 44 Drv 0 40 45 FFLOP
EANDdrv 350 0 VALUE = { IF ( (V(Drv)>800mV) & (V(UVLOIn)>800mV) &
+ (V(UVLO)>800mV), V(Drv), 0 ) }
XDRIVER 350 Out Vcc DRIVER
**** Demag ****
X13 Dem 10 17 COMPAR
D5 0 Dem Dmag
E1 10 0 VALUE = { IF ( V(17) > 3V, 60mV, 65mV ) }
R16 16 17 4.7k
D4 16 4 1N4148
R3 4 0 47k
R6 4 Dis 4.7k
Q2 13 4 0 QN2222
X4 17 Vfm 21 SET 8 Drv FFLOP
X100 14 52 SET OR2 PARAMS: VHIGH=10V
**** 4us Demag Timout ****
Rtimo 13 36 25k
Vtimo 36 0 DC=10
X11 13 37 TimeO COMPAR
V5 37 0 DC=8
Ctimo 13 0 150pF
X12 40 UVLOB Dis OR2 PARAMS: VHIGH=10V
**** Current Sense and LEB ****
EB4 33 0 VALUE = { IF ( V(Err2) < 750m, 750m, V(Err2) ) }
EB6 23 0 VALUE = { IF ( V(Del) > 5V, V(Isense), 10m ) }
X10 Drv Del UTD PARAMS: K=1 TD=250n ; LEB
X8 33 22 GAIN PARAMS: K=0.333
X15 55 21 UTD PARAMS: K=1 TD=150n ; CMP Prop delay
XICMP 23 22 55 COMPAR
**** Oscillator/VCO section ****
Ctm2 Drv 400 1nF
Rtm2 400 0 1k
Dtm2 0 400 1N4148
Xtm2 400 400 410 OR2 PARAMS: VHIGH=10V; 400ns discharge pulse
X21 57 UVLOIn UVLO SwDis OR3B PARAMS: VHIGH=10V
X9 Ct 0 SwDis 0 SWhyste params: RON=200 ROFF=1E6 VT=2 VH=1
X19 Ct 59 Vfm COMPAR
E3 59 0 VALUE = { IF ( V(VFM) > 3V, 500m, 3V ) }
VclpCt 61 0 DC=4.4
D3 Ct 61 1N4148
GB5 0 24 VALUE = { IF ( (V(SwDis) > 3) | (V(UVLOIn) < 800mV) | (V(UVLO) < 800mV)
+ , 0 , IF ( V(Err2) > 1V, 350u, V(Err2)*350u ) ) }
X6 410 Vfm 57 AND2 PARAMS: VHIGH=5V
X1 Vfm TimeO 14 AND2 PARAMS: VHIGH=5V
**** Dummy elements *****
Vdum1 44 0 DC=10
Vdum2 24 Ct
Rdum1 45 0 100k
Rdum2 8 0 100k
**** Discrete models ****
.MODEL Dmag D BV=10V CJO=15p IS=7E-09 M=.45 N=2 RS=.8
+ TT=6E-09 VJ=.6V
.MODEL DOVP D BV=35V Cjo=10pF TT=100n Rs=150m
.MODEL 1N4148 D BV=100V CJO=4PF IS=7E-09 M=.45 N=2 RS=.8
+ TT=6E-09 VJ=.6V
.MODEL NCHAN NMOS Level=1 CBD=69.2P CBS=83P CGBO=334N
+ CGDO=30N CGSO=36N GAMMA=2.17U IS=35.4F KP=.27 LAMBDA=1.25M
+ MJ=.46 PB=.8 PHI=.75 RD=1.7 RS=1.1 VTO=2.3
.MODEL DzBoot D BV=16 CJO=2pF IBV=8.3333M IS=1E-9 N=2
+ RS=8.7297 TT=20N
.MODEL QN2222 NPN BF=105 BR=4 CJC=12.2P CJE=35.5P IKF=.5
+ IKR=.225 IS=15.2F ISE=8.2P NE=2 NF=1 NR=1 RB=1.49 RC=.149
+ RE=.373 TF=500P TR=85N VAF=98.5 VAR=20 XTB=1.5
.ENDS NCP1205P1
