********
.SUBCKT limit_a d Vdc PARAMS: clampH=0.99 clampL=16m
G_d 	0 dcx 		VALUE = { V(d)*100u }
R_dc 	dcx 0 		10k
V_1 	clpn 0 		{clampL}
V_2 	clpp 0 		{clampH}
D_1 	clpn dcx 	dclamp
D_2 	dcx clpp 	dclamp
E_dc 	Vdc 0 		value={ V(dcx) }
