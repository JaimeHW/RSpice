***
.SUBCKT cl_d1 d d1
* Clamp duty cycle d1 between 0.01 and 0.99
G1 0 1 d 0 100u
R1 1 0 10k
D1 2 1 _D1_modX
D2 1 3 _D1_modX
V2 2 0 DC=7m
V3 3 0 DC=0.99
E1 d1 0 1 0 1
.MODEL _D1_modX D BV=100 N=0.01 RS=0.1
.ENDS
***
.SUBCKT X2_Config_1 d2NC d d2c
* Clamp duty cycle d1 between 0.01 and (1-d1)
G1 0 1 d2NC 0 100u
R1 1 0 10k
D1 2 1 _D1_mod
.MODEL _D1_mod D N=0.01 RS=0.1
B1 3 0 V=(1-V(d)-6.687m)
D2 1 3 _D1_mod
V2 2 0 DC=7m
E1 d2c 0 1 0 1
.ENDS
***
.MODEL DN4148 D BV=100V CJO=4PF IS=7E-09 M=.45 N=2 RS=.8
+ TT=6E-09 VJ=.6V
***
*
*Fb section
*
X5 9 9 0 NPNV { le=20 we=40 }
VIfb FB 9 DC=0
B1 0 13 I=I(VIfb) < 42u ? 0.4u : I(VIfb)-41.1u
Voffset Vfb 13 DC=0.5
B2 Vdd 21 I=I(VIfb) < 80u ? 790u-9*I(VIfb) : 70u
B3 Vdd CS I=I(VIfb) > 60u ? I(V6) : 250u
V6 21 0
R7 13 0 45k
Rc CS 0 {Rcs}
Vdd Vdd 0 DC=6
C4 13 0 80p
D2 13 7 DN4148
Vcl_Vfb 7 0 DC=6
*
*PWMS section
*
BIa A P I=I(VM)*V(d1)/(V(d1)+V(d2)+1u)
Bstate CCM 0 V=V(d2x) < (1-V(d1)) ? 0 : 1
Cs C P C=V(CCM) > 0.5 ? (4*V(Ts)^2/({Lpri}*6.28^2)) : 1p
BIpk P cx I=V(CS)/{Rsense}
BIu cx P I=(1-(V(d1)+V(d2))/2)*V(c,p)*V(d2)*V(Ts)/{Lpri}
VM cx C DC=0
Bd1x 17 0 V=V(d2)*V(c,p)/(V(a,c)+1u)
Bd2x d2x 0 V=2*I(VM)*{Lpri}/(V(d1)*V(Ts)*V(a,c)+1u)-V(d1)
BTs Ts 0 V={Ct}*V(Vfb)/{ICt}
X3 17 d1 cl_d1 { }
X2 d2x d1 d2 X2_Config_1 { }
.ENDS
*********
