*SYM=MC33161
.SUBCKT MC33161 23   5   24  7   22   15   1    3
*               VREF IN1 IN2 GND OUT2 OUT1 MODE VCC
.MODEL COMP SW (VT=1.27 VH=0.025 RON=1K ROFF=10MEG)
.MODEL DMOD D (IS=1E-16)
.MODEL QN1 NPN (BF=200 RC=8.5)
.MODEL QN2 NPN (BF=50)
.MODEL M1 NMOS VTO=2.3 KP=100
R1 2 3 1MEG
BCOND 4 7 V=V(2) > 2.5 ? 5 : 0
R3 9 7 250K
V3 11 10 2
R4 10 6 12K
I1 6 7 24U
D2 7 6 DMOD
D5 1 9 DMOD
D6 9 11 DMOD
BCOMP1 12 7 V=2.8 > V(1) ? 5 : 0
BXOR1 13 7 V=ABS(V(12,4)) < 2.5 ? 0 : 5
R5 26 13 44K
Q1 15 26 7 QN1
S2 17 7 24 7 COMP
R8 17 3 1MEG
B2 16 7 V=V(17) > 2.5 ? 5 : 0
BCOM2B 20 7 V=0.6 > V(1) ? 5 : 0
B4 19 7 V=ABS(V(20,16)) < 2.5 ? 0 : 5
R9 18 19 44K
Q3 22 18 7 QN1
Q4 3 21 25 QN2
R12 3 21 25K
R13 25 23 0.3
R15 23 27 10K
R16 27 7 100K
M1 21 27 7 7 M1
S1 2 7 5 7 COMP
.ENDS



*** From file MC33161_Pspice.lib
****************************************************
*                                                  *
*           Pspice Model for MC33161               *
*                                                  *
*    (Modified from the original IsSpice4 Model)   *
*                    REV 2.0                       *
*       ON Semiconductor 2011 Copyright.           *
*                                                  *
****************************************************
*
.SUBCKT MC33161 Vref IN1 IN2 GND OUT2 OUT1 MODE Vcc
.MODEL DMOD D(IS=1E-16)
.MODEL QN1 NPN(BF=200 RC=8.5)
.MODEL QN2 NPN(BF=500)
.MODEL M1 NMOS VTO=2.3 KP=100
G_Gicc Vcc GND VALUE { if(v(Vcc)>1.6,380u,0) }
R1 2 Vcc 1MEG
E_ECOND   4 GND VALUE { if(v(2)>2.5,5,0) }
R3 9 GND 250K
V3 11 10 2
R4 10 6 12K
I1 6 GND 24U
D2 GND 6 DMOD
D5 MODE 9 DMOD
D6 9 11 DMOD
E_ECOMP1   12 GND VALUE { if(v(MODE)>2.8,5,0) }
E_EXOR1   13 GND VALUE { if(ABS(v(12,4))>2.5,5,0) }
R5 26 13 44K
Q1 OUT1 26 GND QN1
X_S2    IN2 GND 17 GND SCHEMATIC1_S1
R8 17 Vcc 1MEG
E_E2   16 GND VALUE { if(v(17)>2.5,5,0) }
E_ECOM2B  20 GND VALUE { if(v(MODE)>0.6,5,0) }
E_EXOR2   19 GND VALUE { if(ABS(v(20,16))>2.5,5,0) }
R9 18 19 44K
Q3 OUT2 18 GND QN1
Q4 Vcc 21 25 QN2
R12 Vcc 21 250K
R13 25 Vref 0.3
R15 Vref 27 10K
R16 27 GND 100K
M1 21 27 GND GND M1
X_S1    IN1 GND 2 GND SCHEMATIC1_S1
.ENDS
*
.subckt SCHEMATIC1_S1 1 2 3 4
S_S1         3 4 1 2 _S1
RS_S1         1 2 1G
.MODEL         _S1 VSWITCH Roff=1e7 Ron=1e3 Voff=1.245V Von=1.27V
.ends SCHEMATIC1_S1
*



