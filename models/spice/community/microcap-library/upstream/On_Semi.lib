*
S1 HV 24 Q Gnd SW1
.MODEL SW1 VSWITCH RON={RDSON} VON=8 VOFF=6 ; ON resistance of the internal switch
GB9 Vcc gnd Value = { IF ( V(pulsok,gnd) > 3.5V, {ICONS}, 160u ) } ; IC consumption
X9xx pulsok Vcc clock OSC1050 params: Ct={Ct} ; Clock frequency
Vlimit 17 gnd DC={Imax} ; maximum peak current
Coss HV Gnd 100pF
X15 HV Vcc dsscmp fault DSS
X6xx dss8V ResetOR 55 qb10 LATCH
X7xx 70 16 fault qb5 LATCH
X8xx 12 19 PULS
XINVFB 3 7 INV
XORFB 7 8 OR OR2X4
Rsense 24 gnd 1
EB1 36 gnd Value = { IF ( V(LEB,gnd) > 3.5, V(24,gnd), 0 ) }
EB6 2 gnd Value = { IF ( V(pulsok,gnd) > 2.5V, 8V, 0 ) }
X10xx UVLO UVLOrst PULS
R8x qb5 gnd 100k
***** Feedback circuitry ****
D4 gnd 8 DCLP
D3 3 2 DCLP
X18 8 22 FB BSS84
X20 3 5 FB BS170
GB2x 2 3 Value = { IF ( V(pulsok,gnd) < 3.5V, 0, IF ( V(OR,gnd) > 3.5, 38u, 45u ) ) }
GB5x 8 gnd Value = { IF ( V(pulsok,gnd) < 3.5, 0, IF ( V(OR,gnd) > 3.5, 37u, 47u ) ) }
EB4 22 gnd Value = { IF ( V(pulsok,gnd) > 3.5V, 2.8V, 0 ) }
EB3 5 gnd Value = { IF ( V(pulsok,gnd) > 3.5V, 3.3V, 0 ) }
*****************************
X13xx OR 77 PULS
X14 4 76 PULS
X11 36 17 11 COMPAR
X16x 21 75 PULS
X21 75 UVLO dss8V AND2
X23 76 UVLO dss7V AND2
X5 Q LEB UTD params: TD=250n
R10 dsscmp 4 100
X39 UVLO 12 INV
X25 77 UVLO ResetOR AND2
X26 UVLO qb5 pulsok AND2
X27 dss7V 55 70 AND2
X19 clock OR 15 Q 1050CLOCK
Dbody gnd HV DBODY
X17 11 15 UTD params: TD=250n
C8 4 gnd 100p IC=10
X24 4 21 INV
X31 Vcc UVLO UVLO params: VON=8.6 VOFF=4.6
X35 UVLOrst 19 16 OR2
.MODEL DBODY D BV=700 CJO=100p RS=10m TT=10n
.MODEL DCLP D BV=100V CJO=4PF IS=7E-09 M=.45 N=0.01
+ RS=.8 TT=6E-09 VJ=.6V
.ENDS
************
.SUBCKT DSS HV Vcc DSSCMP Fault params: VOFF=8.6V VON=7.6V Isrc=6mA
GB12 HV Vcc Value = { IF ( (V(dsscmp) > 3V) & (V(hv) > 20), {Isrc}, 0 ) }
X17 1 Vcc DSSCMP COMPAR
EB13 1 0 Value = { IF ( V(Fault) > 3.5, 0, IF ( V(dsscmp) > 3V, {VOFF}, {VON} ) ) }
R1 HV 0 100Meg
.ENDS
*********
.SUBCKT LATCH 6 8 2 1 params: VHIGH=10 VLOW=100m
*             S R Q Q\
EBQB   10 0 Value = { IF ( (V(8)<800M) & (V(2)>800M), {VLOW}, {VHIGH} ) }
EBQ    20 0 Value = { IF ( (V(6)<800M) & (V(1)>800M), {VLOW}, {VHIGH} ) }
RD1   10 1 100
CD1   1 0 10p IC={VHIGH}
RD2   20 2 100
CD2   2 0 10p IC={VLOW}
.ENDS LATCH
*********
.SUBCKT PULS IN OUT params: Ctime=290pF
X39 in 2 BUFPULS
C13 2 3 {Ctime}
R5 3 0 2.2k
D9 0 3 DCLPN
X40 3 out BUFPULS
.MODEL DCLPN D BV=100V CJO=4PF IS=7E-09 M=.45 N=0.01
+ RS=.8 TT=6E-09 VJ=.6V
.ENDS
********
.SUBCKT INV 1 2
EB1 4 0 Value = { IF ( V(1)>3.5, 0, 10V ) }
RD 4 2 100
CD 2 0 10P
.ENDS
*******
.SUBCKT OR2X4 1 2 3
EB1 4 0 Value = { IF ( (V(1)>2.5V) | (V(2)>2.5V), 5V, 100m ) }
RD 4 3 100
CD 3 0 10P
.ENDS
********
.SUBCKT OSC1050 UVLO Vcc Clock params: Ct=1.18n
Ct Ct 0 {Ct}
X2x Ct 1 CMP COMPAR
EB1 1 0 Value = { IF ( V(CMP) > 3V, 300m, 3V ) }
GB2 0 Ct Value = { IF ( V(UVLO) < 3.5, 0, V(Vcc)*80u ) }
R1 UVLO 0 1Meg
R2 Vcc 0 1Meg
GB3 Ct 0 Value = { IF ( V(CMP) > 3, V(Vcc)*80u*3, 0 ) }
R3 Ct 0 10Meg
X1 UVLO 2 Clock AND2
X2 CMP 2 INV
.ENDS
