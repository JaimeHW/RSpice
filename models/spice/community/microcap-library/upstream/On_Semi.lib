*
**** 2 INPUT COMPARATOR ****
.SUBCKT COMP1 1 2 3 PARAMS: VHYS=10mV
*             + - OUT
Rplus 1 0 1Meg
Rminus 2 0 1Meg

E_Comp 4 0 VALUE = { IF ( V(1) > V(2), 5V, 10m ) }

RD 4 3 100
CD 3 0 10p
.ENDS COMP1
*
**** One Shot Pulse High to Low Trigger ****
.SUBCKT OneShotNeg 1 2 PARAMS: Td = 100n Vlow = 100m
*                IN OUT
RIN 1 0 1MEG
E_6 17 0 VALUE { IF (V(1) > 4V, 10mV , 5V)}
R3 17 18 1k
C3 18 0 {Td/(1000*3.1519)}
E_4 21 0 VALUE {V(19)}
RCQ 21 60 100
CCQ 60 0 10p
E_Q 61 0 VALUE = { V(60) }
RSQ 61 2 10 ;{RS}
R5 17 25 1k
C5 25 0 {Td/(1000*41.4)}
E_1 22 0 VALUE { IF (V(1) > 2V, 10mV, 5V)}
E_2 19 0 VALUE { IF ((V(17)-V(18)) < 200mV, Vlow, 5V)}
.ENDS OneShotNeg
*
.SUBCKT ERRORAMP1 1 2 3 PARAMS: ISINK = 15M, ISOURCE = 10M, VHIGH = 5V, VLOW = 100M POLE = 30, GAIN = 31622
*                 + - OUT
RIN 1 2 8MEG
CP1 11 0 {1/(6.28*(GAIN/100U)*POLE)}
E1 5 0 11 0 1
R9 5 8 5
D14 8 13 DMOD
IS 13 0 {ISINK/100} ;in mA, Divided by PNP Beta
Q1 0 13 16 QPMOD
ISRC 7 3 {ISOURCE}
D12 3 7 DMOD
D15 0 11 DCLAMP
G1 0 11 1 2 100U
V1 7 0 {VHIGH-0.62V}
V4 3 16 {VLOW-38MV}
RP1 11 0 {GAIN/100U}
.MODEL QPMOD PNP
.MODEL DCLAMP D (RS=10 BV=10 IBV=0.01)
.MODEL DMOD D (TT=1N CJO=10P)
.ENDS ERRORAMP1
*
**** Current Source ****
.SUBCKT ISOURCE1 1 2 3 PARAMS: SourceI=1m
*               Vin Vaux Vcontrol
*Sources current if Vcontrol low
G_start 1 2 VALUE = { IF( ( V(3)<3.5), SourceI, 0 )}
R1 1 0 1Meg
R2 2 0 1Meg
R3 3 0 1Meg
.ENDS ISOURCE1
*
.SUBCKT Switch1 G D gnd PARAMS:  RDSON=1000
*
* Power Switch
**********************

S1 D gnd G gnd SW1
D1 gnd D DBODY
C1 D gnd 100p IC=0
.MODEL DBODY D BV=100 CJO=100p RS=100m TT=10n ;
.MODEL SW1 VSWITCH RON={RDSON} VON=2 VOFF=1 ;VOFF = 0.5
.ENDS Switch1
*
**** Current Source ****
.SUBCKT ISOURCE3 1 2 3 4 PARAMS: SourceI1=1m SourceI2=.1m
*               Upper Lower Vcontrol1 Vcontrol2
*Sources current if Vcontrol1 low
* If Vcontrol2 high, SinkI1, else SinkI2

G_start 1 2 VALUE = { IF (V(3) < 3.05, IF (V(4) > 3, SourceI1, SourceI2), 1p)}

R1 1 0 1Meg
R2 2 0 1Meg
R3 3 0 1Meg
R4 4 0 1Meg

.ENDS ISOURCE3
*
**** Inverter ****
.SUBCKT OR2 1 2 3
*           A B Out
RIN1 1 0 1MEG
RIN2 2 0 1MEG
E_1 4 0 VALUE { IF (V(1) > 2V | V(2) > 2V, 5V , 10mV)}

R1 4 3 100
C1 3 0 10p

.ENDS OR2
*
**** Power Switch ****
.SUBCKT PS1 G D gnd Isense Vlimit PARAMS: RDSON=2.1 Td1=100n Ilim=1A Rsense=.05
*
* Power Switch
* Vlimit is the voltage applied to the comparator input
* Need to apply Vlimit and specify Rsense
**********************

S1 D S1 G gnd SW1
D1 gnd D DBODY

Rsense2 S1 gnd {Rsense};


X1 G LEB1 UTD params: TD={Td1}
EB1 36 gnd Value = { IF ( V(LEB1,gnd) > 0.5, V(S1,gnd), 10m ) }
Xq 36 Vlimit 11 COMP1
X2 11 12 UTD params: TD={100n}
RD 12 Isense 100
CD Isense 0 10p

.MODEL DBODY D BV=235 CJO=50p RS=100m TT=10n; N=0.2 ;Rs=10m N,IBV=100u
.MODEL SW1 VSWITCH RON={RDSON} VON=3 VOFF=2

.ENDS PS1
*
.SUBCKT ISINK3 1 2 3 4 PARAMS: SinkI1=1m SinkI2=.1m
*               Upper Lower Vcontrol1 Vcontrol2
*Sinks current if Vcontrol1 high
* If Vcontrol2 high, SinkI1, else SinkI2

G_start 1 2 VALUE = { IF (V(3) > 3, IF (V(4) > 3, SinkI1, SinkI2), 1p)}

R1 1 0 1Meg
R2 2 0 1Meg
R3 3 0 1Meg
R4 4 0 1Meg

.ENDS ISINK3
*
**** Inverter ****
.SUBCKT AND2 1 2 3
*            A B Out
RIN1 1 0 1MEG
RIN2 2 0 1MEG
E_1 4 0 VALUE { IF (V(1) > 2V & V(2) > 2V, 5V , 10m)}
R1 4 3 100
C1 3 0 100p
.ENDS AND2
*
.SUBCKT SRFFLOP2 1 2 3
*                S R Q
R1 1 0 1Meg
R2 2 0 1Meg
