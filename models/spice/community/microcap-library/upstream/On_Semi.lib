*SRC=NCP100;NCP100;ON Semiconductor;Voltage Reference;Sub 1.0V Adj Shunt
*SYM=TLV431
.SUBCKT NCP100 6 3 4
*              K A Reference
B1 3 6 I=.05 * V(7,3) > 0 ? 0 : .05 * V(7,3)
G1 3 5 2 4 240m ; .08
I1 1 2 DC=70u
R1 2 3 9.97k
R4 5 3 30 ; 100
C1 5 3 2.59u ; 1.59u
R5 5 7 10k
C2 7 3 80p
R3 6 2 7.5MEG RMOD
.MODEL RMOD R (TC1=-6.1m)
R11 6 0 1meg
