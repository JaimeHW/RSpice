*** From file ncv8876-sms_rev2.lib
* ------------------------------------------------------------ *
*
* PSpice implementation of the PWM Switch
* CCMVM and CCMCM Switch Models originally derived by Vatche Vorperian
* DCMVM, DCMCM and BCM models originally derived by Christophe Basso
* Auto-toggling versions by Christophe Basso, Toulouse (FRANCE)
* OrCAD PSpice compatible
* Initial release: 26 NOV 2013 by A. Laprade
*	NOTE:  THIS MODEL MAY ONLY BE USED FOR SMALL-SIGNAL AC-ANALYSIS MODELING
*	Basso model modified for NCV887600 and NCV887601 small-signal specific modeling
*	Product specific slope compensation added
*	Default switching frequency FS = 170kHz added
*	OTA parameters added
*	Voltage feedback divider added
*	AC injection point added for small-signal analysis
* EDIT HISTORY (after 26 NOV 2013 creation date)
*- 2 JAN 14 (A. Laprade): Set R_Ro and R_rupper1 to values similar to that in IC.  This has no repercussions on any previous simulations.
*- 22JAN14 - Modified PARAMS: model call method to fix potential simulation problem.  Improved symbol file.
*- 4FEB14 - VFB node & AC feedback analysis injection point replaced by VOUT.  AC injection point is set within the simulation
* by locating an AC source between model VOUT and the simulation output voltage.
* ------------------------------------------------------------ *
*******
*
.SUBCKT NCV887600-sms GND BAT PWR_OUT VOUT CTRL VC Duty_Ratio PARAMS:  L=2.2u rL=3m FS=170K RI=
+ 10m RFET=25m
*
* OTA and voltage feedback model
*
V_V2         1.2V_REF 0 1.2
R_Ro         0 VC  3MEG TC=0,0
R_rupper1         VOUT_DIVIDER VOUT  33.24k TC=0,0
R_Resd         VC CTRL  542 TC=0,0
R_rlower         0 VOUT_DIVIDER  7.12k TC=0,0
G_ABMI1         0 CTRL VALUE { i(V_v4)    }
V_V4         B 0 0Vdc
L_L1         BAT CC  {L}
C_C1         0 VC  10pF  TC=0,0
R_rl1         CC C  {rL} TC=0,0
G_G1         0 B 1.2V_REF VOUT_DIVIDER 0.00107
R_RGND         A GND  1e-15 TC=0,0
*
* This subckt is a current-mode DCM-CCM model including saturation voltages
*
* Duty ratio limit is 83%.  clampH=0.83 to reflect IC programming duty cycle limits (A. Laprade)
* Ri is set to a negative value in expressions for boost topoloty ('-' symbol added in front of Ri)
*
Edc dcx 0 value = { v(d2)*v(cx,PWR_OUT)/(v(a,PWR_OUT)-v(cx,PWR_OUT)+1u) }
Xdc dcx Duty_Ratio limit params: clampH=0.83 clampL=7m
Ed2 d2X 0 value = { (2*{L}*{Fs}*I(VM)/(V(Duty_Ratio)*V(a,cx)+1u)) - V(Duty_Ratio) }
Xd2 d2X Duty_Ratio d2 limit2
GIap a PWR_OUT value = { (V(Duty_Ratio)/(V(Duty_Ratio)+V(d2)+1u))*I(VM) }
GIpc PWR_OUT cx value = { V(CTRL)/{-Ri} }
*
*  Note:  NCV887600 slope compensation is 34kV/s
*
GImju cx PWR_OUT value = { 34K*V(Duty_Ratio)/({-Ri}*{Fs}) + (v(cx,PWR_OUT)/{L})*V(d2)*{1/Fs}*(1-(V(Duty_Ratio)+V(d2))/2) }
Rdum1 Duty_Ratio 0 1Meg
Rdum2 CTRL 0 1Meg
Eloss cx cxx Value = { V(SW)*V(Duty_Ratio)+V(DIO)*V(d2) }
VM cxx c
* XC1 c PWR_OUT mode varicap
* Emode mode 0 Value = { IF (  (2*{L}*{Fs}*I(VM)/(V(Duty_Ratio)*V(a,cx)+1u))
* + < 1, 1p , {4/((L)*(6.28*Fs)^2)}	) } ; connect or disconnects the resonating capacitor
*
**** Loss generator ****
GSW 0 SW value = { I(VM) }
Rds SW SW1 {RFET}
Risense SW1 0 {RI}
GID 0 DIO value = { I(VM) }
dboost 0 DIO MBR1520
.model MBR1520	D(Is=4.091u Rs=4.683m Ikf=3.519 N=1 Xti=0 Eg=1.11 Cjo=2.216n
+		M=.4608 Vj=.75 Fc=.5 Isr=865.4u Nr=2)
*		Motorola	pid=MBR1520	case=DO4
*		88-09-15 rmn
.ENDS
*
********
.SUBCKT NCV887601-sms GND BAT PWR_OUT VOUT CTRL VC Duty_Ratio PARAMS:  L=2.2u rL=3m FS=170K RI=
+ 10m RFET=25m
*
* OTA and voltage feedback model
*
V_V2         1.2V_REF 0 1.2
R_Ro         0 VC  3MEG TC=0,0
R_rupper1         VOUT_DIVIDER VOUT  33.24k TC=0,0
R_Resd         VC CTRL  542 TC=0,0
R_rlower         0 VOUT_DIVIDER  7.12k TC=0,0
G_ABMI1         0 CTRL VALUE { i(V_v4)    }
V_V4         B 0 0Vdc
L_L1         BAT CC  {L}
C_C1         0 VC  10pF  TC=0,0
R_rl1         CC C  {rL} TC=0,0
G_G1         0 B 1.2V_REF VOUT_DIVIDER 0.00107
R_RGND         A GND  1e-15 TC=0,0
*
* This subckt is a current-mode DCM-CCM model including saturation voltages
*
* Duty ratio limit is 83%.  clampH=0.83 to reflect IC programming duty cycle limits (A. Laprade)
* Ri is set to a negative value in expressions for boost topoloty ('-' symbol added in front of Ri)
*
Edc dcx 0 value = { v(d2)*v(cx,PWR_OUT)/(v(a,PWR_OUT)-v(cx,PWR_OUT)+1u) }
Xdc dcx Duty_Ratio limit params: clampH=0.83 clampL=7m
Ed2 d2X 0 value = { (2*{L}*{Fs}*I(VM)/(V(Duty_Ratio)*V(a,cx)+1u)) - V(Duty_Ratio) }
Xd2 d2X Duty_Ratio d2 limit2
GIap a PWR_OUT value = { (V(Duty_Ratio)/(V(Duty_Ratio)+V(d2)+1u))*I(VM) }
GIpc PWR_OUT cx value = { V(CTRL)/{-Ri} }
*
*  Note:  NCV887601 slope compensation is 53kV/s
*
GImju cx PWR_OUT value = { 53K*V(Duty_Ratio)/({-Ri}*{Fs}) + (v(cx,PWR_OUT)/{L})*V(d2)*{1/Fs}*(1-(V(Duty_Ratio)+V(d2))/2) }
Rdum1 Duty_Ratio 0 1Meg
Rdum2 CTRL 0 1Meg
Eloss cx cxx Value = { V(SW)*V(Duty_Ratio)+V(DIO)*V(d2) }
VM cxx c
* XC1 c PWR_OUT mode varicap
* Emode mode 0 Value = { IF (  (2*{L}*{Fs}*I(VM)/(V(Duty_Ratio)*V(a,cx)+1u))
* + < 1, 1p , {4/((L)*(6.28*Fs)^2)}	) } ; connect or disconnects the resonating capacitor
*
**** Loss generator ****
GSW 0 SW value = { I(VM) }
Rds SW SW1 {RFET}
Risense SW1 0 {RI}
GID 0 DIO value = { I(VM) }
dboost 0 DIO MBR1520
.model MBR1520	D(Is=4.091u Rs=4.683m Ikf=3.519 N=1 Xti=0 Eg=1.11 Cjo=2.216n
+		M=.4608 Vj=.75 Fc=.5 Isr=865.4u Nr=2)
*		Motorola	pid=MBR1520	case=DO4
*		88-09-15 rmn
.ENDS
*
********
.subckt limit d dc params: clampH=0.99 clampL=16m
Gd 0 dcx VALUE = { V(d)*100u }
Rdc dcx 0 10k
V1 clpn 0 {clampL}
V2 clpp 0 {clampH}
D1 clpn dcx dclamp
D2 dcx clpp dclamp
Edc dc 0 value={ V(dcx) }
.model dclamp d n=0.01 rs=100m
.ENDS
*
********
.subckt limit2 d2nc d d2c
*
*Modified A. Laprade 13AUG12 due to convergence issue with node d2c.  Limitation of 1 incorporated
*
Gd 0 d2cx d2nc 0 100u
Rdc d2cx 0 10k
V1 clpn 0 7m
E2 clpp 0 Value = { 1-V(d)-6.687m }
D1 clpn d2cx dclamp
D2 d2cx clpp dclamp
Edc d2c 0 value={ V(d2cx) }
*Edc d2c 0 value={ if(V(d2cx)>1,.99,v(d2cx)) }
*.model dclamp d n=0.01 rs=100m
.model dclamp d n=0.01 rs=100m
.ENDS
*
********
.SUBCKT VARICAP 1 2 CTRL
R1 1 3 1u
*bug removed by Holger Vogt, 07/15/2025
VC 3 4
EBC 4 2 Value = { (1/v(ctrl))*v(int) }
GINT 0 INT Value = { I(VC) }
CINT INT 0 1
Rdum INT 0 10E10
.ENDS
