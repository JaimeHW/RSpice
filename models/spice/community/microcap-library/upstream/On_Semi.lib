+ $G_DGND OR2
X_Oscillator_U22        $D_LO $D_LO Oscillator_FF_RESET Oscillator_SET
+ CLOCK CLOCKB DLAT_RESET
E_SAWTOOTH	SAWTOOTH 0 	VALUE { V(CT)*DISCHARGE/(CHARGE+DISCHARGE)}
X_Oscillator_U32        CLOCK SETPULSE PULSE_RISING PARAMS:  WIDTH=100ns
.ends OSCILLATOR

