*** From file ncv89803x-sms_rev2.lib
* ------------------------------------------------------------ *
*
* PSpice implementation of the PWM Switch
* CCMVM and CCMCM Switch Models originally derived by Vatche Vorperian
* DCMVM, DCMCM and BCM models originally derived by Christophe Basso
* Auto-toggling versions by Christophe Basso, Toulouse (FRANCE)
* OrCAD PSpice compatible
* Initial release: 22JAN14 by A. Laprade
*	NOTE:  THIS MODEL MAY ONLY BE USED FOR SMALL-SIGNAL AC-ANALYSIS MODELING
*	Basso model modified for NCV898031 small-signal specific modeling
*	Product specific slope compensation added
*	Default switching frequency FS = 2MHz added
*	OTA parameters added
*	Voltage feedback divider added
*	AC injection point added for small-signal analysis
* EDIT HISTORY (after 22JAN14 creation date)
*- 12FEB14 - Changed node connection for C_C1 & R_Ro to OTA output (was on wrong node, minor phase error possible in 1 MHz range)*- .
*- 18NOV16 - Changed NCV898031 slope compensation to 68 mV/us (datasheet error, no changes to product)
*          - Added NCV898032
*          - Reintroduced resonating capacitor for fs/2, needed when slope compensation is insufficient
* ------------------------------------------------------------ *
*******
*
.SUBCKT NCV898031-sms A C P VFB CTRL VC SW DIO Duty_Ratio PARAMS:  L=10u RI=
+ 100m FS=2E6
*
* OTA and voltage feedback model
*
V_V2         1.2V_REF 0 1.2
R_Ro         0 CTRL  3MEG TC=0,0
R_Resd         VC CTRL  542 TC=0,0
G_ABMI1         0 CTRL VALUE { i(V_v4)    }
V_V4         B 0 0Vdc
C_C1         0 CTRL  10pF  TC=0,0
G_G1         0 B 1.2V_REF VFB 0.00107
*
* This subckt is a current-mode DCM-CCM model including saturation voltages
*
* Duty ratio limit is 88%.  clampH=0.88 to reflect IC programming duty cycle limits (A. Laprade)
* Ri is set to a negative value AT THE SCHEMATIC LEVEL in expressions for boost topoloty
*
Edc dcx 0 value = { v(d2)*v(cx,P)/(v(a,P)-v(cx,P)+1u) }
Xdc dcx Duty_Ratio limit params: clampH=0.88 clampL=7m
Ed2 d2X 0 value = { (2*{L}*{Fs}*I(VM)/(V(Duty_Ratio)*V(a,cx)+1u)) - V(Duty_Ratio) }
Xd2 d2X Duty_Ratio d2 limit2
GIap a P value = { (V(Duty_Ratio)/(V(Duty_Ratio)+V(d2)+1u))*I(VM) }
GIpc P cx value = { V(CTRL)/{Ri} }
*
*  Note:  NCV898031 slope compensation is 34kV/s
*
GImju cx P value = { 34K*V(Duty_Ratio)/({Ri}*{Fs}) + (v(cx,P)/{L})*V(d2)*{1/Fs}*(1-(V(Duty_Ratio)+V(d2))/2) }
Rdum1 Duty_Ratio 0 1Meg
Rdum2 CTRL 0 1Meg
Eloss cx cxx Value = { V(SW)*V(Duty_Ratio)+V(DIO)*V(d2) }
VM cxx c
*XC1 c P mode varicap
Emode mode 0 Value = { IF (  (2*{L}*{Fs}*I(VM)/(V(Duty_Ratio)*V(a,cx)+1u))
 + < 1, 1p , {4/((L)*(6.28*Fs)^2)}	) } ; connect or disconnects the resonating capacitor
*
**** Loss generator ****
GSW 0 SW value = { I(VM) }
GID 0 DIO value = { I(VM) }
.ENDS
*
***************
*
.SUBCKT NCV898032-sms A C P VFB CTRL VC SW DIO Duty_Ratio PARAMS:  L=10u RI=
+ 100m FS=2E6
*
* OTA and voltage feedback model
*
V_V2         0.2V_REF 0 0.2
R_Ro         0 CTRL  3MEG TC=0,0
R_Resd         VC CTRL  542 TC=0,0
G_ABMI1         0 CTRL VALUE { i(V_v4)    }
V_V4         B 0 0Vdc
C_C1         0 CTRL  10pF  TC=0,0
G_G1         0 B 0.2V_REF VFB 0.00107
*
* This subckt is a current-mode DCM-CCM model including saturation voltages
*
* Duty ratio limit is 88%.  clampH=0.88 to reflect IC programming duty cycle limits (A. Laprade)
* Ri is set to a negative value AT THE SCHEMATIC LEVEL in expressions for boost topoloty
*
Edc dcx 0 value = { v(d2)*v(cx,P)/(v(a,P)-v(cx,P)+1u) }
Xdc dcx Duty_Ratio limit params: clampH=0.88 clampL=7m
Ed2 d2X 0 value = { (2*{L}*{Fs}*I(VM)/(V(Duty_Ratio)*V(a,cx)+1u)) - V(Duty_Ratio) }
Xd2 d2X Duty_Ratio d2 limit2
GIap a P value = { (V(Duty_Ratio)/(V(Duty_Ratio)+V(d2)+1u))*I(VM) }
GIpc P cx value = { V(CTRL)/{Ri} }
*
*  Note:  NCV898032 slope compensation is 204kV/s
*
GImju cx P value = {204KV*V(Duty_Ratio)/({Ri}*{Fs}) + (v(cx,P)/{L})*V(d2)*{1/Fs}*(1-(V(Duty_Ratio)+V(d2))/2) }
Rdum1 Duty_Ratio 0 1Meg
Rdum2 CTRL 0 1Meg
Eloss cx cxx Value = { V(SW)*V(Duty_Ratio)+V(DIO)*V(d2) }
VM cxx c
XC1 c p mode varicap
Emode mode 0 Value = { IF (  (2*{L}*{Fs}*I(VM)/(V(Duty_Ratio)*V(a,cx)+1u))
 + < 1, 1p , {4/((L)*(6.28*Fs)^2)}	) } ; connect or disconnects the resonating capacitor
*
**** Loss generator ****
GSW 0 SW value = { I(VM) }
GID 0 DIO value = { I(VM) }
.ENDS
*
********
********
.subckt limit d dc params: clampH=0.99 clampL=16m
Gd 0 dcx VALUE = { V(d)*100u }
Rdc dcx 0 10k
V1 clpn 0 {clampL}
V2 clpp 0 {clampH}
D1 clpn dcx dclamp
D2 dcx clpp dclamp
Edc dc 0 value={ V(dcx) }
.model dclamp d n=0.01 rs=100m
.ENDS
*
********
.subckt limit2 d2nc d d2c
*
*Modified A. Laprade 13AUG12 due to convergence issue with node d2c.  Limitation of 1 incorporated
*
Gd 0 d2cx d2nc 0 100u
Rdc d2cx 0 10k
V1 clpn 0 7m
E2 clpp 0 Value = { 1-V(d)-6.687m }
D1 clpn d2cx dclamp
D2 d2cx clpp dclamp
Edc d2c 0 value={ V(d2cx) }
*Edc d2c 0 value={ if(V(d2cx)>1,.99,v(d2cx)) }
*.model dclamp d n=0.01 rs=100m
.model dclamp d n=0.01 rs=100m
.ENDS
*
********
.SUBCKT VARICAP 1 2 CTRL
R1 1 3 1u
VC 3 4
EBC 4 2 Value = { (1/v(ctrl))*v(int) }
GINT 0 INT Value = { I(VC) }
CINT INT 0 1
Rdum INT 0 10E10
.ENDS
