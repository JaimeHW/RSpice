*
*
.SUBCKT NCP1203P40 skip FB CS GND DRV VCC HV
X1 skip FB CS GND DRV VCC HV NCP1203 params: Ct=1nF Conso=700u
.ENDS
*
**********
.SUBCKT NCP1203P60 skip FB CS GND DRV VCC HV
X1 skip FB CS GND DRV VCC HV NCP1203 params: Ct=650pF Conso=700u
.ENDS
*
**********
.SUBCKT NCP1203P100 skip FB CS GND DRV VCC HV
X1 skip FB CS GND DRV VCC HV NCP1203 params: Ct=400pF Conso=700u
.ENDS
*
**********
*
.SUBCKT NCP1203 skip FB CS GND DRV VCC HV params: Ct=1nF Conso=700u
*
C8 cmp rst 100p
R21 rst gnd 1k
R1 4 gnd 100k
X16 cmp 49 INV
Rskip skip 48 22k
X17 45 rst 38 OR2
X4 6 9 cmp COMPAR params: VHIGH=5
EB1 9 gnd Value = { IF ( V(CMP,gnd) > 3V, 500m, 3V ) }
Rfb 3 FB 20k
EBsetp setpoint gnd Value = { IF ( V(FB,gnd)/3.3 > 1V, 1V, V(FB,gnd)/3 ) }
X5 13 setpoint 16 COMPAR
X6 Q LEB UTD params: TD=250n ; Internal LEB duration
EBiMeas 13 gnd Value = { IF ( V(LEB,gnd) > 3.5V, V(CS,gnd), 0 ) }
RdumCS CS gnd 1Meg
X7 16 44 UTD params: TD=90n 	; Current sense prop. delay
EBdrive 35 gnd Value = { IF ( V(Q,gnd) > 3.5, V(Vcc,gnd), 100m ) }
Rsource 39 DRV 38
Rsink 36 DRV 20
D4 36 39 _D4_mod
Desd1 gnd skip _D5_mod
C1 49 15 100p
X8 Vcc UVLO1 UVLO params: VON=12 VOFF=7 ; First UVLO levels
X11 Vcc UVLO2 UVLO params:VON=12 VOFF=3.5 ; Second UVLO levels
D6 0 FB _D5_mod
GB3 HV Vcc Value = { IF ( V(UVLO2,gnd) > 3.5, 35u, 4m ) } ; HV source level
X14 44 46 38 2 OR3
X1x 1 2 Q 4 LATCH
Ct 6 gnd {Ct}
R100 101 46 1k
Q100 6 101 gnd QMOD
GB6 6 gnd value = { IF ( V(CMP) > 3.5, 500u, 0 ) }
GBCons1 Vcc gnd Value = {IF ( V(UVLO2,gnd) > 3.5, {Conso}, 300u ) }; IC and drive consumption
GBconsDRV Vcc gnd Value = { IF ( (V(UVLO1,gnd) > 3.5)  & (I(Vdrv) > 0), I(Vdrv), 0 ) }
Vdrv 35 39
X15 UVLO1 46 INV
D7 gnd CS _D5_mod
D8 gnd Vcc _D8_mod
EBskip 48 gnd Value = { IF ( V(UVLO1,gnd) > 3.5, 1.1V, 0 ) }
EBFB 3 gnd Value = { IF ( V(UVLO1,gnd) > 3.5, 4.8V, 0 ) }
X13 skip FB 45 COMPAR
GB12 gnd 6 Value = { IF ( (V(CMP,gnd) < 3.5) & (V(UVLO1,gnd) > 3.5), 125u, 0 ) }
R2 15 gnd 1k
D10 gnd 15 _D5_mod
D11 gnd rst _D5_mod
X2 15 53 1 AND2
X3 2 53 INV
** Discrete models **
.MODEL QMOD NPN (IS=15.2F NF=1 BF=105 VAF=98.5 IKF=.5
+ ISE=8.2P NE=2 BR=4 NR=1 VAR=20 IKR=.225 RE=.373 RB=1.49
+ RC=.149 XTB=1.5 CJE=35.5P CJC=12.2P TF=500P TR=85N)
.MODEL _D8_mod D BV=20 CJO=10p N=0.8 RS=100m TT=100n
.MODEL _D5_mod D BV=10 CJO=10p N=0.8 RS=100m TT=100n
.MODEL _D4_mod D CJO=10p N=0.01 RS=10m TT=10n
.ENDS
*
************
* ON Semiconductor
* NCP1203 model developed by Christophe BASSO, Toulouse (FRANCE)
* e-mail: christophe.basso@onsemi.com
* OrCAD PSpice compatible
*
* Last modified: October 25th 2001
* NCP1200 average FLYBACK AC model DCM and CCM modes
* FLYBACK average model made by Ben-Gurion University (ISRAEL)
* http://www.ee.bgu.ac.il/~pel
*************
.SUBCKT NCP1203_Av In Out Gnd FB CTRL PARAMS: FS=40k L=2.7m MC=1 RI=2.7
GIN IN GND VALUE = { I(VLM)*V(DON)/(V(DON)+V(DOFF)) }
ELM OUT1 GND VALUE = { V(IN)*V(DON)-V(OUT)*V(DOFF) }
RM OUT1 5 1M
LM 5 8 {L}
VLM 8 GND
GOUT GND OUT VALUE = { I(VLM)*V(DOFF)/(V(DON)+V(DOFF)) }
VCLP VC 0 9M
D2 VC DOFF DBREAK
D1 DOFF 6 DBREAK
R4 DOFF 7 10
EDOFFM 6 GND VALUE = { 1-V(DON)-9M }
EDOFF 7 GND VALUE = { 2*I(VLM)*{FS}*{L}/(V(DON))/(V(IN))-V(DON) }
EDON  DON GND TABLE { ((V(CONTROL)-I(VLM)*{RI})*{FS})/({MC}+((0.5*{RI}*V(IN))/{L})) }
+ ( (10m,10m) (.999,.999) )
EB1 CONTROL 0 VALUE = { IF ( V(CTRL)/4 > 1, 1, V(CTRL)/4 ) }
Vref 50 GND DC=4.8V
Rfb 50 FB 20k
.MODEL DBREAK D (TT=1N CJO=10P N=0.01)
.ENDS
*
*******
.SUBCKT LATCH 6 8 2 1 params: VHIGH=10 VLOW=100m
*             S R Q Q\
EBQB   10 0 Value = { IF ( (V(8)<800M) & (V(2)>800M), {VLOW}, {VHIGH} ) }
EBQ    20 0 Value = { IF ( (V(6)<800M) & (V(1)>800M), {VLOW}, {VHIGH} ) }
RD1   10 1 100
CD1   1 0 10p IC={VHIGH}
RD2   20 2 100
CD2   2 0 10p IC={VLOW}
.ENDS LATCH
*
*
.SUBCKT INV 1 2
EB1 4 0 Value = { IF ( V(1)>3.5, 0, 10V ) }
RD 4 2 100
CD 2 0 10P
.ENDS INV
*
*
.SUBCKT OR2 1 2 3
EB1 4 0 Value = { IF ( (V(1)>2.5V) | (V(2)>2.5V), 5V, 100m ) }
RD 4 3 100
CD 3 0 10P
.ENDS OR2
*
*
.SUBCKT COMPAR NINV INV OUT params: VHIGH=12 VLOW=100m
EB1 4 0 Value = { IF (  V(NINV,INV) > 0,  {VHIGH},  {VLOW} ) }
RO 4 OUT 100
CO OUT 0 10PF
.ENDS COMPAR
*
*
.SUBCKT UTD 1 2 params: TD=250n
*
*Parameters K=GAIN TD=DELAY
RIN 1 0 1E15
E1 3 0 1 0 1
T1 3 0 2 0 Z0=1 TD={TD}
R1 2 0 1
.ENDS
*
*
.SUBCKT UVLO  1   3 params: VON=8.6 VOFF=4V
*            VIN OUT
Vref 10 0 10V
X1 10 3 1 0 SWhyste params: RON=1 ROFF=1MEG VT={((VON-VOFF)/2) + VOFF} VH={(VON-VOFF)/2}
RUV 3 0 1k
.ENDS UVLO
*
*
.SUBCKT SWhyste NodeMinus NodePlus Plus Minus PARAMS: RON=1 ROFF=1MEG VT=5 VH=2
S5 NodePlus NodeMinus 8 0 smoothSW
EBcrtl 8 0 Value = { IF ( V(plus)-V(minus) > V(ref), 1, 0 ) }
EBref ref1 0 Value = { IF ( V(8) > 0.5, {VT-VH}, {VT+VH} ) }
Rdel ref1 ref 100
Cdel ref 0 100p  IC={VT+VH}
Rconv1 8 0 10Meg
Rconv2 plus 0 10Meg
Rconv3 minus 0 10Meg
.model smoothSW VSWITCH (RON={RON} ROFF={ROFF} VON=1 VOFF=0)
.ends SWhyste
*
*
.SUBCKT OR3 1 2 3 5
EB1 4 0 Value = { IF ( (V(1)>800mV) | (V(2)>800mV) | (V(3)>800mV), 10V, 100m ) }
RD 4 5 100
CD 5 0 10P
.ENDS
*
*
.SUBCKT AND2 1 2 3
