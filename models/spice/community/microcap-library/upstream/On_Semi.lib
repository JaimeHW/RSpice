*
*********
*SRC=FreeRunDT;FreeRunDT;Custom Tof;Generic;FreeRun w. min. toff
*SYM=FreeRun
*
.subckt FreerunDT dem fb cs gnd out {rgate=10 leb=250n toffmin=7.5u}
*
.SUBCKT INV 1 2
B1 4 0 V= V(1)>800M ? 0 : 5V
RD 4 2 100
CD 2 0 10P
.ENDS INV
*
.SUBCKT COMPAR NINV INV OUT {VHIGH=12 VLOW=100m}
B1 4 0 V = V(NINV,INV) > 0  ?  {VHIGH}  :  {VLOW}
RO 4 OUT 100
CO OUT 0 100PF
.ENDS
*
.SUBCKT FFLOP_HD 1   2 4 3  5  6 {VHIGH=10 VLOW=100m VUND=100m Init=1}
*                CLK D R S  QB Q
A10 [1] [51] A2D_001                            ; Analog Clock to Digital Clock
A11 [2] [50] A2D_001                            ; Analog Data to Digital Data
A6 [3] [30] A2D_001                                     ; Analog Set to Digital Set
A7 [4] [40] A2D_001                                     ; Analog Reset to Digital Reset
A8 [31] [5] D2A_001                                     ; Digital Q\ to analog Q\
A9 [32] [6] D2A_001                                     ; Digital Q to analog Q
A3 40 42 INV_001                                        ; Set\
A4 30 41 INV_001                                        ; Reset\
A1 50 51 41 42 32 31 DFF_001            ; HDL Flip-Flop
.MODEL DFF_001 d_dff(clk_delay=1.0N nset_delay=1.0N nreset_delay=1.0N rise_delay=1.0N
+ fall_delay=1.0N ic={Init} data_load=1.0P clk_load=1.0P nset_load=1.0P nreset_load=1.0P)
.MODEL A2D_001 adc_bridge(in_low=1.0 in_high=3.0 rise_delay=1.0N fall_delay=1.0N)
.MODEL D2A_001 dac_bridge(out_low={VLOW} out_high={VHIGH} out_undef={VUND} t_rise=10N
+ t_fall=10N input_load=1.0P)
.MODEL INV_001 d_inverter(rise_delay=1.0N fall_delay=1.0N input_load=1.0P)
.ENDS
*
.SUBCKT LATCH 6 8 2 1 {VHIGH=10 VLOW=100m}
*             S R Q Q\
BQB   10 0 V=(V(8)<800M) & (V(2)>800M) ? {VLOW} : {VHIGH}
BQ    20 0 V=(V(6)<800M) & (V(1)>800M) ? {VLOW} : {VHIGH}
RD1   10 1 100
CD1   1 0 10p IC={VHIGH}
RD2   20 2 100
CD2   2 0 10p IC={VLOW}
.ENDS LATCH
*
.SUBCKT UTD 1 2 {K=??? TD=???}
*Parameters K=GAIN TD=DELAY
RIN 1 0 1E15
E1 3 0 1 0 {K}
T1 3 0 2 0 Z0=1 TD={TD}
R1 2 0 1
.ENDS
*
.SUBCKT AND2 1 2 3
B1 4 0 V= (V(1)>800mV) & (V(2)>800mV) ? 10V : 100m
RD 4 3 100
CD 3 0 10P
.ENDS AND2
*
.SUBCKT NAND2 1 2 3
B1 4 0 V= (V(1)>800M) & (V(2)>800M) ? 100m : 5V
RD 4 3 100
CD 3 0 10P
.ENDS NAND2
*
.SUBCKT ONESHOTRET In Out {DELAY=3u}
R1 1 0 10k
C1 1 In 10pF
X1 Out 3 UTD PARAMS: TD=DELAY K=1
X3 3 4 INV
X4 1 5 Out Qb LATCH
R2 0 5 10k
C2 6 5 10pF
X7 4 Out 6 NAND2
.ENDS
*
Rout drv out {rgate}
D1x gnd dem Desd
* Cdelay dem gnd 20p
X1x 3 dem cmp COMPAR
Bref 3 gnd V=V(cmp) > 3.5 ? 65mV : 60mV
X2 26 5 7 gnd qb drv FFLOP_HD
V1 5 gnd DC=10
X3 16 22 7 COMPAR
X10 drv leb UTD {K=1 TD=leb}
R4 gnd cs 1Meg
B2 22 gnd V=V(FB)/3 > 1 ? 1V : V(FB)/3 < 10m ? 10m : V(FB)/3
Rpull fb 23 20k
V3 23 gnd DC=4.8
X6 30 27 26 AND2
B5 16 gnd V=V(leb)<5V ? 0 : V(cs)
X11 qb 270 ONESHOTRET {Delay=toffmin}
XINV 270 27 INV
C4 cmp 30 100p
R5 30 gnd 1k
** discrete models **
.MODEL Desd D BV=10V CJO=10PF IS=7E-09 M=.45 N=2 RS=.8
+ TT=6E-09 VJ=.6V
.ENDS
