.SUBCKT SRFFLOP2 1 2 3
*                S R Q
R1 1 0 1Meg
R2 2 0 1Meg
E_Q 20 0 VALUE { IF ((V(1) < 800mV) & (V(4)>800mV) | (V(2) > 800mV), 10mV ,5V)}
E_Qbar 10 0 VALUE { IF ((V(2) < 800mV) & (V(3)>800mV) , 10mV ,5V)}

RD1 10 4 10
CD1 4 0 10p IC=5
RD2 20 3 10
CD2 3 0 10p IC = 0
.ENDS SRFFLOP2
*
**** Current Source ****
.SUBCKT ISINK2 1 2 3 PARAMS: SinkI1=1m
*               Upper Lower Vcontrol
*Sinks current if Vcontrol high

G_start 1 2 VALUE = { IF (V(3) > 3.5, SinkI1, 1fA)}

R3 3 0 1Meg
.ENDS ISINK2
*
.SUBCKT COMP_HYST1 1 2 3 PARAMS: VHYS=3V
*                  + - S
Rplus  1 0 10MEG
Rminus 2 0 10MEG
E_Ref ref 0 VALUE = { IF ( V(3) > 3V, V(2)-VHYS, V(2) ) }
E_Comp 4 0 VALUE = { IF ( V(1) > V(ref), 5V, 10mV) }
RD 4 5 100
CD 5 0 10p
Rout 5 3 100

.ENDS COMP_HYST1
*
**** Inverter ****
.SUBCKT Inverter 1 2
*                IN OUT
RIN 1 0 1MEG
E_1 3 0 VALUE { IF (V(1) > 2V, 10mV , 5V)}
R1 3 2 100
C1 2 0 100p
.ENDS Inverter
