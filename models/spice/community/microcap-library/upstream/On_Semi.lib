.SUBCKT NCP1230_Av In Out Gnd FB CTRL PARAMS: FS=65k L=2.7m MC=1 RI=2.7
GIN IN GND VALUE = { I(VLM)*V(DON)/(V(DON)+V(DOFF)) }
ELM OUT1 GND VALUE = { V(IN)*V(DON)-V(OUT)*V(DOFF) }
RM OUT1 5 1M
LM 5 8 {L}
VLM 8 GND
GOUT GND OUT VALUE = { I(VLM)*V(DOFF)/(V(DON)+V(DOFF)) }
VCLP VC 0 9M
D2 VC DOFF DBREAK
D1 DOFF 6 DBREAK
R4 DOFF 7 10
EDOFFM 6 GND VALUE = { 1-V(DON)-9M }
EDOFF 7 GND VALUE = { 2*I(VLM)*{FS}*{L}/(V(DON))/(V(IN))-V(DON) }
EDON  DON GND TABLE { ((V(CONTROL)-I(VLM)*{RI})*{FS})/({MC}+((0.5*{RI}*V(IN))/{L})) }
+ ( (10m,10m) (.999,.999) )
EB1 CONTROL 0 VALUE = { IF ( V(CTRL)/4 > 1, 1, V(CTRL)/4 ) }
Vref 50 GND DC=4.3V
Rfb 50 FB 20k
.MODEL DBREAK D (TT=1N CJO=10P N=0.01)
.ENDS
*
*
**** SUBCIRCUIT MODELS ****
*
.SUBCKT UTD 1 2 params: TD=1n
*
*Parameters K=GAIN TD=DELAY
RIN 1 0 1E15
E1 3 0 1 0 1
T1 3 0 2 0 Z0=1 TD={TD}
R1 2 0 1
.ENDS
*
**** 2 INPUT COMPARATOR ****
.SUBCKT COMPNCP1230 1 2 3
*             + - S
EB1 4 0 Value = { IF ( V(1) > V(2), 5V, 0 ) }
RD 4 3 100
CD 3 0 10P
.ENDS

*
**** 3 INPUT OR GATE ****
.SUBCKT OR3_A 1 2 3  6
* EB1 5 0 Value = { IF ( (V(1)>2.5) | (V(2)>2.5) | (V(3)>2.5), 5, 0 ) }
EB1 5 0 Value = { IF ( (V(1)>800m) | (V(2)>800m) | (V(3)>800m), 5, 0 ) }
* comparison voltage raised to 3 to lower the noise
RD 5 6 100
CD 6 0 10P
.ENDS OR3_A
*
**** 2 INPUT OR GATE ****
.SUBCKT OR2_A 1 2 3
EB1 4 0 Value = { IF ( (V(1)>800M) | (V(2)>800M), 5V, 0 ) }
RD 4 3 100
CD 3 0 10P
.ENDS OR2_A
*
**** 2 INPUT AND CIRCUIT ****
.SUBCKT AND2_A 1 2 3
EB1 4 0 Value = { IF ( (V(1)>800M) & (V(2)>800M), 5V, 0 ) }
RD 4 3 100
CD 3 0 10P
.ENDS AND2_A
*
**** 2 INPUT INVERTED AND CIRCUIT ****
.SUBCKT AND2I_A 1 2 3
EB1 4 0 Value = { IF ( (V(1)<800M) & (V(2)>800M), 5V, 0 ) }
RD 4 3 100
CD 3 0 10P
.ENDS AND2I_A
*
**** 2 INPUT NOR CIRCUIT ****
.SUBCKT NOR2_A 1 2 3
EB1 4 0 Value = { IF ( (V(1)>800M) | (V(2)>800M), 0V, 5 ) }
RD 4 3 100
CD 3 0 10P
.ENDS NOR2_A
*
****
.SUBCKT INV_B 1 2
EB1 4 0 Value = { IF ( V(1)>800mV, 0, 10V ) }
RD 4 2 100
CD 2 0 10P
.ENDS INV_B
*
*
.SUBCKT TFFLOP 6 8 2 1
*              S R Q Q\
EBQB   10 0 Value = { IF ( (V(8)<800M) & (V(2)>800M), 0, 10V ) }
EBQ    20 0 Value = { IF ( (V(6)<800M) & (V(1)>800M), 0, 10V ) }
RD1   10 1 100
CD1   1 0 10p IC=5
RD2   20 2 100
CD2   2 0 10p IC=0
.ENDS TFFLOP
*
*
.SUBCKT UVLO  1   3 params: VON=12.6 VOFF=7.7
*            VIN OUT
Vref 10 0 10V
X1 10 3 1 0 SWhyste params: RON=1 ROFF=1MEG VT={((VON-VOFF)/2) + VOFF} VH={(VON-VOFF)/2}
RUV 3 0 1k
.ENDS UVLO
*
*
.SUBCKT SWhyste NodeMinus NodePlus Plus Minus PARAMS: RON=1 ROFF=1MEG VT=5 VH=2
S5 NodePlus NodeMinus 8 0 smoothSW
EBcrtl 8 0 Value = { IF ( V(plus)-V(minus) > V(ref), 1, 0 ) }
EBref ref1 0 Value = { IF ( V(8) > 0.5, {VT-VH}, {VT+VH} ) }
Rdel ref1 ref 100
Cdel ref 0 100p  IC={VT+VH}
Rconv1 8 0 10Meg
Rconv2 plus 0 10Meg
Rconv3 minus 0 10Meg
.model smoothSW VSWITCH (RON={RON} ROFF={ROFF} VON=1 VOFF=0)
.ends SWhyste
*
.SUBCKT CLOCK1230 out12 ramp vcc maxduty2 params: DC=0.8 Fsw_ref=65k Vref=11V Valley=0V Swing=2.9V DeltaV=1V
+ Jittering=0.04

** Fsw @ Vref
** At Vcc=Vref+DeltaV then Fsw_Vcc=Fsw_ref*(1+Jittering)

.PARAM I1=100uA
.PARAM I2={ (I1*{DC})/(1-{DC}) }
.PARAM Tsw_ref={1/Fsw_ref}
.PARAM Ct={ (Tsw_ref/Swing)*((I1*I2)/(I1+I2)) }

*** coeff : frequency jittering based on Vcc level : {1+((V(vcc)-Vref)/DeltaV)*Jittering}
*** the jittering depth is (0.04 = +/- 4%)
*
* Vcc input is for jittering
* SET/RESET pulses for clock gen.
*
X100	out		outb		INV_B
Cmd	outb		maxduty	1n
Rmd 	maxduty	0		100
Dmd1	0		maxduty 	DCLP
Cpuls out		out1		1n
Rpuls out1		0		100
Dmd2	0		out1		DCLP
*
Xbuf1 out1		out12		BUF_A ; formats the pulses
Xbuf2 maxduty	maxduty2	BUF_A
*
X4	ramp	4	cmp		COMPNCP1230
Ct	ramp	0	{Ct}		IC=0V
X1 	cmp	OUT	INVOSC
EB1	4	0	Value = { IF ( V(CMP) > 3V	, (valley), (valley+swing) ) }
GB2	ramp	0	Value = { IF ( V(CMP) > 3.5V	, (I1*DC*(1+((V(vcc)-Vref)/DeltaV)*Jittering))/(1-DC), 0 ) }
GB3x 	0	ramp	Value = { IF ( V(CMP) < 3.5V	, (I1*(1+((V(vcc)-Vref)/DeltaV)*Jittering)), 0 ) }
*
.model DCLP D (Cjo=10p Rs=100m N=0.01)
.ENDS CLOCK1230


*
*
.SUBCKT INVOSC 1 2
EB1 4 0 Value = { IF ( V(1)>800mV, 0, 5V ) }
RD 4 2 100
CD 2 0 10P
.ENDS INVOSC
*
*
.SUBCKT BUF_A 1 2
EB1 4 0 Value = { IF (  V(1)>0.5V, 5V, 0V ) }
RD 4 2 10
CD 2 0 10P
.ENDS BUF_A
