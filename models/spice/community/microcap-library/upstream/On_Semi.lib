*** From file FreeRun.lib
*==========================================================
*
* FreeRun model made by Christophe Basso
* Last modified May 31st 2002
*
* These simplified subcircuits model a Free Running
* controller as used in QR application.
*
* Both feature adjustable driver output resistance and
* leading edge blanking delay whereas FreerunDT includes
* a minimum Toff (to clamp max. switching) and FreerunNDT
* does not include clamps at all.
*
*==========================================================
**********
*
.subckt FreerunDT dem fb cs gnd out params: rgate=10 tleb=250n toffmin=7.5u
*
EBOUT	drvq	0	value = { IF ( V(drv)>1, 15, 0 ) }
Rout	drvq	out	{rgate}
D1x	gnd	dem	Desd
Cdelay	dem	gnd	20p
X1x 3	dem	cmp	COMPAR
EBref	3	gnd	Value = { IF ( V(cmp) > 3.5, 65mV, 60mV ) }
X2	26	5	7	gnd	qb	drv	FFLOP_A
V1	5	gnd	DC=10
X3	16	22	7	COMPAR
X10	drv	leb	UTD	params: Ret={tleb}
R4	gnd	cs	1Meg
EB2 	22	gnd	Value = { IF ( V(FB)/3 > 1, 1V, IF ( V(FB)/3 < 10m, 10m, V(FB)/3 ) ) }
Rpull	fb	23	20k
V3	23	gnd	DC=4.8
X6	30	27	26	AND2_bis
EB5	16	gnd	Value = { IF ( V(leb)>5V, V(cs), 0 ) }
X11	qb	270	ONESHOTRET params: delay={toffmin}
XINV	270	27	INV_A
C4	cmp	30	100p
R5	30	gnd	1k

** discrete models **
.MODEL Desd D BV=10V CJO=10PF IS=7E-09 M=.45 N=2 RS=.8
+ TT=6E-09 VJ=.6V

.ENDS
*
*********
*SRC=FreeRunNDT;FreeRunNDT;Custom Tof;Generic;FreeRun no min toff
*SYM=FreeRun
*
.subckt FreerunNDT dem fb cs gnd out params: rgate=10 tleb=250n
*
EBOUT drvq 0 value = { IF ( V(drv)>1, 15, 0 ) }
Rout drvq out {rgate}
D1x gnd dem Desd
Cdelay dem gnd 20p
X1x 3 dem cmp COMPAR
EBref 3 gnd Value = { IF ( V(cmp) > 3.5, 65mV, 60mV ) }
X2 30 5 7 gnd qb drv FFLOP
V1 5 gnd DC=10
X3 16 22 7 COMPAR
X10 drv leb UTD params: Ret={tleb}
R4 gnd cs 1Meg
EB2 22 gnd Value = { IF ( V(FB)/3 > 1, 1V, IF ( V(FB)/3 < 10m, 10m, V(FB)/3 ) ) }
Rpull fb 23 20k
V3 23 gnd DC=4.8
EB5 16 gnd Value = { IF ( V(leb)>5V, V(cs), 0 ) }
C4 cmp 30 100p
R5 30 gnd 1k
** discrete models **
.MODEL Desd D BV=10V CJO=10PF IS=7E-09 M=.45 N=2 RS=.8
+ TT=6E-09 VJ=.6V
.ENDS
*
**************
.SUBCKT INV_A 1 2
EB1 4 0 VALUE = { IF ( V(1)>800M, 0, 5V ) }
RD 4 2 10
CD 2 0 10P
.ENDS INV_A
*
*
.SUBCKT LATCH 6 8 2 1
*             S R Q Q\
E_BQB 10 0 VALUE = { IF ( (V(8)<800M) & (V(2)>800M), 0, 5V ) }
E_BQ  20 0 VALUE = { IF ( (V(6)<800M) & (V(1)>800M), 0, 5V ) }
RD1   10 1 100
CD1   1 0 10P IC=5
RD2   20 2 10
CD2   2 0 10P IC=0
.ENDS LATCH
*
*
.SUBCKT NAND2_A 1 2 3
EB1 4 0 VALUE = { IF ( (V(1)>800M) & (V(2)>800M), 0, 5V ) }
RD 4 3 100
CD 3 0 10P
.ENDS NAND2_A
*
*
.SUBCKT AND2_bis 1 2 3
EB1 4 0 VALUE = { IF ( (V(1)>800M) & (V(2)>800M), 5V, 0 ) }
RD 4 3 100
CD 3 0 10P
.ENDS AND2_bis

*
*
.SUBCKT COMPAR NINV INV OUT params: VHIGH=12 VLOW=100m
EB1 4 0 Value = { IF ( V(NINV,INV) > 0, {VHIGH}, {VLOW} ) }
RO 4 OUT 100
CO OUT 0 10P
.ENDS
*
*
**** TOGGLE CIRCUIT ****
.SUBCKT FFLOP_A 1  2 11 12 5  6
*             CLK D R  S  QB Q
X1 7 4 2 8 NAND30_05
X2 8 3 10 9 NAND30_05
X3 1 8 10 7 NAND31_05
X4 4 9 1 10 NAND30_05
X5 4 7 6 5 NAND31_05
X6 5 10 3 6 NAND30_05
X7 11 4 INV_05
X8 12 3 INV_05
.ENDS FFLOP_A
*
***** INTERNAL FFLOP DEFINITION ****
.SUBCKT NAND30_05 1 2 3 4
E1 5 0 VALUE = { IF ( (V(1)>800mV) & (V(2)>800mV) & (V(3)>800mV), 100m, 10 ) }
R1 5 4 10
C1 4 0 10P IC=100m
.ENDS NAND30_05
*
*
.SUBCKT NAND31_05 1 2 3 4
E1 5 0 VALUE = { IF ( (V(1)>800mV) & (V(2)>800mV) & (V(3)>800mV), 100m, 10 ) }
R1 5 4 10
C1 4 0 10P IC=10
.ENDS NAND31_05
*
*
.SUBCKT INV_05 1 2
E1 3 0 VALUE = { IF ( V(1)>800mV, 100m, 10 ) }
R1 3 2 10
C1 2 0 10P IC=10
.ENDS INV_05
*
*
.SUBCKT UTD 1 2 PARAMS: Ret=8u
*
RIN 1 0 1E15
E1 3 0 1 0 1
T1 3 0 2 0 Z0=1 TD={Ret}
R1 2 0 1
.ENDS UTD
*
*
.SUBCKT ONESHOTRET In Out params: DELAY=3u
R1 1 0 10k
C1 1 In 10pF
D1 0 1 Dclp
X1 Out 3 UTD PARAMS: Ret={DELAY}
X3 3 4 INV_A
X4 1 5 Out Qb LATCH
R2 0 5 10k
C2 6 5 10pF
D3 0 5 Dclp
X7 4 Out 6 NAND2_A
.model Dclp D rs=1 tt=10n cjo=10p
.ENDS
*
*
.SUBCKT SFH610A 1 2 3   5
* ISOLATOR      A C COL EMITTER
RB 4 0 100Meg
VM 1 6
D1 6 2 LED
EB1 7 0 Value = { I(VM)*.0075*(1-.25*(temp-27)/50) }
R1 7 8 1K
C1 8 0 .25nF
G1 3 4 8 0 1
Q1 3 4 5 MPSA06
*RBE 4 5 150k
CC 2 5 .4p
.MODEL LED D ( IS=4.94e-021 RS=3.83m
+ CJO=13.0p  M=0.333 N=1.01 TT=1n )
.MODEL MPSA06 NPN (IS=20.3f NF=1.00 BF=343 VAF=25
+ IKF=39.6m ISE=1.19p NE=2.00 BR=10.00 NR=1.00
+ VAR=16.0 IKR=75.0m RE=23.1 RB=92.6 RC=9.26
+ XTB=1.5 CJE=20.7p VJE=1.10 MJE=0.500 CJC=10.0p VJC=0.300
+ MJC=0.500 TF=2.3n TR=376n EG=1.12 )
.ENDS
*
*
.SUBCKT XFMR1 1 2 3 4 PARAMS: RATIO=1
RP 1 2 1MEG
