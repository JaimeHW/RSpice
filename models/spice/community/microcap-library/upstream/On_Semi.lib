.SUBCKT Zener4p5v_table anode cathode
R anode int1 10m
Vx int1 int2 DC 0V
Ed int2 cathode TABLE {I(Vx)}= (-5A,-4.51V)(-50uA,-4.5V)
+ (-5uA,-4.49V) (-0.5uA,-4.48V) (-10pA,-10mV) (0A,0V) (25uA,100mV)
+ (50uA,600mV) (75uA,700mV) (1.5mA,750mV) (5A,775mV)
.ENDS
*
**********************************************************************
.SUBCKT Zener3V_table anode cathode
R anode int1 10m
Vx int1 int2 DC 0V
Ed int2 cathode TABLE {I(Vx)}= (-5A,-3.001V)
+(-20uA,-2.999V) (-10uA,-2.998V) (-1uA,-2.997V)(-100pA,-10mV)
+(0A,0V) (100pA,10mV) (1uA,600mV) (10uA,700mV) (5A,750mV)
.ENDS
*
**********************************************************************
**********************************************************************
.SUBCKT COMP + - V+ V- OUT PARAMS: AV=2000 VRP=0.01 VRN=0.01 ROUT=100
.PARAM PI=3.1415
E_ABM3 10 0 VALUE {(( V(+,-))*(AV)*(PI))/(V(11))}
E_ABM5 12 0 VALUE {( V(V+) + V(V-)-(VRP)+(VRN))/2}
E_GAIN1 13 0 VALUE {1/(PI) * V(11)}
R_R1 V+ V- 500k
E_SUM1 16 0 VALUE {V(14)+V(12)}
E_ABM1 11 0 VALUE {(V(V+,V-))-(VRP)-(VRN)}
E_MULT1 14 0 VALUE {V(15)*V(13)}
E_ATAN1 15 0 VALUE {ATAN(V(10))}
R_R2 + - 10G
R_R3 16 OUT {ROUT}
C_C1 OUT V- 5e-13
.ENDS
*
**********************************************************************
.subckt DELAY  IN OUT
+	optional: DPWR=$G_DPWR DGND=$G_DGND
+	params: DELAY=50NS TOL=5 MNTYMXDLY=3 IO_LEVEL=1
U1 dlyline DPWR DGND
+	IN   OUT
+	DLYMODEL IO_CS80 MNTYMXDLY={MNTYMXDLY} IO_LEVEL={IO_LEVEL}
.model DLYMODEL udly (
+	DLYMN={DELAY - (DELAY*(TOL/100))}
+	DLYTY={DELAY}
+	DLYMX={DELAY + (DELAY*(TOL/100))}
+	)
.ends
*
**********************************************************************
.SUBCKT INV  I0  O
+	optional: DPWR=$G_DPWR DGND=$G_DGND
+     params: MNTYMXDLY=2 IO_LEVEL=2
U1 INV
+  DPWR  DGND
+  I0  O
+  D_CS80 IO_CS80
.ENDS
*
**********************************************************************
.SUBCKT NAN2  I0 I1  O
+	optional: DPWR=$G_DPWR DGND=$G_DGND
+     params: MNTYMXDLY=3 IO_LEVEL=1
U1 NAND(2)
+  DPWR  DGND
+  I0 I1  O
+  D_CS80 IO_CS80
.ENDS
*
**********************************************************************
.SUBCKT OR2  I0 I1  O
+	optional: DPWR=$G_DPWR DGND=$G_DGND
+     params: MNTYMXDLY=2 IO_LEVEL=1
U1 OR(2)
+  DPWR  DGND
+  I0 I1  O
+  D_CS80 IO_CS80
.ENDS
*
**********************************************************************
.SUBCKT NOR2  I0 I1  O
+	optional: DPWR=$G_DPWR DGND=$G_DGND
+     params: MNTYMXDLY=2 IO_LEVEL=1
U1 NOR(2)
+  DPWR  DGND
+  I0 I1  O
+  D_CS80 IO_CS80
.ENDS
*
**********************************************************************
.subckt DIGIFPWR  AGND
+	optional: DPWR=$G_DPWR DGND=$G_DGND
+	params:   VOLTAGE=5.0v REFERENCE=0v
*
VDPWR  DPWR DGND  {VOLTAGE}
R1     DPWR AGND  100MEG
VDGND  DGND AGND  {REFERENCE}
R2     DGND AGND  100MEG
.ends
*
.subckt AtoD_CS80  A D  DPWR DGND
+	params: CAPACITANCE=0
*
O1  A DGND DO_CS80 DGTLNET=D IO_CS80
.ends
*
.subckt DtoA_CS80  D A  DPWR DGND
+	params: DRVL=1 DRVH=1 CAPACITANCE=0
*
N1  A DGND DPWR DIN_CS80 DGTLNET=D IO_CS80
C1  A DGND {CAPACITANCE+0.001pF}
.ends
*
**********************************************************************
