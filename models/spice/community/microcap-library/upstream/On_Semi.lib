.subckt NCP1083 VPORTP CLASS VUVLO INRUSH ILIM VPORTN1 RTN VPORTN2 AUX TEST RT CS NCLASS_AT ARTN DRV VDDH VDDL COMP FB SS EP
* VPOERTN
R_VPORTN1				VPORTN1 VPORTN		0.01
R_VPORTN2				VPORTN2 VPORTN		0.01
R_EP					EP VPORTN			0.01

* CLASS
V_CLASS 				CLASS VPORTN		1.2Vdc
E_ClASS_LOW				CLASS_LOW 0			VALUE { if ((V(VPORTP) - V(VPORTN))>13V, 5Vdc ,0) }
E_ClASS_HIGH			CLASS_HIGH 0		VALUE { if ((V(VPORTP) - V(VPORTN))<20.5V, 5Vdc ,0) }
X_CLASS					AUXnACTIVE CLASS_LOW CLASS_HIGH CLASS_ACTIVE  $G_DPWR $G_DGND AND3
G_CLASS					VPORTP VPORTN		VALUE { if (V(CLASS_ACTIVE)>2.5V, I ( V_CLASS ),0) }

* AUX
V_AUX					AUXTH 0				1.5Vdc
