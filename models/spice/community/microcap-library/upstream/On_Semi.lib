*SRC=QuasiFly;QuasiFly;Custom Tof;Generic;FreeRun QR model
*SYM=QuasiFlyAvg
*
.SUBCKT QuasiFly 13 FB Gnd 3 Ip Ton Fsw {Lp=3.22m Rs=0.8 N=0.06 eff=0.86 Rlf=0.5}
*					In Fb Gnd Out
.SUBCKT XFMR 1    2    3    4 {RATIO=???}
RP 1 2 1MEG
E 5 4 1 2 {RATIO}
F 1 2 VM {RATIO}
RS 6 3 1U
VM 5 6
.ENDS
*
BToff toff 0 V={Lp}*V(Ip)*{N}/V(3)
Rs 1 12 {Rlf}
X2 13 12 0 4 XFMR {RATIO=N}
Lm 13 12 {Lp}
BGd 4 3 I=(((2*{Lp}*(V(3)+{N}*V(13))/(V(ton)*V(3)+1u))*I(V6)^2)/V(3,4))*{eff} < 10m ? 10m :
+(((2*{Lp}*(V(3)+{N}*V(13))/(V(ton)*V(3)+1u))*I(V6)^2)/V(3,4))*{eff}
BEt 7 Gnd V=(2*{Lp}*(V(3)+{N}*V(13))/(V(ton)*V(3)+1u))*I(V6)
VI1 1 7
Bton ton 0 V=V(errint)*{Lp}/({Rs}*V(13))
BIp Ip 0 V=V(ton)*V(13)/{Lp}
Bfreq Fsw 0 V=(1/(V(ton)+V(toff)))/1000
B8 errint 0 V=V(FB)/3 > 1 ? 1 : V(FB)/3 < 10m ? 10m : V(FB)/3
R9 FB 0 1Meg
Bclamp 0 20 I=I(VI1)>0 ? I(VI1) : 0
V6 20 0
Rdum1 errint 0 10Meg
Rdum2 ton 0 10Meg
Rdum3 fsw 0 10Meg
Rdum4 ip 0 10Meg
.ENDS
********
*SRC=QuasiFlyDel;QuasiFlyDel;Custom Tof;Generic;FreeRun QR w. valley
*SYM=QuasiFlyAvg
*
.SUBCKT QuasiFlyDel 13 FB Gnd 3 Ip Ton Fsw {Lp=3.22m Rs=0.8 N=0.06 eff=0.86 Rlf=0.5 Ctot=100p}
*					In Fb Gnd Out
.PARAM DEL={3.14159*SQRT({Lp*Ctot})}
*
.SUBCKT XFMR 1    2    3    4 {RATIO=???}
RP 1 2 1MEG
E 5 4 1 2 {RATIO}
F 1 2 VM {RATIO}
RS 6 3 1U
VM 5 6
.ENDS
*
BToff toff 0 V={Lp}*V(Ip)*{N}/V(3)
Rs 1 12 {Rlf}
X2 13 12 0 4 XFMR {RATIO=N}
Lm 13 12 {Lp}
BEt 7 Gnd V = (2*{Lp}/V(ton)) * ( ({N}*V(13)+V(3))/(V(3)+1u) + {DEL}/V(ton) +
+({Lp}*{Ctot}/V(ton))*(1+(V(3)/{N})/V(13))  ) * I(V6)
BGd 4 3 I= ((2*{Lp}/V(ton)) * ( ({N}*V(13)+V(3))/(V(3)+1u) + {DEL}/V(ton) +
+({Lp}*{Ctot}/V(ton))*(1+(V(3)/{N})/V(13))  ) * I(V6)^2)/(V(3,4)+1u)*{EFF} < 10m ? 10m :
+((2*{Lp}/V(ton)) * ( ({N}*V(13)+V(3))/(V(3)+1u) + {DEL}/V(ton) +
+({Lp}*{Ctot}/V(ton))*(1+(V(3)/{N})/V(13))  ) * I(V6)^2)/(V(3,4)+1u)*{EFF}
VI1 1 7
Bton ton 0 V=V(errint)*{Lp}/({Rs}*V(13))
BIp Ip 0 V=V(ton)*V(13)/{Lp}
Bfreq Fsw 0 V=(1/(V(ton)+V(toff)+{DEL}+({Lp}*{Ctot}/V(ton))*(1+(V(3)/{N})/V(13))))/1000
B8 errint 0 V=V(FB)/3 > 1 ? 1 : V(FB)/3 < 10m ? 10m : V(FB)/3
R9 FB 0 1Meg
Bclamp 0 20 I=I(VI1)>0 ? I(VI1) : 0
V6 20 0
Rdum1 errint 0 10Meg
Rdum2 ton 0 10Meg
Rdum3 fsw 0 10Meg
Rdum4 ip 0 10Meg
.ENDS
***********



*** From file qrav.lib
************************************
*
* Quasi-Resonant SPICE library
* Developped by Christophe Basso
* email: cbasso@wanadoo.fr
* last modified: October 20th 2002
* PSpice compatible
*
************************************
*
.SUBCKT QuasiFly 13 FB Gnd 3 Ip Ton Fsw params: Lp=3.22m Rs=0.5 N=0.06 eff=0.86 Rlf=0.5
*					In Fb Gnd Out
EBToff toff 0 Value = { {Lp}*V(Ip)*{N}/V(3) }
Rs 1 12 {Rlf}
X2 13 12 0 4 XFMR params: RATIO={N}
Lm 13 12 {Lp}
Gd 4 3 TABLE { (((2*{Lp}*(V(3)+{N}*V(13))/(V(ton)*V(3)+1u))*I(V6)^2)/(V(3,4)+1u))*{eff} } ( (10m,10m) (1000,1000) )
Et 7 Gnd Value = { (2*{Lp}*(V(3)+{N}*V(13))/(V(ton)*V(3)+1u))*I(V6) }
VI1 1 7
EBton ton 0 Value = { V(errint)*{Lp}/({Rs}*V(13)) }
EBIp Ip 0 Value = { V(ton)*V(13)/{Lp} }
EBfreq Fsw 0 Value = { (1/(V(ton)+V(toff)))/1000 }
EB8 errint 0 Value = { IF ( V(FB)/3 > 1, 1, IF ( V(FB)/3 < 10m, 10m, V(FB)/3 )) }
R9 FB 0 1Meg
GBclamp 0 20 Value = { MAX(I(VI1),0)}
V6 20 100
Rdumpos 100 0 10
.ENDS
*******
.SUBCKT QuasiFlyDel 13 FB Gnd 3 Ip Ton Fsw params: Lp=3.22m Rs=0.8 N=0.06 eff=0.86 Rlf=0.5 Ctot=100p
*					In Fb Gnd Out
.PARAM DEL={3.14159*SQRT({Lp}*{Ctot})}
*
EBToff toff 0 Value={{Lp}*V(Ip)*{N}/(V(3)+1u)}
Rs 1 12 {Rlf}
X2 13 12 0 4 XFMR params: RATIO={N}
Lm 13 12 {Lp}
Et 7 Gnd Value = { (2*{Lp}/(V(ton)+10n)) * ( ({N}*V(13)+V(3))/(V(3)+1u) + {DEL}/(V(ton)+10n) +
+({Lp}*{Ctot}/(V(ton)+10n))*(1+(V(3)/{N})/V(13))  ) * I(V6) }
Gd 4 3 TABLE { ((2*{Lp}/(V(ton)+10n)) * ( ({N}*V(13)+V(3))/(V(3)+1u) + {DEL}/(V(ton)+10n) +
+({Lp}*{Ctot}/(V(ton)+10n))*(1+(V(3)/{N})/V(13))  ) * I(V6)^2)/(V(3,4)+1u)*{EFF}  } ( (10m,10m) (1000,1000) )
VI1 1 7
EBton ton 0 Value = { V(errint)*{Lp}/({Rs}*V(13)) }
EBIp Ip 0 Value = { V(ton)*V(13)/{Lp} }
EBfreq Fsw 0 Value = { (1/(V(ton)+V(toff)+{DEL}+({Lp}*{Ctot}/V(ton))*(1+(V(3)/{N})/V(13))))/1000 }
EB8 errint 0 Value = { IF ( V(FB)/3 > 1, 1, IF ( V(FB)/3 < 10m, 10m, V(FB)/3 )) }
R9 FB 0 1Meg
GBclamp 0 20 Value = { MAX(I(VI1),0)}
V6 20 100
Rdumpos 100 0 10
.ENDS
***********
.SUBCKT XFMR 1 2 3 4 PARAMS: RATIO=1
RP 1 2 1MEG
E 5 4 VALUE = { V(1,2)*RATIO }
G 1 2 VALUE = { I(VM)*RATIO }
RS 6 3 1U
VM 5 6
.ENDS XFMR
