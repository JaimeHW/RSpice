.subckt XFMRLp pin1 pin2 pin3 pin4 params: LPRIM=400u Tratio=0.1
R_R1         pin3 $N_0001  1u
R_Rp         pin1 pin2  1MEG
V_VM         $N_0002 $N_0001 0V
L_L         pin1 pin2  {LPRIM}
G_G1         pin1 pin2 VALUE {Tratio*I(V_VM) }
E_E1         $N_0002 pin4 VALUE { V(pin1, pin2)*Tratio }
.ends
*
* Created by CBasso
* Revision History: BMatush July, 2008, ON Semiconductor Chandler Design Center
* Revision Date: June 2009 Revision 1
* Revision Author: Skyler Covington
* Revision Description: Changed VTHRESH to (VHIGH+VLOW)/2 to correct hysteresis
* Desc: Comparator with Hysteresis set by Hys Pin.
**
*
.SUBCKT COMPHYST_BHAVE NINV INV OUT HYS params: VHIGH = 5V VLOW = 100m
R_R5         0    HYS  100meg TC=0,0
E_E1         HYS1 NINV VALUE { IF(V(OUT)> {(VHIGH+VLOW)/2},V(HYS),0) }
E_E2         4    0    VALUE { IF(V(HYS1,INV) > 0, {VHIGH}, {VLOW} ) }
R_R7         0    HYS1 100meg TC=0,0
R_R6         0    INV  100meg TC=0,0
R_R4         4    OUT  10 TC=0,0
C_C1         0    OUT  100p  TC=0,0
.ENDS COMPHYST_BHAVE
*
* Created by BMatush
* July, 2008, ON Semiconductor Chandler Design Center
* Revision History:
* Desc: Operational Transconductance Amplifier with parameters
* setting supply pins, Itail sets Imax for the output, Gota sets gm. VOS sets a voltage offset
* LAMBDA and VSAT are used to find MOSFET current and areas of operation respectfully.
*
.SUBCKT OTA1_BHAVE Y INM INP
*               	  inv ninv Vout
+PARAMS: ITAIL=10u GM=100u VOS=0 VEOS=0.1 VSAT=0.1 VDD=1 VSS=-5 LAMBDA = 0.01
*
*
*I2 	S    0    {ITAIL}
*R1 	INm  0    100G
*D1 	S    INm  DMOD1
*R2 	INp  0    100G
*D  	S    INp  DMOD1
*R3 	INm  INp  100G
*
*input stage
************************
Gin 0 Y Value = {V(INP,INM)*GM}
************************
*Gin 0 2 Value = {IF((V(INP,INM)+VOS)>VSAT,
*+				ITAIL,
*		    else
*+				IF(V(INP,INM)+VOS<-VSAT,
*+					-ITAIL,
*				else
*+					(V(INP,INM)*GM))}
*Vref 2 3 0
*R5 3 0 10
*
**** use this to test input stage, comment out rest of code
**Gout 0 Y Value = {I(Vref)}
*
**pull down current
*R6  5 Y 10
*Gpd 0 5 Value = {IF(I(Vref)>0,
*+				0,
*			 else
*+				IF(V(Y)-VSS>VEOS,
*+					I(Vref)*(1+LAMBDA*(V(Y)-VSS)),
*				else
*+					IF(V(Y)-VSS>0,
*+						I(Vref)*(V(Y)-VSS)/VEOS*(1+(LAMBDA*V(Y)-VSS)),
*					else
*+						-0.01*(V(Y)-VSS)*(1+LAMBDA*(V(Y)-VSS)))))}
*
**pull up current
*R7  Y 6 10
*Gpu 0 6 Value = { IF(I(Vref)<0,
*+				0,
*			 else
*+				IF(VDD-V(Y)>VEOS,
*+					I(Vref)*(1+LAMBDA*(VDD-V(Y))),
*				else
*+					IF(VDD-V(Y)>0,
*+						I(Vref)*(VDD-V(Y))/VEOS*(1+LAMBDA*(VDD-V(Y))),
*					else
*+						-0.01*(VDD-V(Y))*(1+LAMBDA*(VDD-V(Y))))))}
*
*.MODEL DMOD1 D
.ENDS OTA1_BHAVE
*
* Created by BMatush
* July, 2008, ON Semiconductor Chandler Design Center
* Revision History:
* Desc: 2 Input NOR Gate (A nor B = Y)
**
*
.SUBCKT NOR2_BHAVE A B Y
+params: VTHRESH = 2.5 VHIGH = 5V VLOW = 100mV INITIAL = 0V
E1 4 0 Value = { IF ( (V(A)>{VTHRESH}) | (V(B)>{VTHRESH}), {VLOW}, {VHIGH} ) }
RD 4 Y 10
CD Y 0 10P IC = {INITIAL}
.ENDS NOR2_BHAVE
*
* Created by BMatush
* July, 2008, ON Semiconductor Chandler Design Center
* Revision History:
* Desc: 3 Input OR Gate (A or B or C = Y)
**
*
.SUBCKT OR3_BHAVE A B C Y
+params: VTHRESH = 2.5 VHIGH = 5V VLOW = 100mV INITIAL = 0V
E1 4 0 Value = { IF ( (V(A)>{VTHRESH}) | (V(B)>{VTHRESH}) | (V(C)>{VTHRESH}), {VHIGH}, {VLOW} ) }
RD 4 Y 10
CD Y 0 10P IC = {INITIAL}
.ENDS OR3_BHAVE
*
* Created by BMatush
* July, 2008, ON Semiconductor Chandler Design Center
* Revision History:
* Desc: 2 Input OR Gate (A or B = Y)
**
*
.SUBCKT OR2_BHAVE A B Y
+params: VTHRESH = 2.5 VHIGH = 5V VLOW = 100mV INITIAL = 0V
E1 4 0 Value = { IF ( (V(A)>{VTHRESH}) | (V(B)>{VTHRESH}), {VHIGH}, {VLOW}) }
RD 4 Y 10
CD Y 0 10P IC = {INITIAL}
.ENDS OR2_BHAVE
*
* Created by BMatush
* July, 2008, ON Semiconductor Chandler Design Center
* Revision History:
* Desc: 2 Input NAND Gate (A nand B = Y)
**
*
.SUBCKT NAND2_BHAVE A B Y
+params: VTHRESH = 2.5 VHIGH = 5V VLOW = 100mV INITIAL = 0V
E1 4 0 Value = { IF ( (V(A)>VTHRESH) & (V(B)>VTHRESH), {VLOW}, {VHIGH} ) }
RD 4 Y 10
CD Y 0 10P IC = {INITIAL}
.ENDS NAND2_BHAVE
*
*ZENER_BHAVE
*Created by BMatush
* October, 2008, ON Semiconductor Chandler Design Center
* Revision History:
* Desc: Generic zener diode with threshold voltage VT and breakdown voltage VZ
* where BREAK will limit V(C,A) to VZ.
.subckt ZENER_BHAVE A C params: VT = -0.7 VZ = 5.5
*
R_Rref		0    Ref  1k TC=0,0
E_E1			Ref  0    VALUE { {If(V(A,C)>{VT}, V(A,C)-{VT},10p)} }
E_Ebreak		Ref1 0    Value { (if(V(C,A)>{VZ}, V(C,A)-{VZ},10p)) }
R_Rleak		C    A1   1G TC=0,0
R_R2			A    A1   1 TC=0,0
G_G1			A1   C    ref  0 100
G_G2			C    A    ref1 0 1000
*
.ends ZENER_BHAVE
*
* Created by BMatush
* July, 2008, ON Semiconductor Chandler Design Center
* Revision History:
* Desc: Inverter Gate (Y = not A)
**
*
.SUBCKT INV_BHAVE A Y
+params: VTHRESH = 2.5 VHIGH = 5V VLOW = 100mV INITIAL = 0V
E1 3 0 VALUE = { IF ( V(A) > {VThresh}, {VLow}, {VHigh} ) }
R1 3 Y 10
C1 Y 0 10P IC = {INITIAL}
.ENDS INV_BHAVE
*
* Created by BMatush
* July, 2008, ON Semiconductor Chandler Design Center
* Revision History:
* Desc: 2 Input AND Gate (A and B = C)
*
.SUBCKT AND2_BHAVE A B Y
+params: VTHRESH = 2.5 VHIGH = 5V VLOW = 100mV INITIAL = 0V
E1 4 0 Value= { IF ( (V(A)>VTHRESH) & (V(B)>VTHRESH), VHIGH, VLOW ) }
RD 4 Y 10
CD Y 0 10P IC = {INITIAL}
.ENDS AND2_BHAVE
*
* Created by BMatush
* July, 2008, ON Semiconductor Chandler Design Center
* Revision History:
* Desc: Generic, ideal diode
*
.subckt DIODE_BHAVE A C params: VT = 0.7
*
R_Rref           0   Ref  1k TC=0,0
R_Rleak          C   A1   1G TC=0,0
R_R2             A   A1   1 TC=0,0
G_G1             A1   C    ref 0 100
E_E1             Ref 0    VALUE { {If(V(A,C)>{VT}, V(A,C)-{VT},10p)} }
.ends DIODE_BHAVE
*
* Created by Skyler Covington
* Contact: Skyler.Covington@onsemi.com
* June, 2009, ON Semiconductor Chandler Design Center
* Revision History: REV 1.1
* Desc: Critical Conduction Mode Power Factor Correction Controller Utilizing a
* Transconductance Error Amplifier
