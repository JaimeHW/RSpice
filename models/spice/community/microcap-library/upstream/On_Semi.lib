DN 4 5 DN
.MODEL DN D(IS=1E-12 N=.14319)
VP 2 6 {PLIM-.0597}
DP 6 4 DN
.ENDS
*
.subckt oscillator out rampo params: dc=0.01 fsw=180k valley=1 swing=4
*
.PARAM I1=100u
.PARAM I2={ (I1*{DC})/(1-{DC}) }
.PARAM TSW={1/FSW}
.PARAM Ct={ (TSW/SWING)*((I1*I2)/(I1+I2)) }
*
EBbuff rampo 0 Value = { V(ramp) }
Rdum1 ramp 0 10Meg
Ct ramp 0 {Ct}
GB3 0 ramp Value = { IF ( V(CMP) < 3.5, {I1}, 0 ) }
X1 cmp OUT INV
X4 ramp 4 cmp COMPAR params: VHIGH=5
EB1 4 0 Value = { IF ( V(CMP) > 3V, {valley}, {valley+swing} ) }
GB2 ramp 0 Value = { IF ( V(CMP) > 3.5, {I2}, 0 ) }
.ENDS
*
.SUBCKT fflopcb 6 8 2 1
*               S R Q Q\
EBQB 10 0 Value = { IF ( (V(8) < 800M) & (V(2) > 800M), 0, 5 ) }; one input inverted
; two input NAND
EBQ 20 0 Value = { IF ( (V(6) < 800M) & (V(1) > 800M), 0, 5 ) }
RD1 10 1 100
CD1 1 0 10p IC=5
RD2 20 2 100
CD2 2 0 10p IC=0
.ends
