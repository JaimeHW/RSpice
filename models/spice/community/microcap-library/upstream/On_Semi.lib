***********
* ------------------------------------------------------------ *
*
* ON Semiconductor
* NCP1215 model developed by Christophe BASSO, Toulouse (FRANCE)
* e-mail: christophe.basso@onsemi.com
* OrCAD's PSpice compatible
*
* Last modified: December 16th 2002
*
*
* ------------------------------------------------------------ *
*
.SUBCKT NCP1215 FB CT CS GND DRV VCC
*
RdumGG Gnd 0 100Meg
R2 FB 1 17k
DVT 2 1 _D1_mod
VVT 2 Gnd
GB2 Vdd 7 Value = { IF ( I(VVT)*1.15 > 250u, 250u, I(VVT)*1.15 ) }
R3 7 Gnd 45k
X3 Ct 8 9 COMPAR
Voffset 8 7 DC=500m
X9 UVLO 11 12 NAND2
Istartup Vcc Gnd DC=10uA
GB1 Vcc Gnd Value = { IF ( V(UVLO) > 3, 800u, 0 ) }
GB3 Vcc Gnd Value = { IF ( I(Vdrv) > 0, I(Vdrv), 0 ) }
SdrvOFF 13 Gnd 12 0 SN
SdrvON Vcc 13 12 0 SP
Vdrv 13 Drv
GB4 Vdd Ct Value = { IF ( V(UVLO) > 3, 10uA, 0 ) }
Q1 Ct 14 Gnd QN2222
R13 14 11 10k
D8 7 Vdd DN4148
D9 Ct Vdd DN4148
GB5 Vdd CS Value = { IF ( V(UVLO) > 3 & (37.5u-I(VVT)*1.33)>0, (37.5u-I(VVT)*1.33), 0 ) }
D6 Gnd CS _D6_mod
D10 CS Vdd DN4148
X5 Vcc UVLO Gnd UVLO_G params: VON=12 VOFF=8
X15 9 15 17 NAND2
XCompI CS Gnd 15 COMPARHYS
X6 17 19 11 NAND2
X7 11 15 19 NAND2
D11 Gnd Ct _D6_mod
D5 FB Vcc DN4148
GB7 Vdd CS Value = { IF ( V(UVLO) > 3, 12.5uA, 0 ) }
EB6 Vdd Gnd Value = { IF ( V(Vcc) > 6.5, 6.5, V(Vcc) ) }
** discrete models **
.model SN VSWITCH RON=40 VON=3 VOFF=1
.model SP VSWITCH RON=80 VON=1 VOFF=3
.MODEL QN2222 NPN BF=105 BR=4 CJC=12.2P CJE=35.5P IKF=.5
+ IKR=.225 IS=15.2F ISE=8.2P NE=2 NF=1 NR=1 RB=1.49 RC=.149
+ RE=.373 TF=500P TR=85N VAF=98.5 VAR=20 XTB=1.5
.MODEL _D1_mod D BV=1.2 RS=10m
.MODEL _D6_mod D BV=10 CJO=15p
.MODEL DN4148 D BV=100V CJO=4PF IS=7E-09 M=.45 N=2 RS=.8
+ TT=6E-09 VJ=.6V
**
.ENDS
**** Model Subckts ****
.SUBCKT COMPAR NINV INV OUT params: VHIGH=12 VLOW=100m
EB1 4 0 Value = { IF ( V(NINV,INV) > 0, {VHIGH}, {VLOW} ) }
RO 4 OUT 100
CO OUT 0 10PF
.ENDS
***
.SUBCKT NAND2 1 2 3
EB1 4 0 Value = { IF ( (V(1)>800M) & (V(2)>800M), 100m, 5V ) }
RD 4 3 100
CD 3 0 10P
.ENDS NAND2
***
.SUBCKT UVLO_G  1   2  30 params: VON=12 VOFF=10
*              VIN OUT Gnd
X1 1 3 1 30 SWhyste params: RON=1 ROFF=1MEG VT={((VON-VOFF)/2) + VOFF} VH={(VON-VOFF)/2}
RUV 3 30 100K
EB1 4 0 Value = { IF ( V(3,30) > 5V, 5V, 0 ) }
RD 4 2 100
CD 2 0 100P
; VON = VT+VH = 15.0 VOFF = VT-VH = 7.6V
.ENDS UVLO_G
***
.SUBCKT SWhyste NodeMinus NodePlus Plus Minus PARAMS: RON=1 ROFF=1MEG VT=5 VH=2
S5 NodePlus NodeMinus 8 0 smoothSW
EBcrtl 8 0 Value = { IF ( V(plus)-V(minus) > V(ref), 1, 0 ) }
EBref ref1 0 Value = { IF ( V(8) > 0.5, {VT-VH}, {VT+VH} ) }
Rdel ref1 ref 100
Cdel ref 0 100p  IC={VT+VH}
Rconv1 8 0 10Meg
Rconv2 plus 0 10Meg
Rconv3 minus 0 10Meg
.model smoothSW VSWITCH (RON={RON} ROFF={ROFF} VON=1 VOFF=0)
.ends SWhyste
***
XCompI CS Gnd 15 COMPARHYS
.SUBCKT COMPARHYS NINV INV OUT params: VHIGH=12 VLOW=100m VHYS=50m
EB2 HYS NINV Value = { IF ( V(OUT) > {(VHIGH+VLOW)/2}, {VHYS}, 0 ) }
EB1 4 0 Value = { IF ( V(HYS,INV) > 0, {VHIGH}, {VLOW} ) }
RO 4 OUT 100
CO OUT 0 450PF ; 130ns prop delay
.ENDS
*** Application models ***
.SUBCKT MOC8101 1 2 3   5
* ISOLATOR      A C COL EMITTER
RB 4 0 100Meg
VM 1 6
D1 6 2 LED
H1 7 0 VM .0055
R1 7 8 1K
C1 8 0 3.35nF
G1 3 4 8 0 1
Q1 3 4 5 MPSA06
.MODEL LED D(N=1.7 RS=.7 CJO=23.9P IS=85.3p BV=6 IBV=10U
+ VJ=0.75 M=0.333 TT=4.32U)
.MODEL MPSA06 NPN (IS=15.2F NF=1 BF=589 VAF=98.6 IKF=90M ISE=3.34P NE=2
+ BR=4 NR=1 VAR=16 IKR=0.135 RE=0.343 RB=1.37 RC=0.137 XTB=1.5
+ CJE=9.67P VJE=1.1 MJE=0.5 CJC=7.34P VJC=0.3 MJC=0.3 TF=10.29n TR=276N)
.ENDS MOC8101
*
**** MULTI-WINDING TRANSFORMER ****
.SUBCKT XFMR2 1 2 3 4 10 11 PARAMS: RATIO1=1 RATIO2=1
RP 1 2 1MEG
E1 5 4 VALUE = { V(1,2)*RATIO1 }
G1 1 2 VALUE = { I(VM1)*RATIO1 }
RS1 6 3 1U
VM1 5 6
E2 20 11 VALUE = { V(2,1)*RATIO2 }
G2 2 1 VALUE = { I(VM2)*RATIO2 }
RS2 21 10 1U
VM2 20 21
.ENDS XFMR2
*
**** SINGLE WINDING TRANSFORMER ****
.SUBCKT XFMR1 1 2 3 4 PARAMS: RATIO=1
RP 1 2 1MEG
E 5 4 VALUE = { V(1,2)*RATIO }
G 1 2 VALUE = { I(VM)*RATIO }
RS 6 3 1U
VM 5 6
.ENDS XFMR1
