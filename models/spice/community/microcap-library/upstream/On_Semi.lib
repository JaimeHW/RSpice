*** From file ncp1351.lib
* ------------------------------------------------------------ *
*
* ON Semiconductor
* Ispice Cycle by cycle model of NCP1351, B version
* Made by Stephanie Conseil.
* November 20 2006
*
* ------------------------------------------------------------ *
*
*SRC=ncp1351_B;ncp1351_B;ON Semiconductor;PWM Controllers;Fixed Ton - variable Fsw
*SYM=dip8
.SUBCKT ncp1351_B Fb Ct CS GND DRV Vcc Latch Timer
***
.SUBCKT COMPARHYS NINV INV OUT params: VHIGH=5 VLOW=100m VHYS=50m
B2 HYS NINV V = V(OUT) > {(VHIGH+VLOW)/2} ? {VHYS} : 0
B1 4 0 V = V(HYS,INV) > 0  ?  {VHIGH}  :  {VLOW}
RO 4 OUT 10
CO OUT 0 10PF
.ENDS
***
.SUBCKT PSW1 1 2 3   4 params: RON=1 ROFF=1MEG VON=1 VOFF=0
*Connections + - NC+ NC-
*Parameters: Ron On Resistance in Ohms, Roff Off Resistance in Ohms
* VON On Current in Amps, VOFF Off Current in Amps
* VON > Voff Case
* IF V(3,4) > VON THEN RSwitch=RON, IF V(3,4) < VOFF THEN RSwitch=ROFF, ELSE
* RSwitch will smoothly transistion between the on and off states
B1 1 2 I=V(3,4) < {VOFF} ? V(1,2)/{ROFF} : V(3,4) > {VON} ?
+ V(1,2)/{RON} : V(1,2)/ (EXP(LN({(RON*ROFF)^.5}) +
+ 3 * LN({RON/ROFF}) * (V(3,4) - {(VON+VOFF)/2}) / ({2* (VON-VOFF)}) -
+ 2 * LN({RON/ROFF}) * (V(3,4) - {(VON+VOFF)/2})^3 / {(VON-VOFF)^3} ))
.ENDS
***
.SUBCKT PSW2 1 2 3   4 params: RON=1 ROFF=1MEG VON=0 VOFF=1
*Connections + - NC+ NC-
*Parameters: Ron On Resistance in Ohms, Roff Off Resistance in Ohms
* VON On Current in Amps, VOFF Off Current in Amps
* VON < Voff Case
* IF V(3,4) > VON THEN RSwitch=RON, IF V(3,4) < VOFF THEN RSwitch=ROFF, ELSE
* RSwitch will smoothly transistion between the on and off states
B1 1 2 I=V(3,4) < {VON} ? V(1,2)/{RON} : V(3,4) > {VOFF} ?
+ V(1,2)/{ROFF} : V(1,2)/ (EXP(LN({(RON*ROFF)^.5}) - (3 * LN({RON/ROFF}) *
+ (V(3,4) - {(VON+VOFF)/2}) / {2* (VOFF-VON)}) +
+ (2 * LN({RON/ROFF}) * (V(3,4) - {(VON+VOFF)/2})^3 / {(VOFF-VON)^3} )))
.ENDS
***
.SUBCKT LATCH 6 8 2 1
*             S R Q Qb
BQB   10 0 V=(V(8)<2.5) & (V(2)>2.5) ? 100m : 5
BQ    20 0 V=(V(6)<2.5) & (V(1)>2.5) ? 100m : 5
RD1   10 1 100
CD1   1 0 10p IC=5
RD2   20 2 100
CD2   2 0 10p IC=100m
.ENDS LATCH
***
.SUBCKT COMPAR NINV INV OUT params: VHIGH=5 VLOW=100m
B1 4 0 V = V(NINV,INV) > 0  ?  {VHIGH}  :  {VLOW}
RO 4 OUT 10
CO OUT 0 10PF
.ENDS
***
.SUBCKT NPNV 1 2 3 params: le=10.5 we=10.5
Q1 1 2 3 NPNV
.model NPNV NPN
+ cje={9.73062e-16*(le*we)+1.27371e-15*2*(le+we)}
