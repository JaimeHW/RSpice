***
.SUBCKT UVLO_G  1   2  30 params: VON=12 VOFF=10
*              VIN OUT Gnd
S1 1 3 1 30 SUVLO
RUV 3 30 100K
B1 4 0 V= V(3,30) > 5V ? 5V : 0
RD 4 2 100
CD 2 0 100P
.MODEL SUVLO SW RON=1 ROFF=1E6 VT={((VON-VOFF)/2) + VOFF} VH={(VON-VOFF)/2}
; VON = VT+VH = 15.0 VOFF = VT-VH = 7.6V
.ENDS UVLO_G
***
.SUBCKT INV 1 2
B1 4 0 V= V(1)>2.5 ? 0 : 5V
RD 4 2 100
CD 2 0 10P
.ENDS INV
***
.SUBCKT OR3 1 2 3 5
B1 4 0 V= (V(1)>2.5) | (V(2)>2.5) | (V(3)>2.5) ? 5V : 100m
RD 4 5 100
CD 5 0 10P
.ENDS OR3
***
.SUBCKT AND3 1 2 3 5
B1 4 0 V= (V(1)>2.5) & (V(2)>2.5) & (V(3)>2.5) ? 5V : 100m
RD 4 5 100
CD 5 0 10P
.ENDS AND3
***
.SUBCKT OR2 1 2 3
B1 4 0 V= (V(1)>2.5) | (V(2)>2.5) ? 5V : 100m
RD 4 3 100
CD 3 0 10P
.ENDS OR2
***
.SUBCKT AND2 1 2 3
B1 4 0 V= (V(1)>2.5) & (V(2)>2.5) ? 5V : 100m
RD 4 3 100
CD 3 0 10P
.ENDS AND2
***
B13 Vdd Ct I=V(UVLO,GND) > 3 ? 10u : 0
V1 37 VccDrv DC=0
X2 18 22 3 COMPARHYS
X1 Ct Fbint set COMPARHYS params: VHYS=1m
B9 37 GND V=V(Vcc,GND) < 20 ? V(Vcc, GND) : 20
X4 VccDrv DRV inDrv GND PSW1 params: RON=24 ROFF=10MEG
X12 DRV GND inDrv GND PSW2 params: RON=12 ROFF=10MEG
X8 set reset Q Qb LATCH
X3 21 5 4 COMPAR params: VHIGH=5
V2 22 GND DC=2.5
B2 GND 7 I=I(Vf) < 42u ? 0.4u : I(Vf)-41.1u
R2 7 GND 45K
Voffset Fbint 7 DC=0.5
Vf Fb 2 DC=0
D3 7 8 DN4148
V10 21 GND DC=40m
X5 2 2 GND NPNV
Vcl_Fb 8 GND DC=5
B3 Vdd 16 I=I(Vf) < 80u ? 790u-9*I(Vf) : 70u
R1 18 GND 1k
C6 18 Q 1n
R7 CS 5 1k
V8 16 GND DC=0
B4 Vdd CS I=I(Vf) > 60u ? I(V8) : 250u
B8 Vdd Timer I=V(UVLO,GND) > 3 ? 50u : 0
B1 Vcc GND I=V(UVLO,GND) > 3 ? 600u+I(V1) : 10u
C4 5 GND 10p
X10 Vcc UVLO GND UVLO_G params: VON=16 VOFF=8
R9 Qb GND 100k
X14 UVLO UVLOb INV
X7 Ct GND 3 GND PSW1 params: ROFF=100Meg VON=5 VOFF=2
X15 Timer GND 35 GND PSW1 params: VON=4
X16 Qtimer UVLOb fault 35 OR3
B5 fault GND V=I(Vf) < 40u ? 0 : 5
X17 Timer 17 38 COMPAR
B6 17 GND V=V(UVLO,GND) > 3 ? 5 : 0
R6 38 SetTimer 10k
C8 SetTimer GND 2n
X18 SetTimer UVLOb Qtimer Qbtimer LATCH
B7 Vdd GND V=V(UVLO,GND) > 3 ? 6 : 0
D5 Timer Vdd DN4148
X20 Qbtimer Q UVLO inDrv AND3
B11 49 GND V=V(UVLO,GND) > 3 ? 5 : 1
R13 SetLatch 47 10k
C10 SetLatch GND 2n
X21 SetLatch 23 Qlatch 53 LATCH
B10 23 GND V=V(Vcc,GND) < 4 ? 5 : 0
X24 4 Qlatch reset OR2
X22 19 GND SCRon GND PSW1 params: ROFF=10MEG VON=4
X23 Qlatch 20 SCRon OR2
R5 53 GND 100k
X25 UVLO Qtimer 20 AND2
D8 19 Vcc _D8_mod
D9 Ct Vdd DN4148
X26 Latch 49 47 COMPARHYS params: VHYS=10m
** discrete models
.MODEL DN4148 D BV=100V CJO=4PF IS=7E-09 M=.45 N=2 RS=.8
+ TT=6E-09 VJ=.6V
.MODEL _D8_mod D BV=6.116 CJO=134P IBV=500u IS=19F M=.333
+ N=1 RS=11.5 TT=2.88U VJ=.75
.ENDS
