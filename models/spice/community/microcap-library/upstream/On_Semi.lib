.MODEL MM NMOS LEVEL=1 IS=1e-32
+VTO=2.83138 LAMBDA=1.40978 KP=674.414
+CGSO=3.98332e-05 CGDO=5.39564e-07
RS 8 3 0.0102589
D1 3 1 MD
.MODEL MD D IS=4.89094e-08 RS=0.00211185 N=1.5 BV=99
+IBV=0.00025 EG=1.2 XTI=3.0136 TT=0
+CJO=1.84663e-09 VJ=0.969692 M=0.9 FC=0.5
RDS 3 1 2.9e+09
RD 9 1 0.00157641
RG 2 7 0.25
D2 4 5 MD1
* Default values used in MD1:
*   RS=0 EG=1.11 XTI=3.0 TT=0
*   BV=infinite IBV=1mA
.MODEL MD1 D IS=1e-32 N=50
+CJO=1.42866e-09 VJ=0.5 M=0.595834 FC=1e-08
D3 0 5 MD2
* Default values used in MD2:
*   EG=1.11 XTI=3.0 TT=0 CJO=0
*   BV=infinite IBV=1mA
.MODEL MD2 D IS=1e-10 N=0.4 RS=3.00703e-06
RL 5 10 1
FI2 7 9 VFI2 -1
VFI2 4 0 0
EV16 10 0 9 7 1
CAP 11 10 2.77313e-09
FI1 7 9 VFI1 -1
VFI1 11 6 0
RCAP 6 10 1
D4 0 6 MD3
* Default values used in MD3:
*   EG=1.11 XTI=3.0 TT=0 CJO=0
