    parameter real voffcv = -12345789;          // C-V lateral-shift parameter [V]
    parameter real dmcg = -12345789;            // Distance of Mid-Contact to Gate edge [m]
    parameter real dmci = -12345789;            // Distance of Mid-Contact to Isolation [m]
    parameter real dmdg = -12345789;            // Distance of Mid-Diffusion to Gate edge [m]
    parameter real dmcgt = -12345789;           // Dist of Mid-Contact to Gate edge in Test [m]
    parameter real xgw = -12345789;             // Dist from gate contact center to dev edge [m]
    parameter real xgl = -12345789;             // Variation in Ldrawn [m]
    parameter real rshg = -12345789;            // Gate sheet resistance [Ohm]
    parameter real ngcon = -12345789;           // Number of gate contacts
    parameter real xrcrg1 = -12345789;          // 1st fitting parm the bias-dependent Rg
    parameter real xrcrg2 = -12345789;          // 2nd fitting parm the bias-dependent Rg
    parameter real lint = -12345789;            // Length reduction parameter [m]
    parameter real ll = -12345789;              // Length reduction parameter [m]
    parameter real llc = -12345789;             // Length reduction parameter for CV [m]
    parameter real lln = -12345789;             // Length reduction parameter [m]
    parameter real lw = -12345789;              // Length reduction parameter [m]
    parameter real lwc = -12345789;             // Length reduction parameter for CV [m]
    parameter real lwn = -12345789;             // Length reduction parameter [m]
    parameter real lwl = -12345789;             // Length reduction parameter [m]
    parameter real lwlc = -12345789;            // Length reduction parameter for CV [m]
    parameter real lmin = -12345789;            // Minimum length for the model [m]
    parameter real lmax = -12345789;            // Maximum length for the model [m]
    parameter real wr = -12345789;              // Width dependence of rds
    parameter real wint = -12345789;            // Width reduction parameter [m]
    parameter real dwg = -12345789;             // Width reduction parameter
    parameter real dwb = -12345789;             // Width reduction parameter
    parameter real wl = -12345789;              // Width reduction parameter [m]
    parameter real wlc = -12345789;             // Width reduction parameter for CV [m]
    parameter real wln = -12345789;             // Width reduction parameter [m]
    parameter real ww = -12345789;              // Width reduction parameter [m]
    parameter real wwc = -12345789;             // Width reduction parameter for CV [m]
    parameter real wwn = -12345789;             // Width reduction parameter [m]
    parameter real wwl = -12345789;             // Width reduction parameter [m]
    parameter real wwlc = -12345789;            // Width reduction parameter for CV [m]
