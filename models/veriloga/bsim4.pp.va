 * Author:  Weidong Liu
 * Authors: Xuemei Xi, Kanyu M. Cao, Hui Wan, Mansun Chan, Chenming Hu.
 * Project Director: Prof. Chenming Hu.
 **********/
//Indicate Xyce is the simulator used here, comment it out if runs with other simulator

// Standard Verilog-AMS Disciplines
// Based on IEEE Std 1800-2017 and Verilog-A LRM 2.4





// Nature declarations for electrical discipline
nature Current;
    units = "A";
    access = I;
    idt_nature = Charge;
    abstol = 1e-12;
endnature

nature Charge;
    units = "coul";
    access = Q;
    ddt_nature = Current;
    abstol = 1e-14;
endnature

nature Voltage;
    units = "V";
    access = V;
    abstol = 1e-6;
endnature

nature Flux;
    units = "Wb";
    access = Phi;
endnature

// Electrical discipline (most common)
discipline electrical;
    potential Voltage;
    flow Current;
enddiscipline

discipline voltage;
    potential Voltage;
enddiscipline

discipline current;
    flow Current;
enddiscipline

// Magnetic discipline
discipline magnetic;
    potential Flux;
    flow Current;
enddiscipline

// Thermal disciplines
nature Temperature;
    units = "K";
    access = Temp;
    abstol = 1e-4;
endnature

nature Power;
    units = "W";
    access = Pwr;
    abstol = 1e-9;
endnature

discipline thermal;
    potential Temperature;
    flow Power;
enddiscipline

// Rotational mechanical disciplines
nature Angle;
    units = "rad";
    access = Theta;
endnature

nature Angular_Velocity;
    units = "rad/s";
    access = Omega;
endnature

nature Angular_Force;
    units = "N*m";
    access = Tau;
endnature

discipline rotational;
    potential Angle;
    flow Angular_Force;
enddiscipline

discipline rotational_omega;
    potential Angular_Velocity;
    flow Angular_Force;
enddiscipline

// Kinematic disciplines
nature Position;
    units = "m";
    access = x;
endnature

nature Velocity;
    units = "m/s";
    access = v;
endnature

nature Force;
    units = "N";
    access = F;
endnature

nature Acceleration;
    units = "m/s^2";
    access = a;
endnature

discipline kinematic;
    potential Position;
    flow Force;
enddiscipline

discipline kinematic_v;
    potential Velocity;
    flow Force;
enddiscipline



// Standard Verilog-AMS Physical Constants
// Based on IEEE Std 1800-2017 and NIST CODATA 2018 values





// Mathematical constants















// Physical constants (CODATA 2018)
// Elementary charge (C)

// Speed of light (m/s)

// Boltzmann constant (J/K)

// Planck constant (J*s)

// Vacuum permittivity (F/m)

// Vacuum permeability (H/m)

// Celsius to Kelvin offset



// Semiconductor constants
// Avogadro's number (1/mol)

// Si bandgap at 300K (eV)

// Si intrinsic carrier conc at 300K (1/cm^3)


