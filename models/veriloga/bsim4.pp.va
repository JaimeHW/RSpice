/*
 * The macros to calculate the subroutines to process the geometry dependent
 * parasitics for BSIM4, which calculates Ps, Pd, As, Ad, and Rs and  Rd
 * for multi-fingers and varous GEO and RGEO options.
 */
















































































































/* function to compute poly depletion effect */





















































































































































































































































module bsim4va(d, g, s, b);

    analog function real BSIM4DioIjthVjmEval;

        input Nvtm, Ijth, Isb, XExpBV;
        real  Nvtm, Ijth, Isb, XExpBV;
        real  Tb, Tc, EVjmovNv;
       
        begin
           Tc = XExpBV;
           Tb = 1.0 + Ijth / Isb - Tc;
           EVjmovNv = 0.5 * (Tb + sqrt(Tb * Tb + 4.0 * Tc));
           BSIM4DioIjthVjmEval = Nvtm * ln(EVjmovNv);
        end 
    endfunction 
   

    //
    //   Node definitions
    //
    inout      d, g, s, b;
    electrical d, g, s, b,di, si,gi, gm,bi,sbulk,dbulk;

    // The parameter "type" should be set for N/P-MOSFET 
    // based on modelcard type (but can be overridden by netlist).
    parameter integer verbose = -9999999;  // debug flag to print DBG msg 
    parameter integer type = -9999999;     // NMOS=1 PMOS=-1
    parameter real l = -12345789;               // Length
    parameter real w = -12345789;               // Width
    parameter integer nf = -9999999;       // Number of fingers
    parameter integer _min = -9999999;     // Minimize either D or S
    parameter real ad = -12345789;              // Drain area
    parameter real as = -12345789;              // Source area
    parameter real pd = -12345789;              // Drain perimeter
    parameter real ps = -12345789;              // Source perimeter
    parameter real nrd = -12345789;             // Number of squares in drain
    parameter real nrs = -12345789;             // Number of squares in source
    parameter integer off = -9999999;      // Device is initially off
    parameter integer trnqsmod = -9999999; // Transient NQS model selector
    parameter integer acnqsmod = -9999999; // AC NQS model selector
    parameter integer rbodymod = -9999999; // Distributed body R model
    parameter integer rgatemod = -9999999; // Gate resistance model selector
    parameter integer geomod = -9999999;   // Geo dependent parasitics model
    parameter integer rgeomod = -9999999;  // S/D res and contact model
    parameter integer capmod = -9999999;   // Capacitance model selector
    parameter integer diomod = -9999999;   // Diode IV model selector
    parameter integer rdsmod = -9999999;   // Bias-dep S/D resistance model
    parameter integer level = -9999999;    // Ignored, for Spice compatibility
    parameter integer mobmod = -9999999;   // Mobility model selector
    parameter integer tempmod = -9999999;  // Temperature model
    parameter integer permod = -9999999;   // Pd and Ps model selector
    parameter integer fnoimod = -9999999;  // Flicker noise model selector
    parameter integer tnoimod = -9999999;  // Thermal noise model selector
    parameter integer igcmod = -9999999;   // Gate-to-channel Ig model select
    parameter integer igbmod = -9999999;   // Gate-to-body Ig model selector
    parameter integer paramchk = -9999999; // Model parameter checking
    parameter integer binunit = -9999999;  // Bin unit selector
    parameter real version = -12345789;         // parameter for model version
    parameter real toxe = -12345789;            // Electrical gate oxide [m]
    parameter real toxp = -12345789;            // Physical gate oxide thickness [m]
    parameter real toxm = -12345789;            // tox at which parameters are extracted [m]
    parameter real toxref = -12345789;          // Target tox value [m]
    parameter real dtox = -12345789;            // Defined as (toxe - toxp) [m]
    parameter real epsrox = -12345789;          // Rel dielectric constant gate oxide
    parameter real cdsc = -12345789;            // Drain/Source and channel coupling cap [F]
    parameter real cdscb = -12345789;           // Body-bias dependence of cdsc [F]
    parameter real cdscd = -12345789;           // Drain-bias dependence of cdsc [F]
    parameter real cit = -12345789;             // Interface state capacitance [F]
    parameter real nfactor = -12345789;         // Subthreshold swing Coefficient
    parameter real xj = -12345789;              // Junction depth [m]
    parameter real vsat = -12345789;            // Saturation velocity at tnom
    parameter real at = -12345789;              // Temperature coefficient of vsat
    parameter real a0 = -12345789;              // Non-uniform depletion width effect coeff
    parameter real ags = -12345789;             // Gate bias coeff of Abulk.
    parameter real a1 = -12345789;              // Non-saturation effect coeff
    parameter real a2 = -12345789;              // Non-saturation effect coeff
    parameter real keta = -12345789;            // Body-bias coeff of non-u deplet width
    parameter real nsub = -12345789;            // Substrate doping concentration
    parameter real ndep = -12345789;            // Channel doping conc at the depl edge
    parameter real nsd = -12345789;             // S/D doping concentration
    parameter real phin = -12345789;            // Adjusting parameter for surface potential [V]
    parameter real ngate = -12345789;           // Poly-gate doping concentration
    parameter real gamma1 = -12345789;          // Vth body coeff
    parameter real gamma2 = -12345789;          // Vth body coeff
    parameter real vbx = -12345789;             // Vth transition body Voltage[V]
    parameter real vbm = -12345789;             // Maximum body voltage [V]
    parameter real xt = -12345789;              // Doping depth [m]
    parameter real k1 = -12345789;              // Bulk effect coeff 1
    parameter real kt1 = -12345789;             // Temperature coeff of Vth
    parameter real kt1l = -12345789;            // Temperature coeff of Vth
    parameter real kt2 = -12345789;             // Body-coeff of kt1
    parameter real k2 = -12345789;              // Bulk effect coeff 2
    parameter real k3 = -12345789;              // Narrow width effect coeff
    parameter real k3b = -12345789;             // Body effect coeff of k3
    parameter real w0 = -12345789;              // Narrow width effect parameter [m]
    parameter real dvtp0 = -12345789;           // 1st parm for Vth shift due to pocket [m]
    parameter real dvtp1 = -12345789;           // 2nd parm for Vth shift due to pocket
    parameter real lpe0 = -12345789;            // Eq. length of pocket region at zero bias [m]
    parameter real lpeb = -12345789;            // Eq. length accounting for body [m]
    parameter real dvt0 = -12345789;            // Short channel effect coeff. 0
    parameter real dvt1 = -12345789;            // Short channel effect coeff. 1
    parameter real dvt2 = -12345789;            // Short channel effect coeff. 2
    parameter real dvt0w = -12345789;           // Narrow Width coeff. 0
    parameter real dvt1w = -12345789;           // Narrow Width effect coeff. 1
    parameter real dvt2w = -12345789;           // Narrow Width effect coeff. 2
    parameter real drout = -12345789;           // DIBL coeff of output resistance
    parameter real dsub = -12345789;            // DIBL coeff in the subthreshold region
    parameter real vth0 = -12345789;            // Threshold voltage [m]
    parameter real ua = -12345789;              // Linear gate dependence of mobility
    parameter real ua1 = -12345789;             // Temperature coeff of ua
    parameter real ub = -12345789;              // Quadratic gate dependence of mobility
    parameter real ub1 = -12345789;             // Temperature coeff of ub
    parameter real uc = -12345789;              // Body-bias dependence of mobility
    parameter real uc1 = -12345789;             // Temperature coeff of uc
    parameter real u0 = -12345789;              // Low-field mobility at Tnom
    parameter real eu = -12345789;              // Mobility exponent
    parameter real ute = -12345789;             // Temperature coeff of mobility
    parameter real voff = -12345789;            // Threshold voltage offset [V]
    parameter real minv = -12345789;            // Fitting parm for moderate inv in Vgsteff
    parameter real voffl = -12345789;           // Length dependence parm for Vth offset
    parameter real tnom = -12345789;            // Parameter measurement temperature [C]
    parameter real cgso = -12345789;            // Gate-source overlap capacitance per width [F]
    parameter real cgdo = -12345789;            // Gate-drain overlap capacitance per width [F]
    parameter real cgbo = -12345789;            // Gate-bulk overlap capacitance per length [F]
    parameter real xpart = -12345789;           // Channel charge partitioning
    parameter real delta = -12345789;           // Effective Vds parameter [V]
    parameter real rsh = -12345789;             // Source-drain sheet resistance [Ohm]
    parameter real rdsw = -12345789;            // Source-drain resistance per width [Ohm]
    parameter real rdswmin = -12345789;         // Source-drain res per width at high Vg [Ohm]
    parameter real rsw =-12345789;              // Source resistance per width [Ohm]
    parameter real rdw = -12345789;             // Drain resistance per width [Ohm]
    parameter real rdwmin = -12345789;          // Drain res per width at high Vg [Ohm]
    parameter real rswmin = -12345789;          // Source res per width at high Vg [Ohm]
    parameter real prwg = -12345789;            // Gate-bias effect on parasitic resistance
    parameter real prwb = -12345789;            // Body-effect on parasitic resistance
    parameter real prt = -12345789;             // Temperature coeff of parasitic resistance
    parameter real eta0 = -12345789;            // Subthreshold region DIBL coeff
    parameter real etab = -12345789;            // Subthreshold region DIBL coeff
    parameter real pclm = -12345789;            // Channel length modulation Coefficient
    parameter real pdiblc1 = -12345789;         // Drain-induced barrier lowering coeff
    parameter real pdiblc2 = -12345789;         // Drain-induced barrier lowering coeff
    parameter real pdiblcb = -12345789;         // Body-eff on drain-ind barrier lowering
    parameter real fprout = -12345789;          // Rout degradation coeff for pocket dev
    parameter real pdits = -12345789;           // Coefficient for drain-induced Vth shifts
    parameter real pditsl = -12345789;          // L dep of drain-induced Vth shifts
    parameter real pditsd = -12345789;          // Vds dep of drain-induced Vth shifts
    parameter real pscbe1 = -12345789;          // Substrate current body-effect coeff
    parameter real pscbe2 = -12345789;          // Substrate current body-effect coeff
    parameter real pvag = -12345789;            // Gate dep of output resistance parameter
    parameter real jss = -12345789;             // Bottom S jun rev sat current density
    parameter real jsws = -12345789;            // Iso edge sidewall S junc rev sat current
    parameter real jswgs = -12345789;           // Gate edge S jun rev sat current density
    parameter real pbs = -12345789;             // Source junction built-in potential [V]
    parameter real njs = -12345789;             // Source junction emission coeff
    parameter real xtis = -12345789;            // Source junction current temperature exp
    parameter real mjs = -12345789;             // Source bottom junction cap grading coeff
    parameter real pbsws = -12345789;           // Source sidewall jun cap built in pot [V]
    parameter real mjsws = -12345789;           // Source sidewall jun cap grading coeff
    parameter real pbswgs = -12345789;          // S (g side) swall jun cap built in
    parameter real mjswgs = -12345789;          // S (g side) swall jun cap grading coeff
    parameter real cjs = -12345789;             // S bottom jun capacitance per unit area [F]
    parameter real cjsws = -12345789;           // S sidewall jun cap per unit periphery [F]
    parameter real cjswgs = -12345789;          // S (g side) swall jun cap per unit [F]
    parameter real jsd = -12345789;             // Bottom D jun rev sat current density
    parameter real jswd = -12345789;            // Iso edge swall drain jun rev sat current
    parameter real jswgd = -12345789;           // Gate edge d jun rev sat current density
    parameter real pbd = -12345789;             // Drain junction built-in potential [V]
    parameter real njd = -12345789;             // Drain junction emission coeff
    parameter real xtid = -12345789;            // D junction current temperature exponent
    parameter real mjd = -12345789;             // Drain bottom junc cap grading coeff
    parameter real pbswd = -12345789;           // Drain swall jun cap built in potential [V]
    parameter real mjswd = -12345789;           // Drain swall jun cap grading coeff
    parameter real pbswgd = -12345789;          // Drain (g side) swall jun cap built in [V]
    parameter real mjswgd = -12345789;          // D (g side) swall jun cap grading coeff
    parameter real cjd = -12345789;             // D bottom jun capacitance per unit area
    parameter real cjswd = -12345789;           // Drain swall jun cap per unit periphery
    parameter real cjswgd = -12345789;          // Drain (g side) swall jun cap per unit
    parameter real vfbcv = -12345789;           // Flat Band Voltage parm for capmod=0 [V]
    parameter real vfb = -12345789;             // Flat Band Voltage [V]
    parameter real tpb = -12345789;             // Temperature coeff of pb
    parameter real tcj = -12345789;             // Temperature coeff of cj
    parameter real tpbsw = -12345789;           // Temperature coeff of pbsw
    parameter real tcjsw = -12345789;           // Temperature coeff of cjsw
    parameter real tpbswg = -12345789;          // Temperature coeff of pbswg
    parameter real tcjswg = -12345789;          // Temperature coeff of cjswg
    parameter real acde = -12345789;            // Exp coeff for finite charge thickness
    parameter real moin = -12345789;            // Coeff for gate-bias dep surf potential
