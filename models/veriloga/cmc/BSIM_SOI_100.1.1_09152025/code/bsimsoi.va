real vth0_well, k2_well, vth0_well_edge, k2_well_edge, mu_well, Wdrn, local_sca, local_scb, local_scc;

// Edge FET Model Variables
real ids_edge, ETA0EDGE_t, NFACTOREDGE_t, Vbi_edge, theta_sce_edge, dvth_dibl, dvth_sce, litl_edge, DGAMMAEDGE_i, vdsatedge, Vdsatedge, Vdssate, phib_edge, phib_n_edge, NDEPEDGE_i, gam_edge, Theta_SCE;
real vth0_stress_EDGE, k2_stress_EDGE, eta_stress_EDGE;

// 1/f noise model for Edge FET
real nq_edge, qdeff_edge, qs_edge, Leffnoi_edge, Leffnoisq_edge, noia_edge, noib_edge, noic_edge, FNPowerAtedge;

// Below are used by macros by GEOMOD and RGEOMOD
real nuIntD, nuEndD, nuIntS, nuEndS;
real Rint, Rend;

// Sub-surface punchthrough
real Issl, SSL0_NT, SSL1_NT, PHIB_SSL;

// VTH variables
real q_vth, psip_th;

// 1/f noise model for halo
real vgfbh, gam_h, phib_h, psiph, psiphclamp, qsh, nq_h, U0_i_h, i1, qdh, i2, qsch;
real Np2, beta_ch, beta_h, gds_h, gds_ch, gm_ch, R_ch, R_h, Ssi_ch;
real Swi_ch, FNPowerAt1Hz_ch, FNPowerAt1Hz_h;
real T0a, T0b, T0c, T0d, T0e, Swi_h, t_tot, CF_ch, CF_h, LeffnoiH, LH1;

// Self heating
real gth, cth, Pdiss;

// gmin is placed in parallel with drain-bulk and source-bulk diode to increase the numerical convergence
real gmin;

// Abulk variables
real AbulkIV, AbulkCV;

//Body contact resistance
real gbody, gbodyagbcp2, gbodyINT;
real RBODYEXT, RBODYINT;
real QB1;
real UB_t, UB_i, UBTE_i;
real NEFF_i, Qbody;

//Backgate
real Vesfb, Vbs;
real Cbox;
real LeffCVb, LeffCVbg, CboxWL;
real Qe1, Qsub;

//Sidewall Fringing Capacitance
real csesw, cdesw;

//Bottom S/D Capacitance
real csbox, csmin, cdbox, cdmin;
real qse, qde;

//   Kb/q (Joule/degree)
real KboQ;

// Operating-point variables
`OPM( QBI,          "C",     "Intrinsic body charge" )
`OPM( QSI,          "C",     "Intrinsic source charge" )
`OPM( QSIM,         "C",     "Intrinsic source charge" )
`OPM( QSIAGBCP2,    "C",     "AGBCP2 source charge" )
`OPM( QDI,          "C",     "Intrinsic drain charge" )
`OPM( QDIM,         "C",     "Intrinsic drain charge" )
`OPM( QDIAGBCP2,    "C",     "AGBCP2 drain charge" )
`OPM( QGI,          "C",     "Intrinsic gate charge" )
`OPM( QGIM,         "C",     "Intrinsic gate charge" )
`OPM( QGIAGBCP2,    "C",     "AGBCP2 gate charge" )
`OPM( CGGI,         "F",     "Intrinsic gate capacitance" )
`OPM( CGBI,         "F",     "Intrinsic gate-to-body capacitance" )
`OPM( CGSI,         "F",     "Intrinsic gate-to-source capacitance" )
`OPM( CGDI,         "F",     "Intrinsic gate-to-drain capacitance" )
`OPM( CSGI,         "F",     "Intrinsic source-to-gate capacitance" )
`OPM( CSBI,         "F",     "Intrinsic source-to-body capacitance" )
`OPM( CSSI,         "F",     "Intrinsic source capacitance" )
`OPM( CSDI,         "F",     "Intrinsic source-to-drain capacitance" )
`OPM( CDGI,         "F",     "Intrinsic drain-to-gate capacitance" )
`OPM( CDBI,         "F",     "Intrinsic drain-to-body capacitance" )
`OPM( CDSI,         "F",     "Intrinsic drain-to-source capacitance" )
`OPM( CDDI,         "F",     "Intrinsic drain capacitance" )
`OPM( CBGI,         "F",     "Intrinsic body-to-gate capacitance" )
`OPM( CBBI,         "F",     "Intrinsic body capacitance" )
`OPM( CBSI,         "F",     "Intrinsic body-to-source capacitance" )
`OPM( CBDI,         "F",     "Intrinsic body-to-drain capacitance" )
`OPM( QB,           "C",     "Body charge" )
`OPM( QS,           "C",     "Source charge" )
`OPM( QD,           "C",     "Drain charge" )
`OPM( QG,           "C",     "Gate charge" )
`OPM( CGG,          "F",     "Total gate capacitance" )
`OPM( CGB,          "F",     "Total gate-to-body capacitance" )
`OPM( CGS,          "F",     "Total gate-to-source capacitance" )
`OPM( CGD,          "F",     "Total gate-to-drain capacitance" )
`OPM( CSG,          "F",     "Total source-to-gate capacitance" )
`OPM( CSB,          "F",     "Total source-to-body capacitance" )
`OPM( CSS,          "F",     "Total source capacitance" )
`OPM( CSD,          "F",     "Total source-to-drain capacitance" )
`OPM( CDG,          "F",     "Total drain-to-gate capacitance" )
`OPM( CDB,          "F",     "Total drain-to-body capacitance" )
`OPM( CDS,          "F",     "Total drain-to-source capacitance" )
`OPM( CDD,          "F",     "Total drain capacitance" )
`OPM( CBG,          "F",     "Total body-to-gate capacitance" )
`OPM( CBB,          "F",     "Total body capacitance" )
`OPM( CBS,          "F",     "Total body-to-source capacitance" )
`OPM( CBD,          "F",     "Total body-to-drain capacitance" )
`OPM( ISUB,         "A",     "Substrate current" )
`OPM( IGIDL,        "A",     "" )
`OPM( IGISL,        "A",     "" )
`OPM( IGS,          "A",     "" )
`OPM( IGD,          "A",     "" )
`OPM( IGCS,         "A",     "" )
`OPM( IGCD,         "A",     "" )
`OPM( IGB,          "A",     "" )
`OPM( CGSEXT,       "F",     "" )
`OPM( CGDEXT,       "F",     "" )
`OPM( CGBOV,        "F",     "Front gate charge" )
`OPM( CAPBS,        "F",     "" )
`OPM( CAPBD,        "F",     "" )
`OPP( WEFF,         "m",     "" )
`OPP( LEFF,         "m",     "" )
`OPP( WEFFCV,       "m",     "" )
`OPP( LEFFCV,       "m",     "" )
`OPM( IDS,          "A",     "Drain-source current" )
`OPM( IDEFF,        "A",     "Effective drain current" )
`OPM( ISEFF,        "A",     "Effective source current" )
`OPM( IGEFF,        "A",     "Effective gate current" )
`OPM( IBS,          "A",     "" )
`OPM( IBD,          "A",     "" )
`OPP( VDS,          "V",     "Drain-to-source voltage" )
`OPP( VGS,          "V",     "Gate-to-source voltage" )
`OPP( VBS,          "V",     "Body-to-source voltage" )
`OPP( VDSAT,        "V",     "" )
`OPM( GM,           "mho",   "" )
`OPM( GMBS,         "mho",   "" )
`OPM( GDS,          "mho",   "" )
`OPP( T_TOTAL_K,    "K",     "" )
`OPP( T_TOTAL_C,    "deg-C", "" )
`OPP( T_DELTA_SH,   "K",     "" )
`OPP( VTH,          "V",     "Threshold voltage" )


analog begin
    // Variable initialization to prevent hidden states
    sp_vfb           = 0.0;
    SP_S_xbar        = 0.0;
    Ig_agbcp2        = 0.0;
    psip             = 0.0;
    inv_gam          = 0.0;
    Vdssat           = 0.0;
    Iii              = 0.0;
    Vfb2             = 0.0;
    gbody            = 0.0;
    CDSCDEDGER_i     = 0.0;
    CDSCDR_i         = 0.0;
    L_WLN1           = 0.0;
    PTWGR_i          = 0.0;
    UAR_i            = 0.0;
    UCSR_i           = 0.0;
    UD_a             = 0.0;
    W_WWN1           = 0.0;
    Inv_sa           = 0.0;
    eta_stress       = 0.0;

    M0_i             = 0.0;
    M0_t             = 0.0;
    ETA0EDGE_i       = 0.0;
    KT2EDGE_i        = 0.0;
    K2EDGE_i         = 0.0;
    Mnud1            = 0.0;
    C0SI_i           = 0.0;
    C0SISAT1_i       = 0.0;
    gmin             = $simparam("gmin",0);
    ETA0R_i          = 0.0;
    PCLMR_i          = 0.0;
    PTWGR_t          = 0.0;
    UAR_t            = 0.0;
    UCSR_t           = 0.0;
    VSATR_i          = 0.0;
    local_sca        = 0.0;
    Inv_sb           = 0.0;
    FNPowerAtedge    = 0.0;

    K01_i            = 0.0;
    CITEDGE_i        = 0.0;
    ETABEDGE_i       = 0.0;
    KT1EXPEDGE_i     = 0.0;
    KVTH0EDGE_i      = 0.0;
    C0_i             = 0.0;
    C0SI1_i          = 0.0;
    C0SISAT_t        = 0.0;
    ETA0R_t          = 0.0;
    PDIBLCR_i        = 0.0;
    U0R_i            = 0.0;
    UCR_i            = 0.0;
    UDR_i            = 0.0;
    VSATR_t          = 0.0;
    local_scb        = 0.0;
    vth0_stress_EDGE = 0.0;
    eta_stress_EDGE  = 0.0;

    M01_i            = 0.0;
    CDSCDEDGE_i      = 0.0;
    KT1EDGE_i        = 0.0;
    TNFACTOREDGE_i   = 0.0;
    STK2EDGE_i       = 0.0;
    C01_i            = 0.0;
    C0SI_t           = 0.0;
    L_LLN1           = 0.0;
    PSATR_i          = 0.0;
    U0R_t            = 0.0;
    UCR_t            = 0.0;
    UDR_t            = 0.0;
    W_LWN1           = 0.0;
    local_scc        = 0.0;
    k2_stress_EDGE   = 0.0;
    K0_i             = 0.0;
    K0_t             = 0.0;
    CDSCBEDGE_i      = 0.0;
    KT1LEDGE_i       = 0.0;
    TETA0EDGE_i      = 0.0;
    STETA0EDGE_i     = 0.0;
    C0_t             = 0.0;
    C0SISAT_i        = 0.0;
    K2EDGEWE_i       = 0.0;
    KVTH0EDGEWE_i    = 0.0;
    temp_ADeff       = 0.0;
    temp_ASeff       = 0.0;
    temp_PDeff       = 0.0;
    temp_PSeff       = 0.0;
    AbulkIV          = 1.0;
    AbulkCV          = 1.0;
    gdpr             = 0.0;
    gspr             = 0.0;
    eta_p            = 1.0;
    DdL              = 0.0;
    Dmob             = 0.0;
    Dr               = 0.0;
    Dvsat            = 0.0;
    Dvsatinv         = 0.0;
    Ibddif           = 0.0;
    Ibsdif           = 0.0;
    Idsmosfet        = 0.0;
    Mnud             = 0.0;
    Moc              = 0.0;
    Mscbe            = 0.0;
    Nsat             = 0.0;
    Rdrain           = 0.0;
    Rsource          = 0.0;
    Vdseff           = 0.0;
    diffVds          = 0.0;
    dps              = 0.0;
    qia              = 0.0;
    qid              = 0.0;
    qim1             = 0.0;
    Rdsi             = 0.0;
    KboQ             =`P_K_NIST1998 / `P_Q_NIST1998;
    qdeff            = 0.0;
    qs               = 0.0;
    x7_d             = 0.0;
    x7_s             = 0.0;
    ln_T1_T2         = 0.0;
    alpha_DD         = 0.0;
    qim              = 0.0;
    H_fact           = 0.0;
    nq_edge          = 0.0;
    qdeff_edge       = 0.0;
    qs_edge          = 0.0;

    // Bias-independent calculations
    if (TYPE == `ntype) begin
        devsign = 1;
    end else begin
        devsign = -1;
    end

    // Constants
    epssi    = EPSRSUB * `P_EPS0;
    epsox    = EPSROX * `P_EPS0;
    Cox      = EPSROX * `P_EPS0 / TOXE;
    epsratio = EPSRSUB / EPSROX;

    // Physical oxide thickness
    if (!$param_given(TOXP)) begin
        BSIMBULKTOXP = (TOXE * EPSROX / 3.9) - DTOX;
    end else begin
        BSIMBULKTOXP = TOXP;
    end
    L_mult = L * LMLT;
    W_mult = W * WMLT;
    Lnew = L_mult + XL;
    if (Lnew <= 0.0) begin
        $error("Fatal: Ldrawn * LMLT + XL = %e for %M is non-positive", Lnew);
    end
    W_by_NF = W_mult / NF;
    Wnew    = W_by_NF + XW;
    if (Wnew <= 0.0) begin
        $error("Fatal: W / NF * WMLT + XW = %e for %M is non-positive", Wnew);
    end

    // Leff and Weff for I-V
    L_LLN      = pow(Lnew, -LLN);
    W_LWN      = pow(Wnew, -LWN);
    LW_LLN_LWN = L_LLN * W_LWN;
    dLIV       = LINT + LL * L_LLN + LW * W_LWN + LWL * LW_LLN_LWN;
    L_WLN      = pow(Lnew, -WLN);
    W_WWN      = pow(Wnew, -WWN);
    LW_WLN_WWN = L_WLN * W_WWN;
    dWIV       = WINT + WL * L_WLN + WW * W_WWN + WWL * LW_WLN_WWN;
    Leff       = Lnew - 2.0 * dLIV;
    if (Leff <= 0.0) begin
        $error("Fatal: Effective channel length = %e for  %M is non-positive", Leff);
    end else if (Leff <= 1.0e-9) begin
        $strobe("Warning: Effective channel length = %e for %M is <= 1.0e-9. Recommended Leff >= 1e-8", Leff);
    end
    Weff = Wnew - NBC * DWBC - (2.0 - NBC) * dWIV;
    if (Weff <= 0.0) begin
        $error("Fatal: Effective channel Width = %e for %M is non-positive", Weff);
    end else if (Weff <= 1.0e-9) begin
        $strobe("Warning: Effective channel width = %e for %M is <= 1.0e-9. Recommended Weff >= 1e-8", Weff);
    end

    // Leff and Weff for C-V
    dLCV = DLC + LLC * L_LLN + LWC * W_LWN + LWLC * LW_LLN_LWN;
    dWCV = DWC + WLC * L_WLN + WWC * W_WWN + WWLC * LW_WLN_WWN;
    Lact = Lnew - 2.0 * dLCV;
    if (Lact <= 0.0) begin
        $error("Fatal: Effective channel length for C-V = %e for %M is non-positive", Lact);
    end else if (Lact <= 1.0e-9) begin
        $strobe("Warning: Effective channel length for C-V = %e for %M is <= 1.0e-9. Recommended Lact >= 1e-8", Lact);
    end
    Wact = Wnew - NBC * DWBC - (2.0 - NBC) * dWCV;
    if (Wact <= 0.0) begin
        $error("Fatal: Effective channel width for C-V = %e for %M is non-positive", Wact);
    end else if (Wact <= 1.0e-9) begin
        $strobe("Warning: Effective channel width for C-V = %e for %M is <= 1.0e-9. Recommended Wact >= 1e-8", Wact);
    end

    // Weffcj for diode, GIDL etc.
    dWJ    = DWJ + WLC / pow(Lnew, WLN) + WWC / pow(Wnew, WWN) + WWLC / pow(Lnew, WLN) / pow(Wnew, WWN);
    Weffcj = Wnew - 2.0 * dWJ;
    if (Weffcj <= 0.0) begin
        $error("Fatal: Effective channel width for S/D junctions = %e for %M is non-positive", Weffcj);
    end
    Inv_L     = 1.0e-6 / Leff;
    Inv_W     = 1.0e-6 / Weff;
    Inv_Lact  = 1.0e-6 / Lact;
    Inv_Wact  = 1.0e-6 / Wact;
    Inv_Llong = 1.0e-6 / LLONG;
    Inv_Wwide = 1.0e-6 / WWIDE;
    Inv_WL    = Inv_L * Inv_W;

    // Effective length and width for binning
    L_LLN1 = L_LLN;
    L_WLN1 = L_WLN;
    if (DLBIN != 0.0) begin
        if (DLBIN <= -Lnew) begin
            $error("Fatal: DLBIN for %M = %e is <= -Ldrawn * LMLT", DLBIN);
        end else begin
            L_LLN1 = pow(Lnew + DLBIN, -LLN);
            L_WLN1 = pow(Lnew + DLBIN, -WLN);
        end
    end
    W_LWN1 = W_LWN;
    W_WWN1 = W_WWN;
    if (DWBIN != 0.0) begin
        if (DWBIN <= -Wnew) begin
            $error("Fatal: DWBIN for %M = %e is <= -Wdrawn * WMLT", DWBIN);
        end else begin
            W_LWN1 = pow(Wnew + DWBIN, -LWN);
            W_WWN1 = pow(Wnew + DWBIN, -WWN);
        end
    end
    LW_LLN_LWN1 = L_LLN1 * W_LWN1;
    dLB         = LINT + LL * L_LLN1 + LW * W_LWN1 + LWL * LW_LLN_LWN1;
    LW_WLN_WWN1 = L_WLN1 * W_WWN1;
    dWB         = WINT + WL * L_WLN1 + WW * W_WWN1 + WWL * LW_WLN_WWN1;
    Leff1 = Lnew - 2.0 * dLB + DLBIN;
    if (Leff1 <= 0.0) begin
        $error("Fatal: Effective channel length for binning = %e for %M is non-positive", Leff1);
    end
    Weff1 = Wnew - 2.0 * dWB + DWBIN;
    if (Weff1 <= 0.0) begin
        $error("Fatal: Effective channel width for binning = %e for %M is non-positive", Weff1);
    end
    if (BINUNIT == 1) begin
        BIN_L = 1.0e-6 / Leff1;
        BIN_W = 1.0e-6 / Weff1;
    end else begin
        BIN_L = 1.0 / Leff1;
        BIN_W = 1.0 / Weff1;
    end
    BIN_WL         = BIN_L * BIN_W;
    VFB_i          = VFB + BIN_L * LVFB + BIN_W * WVFB + BIN_WL * PVFB;
    VFBB_i         = VFBB + BIN_L * LVFBB + BIN_W * WVFBB + BIN_WL * PVFBB;
    VFBCV_i        = VFBCV + BIN_L * LVFBCV + BIN_W * WVFBCV + BIN_WL * PVFBCV;
    NSD_i          = NSD + BIN_L * LNSD + BIN_W * WNSD + BIN_WL * PNSD;
    NDEP_i         = NDEP + BIN_L * LNDEP + BIN_W * WNDEP + BIN_WL * PNDEP;
    NDEPCV_i       = NDEPCV + BIN_L * LNDEPCV + BIN_W * WNDEPCV + BIN_WL * PNDEPCV;
    NGATE_i        = NGATE + BIN_L * LNGATE + BIN_W * WNGATE + BIN_WL * PNGATE;
    CIT_i          = CIT + BIN_L * LCIT + BIN_W * WCIT + BIN_WL * PCIT;
    NFACTOR_i      = NFACTOR + BIN_L * LNFACTOR + BIN_W * WNFACTOR + BIN_WL * PNFACTOR;
    ASCL_i         = ASCL + LASCL * BIN_L + WASCL * BIN_W + PASCL * BIN_WL;
    BSCL_i         = BSCL + LBSCL * BIN_L + WBSCL * BIN_W + PBSCL * BIN_WL;
    DVBD0_i        = DVBD0 + LDVBD0 * BIN_L + WDVBD0 * BIN_W + PDVBD0 * BIN_WL;
    DVBD1_i        = DVBD1 + LDVBD1 * BIN_L + WDVBD1 * BIN_W + PDVBD1 * BIN_WL;
    VSCE_i         = VSCE + LVSCE * BIN_L + WVSCE * BIN_W + PVSCE * BIN_WL;
    CDSBS_i        = CDSBS + LCDSBS * BIN_L + WCDSBS * BIN_W + PCDSBS * BIN_WL;
    CDSBS1_i       = CDSBS1 + LCDSBS1 * BIN_L + WCDSBS1 * BIN_W + PCDSBS1 * BIN_WL;
    DVT1_i         = DVT1 + LDVT1 * BIN_L + WDVT1 * BIN_W + PDVT1 * BIN_WL;
    CDSCD_i        = CDSCD + BIN_L * LCDSCD + BIN_W * WCDSCD + BIN_WL * PCDSCD;
    CDSC_i         = CDSC + BIN_L * LCDSC + BIN_W * WCDSC + BIN_WL * PCDSC;
    CDSCEDGE_i     = CDSCEDGE + BIN_L * LCDSCEDGE + BIN_W * WCDSCEDGE + BIN_WL * PCDSCEDGE;
    CBCBEDGE_i     = CBCBEDGE + BIN_L * LCBCBEDGE + BIN_W * WCBCBEDGE + BIN_WL * PCBCBEDGE;
    CDSCB_i        = CDSCB + BIN_L * LCDSCB + BIN_W * WCDSCB + BIN_WL * PCDSCB;
    CSECSE_i       = CSECSE + BIN_L * LCSECSE + BIN_W * WCSECSE + BIN_WL * PCSECSE;
    CSECSEEDGE_i   = CSECSEEDGE + BIN_L * LCSECSEEDGE + BIN_W * WCSECSEEDGE + BIN_WL * PCSECSEEDGE;
    CBCB_i         = CBCB + BIN_L * LCBCB + BIN_W * WCBCB + BIN_WL * PCBCB;
    DVTP0_i        = DVTP0 + BIN_L * LDVTP0 + BIN_W * WDVTP0 + BIN_WL * PDVTP0;
    DVTP0EDGE_i    = DVTP0EDGE + BIN_L * LDVTP0EDGE + BIN_W * WDVTP0EDGE + BIN_WL * PDVTP0EDGE;
    DVTP1_i        = DVTP1 + BIN_L * LDVTP1 + BIN_W * WDVTP1 + BIN_WL * PDVTP1;
    DVTP1EDGE_i    = DVTP1EDGE + BIN_L * LDVTP1EDGE + BIN_W * WDVTP1EDGE + BIN_WL * PDVTP1EDGE;
    DVTP2_i        = DVTP2 + BIN_L * LDVTP2 + BIN_W * WDVTP2 + BIN_WL * PDVTP2;
    DVTP3_i        = DVTP3 + BIN_L * LDVTP3 + BIN_W * WDVTP3 + BIN_WL * PDVTP3;
    DVTP4_i        = DVTP4 + BIN_L * LDVTP4 + BIN_W * WDVTP4 + BIN_WL * PDVTP4;
    DVTP5_i        = DVTP5 + BIN_L * LDVTP5 + BIN_W * WDVTP5 + BIN_WL * PDVTP5;
    DVTP2EDGE_i    = DVTP2EDGE + BIN_L * LDVTP2EDGE + BIN_W * WDVTP2EDGE + BIN_WL * PDVTP2EDGE;
    DVTP3EDGE_i    = DVTP3EDGE + BIN_L * LDVTP3EDGE + BIN_W * WDVTP3EDGE + BIN_WL * PDVTP3EDGE;
    DVTP4EDGE_i    = DVTP4EDGE + BIN_L * LDVTP4EDGE + BIN_W * WDVTP4EDGE + BIN_WL * PDVTP4EDGE;
    DVTP5EDGE_i    = DVTP5EDGE + BIN_L * LDVTP5EDGE + BIN_W * WDVTP5EDGE + BIN_WL * PDVTP5EDGE;
    K2_i           = K2 + BIN_L * LK2 + BIN_W * WK2 + BIN_WL * PK2;
    K1_i           = K1 + BIN_L * LK1 + BIN_W * WK1 + BIN_WL * PK1;
    K1EDGE_i       = K1EDGE + BIN_L * LK1EDGE + BIN_W * WK1EDGE + BIN_WL * PK1EDGE;
    XJ_i           = XJ + BIN_L * LXJ + BIN_W * WXJ + BIN_WL * PXJ;
    PHIN_i         = PHIN + BIN_L * LPHIN + BIN_W * WPHIN + BIN_WL * PPHIN;
    ETA0_i         = ETA0 + BIN_L * LETA0 + BIN_W * WETA0 + BIN_WL * PETA0;
    ETAB_i         = ETAB + BIN_L * LETAB + BIN_W * WETAB + BIN_WL * PETAB;
    DELTA_i        = DELTA + BIN_L * LDELTA + BIN_W * WDELTA + BIN_WL * PDELTA;
    U0_i           = U0 + BIN_L * LU0 + BIN_W * WU0 + BIN_WL * PU0;
    UA_i           = UA + BIN_L * LUA + BIN_W * WUA + BIN_WL * PUA;
    UD_i           = UD + BIN_L * LUD + BIN_W * WUD + BIN_WL * PUD;
    EU_i           = EU + BIN_L * LEU + BIN_W * WEU + BIN_WL * PEU;
    UCS_i          = UCS + BIN_L * LUCS + BIN_W * WUCS + BIN_WL * PUCS;
    UC_i           = UC + BIN_L * LUC + BIN_W * WUC + BIN_WL * PUC;
    PCLM_i         = PCLM + BIN_L * LPCLM + BIN_W * WPCLM + BIN_WL * PPCLM;
    PCLMCV_i       = PCLMCV + BIN_L * LPCLMCV + BIN_W * WPCLMCV + BIN_WL * PPCLMCV;
    RSW_i          = RSW + BIN_L * LRSW + BIN_W * WRSW + BIN_WL * PRSW;
    RDW_i          = RDW + BIN_L * LRDW + BIN_W * WRDW + BIN_WL * PRDW;
    PRWG_i         = PRWG + BIN_L * LPRWG + BIN_W * WPRWG + BIN_WL * PPRWG;
    PRWB_i         = PRWB + BIN_L * LPRWB + BIN_W * WPRWB + BIN_WL * PPRWB;
    WR_i           = WR + BIN_L * LWR + BIN_W * WWR + BIN_WL * PWR;
    RSWMIN_i       = RSWMIN + BIN_L * LRSWMIN + BIN_W * WRSWMIN + BIN_WL * PRSWMIN;
    RDWMIN_i       = RDWMIN + BIN_L * LRDWMIN + BIN_W * WRDWMIN + BIN_WL * PRDWMIN;
    RDSW_i         = RDSW + BIN_L * LRDSW + BIN_W * WRDSW + BIN_WL * PRDSW;
    RDSWMIN_i      = RDSWMIN + BIN_L * LRDSWMIN + BIN_W * WRDSWMIN + BIN_WL * PRDSWMIN;
    PTWG_i         = PTWG + BIN_L * LPTWG + BIN_W * WPTWG + BIN_WL * PPTWG;
    PDIBLC_i       = PDIBLC + BIN_L * LPDIBLC + BIN_W * WPDIBLC + BIN_WL * PPDIBLC;
    PDIBLCB_i      = PDIBLCB + BIN_L * LPDIBLCB + BIN_W * WPDIBLCB + BIN_WL * PPDIBLCB;
    PSCBE1_i       = PSCBE1 + BIN_L * LPSCBE1 + BIN_W * WPSCBE1 + BIN_WL * PPSCBE1;
    PSCBE2_i       = PSCBE2 + BIN_L * LPSCBE2 + BIN_W * WPSCBE2 + BIN_WL * PPSCBE2;
    PDITS_i        = PDITS + BIN_L * LPDITS + BIN_W * WPDITS + BIN_WL * PPDITS;
    PDITSD_i       = PDITSD + BIN_L * LPDITSD + BIN_W * WPDITSD + BIN_WL * PPDITSD;
    FPROUT_i       = FPROUT + BIN_L * LFPROUT + BIN_W * WFPROUT + BIN_WL * PFPROUT;
    PVAG_i         = PVAG + BIN_L * LPVAG + BIN_W * WPVAG + BIN_WL * PPVAG;
    VSAT_i         = VSAT + BIN_L * LVSAT + BIN_W * WVSAT + BIN_WL * PVSAT;
    KSATIV_i       = KSATIV +  BIN_L * LKSATIV + BIN_W * WKSATIV + BIN_WL * PKSATIV;
    THESAT_i       = THESAT + BIN_L * LTHESAT + BIN_W * WTHESAT + BIN_WL * PTHESAT;
    LPE1_i         = LPE1 + LLPE1 * BIN_L + WLPE1 * BIN_W + PLPE1 * BIN_WL;
    PSAT_i         = PSAT + BIN_L * LPSAT + BIN_W * WPSAT + BIN_WL * PPSAT;
    VSATCV_i       = VSATCV + BIN_L * LVSATCV + BIN_W * WVSATCV + BIN_WL * PVSATCV;
    CF_i           = CF + BIN_L * LCF + BIN_W * WCF + BIN_WL * PCF;
    CGSL_i         = CGSL + BIN_L * LCGSL + BIN_W * WCGSL + BIN_WL * PCGSL;
    CGDL_i         = CGDL + BIN_L * LCGDL + BIN_W * WCGDL + BIN_WL * PCGDL;
    CKAPPAS_i      = CKAPPAS + BIN_L * LCKAPPAS + BIN_W * WCKAPPAS + BIN_WL * PCKAPPAS;
    CKAPPAD_i      = CKAPPAD + BIN_L * LCKAPPAD + BIN_W * WCKAPPAD + BIN_WL * PCKAPPAD;

    //For BSIM-SOI Impact Ionization Module
    ALPHA0_i       = ALPHA0 + BIN_L * LALPHA0 + BIN_W * WALPHA0 + BIN_WL * PALPHA0;
    BETA0_i        = BETA0 + BIN_L * LBETA0 + BIN_W * WBETA0 + BIN_WL * PBETA0;
    BETA1_i        = BETA1 + BIN_L * LBETA1 + BIN_W * WBETA1 + BIN_WL * PBETA1;
    BETA2_i        = BETA2 + BIN_L * LBETA2 + BIN_W * WBETA2 + BIN_WL * PBETA2;
    LII_i          = LII + BIN_L * LLII + BIN_W * WLII + BIN_WL * PLII;
    SII0_i         = SII0 + BIN_L * LSII0 + BIN_W * WSII0 + BIN_WL * PSII0;
    SII1_i         = SII1 + BIN_L * LSII1 + BIN_W * WSII1 + BIN_WL * PSII1;
    SII2_i         = SII2 + BIN_L * LSII2 + BIN_W * WSII2 + BIN_WL * PSII2;
    SIID_i         = SIID + BIN_L * LSIID + BIN_W * WSIID + BIN_WL * PSIID;
    VDSATII0_i     = VDSATII0 + LVDSATII0 * BIN_L + WVDSATII0 * BIN_W + PVDSATII0 * BIN_WL;
    ESATII_i       = ESATII + BIN_L * LESATII + BIN_W * WESATII + BIN_WL * PESATII;
    FBJTII_i       = FBJTII + BIN_L * LFBJTII + BIN_W * WFBJTII + BIN_WL * PFBJTII;

    EBJTII_i       = EBJTII + BIN_L * LEBJTII + BIN_W * WEBJTII + BIN_WL * PEBJTII;
    CBJTII_i       = CBJTII + BIN_L * LCBJTII + BIN_W * WCBJTII + BIN_WL * PCBJTII;
    ABJTII_i       = ABJTII + BIN_L * LABJTII + BIN_W * WABJTII + BIN_WL * PABJTII;
    VBCI_i         = VBCI + BIN_L * LVBCI + BIN_W * WVBCI + BIN_WL * PVBCI;
    MBJTII_i       = MBJTII + BIN_L * LMBJTII + BIN_W * WMBJTII + BIN_WL * PMBJTII;

    //Non-linear Body Resistance
    UB_i           = UB + BIN_L * LUB + BIN_W * WUB + BIN_WL * PUB;
    UBTE_i         = UBTE + BIN_L * LUBTE + BIN_W * WUBTE + BIN_WL * PUBTE;
    NEFF_i         = NEFF + BIN_L * LNEFF + BIN_W * WNEFF + BIN_WL * PNEFF;

    //Binning of Diode and BJT Parameters -- For SOI Junction Currents (Diode and BJT)
    XDIF_i = XDIF + LXDIF * BIN_L + WXDIF * BIN_W + PXDIF * BIN_WL;
    ISDIF_i = ISDIF + LISDIF * BIN_L + WISDIF * BIN_W + PISDIF * BIN_WL;
    IDDIF_i = IDDIF + LIDDIF * BIN_L + WIDDIF * BIN_W + PIDDIF * BIN_WL;
    NRECF0_i = NRECF0 + LNRECF0 * BIN_L + WNRECF0 * BIN_W + PNRECF0 * BIN_WL;
    NRECR0_i = NRECR0 + LNRECR0 * BIN_L + WNRECR0 * BIN_W + PNRECR0 * BIN_WL;
    XREC_i = XREC + LXREC * BIN_L + WXREC * BIN_W + PXREC * BIN_WL;
    ISREC_i = ISREC + LISREC * BIN_L + WISREC * BIN_W + PISREC * BIN_WL;
    IDREC_i = IDREC + LIDREC * BIN_L + WIDREC * BIN_W + PIDREC * BIN_WL;

    NTRECF_i = NTRECF + LNTRECF * BIN_L + WNTRECF * BIN_W + PNTRECF * BIN_WL;
    NTRECR_i = NTRECR + LNTRECR * BIN_L + WNTRECR * BIN_W + PNTRECR * BIN_WL;

    ISTUN_i = ISTUN + LISTUN * BIN_L + WISTUN * BIN_W + PISTUN * BIN_WL;
    IDTUN_i = IDTUN + LIDTUN * BIN_L + WIDTUN * BIN_W + PIDTUN * BIN_WL;

    XTUN_i = XTUN + LXTUN * BIN_L + WXTUN * BIN_W + PXTUN * BIN_WL;
    XTUND_i = XTUND + LXTUND * BIN_L + WXTUND * BIN_W + PXTUND * BIN_WL;

    NTUN_i = NTUN + LNTUN * BIN_L + WNTUN * BIN_W + PNTUN * BIN_WL;
    NTUND_i = NTUND + LNTUND * BIN_L + WNTUND * BIN_W + PNTUND * BIN_WL;

    VTUN0_i = VTUN0 + LVTUN0 * BIN_L + WVTUN0 * BIN_W + PVTUN0 * BIN_WL;
    VTUN0D_i = VTUN0D + LVTUN0D * BIN_L + WVTUN0D * BIN_W + PVTUN0D * BIN_WL;

    VREC0_i = VREC0 + LVREC0 * BIN_L + WVREC0 * BIN_W + PVREC0 * BIN_WL;
    VREC0D_i = VREC0D + LVREC0D * BIN_L + WVREC0D * BIN_W + PVREC0D * BIN_WL;

    VABJT_i     = VABJT + LVABJT  * BIN_L + WVABJT  * BIN_W + PVABJT  * BIN_WL;
    AELY_i      = AELY + LAELY   * BIN_L + WAELY   * BIN_W + PAELY   * BIN_WL;
    AHLI_i      = AHLI + BIN_L * LAHLI + BIN_W * WAHLI + PAHLI * BIN_WL;
    AHLID_i     = AHLID + BIN_L * LAHLID + BIN_W * WAHLID + PAHLID * BIN_WL;
    XBJT_i      = XBJT + LXBJT   * BIN_L + WXBJT   * BIN_W + PXBJT   * BIN_WL;
    NDIODE_i    = NDIODE + LNDIODE * BIN_L + WNDIODE * BIN_W + PNDIODE * BIN_WL;
    ISBJT_i     = ISBJT + LISBJT * BIN_L + WISBJT * BIN_W + PISBJT * BIN_WL;
    IDBJT_i     = IDBJT + LIDBJT * BIN_L + WIDBJT * BIN_W + PIDBJT * BIN_WL;
    NBJT_i      = NBJT + LNBJT * BIN_L + WNBJT * BIN_W + PNBJT * BIN_WL;
    LBJT0_i     = LBJT0 + LLBJT0 * BIN_L +WLBJT0 * BIN_W + PLBJT0 * BIN_WL;
    NDIF_i      = NDIF + LNDIF * BIN_L + WNDIF * BIN_W + PNDIF * BIN_WL;

    KVTH0WE_i      = KVTH0WE + BIN_L * LKVTH0WE  + BIN_W * WKVTH0WE + BIN_WL * PKVTH0WE;
    K2WE_i         = K2WE + BIN_L * LK2WE + BIN_W * WK2WE + BIN_WL * PK2WE;
    KU0WE_i        = KU0WE + BIN_L * LKU0WE + BIN_W * WKU0WE + BIN_WL * PKU0WE;

    AGIDL_i        = AGIDL + BIN_L * LAGIDL + BIN_W * WAGIDL + BIN_WL * PAGIDL;
    BGIDL_i        = BGIDL + BIN_L * LBGIDL + BIN_W * WBGIDL + BIN_WL * PBGIDL;
    BGIDL1_i       = BGIDL1 + LBGIDL1 * BIN_L + WBGIDL1 * BIN_W + PBGIDL1 * BIN_WL;
    CGIDL_i        = CGIDL + BIN_L * LCGIDL + BIN_W * WCGIDL + BIN_WL * PCGIDL;
    EGIDL_i        = EGIDL + BIN_L * LEGIDL + BIN_W * WEGIDL + BIN_WL * PEGIDL;
    AGISL_i        = AGISL + BIN_L * LAGISL + BIN_W * WAGISL + BIN_WL * PAGISL;
    BGISL_i        = BGISL + BIN_L * LBGISL + BIN_W * WBGISL + BIN_WL * PBGISL;
    BGISL1_i       = BGISL1 + LBGISL1 * BIN_L + WBGISL1 * BIN_W + PBGISL1 * BIN_WL;
    CGISL_i        = CGISL + BIN_L * LCGISL + BIN_W * WCGISL + BIN_WL * PCGISL;
    EGISL_i        = EGISL + BIN_L * LEGISL + BIN_W * WEGISL + BIN_WL * PEGISL;
    //GIDL_MOD = 1
    RGISL_i       = RGISL + BIN_L * LRGISL + BIN_W * WRGISL + BIN_WL * PRGISL;
    RGIDL_i       = RGIDL + BIN_L * LRGIDL + BIN_W * WRGIDL + BIN_WL * PRGIDL;
    KGISL_i       = KGISL + BIN_L * LKGISL + BIN_W * WKGISL + BIN_WL * PKGISL;
    KGIDL_i       = KGIDL + BIN_L * LKGIDL + BIN_W * WKGIDL + BIN_WL * PKGIDL;
    FGISL_i       = FGISL + BIN_L * LFGISL + BIN_W * WFGISL + BIN_WL * PFGISL;
    FGIDL_i       = FGIDL + BIN_L * LFGIDL + BIN_W * WFGIDL + BIN_WL * PFGIDL;


    UTE_i          = UTE + BIN_L * LUTE + BIN_W * WUTE + BIN_WL * PUTE;
    UA1_i          = UA1 + BIN_L * LUA1 + BIN_W * WUA1 + BIN_WL * PUA1;
    UC1_i          = UC1 + BIN_L * LUC1 + BIN_W * WUC1 + BIN_WL * PUC1;
    UD1_i          = UD1 + BIN_L * LUD1 + BIN_W * WUD1 + BIN_WL * PUD1;
    EU1_i          = EU1 + BIN_L * LEU1 + BIN_W * WEU1 + BIN_WL * PEU1;
    UCSTE_i        = UCSTE + BIN_L * LUCSTE + BIN_W * WUCSTE + BIN_WL * PUCSTE;
    PRT_i          = PRT + BIN_L * LPRT + BIN_W * WPRT + BIN_WL * PPRT;
    AT_i           = AT + BIN_L * LAT + BIN_W * WAT + BIN_WL * PAT;
    PTWGT_i        = PTWGT + BIN_L * LPTWGT + BIN_W * WPTWGT + BIN_WL * PPTWGT;
    IIT_i          = IIT + BIN_L * LIIT + BIN_W * WIIT + BIN_WL * PIIT;
    IGT_i          = IGT + BIN_L * LIGT + BIN_W * WIGT + BIN_WL * PIGT;
    EIGBINV_i      = EIGBINV + BIN_L * LEIGBINV + BIN_W * WEIGBINV + BIN_WL * PEIGBINV;

    //Binning of IGB's Parameters
    ALPHAGB2_i     = ALPHAGB2 + BIN_L * LALPHAGB2 + BIN_W * WALPHAGB2 + BIN_WL * PALPHAGB2;
    ALPHAGB2_T_i   = ALPHAGB2_T + LALPHAGB2_T * BIN_L + WALPHAGB2_T * BIN_W + PALPHAGB2_T * BIN_WL;
    BETAGB2_i      = BETAGB2  + BIN_L * LBETAGB2 + BIN_W * WBETAGB2 + BIN_WL * PBETAGB2;

    ALPHAGB1_i     = ALPHAGB1 + BIN_L * LALPHAGB1 + BIN_W * WALPHAGB1 + BIN_WL * PALPHAGB1;
    ALPHAGB1_T_i   = ALPHAGB1_T + LALPHAGB1_T * BIN_L + WALPHAGB1_T * BIN_W + PALPHAGB1_T * BIN_WL;
    BETAGB1_i      = BETAGB1  + BIN_L * LBETAGB1 + BIN_W * WBETAGB1 + BIN_WL * PBETAGB1;

    AIGC_i         = AIGC + BIN_L * LAIGC + BIN_W * WAIGC + BIN_WL * PAIGC;
    AIGC1_i        = AIGC1 + LAIGC1 * BIN_L + WAIGC1 * BIN_W + PAIGC1 * BIN_WL;
    BIGC_i         = BIGC + BIN_L * LBIGC + BIN_W * WBIGC + BIN_WL * PBIGC;
    CIGC_i         = CIGC + BIN_L * LCIGC + BIN_W * WCIGC + BIN_WL * PCIGC;
    AIGS_i         = AIGS + BIN_L * LAIGS + BIN_W * WAIGS + BIN_WL * PAIGS;
    AIGS1_i        = AIGS1 + LAIGS1 * BIN_L + WAIGS1 * BIN_W + PAIGS1 * BIN_WL;
    BIGS_i         = BIGS + BIN_L * LBIGS + BIN_W * WBIGS + BIN_WL * PBIGS;
    CIGS_i         = CIGS + BIN_L * LCIGS + BIN_W * WCIGS + BIN_WL * PCIGS;
    AIGD_i         = AIGD + BIN_L * LAIGD + BIN_W * WAIGD + BIN_WL * PAIGD;
    AIGD1_i        = AIGD1 + LAIGD1 * BIN_L + WAIGD1 * BIN_W + PAIGD1 * BIN_WL;
    BIGD_i         = BIGD + BIN_L * LBIGD + BIN_W * WBIGD + BIN_WL * PBIGD;
    CIGD_i         = CIGD + BIN_L * LCIGD + BIN_W * WCIGD + BIN_WL * PCIGD;
    POXEDGE_i      = POXEDGE + BIN_L * LPOXEDGE + BIN_W * WPOXEDGE + BIN_WL * PPOXEDGE;
    DLCIG_i        = DLCIG + BIN_L * LDLCIG + BIN_W * WDLCIG + BIN_WL * PDLCIG;
    DLCIGD_i       = DLCIGD + BIN_L * LDLCIGD + BIN_W * WDLCIGD + BIN_WL * PDLCIGD;
    NTOX_i         = NTOX + BIN_L * LNTOX + BIN_W * WNTOX + BIN_WL * PNTOX;
    KT1_i          = KT1 + BIN_L * LKT1 + BIN_W * WKT1 + BIN_WL * PKT1;
    KT2_i          = KT2 + BIN_L * LKT2 + BIN_W * WKT2 + BIN_WL * PKT2;
    PSATB_i        = PSATB + BIN_L * LPSATB + BIN_W * WPSATB + BIN_WL * PPSATB;
    A1_i           = A1 + BIN_L * LA1 + BIN_W * WA1 + BIN_WL * PA1;
    A11_i          = A11 + BIN_L * LA11 + BIN_W * WA11 + BIN_WL * PA11;
    A2_i           = A2 + BIN_L * LA2 + BIN_W * WA2 + BIN_WL * PA2;
    A21_i          = A21 + BIN_L * LA21 + BIN_W * WA21 + BIN_WL * PA21;
    K0_i           = K0 + BIN_L * LK0 + BIN_W * WK0 + BIN_WL * PK0;
    M0_i           = M0 + BIN_L * LM0 + BIN_W * WM0 + BIN_WL * PM0;
    K01_i          = K01 + BIN_L * LK01 + BIN_W * WK01 + BIN_WL * PK01;
    M01_i          = M01 + BIN_L * LM01 + BIN_W * WM01 + BIN_WL * PM01;
    NFACTOREDGE_i  = NFACTOREDGE + BIN_L * LNFACTOREDGE + BIN_W * WNFACTOREDGE + BIN_WL * PNFACTOREDGE;
    NDEPEDGE_i     = NDEPEDGE + BIN_L * LNDEPEDGE + BIN_W * WNDEPEDGE + BIN_WL * PNDEPEDGE;
    CITEDGE_i      = CITEDGE + BIN_L * LCITEDGE + BIN_W * WCITEDGE + BIN_WL * PCITEDGE;
    CDSCDEDGE_i    = CDSCDEDGE + BIN_L * LCDSCDEDGE + BIN_W * WCDSCDEDGE + BIN_WL * PCDSCDEDGE;
    CDSCBEDGE_i    = CDSCBEDGE + BIN_L * LCDSCBEDGE + BIN_W * WCDSCBEDGE + BIN_WL * PCDSCBEDGE;
    ETA0EDGE_i     = ETA0EDGE + BIN_L * LETA0EDGE + BIN_W * WETA0EDGE + BIN_WL * PETA0EDGE;
    ETABEDGE_i     = ETABEDGE + BIN_L * LETABEDGE + BIN_W * WETABEDGE + BIN_WL * PETABEDGE;
    KT1EDGE_i      = KT1EDGE + BIN_L * LKT1EDGE + BIN_W * WKT1EDGE + BIN_WL * PKT1EDGE;
    KT1LEDGE_i     = KT1LEDGE + BIN_L * LKT1LEDGE + BIN_W * WKT1LEDGE + BIN_WL * PKT1LEDGE;
    KT2EDGE_i      = KT2EDGE + BIN_L * LKT2EDGE + BIN_W * WKT2EDGE + BIN_WL * PKT2EDGE;
    KT1EXPEDGE_i   = KT1EXPEDGE + BIN_L * LKT1EXPEDGE + BIN_W * WKT1EXPEDGE + BIN_WL * PKT1EXPEDGE;
    TNFACTOREDGE_i = TNFACTOREDGE + BIN_L * LTNFACTOREDGE + BIN_W * WTNFACTOREDGE + BIN_WL * PTNFACTOREDGE;
    TETA0EDGE_i    = TETA0EDGE + BIN_L * LTETA0EDGE + BIN_W * WTETA0EDGE + BIN_WL * PTETA0EDGE;
    K2EDGE_i       = K2EDGE + BIN_L * LK2EDGE + BIN_W * WK2EDGE + BIN_WL * PK2EDGE;
    KVTH0EDGE_i    = KVTH0EDGE + BIN_L * LKVTH0EDGE + BIN_W * WKVTH0EDGE + BIN_WL * PKVTH0EDGE;
    K2EDGEWE_i     = K2EDGEWE + BIN_L * LK2EDGEWE + BIN_W * WK2EDGEWE + BIN_WL * PK2EDGEWE;
    KVTH0EDGEWE_i  = KVTH0EDGEWE + BIN_L * LKVTH0EDGEWE + BIN_W * WKVTH0EDGEWE + BIN_WL * PKVTH0EDGEWE;
    STK2EDGE_i     = STK2EDGE + BIN_L * LSTK2EDGE + BIN_W * WSTK2EDGE + BIN_WL * PSTK2EDGE;
    STETA0EDGE_i   = STETA0EDGE + BIN_L * LSTETA0EDGE + BIN_W * WSTETA0EDGE + BIN_WL * PSTETA0EDGE;
    C0_i           = C0 + BIN_L * LC0 + BIN_W * WC0 + BIN_WL * PC0;
    C01_i          = C01 + BIN_L * LC01 + BIN_W * WC01 + BIN_WL * PC01;
    C0SI_i         = C0SI + BIN_L * LC0SI + BIN_W * WC0SI + BIN_WL * PC0SI;
    C0SI1_i        = C0SI1 + BIN_L * LC0SI1 + BIN_W * WC0SI1 + BIN_WL * PC0SI1;
    C0SISAT_i      = C0SISAT + BIN_L * LC0SISAT + BIN_W * WC0SISAT + BIN_WL * PC0SISAT;
    C0SISAT1_i     = C0SISAT1 + BIN_L * LC0SISAT1 + BIN_W * WC0SISAT1 + BIN_WL * PC0SISAT1;


    //Gate current in accumulation in AGBCP2 region
    AIGBCP2_i    = AIGBCP2 + BIN_L * LAIGBCP2 + BIN_W * WAIGBCP2 + BIN_WL * PAIGBCP2;
    AIGBCP2_T_i = AIGBCP2_T + LAIGBCP2_T * BIN_L + WAIGBCP2_T * BIN_W + PAIGBCP2_T * BIN_WL;
    BIGBCP2_i    = BIGBCP2 + BIN_L * LBIGBCP2 + BIN_W * WBIGBCP2 + BIN_WL * PBIGBCP2;
    CIGBCP2_i    = CIGBCP2 + BIN_L * LCIGBCP2 + BIN_W * WCIGBCP2 + BIN_WL * PCIGBCP2;

    //Substrate (back gate)
    NSUB_i    = NSUB + BIN_L * LNSUB + BIN_W * WNSUB + BIN_WL * PNSUB;
    KB1_i     = KB1 + BIN_L * LKB1 + BIN_W * WKB1 + BIN_WL * PKB1;

    if (ASYMMOD != 0) begin
        CDSCDEDGER_i = CDSCDEDGER + BIN_L * LCDSCDEDGER + BIN_W * WCDSCDEDGER + BIN_WL * PCDSCDEDGER;
        CDSCDR_i     = CDSCDR + BIN_L * LCDSCDR + BIN_W * WCDSCDR + BIN_WL * PCDSCDR;
        ETA0R_i      = ETA0R + BIN_L * LETA0R + BIN_W * WETA0R + BIN_WL * PETA0R;
        U0R_i        = U0R + BIN_L * LU0R + BIN_W * WU0R + BIN_WL * PU0R;
        UAR_i        = UAR + BIN_L * LUAR + BIN_W * WUAR + BIN_WL * PUAR;
        UDR_i        = UDR + BIN_L * LUDR + BIN_W * WUDR + BIN_WL * PUDR;
        UCSR_i       = UCSR + BIN_L * LUCSR + BIN_W * WUCSR + BIN_WL * PUCSR;
        UCR_i        = UCR + BIN_L * LUCR + BIN_W * WUCR + BIN_WL * PUCR;
        PCLMR_i      = PCLMR + BIN_L * LPCLMR + BIN_W * WPCLMR + BIN_WL * PPCLMR;
        PDIBLCR_i    = PDIBLCR + BIN_L * LPDIBLCR + BIN_W * WPDIBLCR + BIN_WL * PPDIBLCR;
        VSATR_i      = VSATR + BIN_L * LVSATR + BIN_W * WVSATR + BIN_WL * PVSATR;
        PSATR_i      = PSATR + BIN_L * LPSATR + BIN_W * WPSATR + BIN_WL * PPSATR;
        PTWGR_i      = PTWGR + BIN_L * LPTWGR + BIN_W * WPTWGR + BIN_WL * PPTWGR;
    end

    // Geometrical scaling
    T0        = NDEPL1 * max(pow(Inv_L, NDEPLEXP1) - pow(Inv_Llong, NDEPLEXP1), 0.0) + NDEPL2 * max(pow(Inv_L, NDEPLEXP2) - pow(Inv_Llong, NDEPLEXP2), 0.0);
    T1        = NDEPW * max(pow(Inv_W, NDEPWEXP) - pow(Inv_Wwide, NDEPWEXP), 0.0) + NDEPWL * pow(Inv_W * Inv_L, NDEPWLEXP);
    NDEP_i    = NDEP_i * (1.0 + T0 + T1);
    T0        = NFACTORL * max( pow(Inv_L, NFACTORLEXP) - pow(Inv_Llong, NFACTORLEXP), 0.0);
    T1        = NFACTORW * max( pow(Inv_W, NFACTORWEXP) - pow(Inv_Wwide, NFACTORWEXP), 0.0) + NFACTORWL * pow(Inv_WL, NFACTORWLEXP);
    NFACTOR_i = NFACTOR_i * (1.0 + T0 + T1);
    T0        = (1.0 + CDSCDL * max(pow(Inv_L, CDSCDLEXP) - pow(Inv_Llong, CDSCDLEXP), 0.0));
    CDSCD_i   = CDSCD_i * T0;
    if (ASYMMOD != 0) begin
        CDSCDEDGER_i = CDSCDEDGER_i * T0;
        CDSCDR_i     = CDSCDR_i * T0;
    end
    CDSCB_i = CDSCB_i * (1.0 + CDSCBL * max(pow(Inv_L, CDSCBLEXP) - pow(Inv_Llong, CDSCBLEXP), 0.0));
    U0_i    = MULU0 * U0_i;
    if (MOBSCALE != 1) begin
        if (U0LEXP > 0.0) begin
            U0_i = U0_i * (1.0 - U0L * max(pow(Inv_L, U0LEXP) - pow(Inv_Llong, U0LEXP), 0.0));
            if (ASYMMOD != 0) begin
                U0R_i = U0R_i * (1.0 - U0L * max(pow(Inv_L, U0LEXP) - pow(Inv_Llong, U0LEXP), 0.0));
            end
        end else begin
            U0_i = U0_i * (1.0 - U0L);
            if (ASYMMOD != 0) begin
                U0R_i = U0R_i * (1.0 - U0L);
            end
        end
    end else begin
        U0_i = U0_i * (1.0 - (UP1 * lexp(-Leff / LP1)) - (UP2 * lexp(-Leff / LP2)));
        if (ASYMMOD != 0) begin
            U0R_i = U0R_i * (1.0 - (UP1 * lexp(-Leff / LP1)) - (UP2 * lexp(-Leff / LP2)));
        end
    end
    T0   = UAL * max(pow(Inv_L, UALEXP) - pow(Inv_Llong, UALEXP), 0.0);
    T1   = UAW * max(pow(Inv_W, UAWEXP) - pow(Inv_Wwide, UAWEXP), 0.0) + UAWL * pow(Inv_WL, UAWLEXP);
    UA_i = UA_i * (1.0 + T0 + T1);
    if (ASYMMOD != 0) begin
        UAR_i = UAR_i * (1.0 + T0 + T1);
    end
    T0   = EUL * max(pow(Inv_L, EULEXP) - pow(Inv_Llong, EULEXP), 0.0);
    T1   = EUW * max(pow(Inv_W, EUWEXP) - pow(Inv_Wwide, EUWEXP), 0.0) + EUWL * pow(Inv_WL, EUWLEXP);
    EU_i = EU_i * (1.0 + T0 + T1);
    T0   = 1.0 + UDL * max(pow(Inv_L, UDLEXP) - pow(Inv_Llong, UDLEXP), 0.0);
    UD_i = UD_i * T0;
    if (ASYMMOD != 0) begin
        UDR_i = UDR_i * T0;
    end
    T0   = UCL * max(pow(Inv_L, UCLEXP) - pow(Inv_Llong, UCLEXP), 0.0);
    T1   = UCW * max(pow(Inv_W, UCWEXP) - pow(Inv_Wwide, UCWEXP), 0.0) + UCWL * pow(Inv_WL, UCWLEXP);
    UC_i = UC_i * (1.0 + T0 + T1);
    if (ASYMMOD != 0) begin
        UCR_i = UCR_i * (1.0 + T0 + T1);
    end
    T0     = max(pow(Inv_L, DSUB) - pow(Inv_Llong, DSUB), 0.0);
    ETA0_i = ETA0_i * T0;
    if (ASYMMOD != 0) begin
        ETA0R_i = ETA0R_i * T0;
    end
    ETAB_i     = ETAB_i * max(pow(Inv_L, ETABEXP) - pow(Inv_Llong, ETABEXP), 0.0);
    T0         = 1.0 + PDIBLCL * max(pow(Inv_L, PDIBLCLEXP) - pow(Inv_Llong, PDIBLCLEXP), 0.0);
    PDIBLC_i = PDIBLC_i * T0;
    if (ASYMMOD != 0) begin
        PDIBLCR_i = PDIBLCR_i * T0;
    end
    T0       = DELTA_i * (1.0 + DELTAL * max(pow(Inv_L, DELTALEXP) - pow(Inv_Llong, DELTALEXP), 0.0));
    DELTA_i  = min(T0, 0.5);
    FPROUT_i = FPROUT_i * (1.0 + FPROUTL * max(pow(Inv_L, FPROUTLEXP) - pow(Inv_Llong, FPROUTLEXP), 0.0));
    T0       = (1.0 + PCLML * max(pow(Inv_L, PCLMLEXP) - pow(Inv_Llong, PCLMLEXP), 0.0));
    PCLM_i   = PCLM_i * T0;
    PCLM_i   = max(PCLM_i, 0.0);
    if (ASYMMOD != 0) begin
        PCLMR_i = PCLMR_i * T0;
        PCLMR_i = max(PCLMR_i, 0.0);
    end
    T0     = VSATL * max(pow(Inv_L, VSATLEXP) - pow(Inv_Llong, VSATLEXP), 0.0);
    T1     = VSATW * max(pow(Inv_W, VSATWEXP) - pow(Inv_Wwide, VSATWEXP), 0.0) + VSATWL * pow(Inv_WL, VSATWLEXP);
    VSAT_i = VSAT_i * (1.0 + T0 + T1);
    if (ASYMMOD != 0) begin
        VSATR_i = VSATR_i * (1.0 + T0 + T1);
    end
    PSAT_i = max(PSAT_i * (1.0 + PSATL * max(pow(Inv_L, PSATLEXP) - pow(Inv_Llong, PSATLEXP), 0.0)), 0.25);
    if (ASYMMOD != 0) begin
        PSATR_i = max(PSATR_i * (1.0 + PSATL * max(pow(Inv_L, PSATLEXP) - pow(Inv_Llong, PSATLEXP), 0.0)), 0.25);
    end
    T0     = (1.0 + PTWGL * max(pow(Inv_L, PTWGLEXP) - pow(Inv_Llong, PTWGLEXP), 0.0));
    PTWG_i = PTWG_i * T0;
    if (ASYMMOD != 0) begin
        PTWGR_i = PTWGR_i * T0;
    end
    ALPHA0_i = ALPHA0_i * (1.0 + ALPHA0L * max(pow(Inv_L, ALPHA0LEXP) - pow(Inv_Llong, ALPHA0LEXP), 0.0));
    AGIDL_i  = AGIDL_i * (1.0 + AGIDLL * Inv_L + AGIDLW * Inv_W);
    AGISL_i  = AGISL_i * (1.0 + AGISLL * Inv_L + AGISLW * Inv_W);
    AIGC_i   = AIGC_i * (1.0 + AIGCL * Inv_L + AIGCW * Inv_W);
    AIGS_i   = AIGS_i * (1.0 + AIGSL * Inv_L + AIGSW * Inv_W);
    AIGD_i   = AIGD_i * (1.0 + AIGDL * Inv_L + AIGDW * Inv_W);
    PIGCD_i  = PIGCD * (1.0 + PIGCDL * Inv_L);
    T0       = NDEPCVL1 * max(pow(Inv_Lact, NDEPCVLEXP1) - pow(Inv_Llong, NDEPCVLEXP1), 0.0) + NDEPCVL2 * max( pow(Inv_Lact, NDEPCVLEXP2) - pow(Inv_Llong, NDEPCVLEXP2), 0.0);
    T1       = NDEPCVW * max(pow(Inv_Wact, NDEPCVWEXP) - pow(Inv_Wwide, NDEPCVWEXP), 0.0) + NDEPCVWL * pow(Inv_Wact * Inv_Lact, NDEPCVWLEXP);
    NDEPCV_i = NDEPCV_i * (1.0 + T0 + T1);
    if (SOIMOD == 1) begin
        NDEPCV_i = NDEP_i;
    end else begin
        NDEPCV_i = NDEPCV_i ;
    end
    T0       = VFBL * max(pow(Inv_L, VFBLEXP) - pow(Inv_Llong, VFBLEXP), 0.0);
    T1       = VFBW * max(pow(Inv_W, VFBWEXP) - pow(Inv_Wwide, VFBWEXP), 0.0) + VFBWL * pow(Inv_WL, VFBWLEXP);
    VFB_i    = VFB_i * (1.0 + T0 + T1);
    T0       = VFBCVL * max(pow(Inv_Lact, VFBCVLEXP) - pow(Inv_Llong, VFBCVLEXP), 0.0);
    T1       = VFBCVW * max(pow(Inv_Wact, VFBCVWEXP) - pow(Inv_Wwide, VFBCVWEXP), 0.0) + VFBCVWL * pow(Inv_Wact * Inv_Lact, VFBCVWLEXP);
    VFBCV_i  = VFBCV_i * (1.0 + T0 + T1);
    T0       = VSATCVL * max(pow(Inv_Lact, VSATCVLEXP) - pow(Inv_Llong, VSATCVLEXP), 0.0);
    T1       = VSATCVW * max(pow(Inv_Wact, VSATCVWEXP) - pow(Inv_Wwide, VSATCVWEXP), 0.0) + VSATCVWL * pow(Inv_Wact * Inv_Lact, VSATCVWLEXP);
    VSATCV_i = VSATCV_i * (1.0 + T0 + T1);
    PCLMCV_i = PCLMCV_i * (1.0 + PCLMCVL * max(pow(Inv_Lact, PCLMCVLEXP) - pow(Inv_Llong, PCLMCVLEXP), 0.0));
    PCLMCV_i = max(PCLMCV_i, 0.0);
    T0       = K1L * max(pow(Inv_L, K1LEXP) - pow(Inv_Llong, K1LEXP), 0.0);
    T1       = K1W * max(pow(Inv_W, K1WEXP) - pow(Inv_Wwide, K1WEXP), 0.0) + K1WL * pow(Inv_WL, K1WLEXP);
    K1_i     = K1_i * (1.0 + T0 + T1);
    T0       = K1LEDGE * max(pow(Inv_L, K1LEXPEDGE) - pow(Inv_Llong, K1LEXPEDGE), 0.0);
    T1       = K1WEDGE * max(pow(Inv_W, K1WEXPEDGE) - pow(Inv_Wwide, K1WEXPEDGE), 0.0) + K1WLEDGE * pow(Inv_WL, K1WLEXPEDGE);
    K1EDGE_i = K1EDGE_i * (1.0 + T0 + T1);
    T0       = K2L * max(pow(Inv_L, K2LEXP) - pow(Inv_Llong, K2LEXP), 0.0);
    T1       = K2W * max(pow(Inv_W, K2WEXP) - pow(Inv_Wwide, K2WEXP), 0.0) + K2WL * pow(Inv_WL, K2WLEXP);
    K2_i     = K2_i * (1.0 + T0 + T1);
    T0       = K2LEDGE * max(pow(Inv_L, K2LEXPEDGE) - pow(Inv_Llong, K2LEXPEDGE), 0.0);
    T1       = K2WEDGE * max(pow(Inv_W, K2WEXPEDGE) - pow(Inv_Wwide, K2WEXPEDGE), 0.0) + K2WLEDGE * pow(Inv_WL, K2WLEXPEDGE);
    K2EDGE_i = K2EDGE_i * (1.0 + T0 + T1);
    PRWB_i   = PRWB_i * (1.0 + PRWBL * max( pow(Inv_L, PRWBLEXP) - pow(Inv_Llong, PRWBLEXP), 0));

    // Global scaling parameters for temperature
    UTE_i   = UTE_i * (1.0 + Inv_L * UTEL);
    UA1_i   = UA1_i * (1.0 + Inv_L * UA1L);
    UD1_i   = UD1_i * (1.0 + Inv_L * UD1L);
    AT_i    = AT_i * (1.0 + Inv_L * ATL);
    PTWGT_i = PTWGT_i * (1.0 + Inv_L * PTWGTL);

    if (RDSMOD == 1) begin
        RSW_i = RSW_i * (1.0 + RSWL * max(pow(Inv_L, RSWLEXP) - pow(Inv_Llong, RSWLEXP), 0.0));
        RDW_i = RDW_i * (1.0 + RDWL * max(pow(Inv_L, RDWLEXP) - pow(Inv_Llong, RDWLEXP), 0.0));
    end else begin
        RDSW_i = RDSW_i * (1.0 + RDSWL * max(pow(Inv_L, RDSWLEXP) - pow(Inv_Llong, RDSWLEXP), 0.0));
    end

    // Parameter checking
    if (UCS_i < 1.0) begin
        UCS_i = 1.0;
    end else if (UCS_i > 2.0) begin
        UCS_i = 2.0;
    end
    if (ASYMMOD != 0) begin
        if (UCSR_i < 1.0) begin
            UCSR_i = 1.0;
        end else if (UCSR_i > 2.0) begin
            UCSR_i = 2.0;
        end
    end
    if (CGIDL_i < 0.0) begin
        $error("Fatal: CGIDL_i = %e is negative.", CGIDL_i);
    end
    if (CGISL_i < 0.0) begin
        $error("Fatal: CGISL_i = %e is negative.", CGISL_i);
    end
    if (CKAPPAD_i <= 0.0) begin
        $error("Fatal: CKAPPAD_i = %e is non-positive.", CKAPPAD_i);
    end
    if (CKAPPAS_i <= 0.0) begin
        $error("Fatal: CKAPPAS_i = %e is non-positive.", CKAPPAS_i);
    end
    if (PDITS_i < 0.0) begin
        $error("Fatal: PDITS_i = %e is negative.", PDITS_i);
    end
    if (CIT_i < 0.0) begin
        $error("Fatal: CIT_i = %e is negative.", CIT_i);
    end
    if (NFACTOR_i < 0.0) begin
        $error("Fatal: NFACTOR_i = %e is negative.", NFACTOR_i);
    end
    if (K1_i < 0.0) begin
        $error("Fatal: K1_i = %e is negative.", K1_i);
    end

    if (K1EDGE_i < 0.0) begin
        $error("Fatal: K1EDGE_i = %e is negative.", K1EDGE_i);
    end

    if (NSD_i <= 0.0) begin
        $error("Fatal: NSD_i = %e is non-positive.", NSD_i);
    end
    if (NDEP_i <= 0.0) begin
        $error("Fatal: NDEP_i = %e is non-positive.", NDEP_i);
    end
    if (NDEPCV_i <= 0.0) begin
        $error("Fatal: NDEPCV_i = %e is non-positive.", NDEPCV_i);
    end
    if (NDEPAGBCP2 <= 0.0) begin
        $error("Fatal: NDEPAGBCP2 = %e is non-positive.", NDEPAGBCP2);
    end
    if (NDEPEDGE_i <= 0.0) begin
        $error("Fatal: NDEPEDGE_i = %e is non-positive.", NDEPEDGE_i);
    end
    if (NGATE_i <= 0.0) begin
        $error("Fatal: NGATE_i = %e is non-positive.", NGATE_i);
    end
    if (XJ_i <= 0.0) begin
        $error("Fatal: XJ_i = %e is non-positive.", XJ_i);
    end

    if (IGCMOD != 0) begin
        if (POXEDGE_i <= 0.0) begin
            $error("Fatal: POXEDGE_i = %e is non-positive.", POXEDGE_i);
        end
    end
    if (CDSCD_i < 0.0) begin
        $error("Fatal: CDSCD_i = %e is negative.", CDSCD_i);
    end
    if (ASYMMOD != 0) begin
        if (CDSCDR_i < 0.0) begin
            $error("Fatal: CDSCDR_i = %e is negative.", CDSCDR_i);
        end
        if (CDSCDEDGER_i < 0.0) begin
            $error("Fatal: CDSCDEDGER_i = %e is negative.", CDSCDEDGER_i);
        end
    end
    if (DLCIG_i < 0.0) begin
        $strobe("Warning: DLCIG = %e is negative, setting it to 0.", DLCIG_i);
        DLCIG_i = 0.0;
    end
    if (DLCIGD_i < 0.0) begin
        $strobe("Warning: DLCIGD = %e is negative, setting it to 0.", DLCIGD_i);
        DLCIGD_i = 0.0;
    end
    if (M0_i < 0.0) begin
        $strobe("Warning: M0_i = %e is negative, setting it to 0.", M0_i);
        M0_i = 0.0;
    end
    if (U0_i <= 0.0) begin
        $strobe("Warning: U0_i = %e is non-positive, setting it to the default value.", U0_i);
        U0_i = 0.067;
    end
    if (UA_i < 0.0) begin
        $strobe("Warning: UA_i = %e is negative, setting it to 0.", UA_i);
        UA_i = 0.0;
    end
    if (EU_i < 0.0) begin
        $strobe("Warning: EU_i = %e is negative, setting it to 0.", EU_i);
        EU_i = 0.0;
    end
    if (UD_i < 0.0) begin
        $strobe("Warning: UD_i = %e is negative, setting it to 0.", UD_i);
        UD_i = 0.0;
    end
    if (UCS_i < 0.0) begin
        $strobe("Warning: UCS_i = %e is negative, setting it to 0.", UCS_i);
        UCS_i = 0.0;
    end
    if (NDIODE_i <= 0.0) begin
        $strobe("Warning: NDIODE_i = %e is non-positive, setting it to the default value.", NDIODE_i);
        NDIODE_i = 1.0;
    end
    if (NRECR0_i <= 0.0) begin
        $strobe("Warning: NRECR0_i = %e is non-positive, setting it to the default value.", NRECR0_i);
        NRECR0_i = 10.0;
    end
    if (NRECF0_i <= 0.0) begin
        $strobe("Warning: NRECF0_i = %e is non-positive, setting it to the default value.", NRECF0_i);
        NRECF0_i = 2.0;
    end
    if (CSDMIN < 0.0) begin
        $strobe("Warning: Csdmin = %g is negative.", CSDMIN);
    end

    // Initialize variables used in geometry macros
    nuEndD = 0.0; nuEndS = 0.0; nuIntD = 0.0; nuIntS = 0.0; Rend = 0.0; Rint = 0.0;

    // Process drain series resistance
    DMCGeff = DMCG - DMCGT;
    DMCIeff = DMCI;
    DMDGeff = DMDG - DMCGT;

    // Processing S/D resistances and conductances
    if ($param_given(NRS)) begin
        RSourceGeo = RSH * NRS;
    end else if (RGEOMOD > 0 && RSH > 0.0) begin
        `BSIMBULKRdseffGeo(NF, GEOMOD, RGEOMOD, MINZ, Weff, RSH, DMCGeff, DMCIeff, DMDGeff, 1, RSourceGeo)
    end else begin
        RSourceGeo = 0.0;
    end

    if ($param_given(NRD)) begin
        RDrainGeo = RSH * NRD;
    end else if (RGEOMOD > 0 && RSH > 0.0) begin
        `BSIMBULKRdseffGeo(NF, GEOMOD, RGEOMOD, MINZ, Weff, RSH, DMCGeff, DMCIeff, DMDGeff, 0, RDrainGeo)
    end else begin
        RDrainGeo = 0.0;
    end
    // Clamping of S/D resistances

    if (RDSMOD == 0) begin
        if (RSourceGeo < minr) begin
            RSourceGeo = 0;
        end
        if (RDrainGeo < minr) begin
            RDrainGeo = 0;
        end
    end else begin
        if (RSourceGeo <= minr) begin
            RSourceGeo = minr;
        end
        if (RDrainGeo <= minr) begin
            RDrainGeo = minr;
        end
    end


    if (RDSMOD == 1) begin
        if (RSWMIN_i <= 0.0) begin
            RSWMIN_i = 0.0;
        end
        if (RDWMIN_i <= 0.0) begin
            RDWMIN_i = 0.0;
        end
        if (RSW_i <= 0.0) begin
            RSW_i = 0.0;
        end
        if (RDW_i <= 0.0) begin
            RDW_i = 0.0;
        end
    end else begin
        if (RDSWMIN_i <= 0.0) begin
            RDSWMIN_i = 0.0;
        end
        if (RDSW_i <= 0.0) begin
            RDSW_i = 0.0;
        end
    end

    // Gate process resistance
    Grgeltd = RSHG * (XGW + Weffcj / 3.0 / NGCON) / (NGCON * NF * (Lnew - XGL));
    if (Grgeltd > 0.0) begin
        Grgeltd = 1.0 / Grgeltd;
    end else begin
        Grgeltd = 1.0e3;
        if (RGATEMOD != 0) begin
            `STROBE("Warning: (instance %M) The gate conductance reset to 1.0e3 mho.");
        end
    end
    T0           = TOXE * TOXE;
    T1           = TOXE * POXEDGE_i;
    T2           = T1 * T1;
    ToxRatio     = lexp(NTOX_i * lln(TOXREF / TOXE)) / T0;
    ToxRatioEdge = lexp(NTOX_i * lln(TOXREF / T1)) / T2;
    Aechvb       = (TYPE == `ntype) ? AGBC2P : AGBC2N;
    Bechvb       = (TYPE == `ntype) ? BGBC2P : BGBC2N;
    AechvbEdges   = Aechvb * (Weff / NSEG + PSBCP) * ToxRatioEdge;
    AechvbEdged   = Aechvb * (Weff / NSEG + PDBCP) * ToxRatioEdge;
    BechvbEdge   = -Bechvb * TOXE * POXEDGE_i;
    Aechvb       = Aechvb * (Weff / NSEG * Leff + AGBCPD / NF) * ToxRatio;
    Bechvb       = -Bechvb * TOXE;
    Weff_SH      = WTH0 + Weff;


    if ((SHMOD != 0) && (RTH0 > 0.0) && (Weff_SH > 0.0)) begin
        if (TNODEOUT && !$port_connected(t)) begin
            if ($port_connected(b)) begin             //last terminal is 'b'
                $strobe("\nWarning: A fifth node has been specified with TNODEOUT = 1. The fifth node will be treated as the temperature node 'T'.");
            end else begin
                $strobe("\nWarning: TNODEOUT = 1 requesting an external temperature node, but a fifth node for temperature is not supplied.");
            end
        end
    end else begin
        Temp(t) <+ 0.0;
    end
    // Parameters for self-heating effects
    if ((SHMOD != 0) && (RTH0 > 0.0) && (Weff_SH > 0.0)) begin
        gth = Weff_SH * NF / RTH0;
        cth = CTH0 * Weff_SH * NF;
    end else begin
        // Set gth to some value to prevent a singular G matrix
        gth = 1.0;
        cth = 0.0;
    end

    // Temperature-dependent calculations
    if (TNOM <= -`P_CELSIUS0) begin
        T0 = `REFTEMP - `P_CELSIUS0;
        $strobe("Warning: TNOM = %e C <= %e C. Setting TNOM to %e C.", TNOM, -`P_CELSIUS0, T0);
        Tnom = `REFTEMP;
    end else begin
        Tnom = TNOM + `P_CELSIUS0;
    end
    DevTemp = $temperature + DTEMP;

    // Calculate temperature dependent values for self-heating effects
    if ((SHMOD != 0) && (RTH0 > 0.0)) begin
        if (TNODEOUT != 0 && !$port_connected(t)) begin
            if ($port_connected(b)) begin
                delTemp1 = V(b);
            end else begin //'t' is an internal node
                delTemp1 = Temp(t);
            end
        end else begin
            delTemp1 = Temp(t);
        end
    end else begin
        delTemp1 = 0.0;
    end
    DevTemp    = delTemp1 + DevTemp;
    T_DELTA_SH = Temp(t);
    T_TOTAL_K  = DevTemp;
    T_TOTAL_C  = DevTemp - `P_CELSIUS0;
    Vt         = KboQ * DevTemp;
    inv_Vt     = 1.0 / Vt;
    TRatio     = DevTemp / Tnom;
    delTemp    = DevTemp - Tnom;
    Vtm        = KboQ * DevTemp;
    Vtm0       = KboQ * Tnom;
    Eg         = BG0SUB - TBGASUB * DevTemp * DevTemp / (DevTemp + TBGBSUB);
    T1         = (DevTemp / Tnom) * sqrt(DevTemp / Tnom);
    ni         = NI0SUB * T1 * lexp(Eg / (2.0 * Vtm0) - Eg / (2.0 * Vtm));
    if ((SHMOD != 0) && (RTH0 > 0.0) && (Weff_SH > 0.0)) begin
        T0   = lln(NDEP_i / ni);
        phib = sqrt(T0 * T0 + 1.0e-6);
    end else begin
        phib = lln(NDEP_i / ni);
    end
    if ((SHMOD != 0) && (RTH0 > 0.0) && (Weff_SH > 0.0)) begin
        T0  = lln(NDEPEDGE_i * NSD_i / (ni * ni));
        Vbi_edge = sqrt(T0 * T0 + 1.0e-6);



    end else begin
        Vbi_edge = lln(NDEPEDGE_i * NSD_i / (ni * ni));

    end
    if (NGATE_i > 0.0) begin
        Vfbsdr = -devsign * Vt * lln(NGATE_i / NSD_i) + VFBSDOFF;
    end else begin
        Vfbsdr = 0.0;
    end

    if ($port_connected(b) == 0) begin
        if (BODYMOD != 0) begin
            $strobe("\nWarning: b-node is not connected, however BODYMOD != 0. Assuming Floating-body device!");
        end
        if (MODAGBCP2 != 0) begin
            $strobe("\nWarning: MODAGBCP2 should be set to 0 as it is a floating-body device!");
        end
    end else begin
        if (TNODEOUT && !$port_connected(t)) begin
            if (BODYMOD != 0) begin
                $strobe("\nWarning: last node is b which is a thermal node. Assuming Floating body device!");
            end else begin
                $strobe("\nWarning: last node is b which is a thermal node, however, set BODYMOD != 0. Assuming Floating body device!");
            end
            if (MODAGBCP2 != 0) begin
                $strobe("\nWarning: MODAGBCP2 should be set to 0 as it is a floating-body device!");
            end
        end else begin
            if (BODYMOD == 0) begin
                $strobe("\nWarning: b-node is connected, however BODYMOD = 0. Assuming Floating-body device!");
                if (MODAGBCP2 != 0) begin
                    $strobe("\nWarning: MODAGBCP2 should be set to 0 as it is a floating-body device!");
                end
            end
        end
    end
    if ( (BODYMOD !=0) && ($port_connected (b) == 1) && !((TNODEOUT == 1) && ($port_connected(t) == 0))) begin
        if (MODAGBCP2 == 0) begin
            $strobe("\nWarning: MODAGBCP2 should be set to 1 as it is a body-contacted device!");
        end
    end

    // Short channel effects
    Phist     = max(0.4 + Vt * phib + PHIN_i, 0.4);
    sqrtPhist = sqrt(Phist);
    T1DEP     = sqrt(2.0 * epssi / (`P_Q_NIST1998 * NDEP_i));
    litl      = sqrt((epssi / epsox) * TOXE * XJ_i);
    NFACTOR_t = NFACTOR_i * hypsmooth((1.0 + TNFACTOR * (TRatio - 1.0)), 1e-3);
    ETA0_t    = ETA0_i * (1.0 + TETA0 * (TRatio - 1.0));
    if (ASYMMOD != 0) begin
        ETA0R_t = ETA0R_i * (1.0 + TETA0 * (TRatio - 1.0));
    end

    // Mobility degradation
    eta_mu = (TYPE != `ntype) ? (`Oneby3 * ETAMOB) : (0.5 * ETAMOB);
    U0_t   = U0_i * pow(TRatio, UTE_i);
    UA_t   = UA_i * hypsmooth(1.0 + UA1_i * delTemp - 1.0e-6, 1.0e-3);
    UC_t   = UC_i * hypsmooth(1.0 + UC1_i * delTemp - 1.0e-6, 1.0e-3);
    UD_t   = UD_i * pow(TRatio, UD1_i);
    UCS_t  = UCS_i * pow(TRatio, UCSTE_i);
    EU_t   = EU_i * hypsmooth((1.0 + EU1_i * (TRatio - 1.0)), 1e-3);
    if (ASYMMOD != 0) begin
        U0R_t  = U0R_i * pow(TRatio, UTE_i);
        UAR_t  = UAR_i * hypsmooth(1.0 + UA1_i * delTemp - 1.0e-6, 1.0e-3);
        UCR_t  = UCR_i * hypsmooth(1.0 + UC1_i * delTemp - 1.0e-6, 1.0e-3);
        UDR_t  = UDR_i * pow(TRatio, UD1_i);
        UCSR_t = UCSR_i * pow(TRatio, UCSTE_i);
    end
    rdstemp = pow(TRatio, PRT_i);
    VSAT_t  = VSAT_i * pow(TRatio, -AT_i);
    if (VSAT_t < 100.0) begin
        VSAT_t = 100.0;
    end

    if (ASYMMOD != 0) begin
        VSATR_t = VSATR_i * pow(TRatio, -AT_i);
        if (VSATR_t < 100.0) begin
            VSATR_t = 100.0;
        end
    end
    VSATCV_t = VSATCV_i * pow(TRatio, -AT_i);
    if (VSATCV_t < 100.0) begin
        VSATCV_t = 100.0;
    end
    DELTA_t = 1.0 / ( hypsmooth((1.0 / DELTA_i) * (1.0 + TDELTA * delTemp) - 2.0 , 1.0e-3) + 2.0);
    PTWG_t  = PTWG_i * hypsmooth(1.0 - PTWGT_i * delTemp - 1.0e-6, 1.0e-3);
    if (ASYMMOD != 0) begin
        PTWGR_t = PTWGR_i * hypsmooth(1.0 - PTWGT_i * delTemp - 1.0e-6, 1.0e-3);
    end
    A1_t    = A1_i * hypsmooth(1.0 + A11_i * delTemp - 1.0e-6, 1.0e-3);
    A2_t    = A2_i * hypsmooth(1.0 + A21_i * delTemp - 1.0e-6, 1.0e-3);
    BETA0_t = BETA0_i * pow(TRatio, IIT_i);
    BGIDL_t = BGIDL_i + BGIDL1_i * (TRatio - 1.0);
    BGISL_t = BGISL_i + BGISL1_i * (TRatio - 1.0);
    igtemp  = lexp(IGT_i * lln(TRatio));
    K0_t    = K0_i * hypsmooth(1.0 + K01_i * delTemp - 1.0e-6, 1.0e-3);
    M0_t    = M0_i * hypsmooth(1.0 + M01_i * delTemp - 1.0e-6, 1.0e-3);
    C0_t    = C0_i * hypsmooth(1.0 + C01_i * delTemp - 1.0e-6, 1.0e-3);
    C0SI_t  = C0SI_i * hypsmooth(1.0 + C0SI1_i * delTemp - 1.0e-6, 1.0e-3);
    C0SISAT_t = C0SISAT_i * hypsmooth(1.0 + C0SISAT1_i * delTemp - 1.0e-6, 1.0e-3);

    // Diode model temperature effects
    CJS_t     = CJS * hypsmooth(1.0 + TCJ * delTemp - 1.0e-6, 1.0e-3);
    CJD_t     = CJD * hypsmooth(1.0 + TCJ * delTemp - 1.0e-6, 1.0e-3);
    CJSWS_t   = CJSWS * hypsmooth(1.0 + TCJSW * delTemp - 1.0e-6, 1.0e-3);
    CJSWD_t   = CJSWD * hypsmooth(1.0 + TCJSW * delTemp - 1.0e-6, 1.0e-3);
    CJSWGS_t  = CJSWGS * hypsmooth(1.0 + TCJSWG * delTemp - 1.0e-6, 1.0e-3);
    CJSWGD_t  = CJSWGD * hypsmooth(1.0 + TCJSWG * delTemp - 1.0e-6, 1.0e-3);
    PBS_t     = hypsmooth(PBS - TPB * delTemp - 0.01, 1.0e-3) + 0.01;
    PBD_t     = hypsmooth(PBD - TPB * delTemp - 0.01, 1.0e-3) + 0.01;
    PBSWS_t   = hypsmooth(PBSWS - TPBSW * delTemp - 0.01, 1.0e-3) + 0.01;
    PBSWD_t   = hypsmooth(PBSWD - TPBSW * delTemp - 0.01, 1.0e-3) + 0.01;
    PBSWGS_t  = hypsmooth(PBSWGS - TPBSWG * delTemp - 0.01, 1.0e-3) + 0.01;
    PBSWGD_t  = hypsmooth(PBSWGD - TPBSWG * delTemp - 0.01, 1.0e-3) + 0.01;


    // Effective S/D junction area and perimeters
    `BSIMBULKPAeffGeo(NF, GEOMOD, MINZ, Weffcj, DMCGeff, DMCIeff, DMDGeff, temp_PSeff, temp_PDeff, temp_ASeff, temp_ADeff)
    if ($param_given(AS)) begin
        ASeff = AS * WMLT * LMLT;
    end else begin
        ASeff = temp_ASeff;
    end
    if (ASeff < 0.0) begin
        $strobe("Warning: (instance %M) ASeff = %e is negative. Set to 0.0.", ASeff);
        ASeff = 0.0;
    end
    if ($param_given(AD)) begin
        ADeff = AD * WMLT * LMLT;
    end else begin
        ADeff = temp_ADeff;
    end
    if (ADeff < 0.0) begin
        $strobe("Warning: (instance %M) ADeff = %e is negative. Set to 0.0.", ADeff);
        ADeff = 0.0;
    end
    if ($param_given(PS)) begin
        if (PERMOD == 0) begin
            // PS does not include gate-edge perimeters
            PSeff = PS * WMLT;
        end else begin
            // PS includes gate-edge perimeters
            PSeff = max(PS * WMLT - Weffcj * NF, 0.0);
        end
    end else begin
        PSeff = temp_PSeff;
        if (PSeff < 0.0) begin
            $strobe("Warning: (instance %M) PSeff = %e is negative. Set to 0.0.", PSeff);
            PSeff = 0.0;
        end
    end
    if ($param_given(PD)) begin
        if (PERMOD == 0) begin
            // PD does not include gate-edge perimeters
            PDeff = PD * WMLT;
        end else begin
            // PD includes gate-edge perimeters
            PDeff = max(PD * WMLT - Weffcj * NF, 0.0);
        end
    end else begin
        PDeff = temp_PDeff;
        if (PDeff < 0.0) begin
            $strobe("Warning: (instance %M) PDeff = %e is negative. Set to 0.0.", PDeff);
            PDeff = 0.0;
        end
    end



    // STI stress equations
    if ((SA > 0.0) && (SB > 0.0) && ((NF == 1.0) || ((NF > 1.0) && (SD > 0.0)))) begin
        T0              = pow(Lnew, LLODKU0);
        W_tmp_stress    = Wnew + WLOD;
        T1              = pow(W_tmp_stress, WLODKU0);
        tmp1_stress     = LKU0 / T0 + WKU0 / T1 + PKU0 / (T0 * T1);
        kstress_u0      = 1.0 + tmp1_stress;
        T0              = pow(Lnew, LLODVTH);
        T1              = pow(W_tmp_stress, WLODVTH);
        tmp1_stress_vth = LKVTH0 / T0 + WKVTH0 / T1 + PKVTH0 / (T0 * T1);
        kstress_vth0    = 1.0 + tmp1_stress_vth;
        T0              = TRatio - 1.0;
        ku0_temp        = kstress_u0 * (1.0 + TKU0 * T0) + 1.0e-9;
        for (i = 0; i < NF; i = i + 1) begin: forloop
            T0     = 1.0 / NF / (SA + 0.5 * L_mult + i * (SD + L_mult));
            T1     = 1.0 / NF / (SB + 0.5 * L_mult + i * (SD + L_mult));
            Inv_sa = Inv_sa + T0;
            Inv_sb = Inv_sb + T1;
        end
        Inv_saref   = 1.0 / (SAREF + 0.5 * L_mult);
        Inv_sbref   = 1.0 / (SBREF + 0.5 * L_mult);
        Inv_odref   = Inv_saref + Inv_sbref;
        rho_ref     = (KU0 / ku0_temp) * Inv_odref;
        Inv_od      = Inv_sa + Inv_sb;
        rho         = (KU0 / ku0_temp) * Inv_od;
        mu0_mult    = (1.0 + rho) / (1.0 + rho_ref);
        vsat_mult   = (1.0 + rho * KVSAT) / (1.0 + rho_ref * KVSAT);
        vth0_stress = (KVTH0 / kstress_vth0) * (Inv_od - Inv_odref);
        k2_stress   = (STK2 / pow(kstress_vth0, LODK2)) * (Inv_od - Inv_odref);
        eta_stress  = (STETA0 / pow(kstress_vth0, LODETA0)) * (Inv_od - Inv_odref);
        U0_t        = U0_t * mu0_mult;
        VSAT_t      = VSAT_t * vsat_mult;
        K2_i        = K2_i + k2_stress;
        ETA0_t      = ETA0_t + eta_stress;
        if (EDGEFET == 1) begin
            vth0_stress_EDGE = (KVTH0EDGE_i / kstress_vth0) * (Inv_od - Inv_odref);
            k2_stress_EDGE   = (STK2EDGE_i / pow(kstress_vth0, LODK2)) * (Inv_od - Inv_odref);
            eta_stress_EDGE  = (STETA0EDGE_i / pow(kstress_vth0, LODETA0)) * (Inv_od - Inv_odref);
        end
        K2EDGE_i   = K2EDGE_i + k2_stress_EDGE;
        ETA0EDGE_i = ETA0EDGE_i + eta_stress_EDGE;
    end else begin
        vth0_stress = 0.0;
        vth0_stress_EDGE = 0.0;
    end

    // Well proximity effect
    if (WPEMOD == 1) begin
        Wdrn      = W / NF;
        local_sca = SCA;
        local_scb = SCB;
        local_scc = SCC;
        if (!$param_given(SCA) && !$param_given(SCB) && !$param_given(SCC)) begin
            if ($param_given(SC) && SC > 0.0) begin
                T1        = SC + Wdrn;
                T2        = 1.0 / SCREF;
                local_sca = SCREF * SCREF / (SC * T1);
                local_scb = ((0.1 * SC + 0.01 * SCREF) * lexp(-10.0 * SC * T2)  - (0.1 * T1 + 0.01 * SCREF) *
                            lexp(-10.0 * T1 * T2)) / Wdrn;
                local_scc = ((0.05 * SC + 0.0025 * SCREF) * lexp(-20.0 * SC * T2)  - (0.05 * T1 + 0.0025 * SCREF) *
                            lexp(-20.0 * T1 * T2)) / Wdrn;
            end else begin
                `STROBE("Warning: (Instance %M) No WPE as none of SCA, SCB, SCC, SC is given and/or SC not positive.");
            end
        end
    end
    vth0_well      = KVTH0WE_i * (local_sca + WEB * local_scb + WEC * local_scc);
    k2_well        = K2WE_i * (local_sca + WEB * local_scb + WEC * local_scc);
    vth0_well_edge = KVTH0EDGEWE_i * (local_sca + WEB * local_scb + WEC * local_scc);
    k2_well_edge   = K2EDGEWE_i * (local_sca + WEB * local_scb + WEC * local_scc);
    mu_well        = 1.0 + KU0WE_i * (local_sca + WEB * local_scb + WEC * local_scc);
    U0_t           = U0_t * mu_well;
    K2_i           = K2_i + k2_well;
    K2EDGE_i       = K2EDGE_i + k2_well_edge;

    // Load terminal voltages
    Vg            = devsign * V(gi, bi);
    Vg1           = devsign * V(gi, bi2);
    Vd            = devsign * V(di, bi);
    Vs            = devsign * V(si, bi);
    Vs1           = devsign * V(si, bi2);
    Vds           = Vd - Vs;
    Vds_noswap    = Vds;
    Vsb_noswap    = Vs;
    Vdb_noswap    = Vd;
    Vbs_jct       = devsign * V(bi, si);
    Vbd_jct       = devsign * V(bi, di);
    Vgd_noswap    = Vg - Vd;
    Vgs_noswap    = Vg - Vs;
    Vgd_ov_noswap = devsign * V(gm, di);
    Vgs_ov_noswap = devsign * V(gm, si);

    //Introduced e terminal : substrate terminal
    Ve            = devsign * V(e, bi);
    Ve1           = devsign * V(e, bi2);
    Ves           = Ve - Vs;
    ves           = Ve - Vs;
    ved           = Ve - Vd;
    Vbs           = -devsign * V(si, bi);


    // Terminal voltage conditioning
    // Source-drain interchange
    sigvds = 1.0;
    if (Vds < 0.0) begin
        sigvds = -1.0;
        Vd = devsign * V(si, bi);
        Vs = devsign * V(di, bi);
        Vs1 = devsign * V(di, bi2);
        Ves = Ve - Vs;
        Vbs = -devsign * V(di, bi);

    end
    Vds  = Vd - Vs;
    T0   = AVDSX * Vds;
    if (T0 > `EXPL_THRESHOLD) begin
        T1 = T0;
    end else begin
        T1 = ln(1.0 + lexp(T0));
    end
    Vdsx = ((2.0 / AVDSX) * T1) - Vds - ((2.0 / AVDSX) * ln(2.0));
    Vbsx = -(Vs + 0.5 * (Vds - Vdsx));
    Vbsx1 = -(Vs1 + 0.5 * (Vds - Vdsx));
    Vesx  = Ve + 0.5 * (Vdsx - Vds);

    // Asymmetry model
    T0 = tanh(0.6 * Vds_noswap / Vtm);
    wf = 0.5 + 0.5 * T0;
    wr = 1.0 - wf;
    if (ASYMMOD != 0) begin
        CDSCDEDGE_a = CDSCDEDGER_i * wr + CDSCDEDGE_i * wf;
        CDSCD_a     = CDSCDR_i * wr + CDSCD_i * wf;
        ETA0_a      = ETA0R_t * wr + ETA0_t * wf;
        PDIBLC_a    = PDIBLCR_i * wr + PDIBLC_i * wf;
        PCLM_a      = PCLMR_i * wr + PCLM_i * wf;
        PSAT_a      = PSATR_i * wr + PSAT_i * wf;
        VSAT_a      = VSATR_t * wr + VSAT_t * wf;
        PTWG_a      = PTWGR_t * wr + PTWG_t * wf;
        U0_a        = U0R_t * wr + U0_t * wf;
        UA_a        = UAR_t * wr + UA_t * wf;
        UC_a        = UCR_t * wr + UC_t * wf;
        UD_a        = UDR_t * wr + UD_t * wf;
        UCS_a       = UCSR_t * wr + UCS_t * wf;
    end else begin
        CDSCDEDGE_a = CDSCDEDGE_i;
        CDSCD_a     = CDSCD_i;
        ETA0_a      = ETA0_t;
        PDIBLC_a    = PDIBLC_i;
        PCLM_a      = PCLM_i;
        PSAT_a      = PSAT_i;
        VSAT_a      = VSAT_t;
        PTWG_a      = PTWG_t;
        U0_a        = U0_t;
        UA_a        = UA_t;
        UC_a        = UC_t;
        UD_a        = UD_t;
        UCS_a       = UCS_t;
    end

    //SOIMOD=1 additional effects Back-gate bias dependence
    sclf = sqrt(epsratio * TSI * TOXE);
    sclm = sqrt(TSI * (epsratio * TOXE + 0.375 * TSI));
    teff       = TSI + epsratio * (TOXE + TBOX);
    T0   = ((Vg - VFB_i) * (TBOX * epsratio) + (Ve - VFBB_i) * (TOXE * epsratio + TSI)) / teff ;
    T1   = atan(ASCL_i + BSCL_i * T0) / `M_PI + 0.5;
    scl  = sclm + T1 * (sclf - sclm);

    tmp = DVT1_i * Leff / scl + 1.0e-6;

    if (tmp < 40.0) begin
        Theta_SCE = 0.5 / (cosh(tmp) - 1.0);
    end else begin
        Theta_SCE = lexp(-tmp);
    end


    // SCE, DIBL, SS degradation effects, Ref: BSIM4
    CB = epssi / TSI;
    CBOX = epsox / TBOX;
    `Smooth(Phist - Vbsx, 0.05, 0.1, PhistVbs)
    sqrtPhistVbs = sqrt(PhistVbs);
    Xdep         = T1DEP * sqrtPhistVbs;
    Cdep         = epssi / Xdep;
    cdsc         = CIT_i + NFACTOR_t + CDSCD_a * Vdsx - CDSCB_i * Vbsx;
    T1           = 1.0 + cdsc/Cox;
    if (SOIMOD == 1) begin
        T2        = CB * CBOX / (CB + CBOX);
        T3        = (CDSCD_a + CSECSED * Vesx - CBCBD * Vbsx) * Vdsx;
        T4        = CSECSE0 * Vesx + CSECSE0P * Vesx * Vesx - CBCB0 *Vbsx - CBCB0P *Vbsx*Vbsx  + Theta_SCE * (CDSC_i + CSECSE_i * Vesx + CSECSEP * Vesx * Vesx + CBCB_i *Vbsx + CBCBP *Vbsx * Vbsx+ T3);
        T1        =  (Cox + T2 + CIT_i + NFACTOR_t + T4) / (Cox + T2);
    end
    `Smooth(T1, 1.0, 0.05, n)
    nVt     = n * Vt;
    inv_nVt = 1.0 / nVt;

    // Vth shift for DIBL
    dVth_dibl = -(ETA0_a + ETAB_i * Vbsx) * Vdsx;
    `Smooth2(dVth_dibl, 0.0, 5.0e-5, dVth_dibl)

    // Vth shift with temperature
    dvth_temp = (KT1_i + KT1L / Leff + KT2_i * Vbsx) * (pow(TRatio, KT1EXP) - 1.0);

    // Vth correction for pocket implants
    if (DVTP0_i > 0.0) begin
        T0 = -DVTP1_i * Vdsx;
        if (T0 < -`EXPL_THRESHOLD) begin
            T2 = `MIN_EXPL;
        end else begin
            T2 = lexp(T0);
        end
        T3        = Leff + DVTP0_i * (1.0 + T2);
        dVth_ldop = -nVt * lln(Leff / T3);
    end else begin
        dVth_ldop = 0.0;
    end
    T4        = DVTP5_i + DVTP2_i / pow(Leff, DVTP3_i);
    dVth_ldop = dVth_ldop - T4 * tanh(DVTP4_i * Vdsx);


    // Normalization of terminal and flatband voltage by nVt
    VFB_i = VFB_i + DELVTO;
    vg    = Vg * inv_nVt;
    vs    = Vs * inv_nVt;
    vfb   = VFB_i * inv_nVt;
    vfbb  = VFBB_i * inv_nVt;
    ve = Ve * inv_nVt;

    // Compute dVth_VNUD with "first-order" and "second-order" body-bias effect
    dVth_VNUD = K1_i * (sqrtPhistVbs - sqrtPhist) - K2_i * Vbsx;
    Vth_shift = dVth_dibl + dVth_ldop + dVth_VNUD - dvth_temp + vth0_stress + vth0_well;
    vgfb      = vg - vfb - Vth_shift * inv_nVt;

    vgsfb = vg - Vbsx * inv_nVt - vfb - Vth_shift * inv_nVt;

    //Normalized terminal voltages for DDMOD
    vgfb1 = vg - vfb  - Vth_shift * inv_nVt;
    vgfbb = ve - vfbb;

    // Threshold voltage for operating point information
    gam     = sqrt(2.0 * `P_Q_NIST1998 * epssi * NDEP_i * inv_Vt) / Cox;
    q_vth   = 0.5;
    T0      = hypsmooth((2.0 * phib + Vs * inv_Vt), 1.0e-3);
    nq      = 1.0 + gam / (2.0 * sqrt(T0));
    psip_th = hypsmooth((Vs * inv_Vt + 2.0 * phib + lln(q_vth) + 2.0 * q_vth + lln(2.0 * nq / gam * (2.0 * q_vth * nq / gam + 2.0 * sqrt(T0)))), 1.0e-3);
    VTH     = devsign * (VFB_i + (psip_th - Vs * inv_Vt) * Vt + Vt * gam * sqrt(psip_th) + Vth_shift);
    inv_gam = 1.0 / gam;
    if (SOIMOD == 1) begin
        // Normalized body factor
        gam     = sqrt(2.0 * `P_Q_NIST1998 * epssi * NDEP_i * inv_nVt) / Cox;
        inv_gam = 1.0 / gam;
        gam2 = gam * gam;
        inv_gam2 = 1.0 / gam2;
        // DD Model Back potential solved independently for PD decoupled case.
        CB = epssi / TSI;
        CBOX = epsox / TBOX;
        RC= (CBOX +CDSBS_i) / CB ;
        RT = TOXE / TBOX ;
        gam_sb = gam / RT;
        x1_sb = 1.0 + gam_sb * `invSqrt2;
        limit_sb = 1.0e-7 * x1_sb;
        x1_csb         =  5.0/4.0;
        inv_xi_sb = (1.0/gam_sb);
        gam_sb2 = gam_sb*gam_sb;
        inv_xg1_sb  =  1.0 / (x1_csb + gam_sb * 7.324648775608221e-1);
        if (abs(vgfbb) <= limit_sb) begin
            pd_sb        =  ((-vgfbb ) * inv_xi_sb)*(1.0+gam_sb*((-vgfbb /(6.0*sqrt(2.0)*x1_sb*x1_sb))));
        end else begin
            if (vgfbb  < (-limit_sb)) begin
                PD_yg    =  -vgfbb ;
                PD_z     =  x1_csb * PD_yg  * inv_xi_sb;
                PD_eta   =  0.5 * (PD_z  + 10.0 - sqrt((PD_z  - 6.0) * (PD_z  - 6.0) + 64.0));
                PD_a     =  (PD_yg   - PD_eta) * (PD_yg   - PD_eta) + gam_sb2 * (PD_eta  + 1.0);
                PD_c     =  2.0 * (PD_yg   - PD_eta) - gam_sb2;
                PD_tau   =  lln(PD_a  / gam_sb2) - PD_eta ;
                `sigma0(PD_a, PD_c, PD_tau, PD_eta, PD_y0)
                PD_D0    =  lexp(PD_y0);
                PD_temp  =  PD_yg  - PD_y0 ;
                PD_p     =  2.0 * PD_temp  + gam_sb2 * (PD_D0  - 1.0);
                PD_q     =  PD_temp  * PD_temp  + gam_sb2 * (PD_y0  + 1.0 - PD_D0 );
                PD_xi    =  1.0 - gam_sb2 * 0.5 * PD_D0 ;
                PD_temp  =  PD_p  * PD_p  - 4.0 * (PD_xi  * PD_q );
                PD_w     =  2.0 * (PD_q  / (PD_p  + sqrt(PD_temp )));
                pd_sb    = -(PD_y0  + PD_w );
            end else begin
                PD_Afac  =  (x1_sb * x1_csb * inv_xg1_sb - 1.0) * inv_xg1_sb;
                PD_xbar  =  vgfbb  * inv_xi_sb * (1.0 + PD_Afac * vgfbb );
                PD_temp1 = lexp(-PD_xbar);
                PD_w1    =  1.0 - PD_temp1;
                PD_x0    =  vgfbb  + gam_sb2 * 0.5 - gam_sb * sqrt(vgfbb  + gam_sb2 * 0.25 - PD_w1 );
                PD_D01   =  lexp(-PD_x0);
                PD_p1    =  2.0 * (vgfbb - PD_x0 ) + gam_sb2 * (1.0 - PD_D01 );
                PD_q1    =  (vgfbb  - PD_x0 ) * (vgfbb  - PD_x0 ) - gam_sb2 * (PD_x0  - 1.0 + PD_D01 );
                PD_xi1   =  1.0 - gam_sb2 * 0.5 * PD_D01 ;
                PD_temp1 =  PD_p1  * PD_p1  - 4.0 * (PD_xi1  * PD_q1 );
                PD_u     =  2.0 * (PD_q1  / (PD_p1  + sqrt(PD_temp1 )));
                pd_sb    =  PD_x0  + PD_u ;
            end
        end
        // One iteration given to correct value even at 10th decimal point
        if (abs(vgfbb)  < (limit_sb)) begin
            phisb0=((-vgfbb ) * inv_xi_sb)*(1.0+gam_sb*((-vgfbb /(6.0*sqrt(2.0)*x1_sb*x1_sb))));
            pd_sb=((-vgfbb ) * inv_xi_sb)*(1.0+gam_sb*((-vgfbb /(6.0*sqrt(2.0)*x1_sb*x1_sb))));
        end else begin
            fx = RT*RT*(vgfbb - pd_sb)*(vgfbb - pd_sb)*(1.0/gam)*(1.0/gam) -(lexp(-pd_sb) + pd_sb -1.0);
            f_x = lexp(-pd_sb) + (RT*RT*(2.0*pd_sb - 2.0*vgfbb))/(gam*gam) - 1.0;
            phisb0 =(pd_sb)-(fx /f_x );
        end
        phisb0=phisb0* nVt;

        // DD-MODEL core source side surface potential
        /* Surface potential at source side  DD-MODEL*/
        x1           =  1.0 + gam * `invSqrt2;
        inv_x1       =  1.0 /  x1;
        phisf         =  2.0 * phib/n + vs ;
        exp_ns     =  lexp(-phisf);
        limit       =  1.0e-3 * x1;
        T0 = -DVBD1_i * Leff / litl;
        T1 = DVBD0_i * (lexp(0.5*T0) + 2.0*lexp(T0)) * (0.0 + VSCE_i);
        phic_star  = (1.0 + LPE1_i / Leff)*(`P_Q_NIST1998 * NDEP_i * TSI * TSI) / (2.0 * epssi * nVt) + VBSA/nVt - RC * (vgfbb);
        vg_FD = phic_star + gam * sqrt(lexp(-phic_star) + phic_star -1.0) ;

        if (phic_star <phisf ) begin
            if (vgfb1 < (vg_FD)) begin
                //PD initial Guess
                if (abs(vgfb1) <= limit) begin
                    T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
                    sp_dd         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * T0);
                end else begin
                    if (vgfb1 < (-limit)) begin
                        SP_S_yg   = -vgfb1;
                        SP_S_ysub   = 1.25 * (SP_S_yg * inv_x1);
                        SP_S_eta  =  0.5 * (SP_S_ysub + 10.0 - sqrt((SP_S_ysub - 6.0) * (SP_S_ysub - 6.0) + 64.0));
                        SP_S_temp   = SP_S_yg - SP_S_eta;
                        SP_S_a      = SP_S_temp * SP_S_temp + gam2 * (SP_S_eta + 1.0);
                        SP_S_c      = 2.0 * SP_S_temp - gam2;
                        SP_S_tau    = -SP_S_eta + lln(SP_S_a * inv_gam2);
                        `sigma0(SP_S_a, SP_S_c, SP_S_tau, SP_S_eta, SP_S_y0)
                        SP_S_delta0 = lexp(SP_S_y0);
                        SP_S_delta1 = 1.0 / SP_S_delta0;
                        SP_S_temp   = 1.0 / (2.0 + SP_S_y0 * SP_S_y0);
                        SP_S_xi0    = SP_S_y0 * SP_S_y0 * SP_S_temp;
                        SP_S_xi1    = 4.0 * (SP_S_y0 * SP_S_temp * SP_S_temp);
                        SP_S_xi2    = (8.0 * SP_S_temp - 12.0 * SP_S_xi0) * SP_S_temp * SP_S_temp;
                        SP_S_temp   = SP_S_yg - SP_S_y0;
                        SP_S_temp1  = (exp_ns) * SP_S_delta1;
                        SP_S_pC     = 2.0 * SP_S_temp + gam2 * (SP_S_delta0 - 1.0 - SP_S_temp1 + (exp_ns) * (1.0 - SP_S_xi1));
                        SP_S_qC     = SP_S_temp * SP_S_temp - gam2 * (SP_S_delta0 - SP_S_y0 - 1.0 + SP_S_temp1 + (exp_ns) * (SP_S_y0 - 1.0 - SP_S_xi0));
                        SP_S_temp   = 2.0 - gam2 * (SP_S_delta0 + SP_S_temp1 - (exp_ns) * SP_S_xi2);
                        SP_S_temp   = SP_S_pC * SP_S_pC - 2.0 * (SP_S_qC * SP_S_temp);
                        sp_dd          = -SP_S_y0 - 2.0 * (SP_S_qC / (SP_S_pC + sqrt(SP_S_temp)));
                    end else begin
                        SP_xg1    = 1.0 / (1.25 + gam * 7.324648775608221e-001);
                        SP_S_A_fac= (x1 * 1.25 * SP_xg1 - 1.0) * SP_xg1;
                        SP_S_xbar = vgfb1 * inv_x1 * (1.0 + SP_S_A_fac * vgfb1);
                        SP_S_temp = lexp(-SP_S_xbar);
                        SP_S_w    = 1.0 - SP_S_temp;
                        SP_S_x1   = vgfb1 + gam2 * 0.5 - gam * sqrt(vgfb1 + gam2 * 0.25 - SP_S_w);
                        SP_S_bx   = (phisf) + 3.0;
                        SP_S_eta  = `MINF(SP_S_x1, SP_S_bx, 5.0) - 0.5 * (SP_S_bx - sqrt(SP_S_bx * SP_S_bx + 5.0));
                        SP_S_temp = vgfb1 - SP_S_eta;
                        SP_S_temp1= lexp(-SP_S_eta);
                        SP_S_temp2= 1.0 / (2.0 + SP_S_eta * SP_S_eta);
                        SP_S_xi0  = SP_S_eta * SP_S_eta * SP_S_temp2;
                        SP_S_xi1  = 4.0 * (SP_S_eta * SP_S_temp2 * SP_S_temp2);
                        SP_S_xi2  = (8.0 * SP_S_temp2 - 12.0 * SP_S_xi0) * SP_S_temp2 * SP_S_temp2;
                        SP_S_a    = max(1.0e-40, SP_S_temp * SP_S_temp - gam2 * (SP_S_temp1 + SP_S_eta - 1.0 - (exp_ns) * (SP_S_eta + 1.0 + SP_S_xi0)));
                        SP_S_b    = 1.0 - 0.5 * (gam2 * (SP_S_temp1 - (exp_ns) * SP_S_xi2));
                        SP_S_c    = 2.0 * SP_S_temp + gam2 * (1.0 - SP_S_temp1 - (exp_ns) * (1.0 + SP_S_xi1));
                        SP_S_tau  = (phisf) - SP_S_eta + lln(SP_S_a / gam2);
                        `sigma1(SP_S_a, SP_S_b, SP_S_c, SP_S_tau, SP_S_eta, SP_S_x0)
                        SP_S_delta0 = lexp(SP_S_x0);
                        SP_S_delta1 = 1.0 / SP_S_delta0;
                        SP_S_delta0 = lexp(SP_S_x0 - phisf);
                        SP_S_temp   = 1.0 / (2.0 + SP_S_x0 * SP_S_x0);
                        SP_S_xi0    = SP_S_x0 * SP_S_x0 * SP_S_temp;
                        SP_S_xi1    = 4.0 * (SP_S_x0 * SP_S_temp * SP_S_temp);
                        SP_S_xi2    = (8.0 * SP_S_temp - 12.0 * SP_S_xi0) * SP_S_temp * SP_S_temp;
                        SP_S_temp   = vgfb1 - SP_S_x0;
                        SP_S_pC     = 2.0 * SP_S_temp + gam2 * (1.0 - SP_S_delta1 + SP_S_delta0 - (exp_ns) * (1.0 + SP_S_xi1));
                        SP_S_qC     = SP_S_temp * SP_S_temp - gam2 * (SP_S_delta1 + SP_S_x0 - 1.0 + SP_S_delta0 - (exp_ns) * (SP_S_x0 + 1.0 + SP_S_xi0));
                        SP_S_temp   = 2.0 - gam2 * (SP_S_delta1 + SP_S_delta0 - (exp_ns) * SP_S_xi2);
                        SP_S_temp   = SP_S_pC * SP_S_pC - 2.0 * (SP_S_qC * SP_S_temp);
                        sp_dd       = SP_S_x0 + 2.0 * (SP_S_qC / (SP_S_pC + sqrt(SP_S_temp)));
                    end
                end
            end else begin
                //FD initial Guess
                zeta    = RT;
                zeta2   = zeta * zeta;
                u_crit  = phic_star - phisb0 * inv_nVt;
                usf_FD  = vgfb1 - gam * sqrt(lexp(-u_crit) + u_crit -1.0) ;
                SP_S_bx = (phisf) + 3.0;
                SP_S_Z0 =  `MINF(usf_FD, SP_S_bx, 40.0);
                a_fd = ((vgfb1-SP_S_Z0) * (vgfb1-SP_S_Z0) - zeta2 * (vgfbb-SP_S_Z0 + phic_star) * (vgfbb-SP_S_Z0+phic_star) - gam2 * (phic_star));
                c_fd = 2.0 * (vgfb1 - SP_S_Z0 ) - 2.0 * zeta2 * (vgfbb - SP_S_Z0 + phic_star) ;
                c_fd2 = c_fd * c_fd;
                d_fd = 1.0 - zeta2;
                if (a_fd < 0) begin
                    a_fd = 0.0;
                end
                tau_fd = phisf - SP_S_Z0  + lln(a_fd * inv_gam2);
                v_fd = a_fd + c_fd;
                v_fd2 = v_fd * v_fd;
                mu_fd = v_fd2 / tau_fd  + 0.5 * c_fd2 - a_fd * d_fd;
                temp1_fd = (c_fd * v_fd) / mu_fd;
                temp2_fd = ( `oneThird * c_fd2 - a_fd * d_fd);
                u_first_r = (v_fd * a_fd) / (mu_fd + temp1_fd * temp2_fd);
                u0_first_FD = SP_S_Z0  + u_first_r;
                delta0_fd = lexp(u0_first_FD - phisf);
                p_fd = 2 *(vgfb1-u0_first_FD)- 2.0 * zeta2 * (vgfbb-u0_first_FD + phic_star)+ gam2 * delta0_fd;
                q_fd = (vgfb1-u0_first_FD) * (vgfb1-u0_first_FD) - zeta2 * (vgfbb-u0_first_FD + phic_star) * (vgfbb-u0_first_FD+phic_star)- gam2 * (phic_star+delta0_fd);
                temp3_fd = 2.0 * q_fd * (2.0- 2.0 * zeta2 - gam2 * delta0_fd);
                w_fd= (2.0 * q_fd) / (p_fd + sqrt(p_fd * p_fd - temp3_fd));
                sp_dd  = u0_first_FD + w_fd;
            end
        end else begin
            //PD initial Guess
            if (abs(vgfb1) <= limit) begin
                T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
                sp_dd         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * T0);
            end else begin
                if (vgfb1 < (-limit)) begin
                    SP_S_yg   = -vgfb1;
                    SP_S_ysub   = 1.25 * (SP_S_yg * inv_x1);
                    SP_S_eta  =  0.5 * (SP_S_ysub + 10.0 - sqrt((SP_S_ysub - 6.0) * (SP_S_ysub - 6.0) + 64.0));
                    SP_S_temp   = SP_S_yg - SP_S_eta;
                    SP_S_a      = SP_S_temp * SP_S_temp + gam2 * (SP_S_eta + 1.0);
                    SP_S_c      = 2.0 * SP_S_temp - gam2;
                    SP_S_tau    = -SP_S_eta + lln(SP_S_a * inv_gam2);
                    `sigma0(SP_S_a, SP_S_c, SP_S_tau, SP_S_eta, SP_S_y0)
                    SP_S_delta0 = lexp(SP_S_y0);
                    SP_S_delta1 = 1.0 / SP_S_delta0;
                    SP_S_temp   = 1.0 / (2.0 + SP_S_y0 * SP_S_y0);
                    SP_S_xi0    = SP_S_y0 * SP_S_y0 * SP_S_temp;
                    SP_S_xi1    = 4.0 * (SP_S_y0 * SP_S_temp * SP_S_temp);
                    SP_S_xi2    = (8.0 * SP_S_temp - 12.0 * SP_S_xi0) * SP_S_temp * SP_S_temp;
                    SP_S_temp   = SP_S_yg - SP_S_y0;
                    SP_S_temp1  = (exp_ns) * SP_S_delta1;
                    SP_S_pC     = 2.0 * SP_S_temp + gam2 * (SP_S_delta0 - 1.0 - SP_S_temp1 + (exp_ns) * (1.0 - SP_S_xi1));
                    SP_S_qC     = SP_S_temp * SP_S_temp - gam2 * (SP_S_delta0 - SP_S_y0 - 1.0 + SP_S_temp1 + (exp_ns) * (SP_S_y0 - 1.0 - SP_S_xi0));
                    SP_S_temp   = 2.0 - gam2 * (SP_S_delta0 + SP_S_temp1 - (exp_ns) * SP_S_xi2);
                    SP_S_temp   = SP_S_pC * SP_S_pC - 2.0 * (SP_S_qC * SP_S_temp);
                    SP_S_temp   = sqrt(SP_S_temp * SP_S_temp + 64e-8) - 8e-4;
                    sp_dd          = -SP_S_y0 - 2.0 * (SP_S_qC / (SP_S_pC + sqrt(SP_S_temp)));
                end else begin
                    SP_xg1    = 1.0 / (1.25 + gam * 7.324648775608221e-001);
                    SP_S_A_fac= (x1 * 1.25 * SP_xg1 - 1.0) * SP_xg1;
                    SP_S_xbar = vgfb1 * inv_x1 * (1.0 + SP_S_A_fac * vgfb1);
                    SP_S_temp = lexp(-SP_S_xbar);
                    SP_S_w    = 1.0 - SP_S_temp;
                    SP_S_x1   = vgfb1 + gam2 * 0.5 - gam * sqrt(vgfb1 + gam2 * 0.25 - SP_S_w);
                    SP_S_bx   = (phisf) + 3.0;
                    SP_S_eta  = `MINF(SP_S_x1, SP_S_bx, 5.0) - 0.5 * (SP_S_bx - sqrt(SP_S_bx * SP_S_bx + 5.0));
                    SP_S_temp = vgfb1 - SP_S_eta;
                    SP_S_temp1= lexp(-SP_S_eta);
                    SP_S_temp2= 1.0 / (2.0 + SP_S_eta * SP_S_eta);
                    SP_S_xi0  = SP_S_eta * SP_S_eta * SP_S_temp2;
                    SP_S_xi1  = 4.0 * (SP_S_eta * SP_S_temp2 * SP_S_temp2);
                    SP_S_xi2  = (8.0 * SP_S_temp2 - 12.0 * SP_S_xi0) * SP_S_temp2 * SP_S_temp2;
                    SP_S_a    = max(1.0e-40, SP_S_temp * SP_S_temp - gam2 * (SP_S_temp1 + SP_S_eta - 1.0 - (exp_ns) * (SP_S_eta + 1.0 + SP_S_xi0)));
                    SP_S_b    = 1.0 - 0.5 * (gam2 * (SP_S_temp1 - (exp_ns) * SP_S_xi2));
                    SP_S_c    = 2.0 * SP_S_temp + gam2 * (1.0 - SP_S_temp1 - (exp_ns) * (1.0 + SP_S_xi1));
                    SP_S_tau  = (phisf) - SP_S_eta + lln(SP_S_a / gam2);
                    `sigma1(SP_S_a, SP_S_b, SP_S_c, SP_S_tau, SP_S_eta, SP_S_x0)
                    SP_S_delta0 = lexp(SP_S_x0);
                    SP_S_delta1 = 1.0 / SP_S_delta0;
                    SP_S_delta0 = lexp(SP_S_x0 - phisf);
                    SP_S_temp   = 1.0 / (2.0 + SP_S_x0 * SP_S_x0);
                    SP_S_xi0    = SP_S_x0 * SP_S_x0 * SP_S_temp;
                    SP_S_xi1    = 4.0 * (SP_S_x0 * SP_S_temp * SP_S_temp);
                    SP_S_xi2    = (8.0 * SP_S_temp - 12.0 * SP_S_xi0) * SP_S_temp * SP_S_temp;
                    SP_S_temp   = vgfb1 - SP_S_x0;
                    SP_S_pC     = 2.0 * SP_S_temp + gam2 * (1.0 - SP_S_delta1 + SP_S_delta0 - (exp_ns) * (1.0 + SP_S_xi1));
                    SP_S_qC     = SP_S_temp * SP_S_temp - gam2 * (SP_S_delta1 + SP_S_x0 - 1.0 + SP_S_delta0 - (exp_ns) * (SP_S_x0 + 1.0 + SP_S_xi0));
                    SP_S_temp   = 2.0 - gam2 * (SP_S_delta1 + SP_S_delta0 - (exp_ns) * SP_S_xi2);
                    SP_S_temp   = SP_S_pC * SP_S_pC - 2.0 * (SP_S_qC * SP_S_temp);
                    SP_S_temp   = sqrt(SP_S_temp * SP_S_temp + 64e-8) - 8e-4;
                    sp_dd          = SP_S_x0 + 2.0 * (SP_S_qC / (SP_S_pC + sqrt(SP_S_temp)));
                end
            end
        end

        xs = sp_dd;
        limit1 = 1.0e-7;
        K11 = 2.0;
        SP_S_tempc =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2 ;

        T0 = -DVBD1_i * Leff / litl;
        T1 = DVBD0_i * (lexp(0.5*T0) + 2.0*lexp(T0)) * (0.0 + VSCE_i);
        PHIC =  (1.0 + LPE1_i / Leff)*(`P_Q_NIST1998 * NDEP_i * (TSI * TSI)) / (2.0 * epssi)+ VBSA;
        phic_s = PHIC-RC*(vgfbb*nVt)*CDSBS1_i+ (1.0+RC)*(phisb0);

        //First Iteration of final Poisson's expression
        if (abs(vgfb1)<= (limit1)) begin
            T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
            x7_s         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * T0); // sp-> sp_dd
        end else begin
            T0= (0.5 * (tanh(-5.0 * (vgfb1 - K11)) +  tanh(5.0 * (vgfb1 + K11)) ));
            sp_vfb       =vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * SP_S_tempc) * T0;

            T0  = lexp((xs * nVt - phic_s)/nVt);
            T1  = lexp((sp_vfb * nVt - phic_s)/nVt);
            T2  = ln_one_plus_exp((xs * nVt - phic_s) / nVt) - ln_one_plus_exp((sp_vfb * nVt - phic_s)/nVt);
            T3  = -(phisb0 / nVt + T2/(1.0+RC));
            T4  = lexp(T3);
            T6  = lexp(-xs);
            T7  = xs * xs;
            T8  = 1.0 / (T7 + 2.0);
            T9  = lexp(-phisf);
            T10 = lexp(xs - phisf);

            fx   = (vgfb1 - xs) * (vgfb1 - xs) - RT * RT * (vgfbb + T3) * (vgfbb + T3) - gam2 * (T6 - T4 + xs + T3 + T10 - T9 * (xs + 1.0 + T8 * T7));
            f_x  = (2.0 * T0 * (vgfbb + T3) * RT * RT) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * vgfb1 + 2.0 * xs - gam2 * (T10 + T9 * (-2.0 * xs * T8 + 2.0 * xs * xs * xs * T8 * T8 - 1.0) - T6 - T0 / ((1.0 + RC) * (1.0 + T0)) + (T0 * T4) / ((1.0 + RC) * (1.0 + T0)) + 1.0);

            f_xx = 2.0 * RT * RT * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * RT * RT * T0 * T0 / ((1.0 + RC) * (1.0 + T0) * (1.0 + RC) * (1.0 + T0)) - gam2 * (T6 + T10 - 2.0 * T9 * T8 * (1.0 - T7 * T8 * (5.0 - 4.0 * T7 * T8)) - T0 / ((1.0 + RC) * (1.0 + T0)) * (1.0 - T0 / (1.0 + T0) - T4 + T0 * T4 / (1.0 + T0) * (1.0 + 1.0 / (1.0 + RC)))) - 2.0 * RT * RT * T0 * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0) * (1.0 + T0)) + 2.0;

            x7_s=xs-(fx/f_x)*(1.0 + ((fx*f_xx)/(2.0*f_x*f_x)));

        end

        //Second Iteration of final Poisson's expression
        xs=x7_s;
        if (abs(vgfb1)<= (limit1)) begin
            T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
            x7_s         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * T0); // sp-> sp_dd
        end else begin
            T0= (0.5 * (tanh(-5.0 * (vgfb1 - K11)) +  tanh(5.0 * (vgfb1 + K11)) ));
            sp_vfb       =vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * SP_S_tempc) * T0;

            T0  = lexp((xs * nVt - phic_s)/nVt);
            T1  = lexp((sp_vfb * nVt - phic_s)/nVt);
            T2  = ln_one_plus_exp((xs * nVt - phic_s) / nVt) - ln_one_plus_exp((sp_vfb * nVt - phic_s)/nVt);
            T3  = -(phisb0 / nVt + T2/(1.0+RC));
            T4  = lexp(T3);
            T6  = lexp(-xs);
            T7  = xs * xs;
            T8  = 1.0 / (T7 + 2.0);
            T9  = lexp(-phisf);
            T10 = lexp(xs - phisf);

            fx   = (vgfb1 - xs) * (vgfb1 - xs) - RT * RT * (vgfbb + T3) * (vgfbb + T3) - gam2 * (T6 - T4 + xs + T3 + T10 - T9 * (xs + 1.0 + T8 * T7));
            f_x  = (2.0 * T0 * (vgfbb + T3) * RT * RT) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * vgfb1 + 2.0 * xs - gam2 * (T10 + T9 * (-2.0 * xs * T8 + 2.0 * xs * xs * xs * T8 * T8 - 1.0) - T6 - T0 / ((1.0 + RC) * (1.0 + T0)) + (T0 * T4) / ((1.0 + RC) * (1.0 + T0)) + 1.0);

            f_xx = 2.0 * RT * RT * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * RT * RT * T0 * T0 / ((1.0 + RC) * (1.0 + T0) * (1.0 + RC) * (1.0 + T0)) - gam2 * (T6 + T10 - 2.0 * T9 * T8 * (1.0 - T7 * T8 * (5.0 - 4.0 * T7 * T8)) - T0 / ((1.0 + RC) * (1.0 + T0)) * (1.0 - T0 / (1.0 + T0) - T4 + T0 * T4 / (1.0 + T0) * (1.0 + 1.0 / (1.0 + RC)))) - 2.0 * RT * RT * T0 * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0) * (1.0 + T0)) + 2.0;

            x7_s=xs-(fx/f_x)*(1.0 + ((fx*f_xx)/(2.0*f_x*f_x)));

        end

        //Third Iteration of final Poisson's expression
        xs=x7_s;
        if (abs(vgfb1)<= (limit1)) begin
            T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
            x7_s         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * T0); // sp-> sp_dd
        end else begin
            T0= (0.5 * (tanh(-5.0 * (vgfb1 - K11)) +  tanh(5.0 * (vgfb1 + K11)) ));
            sp_vfb       =vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * SP_S_tempc) * T0;

            T0  = lexp((xs * nVt - phic_s)/nVt);
            T1  = lexp((sp_vfb * nVt - phic_s)/nVt);
            T2  = ln_one_plus_exp((xs * nVt - phic_s) / nVt) - ln_one_plus_exp((sp_vfb * nVt - phic_s)/nVt);
            T3  = -(phisb0 / nVt + T2/(1.0+RC));
            T4  = lexp(T3);
            T6  = lexp(-xs);
            T7  = xs * xs;
            T8  = 1.0 / (T7 + 2.0);
            T9  = lexp(-phisf);
            T10 = lexp(xs - phisf);

            fx   = (vgfb1 - xs) * (vgfb1 - xs) - RT * RT * (vgfbb + T3) * (vgfbb + T3) - gam2 * (T6 - T4 + xs + T3 + T10 - T9 * (xs + 1.0 + T8 * T7));
            f_x  = (2.0 * T0 * (vgfbb + T3) * RT * RT) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * vgfb1 + 2.0 * xs - gam2 * (T10 + T9 * (-2.0 * xs * T8 + 2.0 * xs * xs * xs * T8 * T8 - 1.0) - T6 - T0 / ((1.0 + RC) * (1.0 + T0)) + (T0 * T4) / ((1.0 + RC) * (1.0 + T0)) + 1.0);

            f_xx = 2.0 * RT * RT * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * RT * RT * T0 * T0 / ((1.0 + RC) * (1.0 + T0) * (1.0 + RC) * (1.0 + T0)) - gam2 * (T6 + T10 - 2.0 * T9 * T8 * (1.0 - T7 * T8 * (5.0 - 4.0 * T7 * T8)) - T0 / ((1.0 + RC) * (1.0 + T0)) * (1.0 - T0 / (1.0 + T0) - T4 + T0 * T4 / (1.0 + T0) * (1.0 + 1.0 / (1.0 + RC)))) - 2.0 * RT * RT * T0 * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0) * (1.0 + T0)) + 2.0;

            x7_s=xs-(fx/f_x)*(1.0 + ((fx*f_xx)/(2.0*f_x*f_x)));

        end

        // Drain current and Charge calculation part starts
        Vdsat_lim    =  3.912023005 * nVt;
        if (x7_s <= 0.0) begin
            qis          =  0.0;
            xgm          =  vgfb1 - x7_s;
            Voxm         =  xgm * nVt;
            Vdsat        =  Vdsat_lim;
            Dr = 1.0;
            Nsat = 1.0;
            Mnud = 1.0;
            Mnud1 = 1.0;
            Dvsat = 1.0;
            Dmob  = 1.0;
            Moc = 1.0;
            Mscbe = 1.0;
            Rdrain = RDrainGeo;
            Rsource = RSourceGeo;
        end else begin //vgfb1 >0

            tempc        =  1.0 / (2.0 + x7_s * x7_s);
            xi0s         =  x7_s * x7_s * tempc;
            delta_1s     =  lexp(x7_s);
            Es1          =  1.0 / delta_1s;
            delta_1s     =  lexp(x7_s - phisf);
            Ds           =  delta_1s - lexp(-phisf) * (x7_s + 1.0 + xi0s);
            Ps           =  (vgfb1-x7_s)*(vgfb1-x7_s)*(1.0/gam2) - Ds;
            Ps           = hypsmooth(Ps - 1.0e-3, 1.0e-5) + 1.0e-3;
            sqms         =  sqrt(Ps);
            xgs          =  gam * sqrt(Ps + Ds);
            qis          =  gam2 * Ds * nVt / (xgs + gam * sqms);
            qbs          =  sqms * gam * nVt;
            Em           =  Es1;

            Dm           =  Ds;


            //Drain saturation voltage part implementation (Ref. BSIM4,BSIM-CMG)
            EeffFactor = 1.0e-8 / (epsratio * TOXE);
            Eeffs = EeffFactor * (qbs  + eta_mu * qis);

            // Ref: BSIM4 mobility model

            T2 = lexp(UCS_a * lln(0.5 * (1.0 + (qis / qbs))));

            T3 = (UA_a + UC_a * Vbsx) * pow(Eeffs, EU_t) + UD_a / T2;
            T4 = 1.0 + T3;
            `Smooth(T4, 1.0, 0.0015, Dmobs)

            WeffWRFactor = 1.0 / (pow(Weff * 1.0e6, WR_i) * NF);

            if (RDSMOD == 1) begin
                Rdss = 0.0;
            end else begin
                T0   = 1.0 + PRWG_i * qis;
                T1   = PRWB_i * (sqrtPhistVbs - sqrtPhist);
                T2   = 1.0 / T0 + T1;
                T3   = T2 + sqrt(T2 * T2 + 0.01);
                Rdss = (RDSWMIN_i + RDSW_i * T3) * WeffWRFactor * NF * rdstemp;
                if (RDSMOD == 2) begin
                    Rdss = (RSourceGeo + (RDSWMIN_i + RDSW_i * T3) * WeffWRFactor * NF + RDrainGeo) * rdstemp;
                end
            end

            Esat = 2.0 * VSAT_a / U0_a * Dmobs;
            EsatL = Esat * Leff;
            T6 = KSATIV_i * (qis + 2.0 * nVt);

            if (Rdss > 0.0) begin
                WVCox = Weff * VSAT_a * Cox;
                T0 = WVCox * Rdss;
                Ta = 2.0 * T0;
                Tb = T6 + EsatL + 3.0 * T6 * T0;
                Tc = T6 * (EsatL + 2.0 * T6 * T0);
                Vdsat = (Tb - sqrt(Tb * Tb - 2.0 * Ta * Tc)) / Ta;
            end else begin
                Vdsat = EsatL * T6 / (EsatL + T6);
            end

            if (A0 == 0.0 && AGS == 0.0) begin
                AbulkIV = 1.0;
            end else begin
                T1  = Leff / (Leff + sqrt(XJ_i * Xdep));
                AbulkIV = 1.0 + (A0 * T1 - AGS * T1 * pow(qis,AGS1) * nVt) / (1.0 + KETA * Vbsx);
                `Smooth(AbulkIV, 0.1, 0.0005, AbulkIV)
            end

            Vdsat   = hypsmooth(Vdsat - 1.0e-3, 1.0e-5) + 1.0e-3;
            Vdsat    = Vdsat / AbulkIV;
            T7      = pow((Vds / Vdsat) + 1.0e-6, 1.0 / DELTA_t);
            T8      = pow(1.0 + T7, -DELTA_t);
            Vdseff  = Vds * T8;
            vdeff   = (Vdseff +Vs) * inv_nVt;

            /* Surface potential at Drain side  DD-MODEL*/
            phidf         =  2 * phib/n + vdeff;
            exp_nd     =  lexp(-phidf);
            limit       =  1.0e-3 * x1;
            T0 = -DVBD1_i * Leff / litl;
            T1 = DVBD0_i * (lexp(0.5*T0) + 2.0*lexp(T0)) * (Vds* inv_nVt + VSCE_i* inv_nVt);
            phic_star  = (1.0 + LPE1_i / Leff)*(`P_Q_NIST1998 * NDEP_i * TSI * TSI) / (2.0 * epssi * nVt) + VBSA/nVt - RC * (vgfbb)*CDSBS1_i + (1.0+RC)*T1;

            vg_FD = phic_star + gam * sqrt(lexp(-phic_star) + phic_star -1.0 );

            if (phic_star < phidf) begin
                if (vgfb1 < (vg_FD)) begin
                    //PD initial Guess
                    if (abs(vgfb1) <= limit) begin
                        T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
                        sp_dd         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_nd)) * gam * T0);// sp-> sp_dd
                    end else begin
                        if (vgfb1 < (-limit)) begin
                            SP_S_yg   = -vgfb1;
                            SP_S_ysub   = 1.25 * (SP_S_yg * inv_x1);
                            SP_S_eta  =  0.5 * (SP_S_ysub + 10.0 - sqrt((SP_S_ysub - 6.0) * (SP_S_ysub - 6.0) + 64.0));
                            SP_S_temp   = SP_S_yg - SP_S_eta;
                            SP_S_a      = SP_S_temp * SP_S_temp + gam2 * (SP_S_eta + 1.0);
                            SP_S_c      = 2.0 * SP_S_temp - gam2;
                            SP_S_tau    = -SP_S_eta + lln(SP_S_a * inv_gam2);
                            `sigma0(SP_S_a, SP_S_c, SP_S_tau, SP_S_eta, SP_S_y0)
                            SP_S_delta0 = lexp(SP_S_y0);
                            SP_S_delta1 = 1.0 / SP_S_delta0;
                            SP_S_temp   = 1.0 / (2.0 + SP_S_y0 * SP_S_y0);
                            SP_S_xi0    = SP_S_y0 * SP_S_y0 * SP_S_temp;
                            SP_S_xi1    = 4.0 * (SP_S_y0 * SP_S_temp * SP_S_temp);
                            SP_S_xi2    = (8.0 * SP_S_temp - 12.0 * SP_S_xi0) * SP_S_temp * SP_S_temp;
                            SP_S_temp   = SP_S_yg - SP_S_y0;
                            SP_S_temp1  = (exp_nd) * SP_S_delta1;
                            SP_S_pC     = 2.0 * SP_S_temp + gam2 * (SP_S_delta0 - 1.0 - SP_S_temp1 + (exp_nd) * (1.0 - SP_S_xi1));
                            SP_S_qC     = SP_S_temp * SP_S_temp - gam2 * (SP_S_delta0 - SP_S_y0 - 1.0 + SP_S_temp1 + (exp_nd) * (SP_S_y0 - 1.0 - SP_S_xi0));
                            SP_S_temp   = 2.0 - gam2 * (SP_S_delta0 + SP_S_temp1 - (exp_nd) * SP_S_xi2);
                            SP_S_temp   = SP_S_pC * SP_S_pC - 2.0 * (SP_S_qC * SP_S_temp);
                            sp_dd          = -SP_S_y0 - 2.0 * (SP_S_qC / (SP_S_pC + sqrt(SP_S_temp)));
                        end else begin
                            SP_xg1    = 1.0 / (1.25 + gam * 7.324648775608221e-001);
                            SP_S_A_fac= (x1 * 1.25 * SP_xg1 - 1.0) * SP_xg1;
                            SP_S_xbar = vgfb1 * inv_x1 * (1.0 + SP_S_A_fac * vgfb1);
                            SP_S_temp = lexp(-SP_S_xbar);
                            SP_S_w    = 1.0 - SP_S_temp;
                            SP_S_x1   = vgfb1 + gam2 * 0.5 - gam * sqrt(vgfb1 + gam2 * 0.25 - SP_S_w);
                            SP_S_bx   = (phidf) + 3.0;
                            SP_S_eta  = `MINF(SP_S_x1, SP_S_bx, 5.0) - 0.5 * (SP_S_bx - sqrt(SP_S_bx * SP_S_bx + 5.0));
                            SP_S_temp = vgfb1 - SP_S_eta;
                            SP_S_temp1= lexp(-SP_S_eta);
                            SP_S_temp2= 1.0 / (2.0 + SP_S_eta * SP_S_eta);
                            SP_S_xi0  = SP_S_eta * SP_S_eta * SP_S_temp2;
                            SP_S_xi1  = 4.0 * (SP_S_eta * SP_S_temp2 * SP_S_temp2);
                            SP_S_xi2  = (8.0 * SP_S_temp2 - 12.0 * SP_S_xi0) * SP_S_temp2 * SP_S_temp2;
                            SP_S_a    = max(1.0e-40, SP_S_temp * SP_S_temp - gam2 * (SP_S_temp1 + SP_S_eta - 1.0 - (exp_nd) * (SP_S_eta + 1.0 + SP_S_xi0)));
                            SP_S_b    = 1.0 - 0.5 * (gam2 * (SP_S_temp1 - (exp_nd) * SP_S_xi2));
                            SP_S_c    = 2.0 * SP_S_temp + gam2 * (1.0 - SP_S_temp1 - (exp_nd) * (1.0 + SP_S_xi1));
                            SP_S_tau  = (phidf) - SP_S_eta + lln(SP_S_a / gam2);
                            `sigma1(SP_S_a, SP_S_b, SP_S_c, SP_S_tau, SP_S_eta, SP_S_x0)
                            SP_S_delta0 = lexp(SP_S_x0);
                            SP_S_delta1 = 1.0 / SP_S_delta0;
                            SP_S_delta0 = lexp(SP_S_x0 - phidf);
                            SP_S_temp   = 1.0 / (2.0 + SP_S_x0 * SP_S_x0);
                            SP_S_xi0    = SP_S_x0 * SP_S_x0 * SP_S_temp;
                            SP_S_xi1    = 4.0 * (SP_S_x0 * SP_S_temp * SP_S_temp);
                            SP_S_xi2    = (8.0 * SP_S_temp - 12.0 * SP_S_xi0) * SP_S_temp * SP_S_temp;
                            SP_S_temp   = vgfb1 - SP_S_x0;
                            SP_S_pC     = 2.0 * SP_S_temp + gam2 * (1.0 - SP_S_delta1 + SP_S_delta0 - (exp_nd) * (1.0 + SP_S_xi1));
                            SP_S_qC     = SP_S_temp * SP_S_temp - gam2 * (SP_S_delta1 + SP_S_x0 - 1.0 + SP_S_delta0 - (exp_nd) * (SP_S_x0 + 1.0 + SP_S_xi0));
                            SP_S_temp   = 2.0 - gam2 * (SP_S_delta1 + SP_S_delta0 - (exp_nd) * SP_S_xi2);
                            SP_S_temp   = SP_S_pC * SP_S_pC - 2.0 * (SP_S_qC * SP_S_temp);
                            sp_dd          = SP_S_x0 + 2.0 * (SP_S_qC / (SP_S_pC + sqrt(SP_S_temp)));
                        end
                    end
                end else begin
                    //FD initial Guess
                    zeta    = RT;
                    zeta2   = zeta * zeta;
                    u_crit  = phic_star - phisb0 * inv_nVt;
                    usf_FD  = vgfb1 - gam * sqrt(lexp(-u_crit) + u_crit -1.0);
                    SP_S_bx = (phidf) + 3.0;
                    SP_S_Z0 =  `MINF(usf_FD, SP_S_bx, 40.0);
                    a_fd = ((vgfb1-SP_S_Z0) * (vgfb1-SP_S_Z0) - zeta2 * (vgfbb-SP_S_Z0 + phic_star) * (vgfbb-SP_S_Z0+phic_star) - gam2 * (phic_star));
                    c_fd = 2.0 * (vgfb1 - SP_S_Z0 ) - 2.0 * zeta2 * (vgfbb - SP_S_Z0 + phic_star) ;
                    c_fd2 = c_fd * c_fd;
                    d_fd = 1.0 - zeta2;
                    if (a_fd < 0) begin
                        a_fd = 0.0;
                    end
                    tau_fd = phidf - SP_S_Z0  + lln(a_fd * inv_gam2);
                    v_fd = a_fd + c_fd;
                    v_fd2 = v_fd * v_fd;
                    mu_fd = v_fd2 / tau_fd  + 0.5 * c_fd2 - a_fd * d_fd;
                    temp1_fd = (c_fd * v_fd) / mu_fd;
                    temp2_fd = ( `oneThird * c_fd2 - a_fd * d_fd);
                    u_first_r = (v_fd * a_fd) / (mu_fd + temp1_fd * temp2_fd);
                    u0_first_FD = SP_S_Z0  + u_first_r;
                    delta0_fd = lexp(u0_first_FD - phidf);
                    p_fd = 2.0 *(vgfb1-u0_first_FD)- 2.0 * zeta2 * (vgfbb-u0_first_FD + phic_star)+ gam2 * delta0_fd;
                    q_fd = (vgfb1-u0_first_FD) * (vgfb1-u0_first_FD) - zeta2 * (vgfbb-u0_first_FD + phic_star) * (vgfbb-u0_first_FD+phic_star)- gam2 * (phic_star+delta0_fd);
                    temp3_fd = 2.0 * q_fd * (2.0- 2.0 * zeta2 - gam2 * delta0_fd);
                    w_fd= (2.0 * q_fd) / (p_fd + sqrt(p_fd * p_fd - temp3_fd));
                    sp_dd  = u0_first_FD + w_fd;
                end
            end else begin
                //PD initial Guess
                if (abs(vgfb1) <= limit) begin
                    T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
                    sp_dd         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_nd)) * gam * T0);// sp-> sp_dd
                end else begin
                    if (vgfb1 < (-limit)) begin
                        SP_S_yg   = -vgfb1;
                        SP_S_ysub   = 1.25 * (SP_S_yg * inv_x1);
                        SP_S_eta  =  0.5 * (SP_S_ysub + 10.0 - sqrt((SP_S_ysub - 6.0) * (SP_S_ysub - 6.0) + 64.0));
                        SP_S_temp   = SP_S_yg - SP_S_eta;
                        SP_S_a      = SP_S_temp * SP_S_temp + gam2 * (SP_S_eta + 1.0);
                        SP_S_c      = 2.0 * SP_S_temp - gam2;
                        SP_S_tau    = -SP_S_eta + lln(SP_S_a * inv_gam2);
                        `sigma0(SP_S_a, SP_S_c, SP_S_tau, SP_S_eta, SP_S_y0)

                        SP_S_delta0 = lexp(SP_S_y0);
                        SP_S_delta1 = 1.0 / SP_S_delta0;
                        SP_S_temp   = 1.0 / (2.0 + SP_S_y0 * SP_S_y0);
                        SP_S_xi0    = SP_S_y0 * SP_S_y0 * SP_S_temp;
                        SP_S_xi1    = 4.0 * (SP_S_y0 * SP_S_temp * SP_S_temp);
                        SP_S_xi2    = (8.0 * SP_S_temp - 12.0 * SP_S_xi0) * SP_S_temp * SP_S_temp;
                        SP_S_temp   = SP_S_yg - SP_S_y0;
                        SP_S_temp1  = (exp_nd) * SP_S_delta1;
                        SP_S_pC     = 2.0 * SP_S_temp + gam2 * (SP_S_delta0 - 1.0 - SP_S_temp1 + (exp_nd) * (1.0 - SP_S_xi1));
                        SP_S_qC     = SP_S_temp * SP_S_temp - gam2 * (SP_S_delta0 - SP_S_y0 - 1.0 + SP_S_temp1 + (exp_nd) * (SP_S_y0 - 1.0 - SP_S_xi0));
                        SP_S_temp   = 2.0 - gam2 * (SP_S_delta0 + SP_S_temp1 - (exp_nd) * SP_S_xi2);
                        SP_S_temp   = SP_S_pC * SP_S_pC - 2.0 * (SP_S_qC * SP_S_temp);
                        sp_dd       = -SP_S_y0 - 2.0 * (SP_S_qC / (SP_S_pC + sqrt(SP_S_temp)));
                    end else begin
                        SP_xg1    = 1.0 / (1.25 + gam * 7.324648775608221e-001);
                        SP_S_A_fac= (x1 * 1.25 * SP_xg1 - 1.0) * SP_xg1;
                        SP_S_xbar = vgfb1 * inv_x1 * (1.0 + SP_S_A_fac * vgfb1);
                        SP_S_temp = lexp(-SP_S_xbar);
                        SP_S_w    = 1.0 - SP_S_temp;
                        SP_S_x1   = vgfb1 + gam2 * 0.5 - gam * sqrt(vgfb1 + gam2 * 0.25 - SP_S_w);
                        SP_S_bx   = (phidf) + 3.0;
                        SP_S_eta  = `MINF(SP_S_x1, SP_S_bx, 5.0) - 0.5 * (SP_S_bx - sqrt(SP_S_bx * SP_S_bx + 5.0));
                        SP_S_temp = vgfb1 - SP_S_eta;
                        SP_S_temp1= lexp(-SP_S_eta);
                        SP_S_temp2= 1.0 / (2.0 + SP_S_eta * SP_S_eta);
                        SP_S_xi0  = SP_S_eta * SP_S_eta * SP_S_temp2;
                        SP_S_xi1  = 4.0 * (SP_S_eta * SP_S_temp2 * SP_S_temp2);
                        SP_S_xi2  = (8.0 * SP_S_temp2 - 12.0 * SP_S_xi0) * SP_S_temp2 * SP_S_temp2;
                        SP_S_a    = max(1.0e-40, SP_S_temp * SP_S_temp - gam2 * (SP_S_temp1 + SP_S_eta - 1.0 - (exp_nd) * (SP_S_eta + 1.0 + SP_S_xi0)));
                        SP_S_b    = 1.0 - 0.5 * (gam2 * (SP_S_temp1 - (exp_nd) * SP_S_xi2));
                        SP_S_c    = 2.0 * SP_S_temp + gam2 * (1.0 - SP_S_temp1 - (exp_nd) * (1.0 + SP_S_xi1));
                        SP_S_tau  = (phidf) - SP_S_eta + lln(SP_S_a / gam2);
                        `sigma1(SP_S_a, SP_S_b, SP_S_c, SP_S_tau, SP_S_eta, SP_S_x0)
                        SP_S_delta0 = lexp(SP_S_x0);
                        SP_S_delta1 = 1.0 / SP_S_delta0;
                        SP_S_delta0 = lexp(SP_S_x0 - phidf);
                        SP_S_temp   = 1.0 / (2.0 + SP_S_x0 * SP_S_x0);
                        SP_S_xi0    = SP_S_x0 * SP_S_x0 * SP_S_temp;
                        SP_S_xi1    = 4.0 * (SP_S_x0 * SP_S_temp * SP_S_temp);
                        SP_S_xi2    = (8.0 * SP_S_temp - 12.0 * SP_S_xi0) * SP_S_temp * SP_S_temp;
                        SP_S_temp   = vgfb1 - SP_S_x0;
                        SP_S_pC     = 2.0 * SP_S_temp + gam2 * (1.0 - SP_S_delta1 + SP_S_delta0 - (exp_nd) * (1.0 + SP_S_xi1));
                        SP_S_qC     = SP_S_temp * SP_S_temp - gam2 * (SP_S_delta1 + SP_S_x0 - 1.0 + SP_S_delta0 - (exp_nd) * (SP_S_x0 + 1.0 + SP_S_xi0));
                        SP_S_temp   = 2.0 - gam2 * (SP_S_delta1 + SP_S_delta0 - (exp_nd) * SP_S_xi2);
                        SP_S_temp   = SP_S_pC * SP_S_pC - 2.0 * (SP_S_qC * SP_S_temp);
                        sp_dd          = SP_S_x0 + 2.0 * (SP_S_qC / (SP_S_pC + sqrt(SP_S_temp)));
                    end
                end
            end

            xs = sp_dd;
            limit1 = 1e-7;
            K11 = 2.0;
            SP_S_tempc =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2 ;
            PHIC =  (1.0 + LPE1_i / Leff)*(`P_Q_NIST1998 * NDEP_i * (TSI * TSI)) / (2.0 * epssi) + VBSA;
            T0 = -DVBD1_i * Leff / litl;
            T1 = DVBD0_i * (lexp(0.5*T0) + 2.0*lexp(T0)) * (Vds* inv_nVt + VSCE_i* inv_nVt);
            phic_s =PHIC-RC*(vgfbb*nVt)*CDSBS1_i + (1.0+RC)*T1*nVt+ (1.0+RC)*(phisb0);

            //First Iteration of final Poisson's expression
            if (abs(vgfb1)<= (limit1)) begin
                T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
                x7_d         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * T0);
            end else begin
                T0= (0.5 * (tanh(-5.0 * (vgfb1 - K11)) +  tanh(5.0 * (vgfb1 + K11)) ));
                sp_vfb       =vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (lexp(-phidf))) * gam * SP_S_tempc) * T0;

                T0  = lexp((xs * nVt - phic_s)/nVt);
                T1  = lexp((sp_vfb * nVt - phic_s)/nVt);
                T2  = ln_one_plus_exp((xs * nVt - phic_s) / nVt) - ln_one_plus_exp((sp_vfb * nVt - phic_s)/nVt);
                T3  = -(phisb0 / nVt + T2/(1.0+RC));
                T4  = lexp(T3);
                T6  = lexp(-xs);
                T7  = xs * xs;
                T8  = 1.0 / (T7 + 2.0);
                T9  = lexp(-phidf);
                T10 = lexp(xs - phidf);

                fx   = (vgfb1 - xs) * (vgfb1 - xs) - RT * RT * (vgfbb + T3) * (vgfbb + T3) - gam2 * (T6 - T4 + xs + T3 + T10 - T9 * (xs + 1.0 + T8 * T7));
                f_x  = (2.0 * T0 * (vgfbb + T3) * RT * RT) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * vgfb1 + 2.0 * xs - gam2 * (T10 + T9 * (-2.0 * xs * T8 + 2.0 * xs * xs * xs * T8 * T8 - 1.0) - T6 - T0 / ((1.0 + RC) * (1.0 + T0)) + (T0 * T4) / ((1.0 + RC) * (1.0 + T0)) + 1.0);
                f_xx = 2.0 * RT * RT * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * RT * RT * T0 * T0 / ((1.0 + RC) * (1.0 + T0) * (1.0 + RC) * (1.0 + T0)) - gam2 * (T6 + T10 - 2.0 * T9 * T8 * (1.0 - T7 * T8 * (5.0 - 4.0 * T7 * T8)) - T0 / ((1.0 + RC) * (1.0 + T0)) * (1.0 - T0 / (1.0 + T0) - T4 + T0 * T4 / (1.0 + T0) * (1.0 + 1.0 / (1.0 + RC)))) - 2.0 * RT * RT * T0 * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0) * (1.0 + T0)) + 2.0;

                x7_d=xs-(fx/f_x)*(1.0 + ((fx*f_xx)/(2.0*f_x*f_x)));
            end

            //Second Iteration of final Poisson's expression
            xs=x7_d;
            if (abs(vgfb1)<= (limit1)) begin
                T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
                x7_d         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * T0);
            end else begin
                T0= (0.5 * (tanh(-5.0 * (vgfb1 - K11)) +  tanh(5.0 * (vgfb1 + K11)) ));
                sp_vfb       =vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (lexp(-phidf))) * gam * SP_S_tempc) * T0;

                T0  = lexp((xs * nVt - phic_s)/nVt);
                T1  = lexp((sp_vfb * nVt - phic_s)/nVt);
                T2  = ln_one_plus_exp((xs * nVt - phic_s) / nVt) - ln_one_plus_exp((sp_vfb * nVt - phic_s)/nVt);
                T3  = -(phisb0 / nVt + T2/(1.0+RC));
                T4  = lexp(T3);
                T6  = lexp(-xs);
                T7  = xs * xs;
                T8  = 1.0 / (T7 + 2.0);
                T9  = lexp(-phidf);
                T10 = lexp(xs - phidf);

                fx   = (vgfb1 - xs) * (vgfb1 - xs) - RT * RT * (vgfbb + T3) * (vgfbb + T3) - gam2 * (T6 - T4 + xs + T3 + T10 - T9 * (xs + 1.0 + T8 * T7));
                f_x  = (2.0 * T0 * (vgfbb + T3) * RT * RT) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * vgfb1 + 2.0 * xs - gam2 * (T10 + T9 * (-2.0 * xs * T8 + 2.0 * xs * xs * xs * T8 * T8 - 1.0) - T6 - T0 / ((1.0 + RC) * (1.0 + T0)) + (T0 * T4) / ((1.0 + RC) * (1.0 + T0)) + 1.0);
                f_xx = 2.0 * RT * RT * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * RT * RT * T0 * T0 / ((1.0 + RC) * (1.0 + T0) * (1.0 + RC) * (1.0 + T0)) - gam2 * (T6 + T10 - 2.0 * T9 * T8 * (1.0 - T7 * T8 * (5.0 - 4.0 * T7 * T8)) - T0 / ((1.0 + RC) * (1.0 + T0)) * (1.0 - T0 / (1.0 + T0) - T4 + T0 * T4 / (1.0 + T0) * (1.0 + 1.0 / (1.0 + RC)))) - 2.0 * RT * RT * T0 * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0) * (1.0 + T0)) + 2.0;

                x7_d=xs-(fx/f_x)*(1.0 + ((fx*f_xx)/(2.0*f_x*f_x)));
            end

            //Third Iteration of final Poisson's expression
            xs=x7_d;
            if (abs(vgfb1)<= (limit1)) begin
                T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
                x7_d         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * T0);
            end else begin
                T0= (0.5 * (tanh(-5.0 * (vgfb1 - K11)) +  tanh(5.0 * (vgfb1 + K11)) ));
                sp_vfb       =vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (lexp(-phidf))) * gam * SP_S_tempc) * T0;

                T0  = lexp((xs * nVt - phic_s)/nVt);
                T1  = lexp((sp_vfb * nVt - phic_s)/nVt);
                T2  = ln_one_plus_exp((xs * nVt - phic_s) / nVt) - ln_one_plus_exp((sp_vfb * nVt - phic_s)/nVt);
                T3  = -(phisb0 / nVt + T2/(1.0+RC));
                T4  = lexp(T3);
                T6  = lexp(-xs);
                T7  = xs * xs;
                T8  = 1.0 / (T7 + 2.0);
                T9  = lexp(-phidf);
                T10 = lexp(xs - phidf);

                fx   = (vgfb1 - xs) * (vgfb1 - xs) - RT * RT * (vgfbb + T3) * (vgfbb + T3) - gam2 * (T6 - T4 + xs + T3 + T10 - T9 * (xs + 1.0 + T8 * T7));
                f_x  = (2.0 * T0 * (vgfbb + T3) * RT * RT) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * vgfb1 + 2.0 * xs - gam2 * (T10 + T9 * (-2.0 * xs * T8 + 2.0 * xs * xs * xs * T8 * T8 - 1.0) - T6 - T0 / ((1.0 + RC) * (1.0 + T0)) + (T0 * T4) / ((1.0 + RC) * (1.0 + T0)) + 1.0);
                f_xx = 2.0 * RT * RT * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * RT * RT * T0 * T0 / ((1.0 + RC) * (1.0 + T0) * (1.0 + RC) * (1.0 + T0)) - gam2 * (T6 + T10 - 2.0 * T9 * T8 * (1.0 - T7 * T8 * (5.0 - 4.0 * T7 * T8)) - T0 / ((1.0 + RC) * (1.0 + T0)) * (1.0 - T0 / (1.0 + T0) - T4 + T0 * T4 / (1.0 + T0) * (1.0 + 1.0 / (1.0 + RC)))) - 2.0 * RT * RT * T0 * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0) * (1.0 + T0)) + 2.0;

                x7_d=xs-(fx/f_x)*(1.0 + ((fx*f_xx)/(2.0*f_x*f_x)));
            end

            x_ds         =  x7_d - x7_s;

            //Approximations for extremely small x7_ds: capacitance calculation
            Udse         =  (Vds)*inv_nVt;
            k_ds         =  lexp(-Udse);
            if (x_ds < 1.0e-10) begin
                T0  = lexp((xs * nVt - phic_s) / nVt);
                T1  = lexp((sp_vfb * nVt - phic_s) / nVt);
                T2  = ln_one_plus_exp((xs * nVt - phic_s) / nVt) - ln_one_plus_exp((sp_vfb * nVt - phic_s) / nVt);
                T3  = -(phisb0 / nVt + T2 / (1.0 + RC));
                T4  = lexp(T3);
                T5  = lexp(T3 + (xs * nVt - phic_s) / nVt);
                T6  = lexp(-xs);
                T7  = xs * xs;
                T8  = 1.0 / (T7 + 2.0);

                T10 = lexp(xs - phidf);
                T11 = lexp(2.0 * (xs * nVt - phic_s) / nVt);
                T12 = lexp(2.0 * (xs * nVt - phic_s) / nVt + T3);

                pC   = -( (2.0 * T0 * (vgfbb + T3)*RT * RT)/((RC + 1.0) * (T0 + 1.0)) - 2.0 * vgfb1  + 2.0 * xs  - gam2 * (lexp(xs - Udse -phidf) + lexp(-Udse - phidf) * (-2.0 * xs * T8 + 2.0 * xs * xs * xs * T8 * T8 - 1.0) - T6 - T0 / ((RC + 1.0) * (T0 + 1.0)) + T5 / ((RC + 1.0) * (T0 + 1.0)) + 1.0) );
                qC    =  gam2 *(1.0 - k_ds)* Ds;
                tempc =  2.0 * RT * RT * T0 * (vgfbb + T3) / ((1+RC) * (1 + T0)) - 2.0 * RT * RT * T11 / ((1.0 + RC) * (1.0 + RC) * (1.0 + 2.0 * T0 + T11)) - gam2 * (T6 + lexp(xs -phidf - Udse) + lexp(-phidf - Udse) * ( -2.0 * T8 + 10.0 * xs * xs * T8 * T8 - 8.0 * xs * xs * xs * xs * T8 * T8 * T8) - T0 / ((1.0 + RC) * (1.0 + T0)) + T11 / ((1.0 + RC) * (1.0 + 2.0 * T0 + T11)) + T5 / ((1.0 + RC) * (1.0 + T0)) - T12 / ((1.0 + RC) * (1.0 + 2.0 * T0 + T11)) - T12 / ((1.0 + RC) * (1.0 + RC) * (1.0 + 2.0 * T0 + T11))) - 2.0 * RT * RT * T11 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + 2.0 * T0 + T11)) + 2;
                tempc        =  pC * pC - 2.0 * (tempc * qC);
                if (tempc >= 0.0) begin
                    x_ds         =  2.0 * (qC / (pC + sqrt(tempc)));
                end
                x7_d         = x7_s + x_ds;
            end

            dps          =  x_ds * nVt;
            xi0d         =  x7_d * x7_d / (2.0 + x7_d * x7_d);
            Ed           =  lexp(-x7_d);
            Dd           =  lexp(x7_d - phidf) - lexp(-phidf) * (x7_d + 1.0 + xi0d);
            Pd           = (vgfb1 - x7_d )*(vgfb1 - x7_d )*(1.0/gam2) -  Dd;
            Pd           = hypsmooth(Pd - 1.0e-3, 1.0e-5) + 1.0e-3;
            sqd          =  sqrt(Pd);

            //--------------------------------------
            xgd          =  gam * sqrt(Pd + Dd);
            qid          =  gam2 * Dd * nVt / (xgd + gam * sqd);


            // Mid-point surface potential
            x_m          =  0.5 * (x7_s + x7_d);
            tempc         =  abs(Ed * Es1);
            Em           =  sqrt(tempc);
            D_bar        =  0.5 * (Ds + Dd);
            Dm           =  D_bar + 0.125 * (x_ds * x_ds * (Em - 2.0 * inv_gam2));
            Pm           =  (vgfb1-x_m )*(vgfb1-x_m )*(1.0/gam2) - Dm;
            xgm          =  gam * sqrt(Dm + Pm);
            Pm           =  hypsmooth(Pm - 1.0e-3, 1.0e-5) + 1.0e-3;
            sqm          =  sqrt(Pm);


            if (PDEMOD==1) begin
            //Poly depletion effect
                pdef =2 * Cox * Cox * nVt /(`P_Q_NIST1998 * epssi * NGATE_i);
                d0  =  1.0 - Em + 2.0 * (xgm * (1/gam2));
                eta_p        =  1.0 / sqrt(1.0 + pdef * xgm);
                tempc         =  eta_p / (eta_p + 1.0);
                x_pm         =  pdef * (tempc * tempc *xgm  *xgm)*(Dm /(Dm  + Pm)) ;
                p_pd         =  2.0 * (xgm - x_pm) + gam2 * (1.0 - Em + Dm);
                q_pd         =  x_pm * (x_pm - 2.0 * xgm);
                xi_pd        =  1.0 - 0.5 * (gam2 * (Em + Dm));
                u_pd         =  q_pd * p_pd / (p_pd * p_pd - xi_pd * q_pd);
                x_m          =  x_m + u_pd;
                km           =  lexp(u_pd);
                Em           =  Em / km;
                Dm           =  Dm * km;
                Pm           =  ( vgfb1-x_m+ u_pd )*( vgfb1-x_m+ u_pd)*(1/gam2) -  Dm/ km ;
                xgm          =  gam * sqrt(Dm + Pm);
                km0          =  1.0 - Em + 2.0 * (xgm * eta_p * inv_gam2);
                x_ds         =  x_ds * km * (d0 + D_bar) / (km0 + km * D_bar);
                dps          =  x_ds * nVt;
                Pm           =  hypsmooth(Pm - 1.0e-3, 1.0e-5) + 1.0e-3;
                sqm          =  sqrt(Pm);
            end

            if (abs(dps) > 1e-35) begin
                alpha_DD    =  (qis - qid) / dps;
            end

            qim          =  nVt * (gam2 * Dm / (xgm + gam * sqm));
            qbm          =  sqm * gam * nVt;
            Voxm         =  xgm * nVt ;

            // Mobility degradation, Ref: BSIM4
            Eeffm = EeffFactor * (qbm + eta_mu * qim);
            T2    = lexp(UCS_a * lln(0.5 * (1.0 + (qim / qbm))));
            T3    = (UA_a + UC_a * Vbsx) * pow(Eeffm, EU_t) + UD_a / T2;
            T4    = 1.0 + T3;
            `Smooth(T4, 1.0, 0.0015, Dmob)

            // Output conductance
            Esat  = 2.0 * VSAT_a / (U0_a / Dmob);
            EsatL = Esat * Leff;
            if (PVAG_i > 0.0) begin
                PVAGfactor = 1.0 + PVAG_i * qim / EsatL;
            end else begin
                PVAGfactor = 1.0 / (1.0 - PVAG_i * qim / EsatL);
            end

            // Output conductance due to DIBL, Ref: BSIM4
            DIBLfactor = PDIBLC_a;
            diffVds    = Vds - Vdseff;
            Vgst2Vtm   = qim + 2.0 * nVt;
            if (DIBLfactor > 0.0) begin
                T3     = Vgst2Vtm / (Vdsat + Vgst2Vtm);
                T4     = hypsmooth((1.0 + PDIBLCB_i * Vbsx), 1.0e-3);
                T5     = 1.0 / T4;
                VaDIBL = Vgst2Vtm / DIBLfactor * T3 * PVAGfactor * T5;
                Moc    = 1.0 + diffVds / VaDIBL;
            end else begin
                Moc = 1.0;
            end

            // Degradation factor due to pocket implants, Ref: BSIM4
            if (FPROUT_i <= 0.0) begin
                Fp = 1.0;
            end else begin
                T9 = FPROUT_i * sqrt(Leff) / Vgst2Vtm;
                Fp = 1.0 / (1.0 + T9);
            end

            // Channel length modulation, Ref: BSIM4
            Vasat = Vdsat + EsatL;
            if (PCLM_a > 0.0) begin
                if (PCLMG < 0.0) begin
                    T1 = PCLM_a / (1.0 - PCLMG * qim / EsatL) / Fp;
                end else begin
                    T1 = PCLM_a * (1.0 + PCLMG * qim / EsatL) / Fp;
                end
                MdL = 1.0 + T1 * lln(1.0 + diffVds / T1 / Vasat);
            end else begin
                if (PCLMG < 0.0) begin
                    T1 = PCLM_a / (1.0 - PCLMG * qim / EsatL) / Fp;
                end else begin
                    T1 = PCLM_a * (1.0 + PCLMG * qim / EsatL) / Fp;
                end
                MdL = 1.0 + T1;
            end
            Moc = Moc * MdL;

            // Calculate Va_DITS, Ref: BSIM4
            T1 = lexp(PDITSD_i * Vds);
            if (PDITS_i > 0.0) begin
                T2      = 1.0 + PDITSL * Leff;
                VaDITS  = (1.0 + T2 * T1) / PDITS_i;
                VaDITS  = VaDITS * Fp;
            end else begin
                VaDITS  = `MAX_EXPL;
            end
            T4  = diffVds / VaDITS;
            T0  = 1.0 + T4;
            Moc = Moc * T0;

            // Calculate Va_SCBE, Ref: BSIM4
            if (PSCBE2_i > 0.0) begin
                if (diffVds > PSCBE1_i * litl / `EXPL_THRESHOLD) begin
                    T0     = PSCBE1_i * litl / diffVds;
                    VaSCBE = Leff * lexp(T0) / PSCBE2_i;
                end else begin
                    VaSCBE = `MAX_EXPL * Leff/PSCBE2_i;
                end
            end else begin
                VaSCBE = `MAX_EXPL;
            end
            Mscbe = 1.0 + (diffVds / VaSCBE);
            Moc   = Moc * Mscbe;

            // Velocity saturation (ref. BSIM-BULK)
            if (PSATB_i < 0) begin
                zetasb      = 1.0 / (1.0 - PSATB_i * Vbsx);
            end else begin
                zetasb      = 1.0 + PSATB_i * Vbsx;
            end
            T0      =  qim * zetasb;
            wsat       =  100.0 * (T0 / (100.0 + T0));
            inv_VP = 1.0/VP;
            T0         =  ln((1.0 + (Vds - dps) * inv_VP) / (1.0 + (Vdseff  - dps) * inv_VP));
            dL         =  ALP * T0;
            DdL        =  1.0 / (1.0 + dL + dL * dL);
            Dmob_dL    =  Dmob*DdL;

            if (PSAT_i < 0) begin
                T1       = 1 / (1 - PSAT_i * wsat);
            end else begin
                T1       = 1 + PSAT_i * wsat;
            end
            thesat1    =  THESAT_i * (T1 / Dmob_dL);
            zsat       =  thesat1 * thesat1 * dps * dps;
            if (TYPE == `ptype) begin
                zsat       =  zsat / (1.0 + thesat1 * dps);
            end
            Dvsat      =  0.5 * (Dmob_dL * (1.0 + sqrt(1.0 + 2.0 * zsat)));
            Dvsatinv   =  1.0 / Dvsat;

            // S/D series resistances, Ref: BSIM4
            Rsource = 0.0;
            Rdrain  = 0.0;
            qia   = (qis + qid);
            if (RDSMOD == 1) begin
                Rdsi = 0.0;
                Dr   = 1.0;
                // Rs (Source side resistance for all fingers)
                T2      = Vgs_noswap - Vfbsdr;
                T3      = sqrt(T2 * T2 + 0.01);
                Vgs_eff = 0.5 * (T2 + T3);
                T5      = 1.0 + PRWG_i * Vgs_eff;
                T6      = (1.0 / T5) + PRWB_i * Vsb_noswap;
                T4      = 0.5 * (T6 + sqrt(T6 * T6 + 0.01));
                Rsource = rdstemp * (RSourceGeo + (RSWMIN_i + RSW_i * T4) * WeffWRFactor);
                // Rd (Drain side resistance for all fingers)
                T2      = Vgd_noswap - Vfbsdr;
                T3      = sqrt(T2 * T2 + 0.01);
                Vgd_eff = 0.5 * (T2 + T3);
                T5      = 1.0 + PRWG_i * Vgd_eff;
                T6      = (1.0 / T5) + PRWB_i * Vdb_noswap;
                T4      = 0.5 * (T6 + sqrt(T6 * T6 + 0.01));
                Rdrain  = rdstemp * (RDrainGeo + (RDWMIN_i + RDW_i * T4) * WeffWRFactor);
            end else begin
                // Ref: (1) BSIM4 (2) "Operation and Modeling of the MOS Transistor" by Yannis Tsividis
                T0      = 1.0 + PRWG_i * qia;
                T1      = PRWB_i * (sqrtPhistVbs - sqrtPhist);
                T2      = 1.0 / T0 + T1;
                T3      = 0.5 * (T2 + sqrt(T2 * T2 + 0.01));
                Rdsi    = rdstemp * (RDSWMIN_i + RDSW_i * T3) * WeffWRFactor * NF;
                Rdrain  = RDrainGeo;
                Rsource = RSourceGeo;
                Dr      = 1.0 + U0_a /(Dvsat ) * Cox * Weff / Leff * qia * Rdsi;
                if (RDSMOD == 2) begin
                    Rdsi    = rdstemp * (RSourceGeo + (RDSWMIN_i + RDSW_i * T3) * WeffWRFactor * NF + RDrainGeo);
                    Rdrain  = 0.0;
                    Rsource = 0.0;
                    Dr      = 1.0 + U0_a /(Dvsat) * Cox * Weff / Leff * qia * Rdsi;
                end
            end

            // Non-saturation effect

            T0   = A1_t + A2_t / (qia + 2.0 * n * Vtm);
            DQSD = qis - qid;
            T1   = T0 * DQSD * DQSD;
            T2   = T1 + 1.0 - 0.001;
            T3   = -1.0 + 0.5 * (T2 + sqrt(T2 * T2 + 0.004));
            Nsat = 0.5 * (1.0 + sqrt(1.0 + T3));
            `Smooth2(Nsat, 1.0, 0.01, Nsat)

            // MNUD model to enhance Id-Vd fitting flexibility
            T0   =  (qis + qid);
            T1   = qis - qid;
            T2   = T1 / (T0 + M0_t);
            T3   = K0_t * T2 * T2;
            Mnud = 1.0 + T3;

            // MNUD1 to enhance the fitting flexibility for the gm/Id - similar approach used in BSIM-CMG
            T9    = C0_t / (max(0, C0SI_t + C0SISAT_t * T1 * T1) * T0 + 2.0 * n * Vtm);
            Mnud1 = lexp(-T9);
            T0       =  Dmob_dL * Dvsatinv;
            alpha1       =  alpha_DD *  (1.0 + 0.5 * (zsat * T0 * T0));
            alpha1       =  hypsmooth(alpha1 - 1.0e-3, 1.0e-5) + 1.0e-3;
            qim1         =  qim + nVt * alpha_DD;
            H_fact  = ( qim1 / alpha1) * (Dmob_dL / Dvsat);

        end//upto this

        // DD Core drain  Current
        ids = NF*(U0_a)*(Weff / Leff)*Cox*qim1*dps *(DdL*Dvsatinv/(Dr)) * Moc / Nsat * Mnud * Mnud1;

        // Rgate Model Modules. Ref. BSIM-4, BSIM-BULK
        Dtot = Dmob*Dvsat*Dr;
        ueff = U0_a / Dtot;
        Gcrg = 0.0;
        if (RGATEMOD > 1) begin
            idsovvds = ueff * Weff / Leff * Cox * qia;
            T9       = XRCRG2 * Vt;
            T0       = T9 * ueff * Weff / Leff * Cox;
            Gcrg     = XRCRG1 * NF * (T0 + idsovvds);
            if (RGATEMOD == 2) begin
                Rgeltd = 1.0 / Grgeltd;
                if (Rgeltd < minr) begin
                    Rgeltd = minr ;
                    Grgeltd = 1.0 / Rgeltd;
                end
                T11  = Grgeltd + Gcrg;
                Gcrg = Grgeltd * Gcrg / T11;
            end
        end

        // Junction currents and capacitances
        //Diode and BJT Current
        wdiod = Weff / NSEG + PDBCP;
        wdios = Weff / NSEG + PSBCP;
        WsTsi = wdios * TSI;
        WdTsi = wdiod * TSI;

        NVtm1 = Vtm * NDIODE_i;
        T0 = Vbs_jct / NVtm1;
        ExpVbsNVtm = lexp(T0);

        NVtm2 = Vtm * NDIODE_i;
        T0 = Vbd_jct / NVtm2;
        ExpVbdNVtm = lexp(T0);


        T4 = `Eg300 / Vtm * (TRatio-1);

        //Ibs1 : Diffusion current as per SOI
        if (ISDIF_i == 0.0) begin
            Ibs1 = 0.0;
        end else begin
            T7 = XDIF_i * T4 / NDIODE_i;
            T1 = lexp(T7);
            JDIFS = ISDIF_i * T1;
            T0 = WsTsi * JDIFS;
            Ibs1 = T0 * (ExpVbsNVtm - 1);
        end

        //Ibd1 : Diffusion Current as per SOI
        if (IDDIF_i == 0.0) begin
            Ibd1 = 0.0;
        end else begin
            T7 = XDIF_i * T4 / NDIODE_i;
            T1 = lexp(T7);
            JDIFD = IDDIF_i * T1;
            T0 = WdTsi * JDIFD;
            Ibd1 = T0 * (ExpVbdNVtm - 1);
        end

        // Ibs2 and Ibd2: Recombination / Trap-assisted tunneling current
        if (ISREC_i == 0.0) begin
            Ibs2 = 0.0;
        end else begin
            T7 = XREC_i * T4 / NRECF0_i;
            T2 = lexp(T7);
            JRECS = ISREC_i * T2;
            //forward bias
            NVtmf = VTM00 * NRECF0_i * (1 + NTRECF_i * (TRatio - 1));
            NVtmr = VTM00 * NRECR0_i * (1 + NTRECR_i * (TRatio - 1));

            T0 = Vbs_jct / NVtmf;
            T10 = lexp(T0);

            //reverse bias
            if (( VREC0_i - Vbs_jct) < 1e-3) begin
                T1 = 1e3;
                T0 = - Vbs_jct / NVtmr * VREC0_i * T1;
                T11 = lexp(T0);
                T11 = -T11;
            end else begin
                T1 = 1 / (VREC0_i - Vbs_jct);
                T0 = -Vbs_jct / NVtmr * VREC0_i * T1;
                T11 = lexp(T0);

                T11 = -T11;
            end

            T3 = WsTsi * JRECS;
            Ibs2 = T3 * (T10 + T11);
        end

        if (IDREC_i == 0.0) begin
            Ibd2 = 0.0;
        end else begin
            T7 = XREC_i * T4 / NRECF0_i;
            T2 = lexp(T7);
            JRECD = IDREC_i * T2;
            NVtmf = VTM00 * NRECF0_i * (1 + NTRECF_i * (TRatio - 1));
            NVtmr = VTM00 * NRECR0_i * (1 + NTRECR_i * (TRatio - 1));

            T0 = Vbd_jct / NVtmf;
            T10 = lexp(T0);

            if (( VREC0D_i - Vbd_jct) < 1e-3) begin

                T1 = 1e3;
                T0 = - Vbd_jct / NVtmr * VREC0D_i * T1;
                T11 = lexp(T0);
                T11 = -T11;
            end else begin
                T1 = 1 / (VREC0D_i - Vbd_jct);
                T0 = -Vbd_jct / NVtmr * VREC0D_i * T1;
                T11 = lexp(T0);

                T11 = -T11;
            end

            T3 = WdTsi * JRECD;
            Ibd2 = T3 * (T10 + T11);
        end

        //Ibs3 and Ibd3 - Recombination current in neutral body
        WTsi = Weff / NSEG * TSI;

        if (ISBJT_i == 0.0 && IDBJT_i == 0.0 ) begin
            Ibs3 =0.0;
            Ibd3 =0.0;
            Ic = 0.0;
        end else begin
            T7 = XBJT_i * T4 / NDIODE_i;
            T0 = lexp(T7);
            Ahlis = AHLI_i * T0; /* high level injection */
            JBJTS = ISBJT_i * T0;
            T7 = XBJT_i * T4 / NDIODE_i;
            T0 = lexp(T7);
            Ahlid = AHLID_i * T0; /* high level injection */
            JBJTD = IDBJT_i * T0;
            //High level injection on Source Side
            Ehlis = Ahlis * (ExpVbsNVtm - 1);
            if (Ehlis < 1e-5) begin
                Ehlis = 0;
                EhlisFactor = 1;
            end else begin
                EhlisFactor = 1.0 / sqrt(1 + Ehlis);
            end

            // high level injection of drain side
            Ehlid = Ahlid * (ExpVbdNVtm - 1);
            if (Ehlid < 1e-5) begin
                Ehlid = 0;
                EhlidFactor = 1;
            end else begin
                EhlidFactor = 1.0 / sqrt(1 + Ehlid);
            end

            T0 = -0.5 * Leff * Leff / LN / LN;
            ALPHABJT = lexp(T0);
            T2 = 1 - ALPHABJT;
            T0 = LBJT0_i * (1.0 / Leff + 1.0 / LN);
            lratio = pow(T0,NBJT_i);

            Ien = WTsi * JBJTS * lratio;
            T1 = T0 * Ien;
            Ibs3 = T1 * (ExpVbsNVtm -1) * EhlisFactor;

            Ien = WTsi * JBJTD * lratio;
            T1 = T0 * Ien;
            Ibd3 = T1 * (ExpVbdNVtm -1) * EhlidFactor;

            //Terms for diffusion charge
            lratiodif = 1.0 + LDIF0 * pow(T0,NDIF_i);

            Iendif = WTsi * JBJTS * lratiodif;
            Ibsdif = Iendif * (ExpVbsNVtm - 1) * EhlisFactor;

            Iendif = WTsi * JBJTD * lratiodif;
            Ibddif = Iendif * (ExpVbdNVtm - 1) * EhlidFactor;

            //BJT collector Current Ic
            Vearly = VABJT_i + AELY_i * Leff;

            if (Vearly < 1)
                Vearly = 1;
            if (BJTOFF == 1) begin
                Ic = 0.0;
            end else begin
                // second order effects
                T0 = 1 + (Vbs_jct + Vbd_jct) / Vearly;
                T1 = Ehlis + Ehlid;
                T3 = sqrt(T0 * T0 + 4 * T1);
                T2 = (T0 + T3) / 2.0;

                if (T2 < 0.1) begin
                    E2ndFactor = 10.0;
                end else begin
                    E2ndFactor = 1.0 /T2;
                end
                T0 = ALPHABJT * Ien;
                Ic = NF * T0 * (ExpVbsNVtm - ExpVbdNVtm) * E2ndFactor;
            end
        end

        //Ibs4 and Ibd4 : tunneling
        if (ISTUN_i == 0.0 && IDTUN_i == 0.0) begin
            Ibs4 = 0.0;
            Ibd4 = 0.0;
        end else begin
            T7 = XTUN_i * (TRatio - 1);
            T0 = lexp(T7);
            JTUNS = ISTUN_i * T0;
            T7 = XTUND_i * (TRatio - 1);
            T0 = lexp(T7);

            JTUND = IDTUN_i * T0;
            NVtm2 = VTM00 * NTUN_i;
            if (( VTUN0_i - Vbs_jct) < 1e-3) begin
                T1 = 1e3;
                T0 = -Vbs_jct / NVtm2 * VTUN0_i * T1;
                T1 = lexp(T0);

                T3 = WsTsi * JTUNS;
                Ibs4 = T3 * (1 - T1);
            end else begin
                T1 = 1 / (VTUN0_i - Vbs_jct);
                T0 = -Vbs_jct / NVtm2 * VTUN0_i * T1;
                T1 = lexp(T0);

                T3 = WsTsi * JTUNS;
                Ibs4 = T3 * (1 - T1);
            end

            NVtm2 = VTM00 * NTUND_i;
            if (( VTUN0D_i - Vbd_jct) < 1e-3) begin
                T1 = 1e3;
                T0 = -Vbd_jct / NVtm2 * VTUN0D_i * T1;
                T1 = lexp(T0);

                T3 = WsTsi * JTUND;
                Ibd4 = T3 * (1 - T1);
            end else begin
                T1 = 1 / (VTUN0D_i - Vbd_jct);
                T0 = -Vbd_jct / NVtm2 * VTUN0D_i * T1;
                T1 = lexp(T0);

                T3 = WsTsi * JTUND;
                Ibd4 = T3 * (1 - T1);
            end
        end

        Ibs = NF * (Ibs1 + Ibs2 + Ibs3 + Ibs4);
        Ibd = NF * (Ibd1 + Ibd2 + Ibd3 + Ibd4);

        // GIDL and GISL currents, Ref: BSIM4 and BSIM-SOI
        igisl = 0.0;
        igidl = 0.0;
        if (GIDLMOD == 0) begin
            T0 = epsratio * TOXE;
            // GIDL
            if ((AGIDL_i <= 0.0) || (BGIDL_t <= 0.0) || (CGIDL_i < 0.0)) begin
                T6 = 0.0;
            end else begin
                T1 = (-Vgd_noswap - EGIDL_i + Vfbsdr) / T0;
                T1 = hypsmooth(T1, 1.0e-2);
                T2 = BGIDL_t / (T1 + 1.0e-3);
                if (CGIDL_i != 0.0) begin
                    T3 = Vdb_noswap * Vdb_noswap * Vdb_noswap;
                    T4 = CGIDL_i + abs(T3) + 1.0e-4;
                    T5 = hypsmooth(T3 / T4, 1.0e-6) - 1.0e-6;
                end else begin
                    T5 = 1.0;
                end
                T6 = AGIDL_i * wdiod * T1 * lexp(-T2) * T5;
            end
            igidl = T6;
            // GISL
            if ((AGISL_i <= 0.0) || (BGISL_t <= 0.0) || (CGISL_i < 0.0)) begin
                T6 = 0.0;
            end else begin
                T1 = (-Vgs_noswap - EGISL_i + Vfbsdr) / T0;
                T1 = hypsmooth(T1, 1.0e-2);
                T2 = BGISL_t / (T1 + 1.0e-3);
                if (CGISL_i != 0.0) begin
                    T3 = Vsb_noswap * Vsb_noswap * Vsb_noswap;
                    T4 = CGISL_i + abs(T3) + 1.0e-4;
                    T5 = hypsmooth(T3 / T4, 1.0e-6) - 1.0e-6;
                end else begin
                    T5 = 1.0;
                end
                T6 = AGISL_i * wdios * T1 * lexp(-T2) * T5;
            end
            igisl = T6;
        end else begin
            //GIDLMOD = 1
            T0 = epsratio * TOXE;
            Vgd_noswap_1    = RGISL_i * Vg - Vd;
            Vgs_noswap_1    = RGIDL_i * Vg - Vs;
            T2      = Vgs_noswap - Vfbsdr;
            Vgs_eff = sqrt(T2 * T2 + 1.0e-4);
            //GIDL
            if ((AGIDL_i <= 0.0) || (BGIDL_t <= 0.0)) begin
                T6 = 0.0;
            end else begin
                T1 = (-Vgd_noswap_1 - EGIDL_i + Vfbsdr) / T0;
                T1 = hypsmooth(T1, 1.0e-2);
                T2 = BGIDL_t / (T1 + 1.0e-3);

                if (KGIDL_i != 0.0) begin
                    T3 = -Vdb_noswap-FGIDL_i;
                    T4 = T3 + 1.0e-4;
                    T5 = hypsmooth(KGIDL_i / T4, 1.0e-6) - 1.0e-6;
                end else begin
                    T5 = 1.0;
                end
                T6 = AGIDL_i * wdiod * T1 * lexp(-T2) * lexp(T5);
            end
            igidl = T6;

            //GISL
            if ((AGISL_i <= 0.0) || (BGISL_t <= 0.0)) begin
                T6 = 0.0;
            end else begin
                T1 = (-Vgs_noswap_1 - EGISL_i + Vfbsdr) / T0;
                T1 = hypsmooth(T1, 1.0e-2);
                T2 = BGISL_t / (T1 + 1.0e-3);

                if (KGISL_i != 0.0) begin
                    T3 = -Vsb_noswap-FGISL_i;
                    T4 = T3 + 1.0e-4;
                    T5 = hypsmooth(KGISL_i / T4, 1.0e-6) - 1.0e-6;
                end else begin
                    T5 = 1.0;
                end
                T6 = AGISL_i * wdios * T1 * lexp(-T2) * lexp(T5);
            end
            igisl = T6;
        end

        IGIDL = devsign * NF * igidl;
        IGISL = devsign * NF * igisl;

        // Impact ionization currents, Ref: BSIM4 and BSIM-SOI
        //BULK MOSFET
        if (IIIMOD == 0) begin
            if ((ALPHA0_i <= 0.0) || (BETA0_t <= 0.0)) begin
                Iii = 0.0;
            end else if (diffVds > BETA0_t / `EXPL_THRESHOLD) begin
                T1  = -BETA0_t / diffVds;
                Iii = ALPHA0_i * diffVds * ids * lexp(T1) / Mscbe;
            end else begin
                Iii = ALPHA0_i * diffVds * ids * `MIN_EXPL / Mscbe;
            end

        //SOI
        end else if (IIIMOD == 1) begin
            if ((ALPHA0_i <= 0.0) || (BETA2_i == 0.0 && BETA1_i == 0.0 && BETA0_t == 0.0)) begin
                Iii = 0.0;
            end else begin
                Vdsatii0 = VDSATII0_i * (1 + TII * (TRatio - 1.0)) - (LII_i / Leff);
                T0 = ESATII_i * Leff;
                T1 = SII0_i * T0 / (1.0 + T0);

                T0 = 1.0 / (1.0 + hypsmooth((SII1_i * vgsfb * nVt), IIMOD2CLAMP1));
                T3 = T0 + SII2_i;
                T2 = hypsmooth((vgsfb * nVt * T3), IIMOD2CLAMP2);
                T3 = 1.0 / (1.0 + SIID_i * Vdsx);

                VgsStep = T1 * T2 * T3;
                Vdsatii = Vdsatii0 + VgsStep;
                Vdiff = Vdsx - Vdsatii;

                T0 = BETA2_i + BETA1_i * Vdiff + BETA0_t * Vdiff * Vdiff;
                T1 = sqrt(T0 * T0 + 1.0e-10);
                Ratio = -hypmax(-ALPHA0_i * lexp(Vdiff / T1), -10.0, IIMOD2CLAMP3);
                Iii = Ratio * (ids + FBJTII_i * sigvds * Ic);
            end

        //IIIMOD = 2
        //two components have the different impact ionization rate.
        end else begin
            if ((ALPHA0_i <= 0.0) || (BETA2_i == 0.0 && BETA1_i == 0.0 && BETA0_t == 0.0)) begin
                Iii = 0.0;
            end else begin
                //Idsmosfet
                Vdsatii0 = VDSATII0_i * (1 + TII * (TRatio - 1.0)) - (LII_i / Leff);
                T0 = ESATII_i * Leff;
                T1 = SII0_i * T0 / (1.0 + T0);

                T0 = 1.0 / (1.0 + hypsmooth((SII1_i * vgsfb * nVt), IIMOD2CLAMP1));
                T3 = T0 + SII2_i;
                T2 = hypsmooth((vgsfb * nVt * T3), IIMOD2CLAMP2);
                T3 = 1.0 / (1.0 + SIID_i * Vdsx);

                VgsStep = T1 * T2 * T3;
                Vdsatii = Vdsatii0 + VgsStep;
                Vdiff = Vdsx - Vdsatii;

                T0 = BETA2_i + BETA1_i * Vdiff + BETA0_t * Vdiff * Vdiff;
                T1 = sqrt(T0 * T0 + 1.0e-10);
                Ratio = -hypmax(-ALPHA0_i * lexp(Vdiff / T1), -10.0, IIMOD2CLAMP3);
                Idsmosfet = Ratio * ids;
            end

            //Iiibjt
            T0 = (CBJTII_i + EBJTII_i * Leff) / Leff;
            Vbc = VBCI_i * (1.0 + TVBCI * (TRatio - 1));

            if (sigvds > 0)
                T1 = Vbc - Vbd_jct;
            else
                T1 = Vbc - Vbs_jct;

            T2 = MBJTII_i - 1.0;

            if (T1 > 0.0)
                T3 = -ABJTII_i * pow(T1,T2);
            else
                T3 = 0.0;

            T4 = lexp(T3);
            Iiibjt = T0 * sigvds * Ic * T1 * T4;

            //Total Iii
            Iii = Idsmosfet + Iiibjt;
        end

        ISUB = Iii * devsign;

        // Junction capacitances (no swapping)
        // Source-to-bulk junction
        Czbs       = CJS_t * ASeff;
        Czbssw     = CJSWS_t * PSeff;
        Czbsswg    = CJSWGS_t * Weffcj * NF;
        czbs_p1    = pow(0.1, -MJS);

        if (MJS == 1) begin
            czbs_p2    = 1.5 - ln(0.1);
        end else begin
            czbs_p2    = 1.0 / (1.0 - MJS) * (1.0 - 0.05 * MJS * (1.0 + MJS) * czbs_p1);
        end
        czbssw_p1  = pow(0.1, -MJSWS);
        if (MJSWS == 1) begin
            czbssw_p2    = 1.5 - ln(0.1);
        end else begin
            czbssw_p2  = 1.0 / (1.0 - MJSWS) * (1.0 - 0.05 * MJSWS * (1.0 + MJSWS) * czbssw_p1);
        end
        czbsswg_p1 = pow(0.1, -MJSWGS);
        if (MJSWGS == 1) begin
            czbsswg_p2    = 1.5 - ln(0.1);
        end else begin
            czbsswg_p2 = 1.0 / (1.0 - MJSWGS) * (1.0 - 0.05 * MJSWGS * (1.0 + MJSWGS) * czbsswg_p1);
        end

        `JunCap(Czbs, Vbs_jct, PBS_t, MJS, czbs_p1, czbs_p2, Qbsj1)
        `JunCap(Czbssw, Vbs_jct, PBSWS_t, MJSWS, czbssw_p1, czbssw_p2, Qbsj2)
        `JunCap(Czbsswg, Vbs_jct, PBSWGS_t, MJSWGS, czbsswg_p1, czbsswg_p2, Qbsj3)

        Qbsj4 = TT * Ibsdif * NF;
        Qbsj = Qbsj1 + Qbsj2 + Qbsj3 + Qbsj4;

        // Drain-to-bulk junction
        Czbd       = CJD_t * ADeff;
        Czbdsw     = CJSWD_t * PDeff;
        Czbdswg    = CJSWGD_t * Weffcj * NF;
        czbd_p1    = pow(0.1, -MJD);

        if (MJD == 1) begin
            czbd_p2    = 1.5 - ln(0.1);
        end else begin
            czbd_p2    = 1.0 / (1.0 - MJD) * (1.0 - 0.05 * MJD * (1.0 + MJD) * czbd_p1);
        end
        czbdsw_p1  = pow(0.1, -MJSWD);
        if (MJSWD == 1) begin
            czbdsw_p2  = 1.5 - ln(0.1);
        end else begin
            czbdsw_p2  = 1.0 / (1.0 - MJSWD) * (1.0 - 0.05 * MJSWD * (1.0 + MJSWD) * czbdsw_p1);
        end
        czbdswg_p1 = pow(0.1, -MJSWGD);
        if (MJSWGD == 1) begin
            czbdswg_p2 = 1.5 - ln(0.1);
        end else begin
            czbdswg_p2 = 1.0 / (1.0 - MJSWGD) * (1.0 - 0.05 * MJSWGD * (1.0 + MJSWGD) * czbdswg_p1);
        end

        `JunCap(Czbd, Vbd_jct, PBD_t, MJD, czbd_p1, czbd_p2, Qbdj1)
        `JunCap(Czbdsw, Vbd_jct, PBSWD_t, MJSWD, czbdsw_p1, czbdsw_p2, Qbdj2)
        `JunCap(Czbdswg, Vbd_jct, PBSWGD_t, MJSWGD, czbdswg_p1, czbdswg_p2, Qbdj3)

        Qbdj4 = TT * Ibddif * NF;
        Qbdj = Qbdj1 + Qbdj2 + Qbdj3 + Qbdj4;

        // DD  Core Capacitances
        if (x7_s <= 0.0) begin
            QG           =  Voxm;

            QD           =  0.0;
            QB           =  QG;
            QS=0.0;
        end else begin
            Fj         =  0.5 * (dps / H_fact);
            Fj2        =  Fj * Fj;
            QCLM       =  (1.0 - DdL) * (qim - 0.5 * (alpha_DD * dps));
            QG         =  Voxm + 0.5 * (eta_p * dps * (Fj * DdL * `oneThird - 1.0 + DdL));
            tempc       =  alpha_DD * dps * `oneSixth;
            QI         =  DdL * (qim + tempc * Fj) + QCLM;
            QD         =  0.5 * (DdL * DdL * (qim - tempc * (1.0 - Fj - 0.2 * Fj2)) + QCLM * (1.0 + DdL));
            QB         =  QG - QI;
            QS         =  (QG - QB - QD );
        end

        // Quantum mechanical effects
        `Smooth(QB, 0.0, 0.1, qbaCV)
        qiaCV      =  (QS + QD);
        T0         = (qiaCV + ETAQM * (qbaCV)) / QM0;
        T0         = hypsmooth(T0,1.0e-3);
        T1         = 1.0 + pow(T0, 0.7 * BDOS);
        XDCinv     = ADOS * 1.9e-9 / T1;
        Coxeffinv  = 3.9 * `P_EPS0 / (BSIMBULKTOXP * 3.9 / EPSROX + XDCinv / epsratio);
        QBi        = - (NF * Wact * Lact + AGBCP) * (`P_EPS0 * EPSROX / BSIMBULKTOXP) * QB;
        WLCOXVtinv = (NF * Wact * Lact + AGBCP) * Coxeffinv;
        if (sigvds > 0) begin
            QSi = -WLCOXVtinv * QS;
            QDi = -WLCOXVtinv * QD;
        end else begin
            QSi = -WLCOXVtinv * QD;
            QDi = -WLCOXVtinv * QS;
        end

        QGi        = - (QBi + QSi + QDi);


        // Outer fringing capacitances
        if (!$param_given(CF)) begin
            CF_i = 2.0 * EPSROX * `P_EPS0 / `M_PI * lln(CFRCOEFF * (1.0 + 0.4e-6 / TOXE));
        end
        Cgsof = CGSO + CF_i;
        Cgdof = CGDO + CF_i;

        // Overlap capacitances
        wdiosCV = Wact / NSEG + PSBCP;
        wdiodCV = Wact / NSEG + PDBCP;
        if (COVMOD == 0) begin
            Qovs = -wdiosCV * NF * Cgsof * Vgs_ov_noswap;
            Qovd = -wdiodCV * NF * Cgdof * Vgd_ov_noswap;
        end else begin
            T0    = sqrt((Vgs_ov_noswap - Vfbsdr + `DELTA_1) * (Vgs_ov_noswap - Vfbsdr + `DELTA_1) + 4.0 * `DELTA_1);
            Vgsov = 0.5 * (Vgs_ov_noswap - Vfbsdr + `DELTA_1 - T0);
            T6    = Vgsov / pow(1.0 + pow((-Vgsov / CKAPPAS1), CKAPPAS2), 1.0 / CKAPPAS2);
            T1    = sqrt(1.0 - 4.0 * T6 / CKAPPAS_i);
            Qovs  = -wdiosCV * NF * (Cgsof * Vgs_ov_noswap + CGSL_i * (Vgs_ov_noswap - Vfbsdr - Vgsov - 0.5 * CKAPPAS_i * (-1.0 + T1)));
            T0    = sqrt((Vgd_ov_noswap - Vfbsdr + `DELTA_1) * (Vgd_ov_noswap - Vfbsdr + `DELTA_1) + 4.0 * `DELTA_1);
            Vgdov = 0.5 * (Vgd_ov_noswap - Vfbsdr + `DELTA_1 - T0);
            T6    = Vgdov / pow(1.0 + pow((-Vgdov / CKAPPAD1), CKAPPAD2), 1.0 / CKAPPAD2);
            T2    = sqrt(1.0 - 4.0 * T6 / CKAPPAD_i);
            Qovd  = -wdiodCV * NF * (Cgdof * Vgd_ov_noswap + CGDL_i * (Vgd_ov_noswap - Vfbsdr - Vgdov - 0.5 * CKAPPAD_i * (-1.0 + T2)));
        end
        Qovb = -devsign * NF * Lact * CGBO * V(gm, bi);
        Qovg = -(Qovs + Qovd + Qovb);

        //Backgate Charges --- related to new introduced substrate terminal
        LeffCVb = Lnew - 2.0 * dLCV - DLCB;
        LeffCVbg = LeffCVb + 2 * DLBG;
        if (NSUB_i > 0) begin
            T0 = lln(NDEP_i / NSUB_i);
            vfbb = -devsign * Vtm * T0;
        end else begin
            T0 = lln(-NDEP_i * NSUB_i / ni / ni);
            vfbb = -devsign * Vtm * T0;
        end

        Vesfb = Ves - vfbb;
        Cbox = 3.453133e-11 / TBOX;
        CboxWL = KB1_i * FBODY * Cbox * (Wact / NSEG * NF * LeffCVbg + AEBCP);
        Qe1 = CboxWL * (Vesfb - Vbs);
        Qsub = Qe1;

        //Sidewall Fringing Capacitance
        if (FBODY1 != 0) begin
            T0 = CSDESW * lln(CFRCOEFF * (1 + TSI / TBOX));
            T1 = PS - W;
            if (T1 > 0.0)
                csesw = T0 * T1;
            else
                csesw = 0.0;

            T1 = PD - W;
            if (T1 > 0.0)
                cdesw = T0 * T1;
            else
                cdesw = 0.0;

            // Extrinsic Bottom S/D to Substrate Charge
            csbox = Cbox * AS;
            csmin = CSDMIN * AS;
            cdbox = Cbox * AD;
            cdmin = CSDMIN * AD;

            //T10 is vse without type conversion
            //T11 is vde without type conversion
            T10 = -devsign * ves;
            T11 = -devsign * ved;

            if (CSDMIN != 0) begin
                T1 = -0.5 * (cdbox - cdmin) / ACEDB;
                T2 = lln(cosh(-ACEDB * T11 + BCEDB));
                T3 = 0.5 * (cdbox + cdmin) * T11;
                qde = T1 * T2 + T3;

                T1 = -0.5 * (csbox - csmin) / ACESB;
                T2 = lln(cosh(-ACESB * T10 + BCESB));
                T3 = 0.5 * (csbox + csmin) * T10;
                qse = T1 * T2 + T3;
            end else begin
                qse = csbox * T10;
                qde = cdbox * T11;
            end
            qse = qse + csesw * T10;
            qde = qde + cdesw * T11;

        end else begin
            qse = 0.0;
            qde = 0.0;
        end

        //AGBCP2 Cap, 4 terminal Capacitor
        if (MODAGBCP2 == 1) begin
            VFBAGBCP2_i = VFBAGBCP2 + DELVTO;
            vg1      = Vg1 * inv_Vt;
            vs1      = Vs1 * inv_Vt;
            vfb      = VFBAGBCP2_i * inv_Vt;
            ve1      = Ve1 * inv_Vt;
            vgfbAGBCP2  = vg1 - vfb;
            phibAGBCP2  = lln(NDEPAGBCP2 / ni);
            // Normalized body factor
            gamAGBCP2      = sqrt(2.0 * `P_Q_NIST1998 * epssi * NDEPAGBCP2 * inv_Vt) / Cox;
            //Input conversion for AGBCP2
            gam = gamAGBCP2;
            vgfb1 =vgfbAGBCP2;
            vfbb = VFBB_i * inv_Vt;
            vgfbb = ve1 - vfbb;
            inv_gam = 1.0 / gam;
            gam2 = gam * gam;
            inv_gam2 = 1.0 / gam2;
            phib = phibAGBCP2;
            //Normalized terminal voltages for DDMOD
            NDEP_i = NDEPAGBCP2;
            gam_sb = gam / RT;
            x1_sb = 1.0 + gam_sb * `invSqrt2;
            limit_sb = 1.0e-7 * x1_sb;
            x1_csb         =  5.0/4.0;
            inv_xi_sb = (1.0/gam_sb);
            gam_sb2 = gam_sb*gam_sb;
            inv_xg1_sb  =  1.0 / (x1_csb + gam_sb * 7.324648775608221e-1);
            if (abs(vgfbb) <= limit_sb) begin
                pd_sb          =  ((-vgfbb ) * inv_xi_sb)*(1.0+gam_sb*((-vgfbb /(6.0*sqrt(2.0)*x1_sb*x1_sb))));
            end else begin
                if (vgfbb  < (-limit_sb)) begin
                    PD_yg    = -vgfbb ;
                    PD_z     =  x1_csb * PD_yg  * inv_xi_sb;
                    PD_eta   =  0.5 * (PD_z  + 10.0 - sqrt((PD_z  - 6.0) * (PD_z  - 6.0) + 64.0));
                    PD_a     =  (PD_yg   - PD_eta) * (PD_yg   - PD_eta) + gam_sb2 * (PD_eta  + 1.0);
                    PD_c     =  2.0 * (PD_yg   - PD_eta) - gam_sb2;
                    PD_tau   =  lln(PD_a  / gam_sb2) - PD_eta ;
                    `sigma0(PD_a, PD_c, PD_tau, PD_eta, PD_y0)
                    PD_D0    =  lexp(PD_y0);
                    PD_temp  =  PD_yg  - PD_y0 ;
                    PD_p     =  2.0 * PD_temp  + gam_sb2 * (PD_D0  - 1.0);
                    PD_q     =  PD_temp  * PD_temp  + gam_sb2 * (PD_y0  + 1.0 - PD_D0 );
                    PD_xi    =  1.0 - gam_sb2 * 0.5 * PD_D0 ;
                    PD_temp  =  PD_p  * PD_p  - 4.0 * (PD_xi  * PD_q );
                    PD_w     =  2.0 * (PD_q  / (PD_p  + sqrt(PD_temp )));
                    pd_sb    = -(PD_y0  + PD_w );
                end else begin
                    PD_Afac  =  (x1_sb * x1_csb * inv_xg1_sb - 1.0) * inv_xg1_sb;
                    PD_xbar  =  vgfbb  * inv_xi_sb * (1.0 + PD_Afac * vgfbb );
                    PD_temp1 =  lexp(-PD_xbar);
                    PD_w1    =  1.0 - PD_temp1 ;
                    PD_x0    =  vgfbb  + gam_sb2 * 0.5 - gam_sb * sqrt(vgfbb  + gam_sb2 * 0.25 - PD_w1 );
                    PD_D01   =  lexp(-PD_x0);
                    PD_p1    =  2.0 * (vgfbb  - PD_x0 ) + gam_sb2 * (1.0 - PD_D01 );
                    PD_q1    =  (vgfbb  - PD_x0 ) * (vgfbb  - PD_x0 ) - gam_sb2 * (PD_x0  - 1.0 + PD_D01 );
                    PD_xi1   =  1.0 - gam_sb2 * 0.5 * PD_D01 ;
                    PD_temp1 =  PD_p1  * PD_p1  - 4.0 * (PD_xi1  * PD_q1 );
                    PD_u     =  2.0 * (PD_q1  / (PD_p1  + sqrt(PD_temp1 )));
                    pd_sb    =  PD_x0  + PD_u ;
                end
            end
            // One iteration given to correct value even at 10th decimal point
            if (abs(vgfbb)  < (limit_sb)) begin
                phisb0=((-vgfbb ) * inv_xi_sb)*(1.0+gam_sb*((-vgfbb /(6.0*sqrt(2.0)*x1_sb*x1_sb))));
                pd_sb=((-vgfbb ) * inv_xi_sb)*(1.0+gam_sb*((-vgfbb /(6.0*sqrt(2.0)*x1_sb*x1_sb))));
            end else begin
                fx = RT*RT*(vgfbb - pd_sb)*(vgfbb - pd_sb)*(1.0/gam)*(1.0/gam) -(lexp(-pd_sb) + pd_sb -1.0);
                f_x = lexp(-pd_sb) + (RT*RT*(2.0*pd_sb - 2.0*vgfbb))/(gam*gam) - 1.0;
                phisb0 =(pd_sb)-(fx /f_x );
            end
            phisb0=phisb0* Vt;

            // DD-MODEL core source side surface potential
            /* Surface potential at source side  DD-MODEL*/
            x1           =  1.0 + gam * `invSqrt2;
            inv_x1       =  1.0 /  x1;
            phisf         =  2 * phib/n + vs1 ;
            exp_ns     =  lexp(-phisf);
            limit       =  1.0e-3 * x1;
            T0 = -DVBD1_i * Leff / litl;

            phic_star  = (1.0 + LPE1_i / Leff)*(`P_Q_NIST1998 * NDEP_i * TSI * TSI) / (2 * epssi * Vt) + VBSA/Vt - RC * (vgfbb);
            vg_FD = phic_star + gam * sqrt(lexp(-phic_star) + phic_star -1.0) ;

            if (phic_star <phisf ) begin
                if (vgfb1 < (vg_FD)) begin
                    //PD initial Guess
                    if (abs(vgfb1) <= limit) begin
                        T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
                        sp_dd         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * T0); // sp-> sp_dd
                    end else begin
                        if (vgfb1 < (-limit)) begin
                            SP_S_yg   = -vgfb1;
                            SP_S_ysub   = 1.25 * (SP_S_yg * inv_x1);
                            SP_S_eta  =  0.5 * (SP_S_ysub + 10.0 - sqrt((SP_S_ysub - 6.0) * (SP_S_ysub - 6.0) + 64.0));
                            SP_S_temp   = SP_S_yg - SP_S_eta;
                            SP_S_a      = SP_S_temp * SP_S_temp + gam2 * (SP_S_eta + 1.0);
                            SP_S_c      = 2.0 * SP_S_temp - gam2;
                            SP_S_tau    = -SP_S_eta + lln(SP_S_a * inv_gam2);
                            `sigma0(SP_S_a, SP_S_c, SP_S_tau, SP_S_eta, SP_S_y0)
                            SP_S_delta0 = lexp(SP_S_y0);
                            SP_S_delta1 = 1.0 / SP_S_delta0;
                            SP_S_temp   = 1.0 / (2.0 + SP_S_y0 * SP_S_y0);
                            SP_S_xi0    = SP_S_y0 * SP_S_y0 * SP_S_temp;
                            SP_S_xi1    = 4.0 * (SP_S_y0 * SP_S_temp * SP_S_temp);
                            SP_S_xi2    = (8.0 * SP_S_temp - 12.0 * SP_S_xi0) * SP_S_temp * SP_S_temp;
                            SP_S_temp   = SP_S_yg - SP_S_y0;
                            SP_S_temp1  = (exp_ns) * SP_S_delta1;
                            SP_S_pC     = 2.0 * SP_S_temp + gam2 * (SP_S_delta0 - 1.0 - SP_S_temp1 + (exp_ns) * (1.0 - SP_S_xi1));
                            SP_S_qC     = SP_S_temp * SP_S_temp - gam2 * (SP_S_delta0 - SP_S_y0 - 1.0 + SP_S_temp1 + (exp_ns) * (SP_S_y0 - 1.0 - SP_S_xi0));
                            SP_S_temp   = 2.0 - gam2 * (SP_S_delta0 + SP_S_temp1 - (exp_ns) * SP_S_xi2);
                            SP_S_temp   = SP_S_pC * SP_S_pC - 2.0 * (SP_S_qC * SP_S_temp);
                            sp_dd          = -SP_S_y0 - 2.0 * (SP_S_qC / (SP_S_pC + sqrt(SP_S_temp)));
                        end else begin
                            SP_xg1    = 1.0 / (1.25 + gam * 7.324648775608221e-001);
                            SP_S_A_fac= (x1 * 1.25 * SP_xg1 - 1.0) * SP_xg1;
                            SP_S_xbar = vgfb1 * inv_x1 * (1.0 + SP_S_A_fac * vgfb1);
                            SP_S_temp = lexp(-SP_S_xbar);
                            SP_S_w    = 1.0 - SP_S_temp;
                            SP_S_x1   = vgfb1 + gam2 * 0.5 - gam * sqrt(vgfb1 + gam2 * 0.25 - SP_S_w);
                            SP_S_bx   = (phisf) + 3.0;
                            SP_S_eta  = `MINF(SP_S_x1, SP_S_bx, 5.0) - 0.5 * (SP_S_bx - sqrt(SP_S_bx * SP_S_bx + 5.0));
                            SP_S_temp = vgfb1 - SP_S_eta;
                            SP_S_temp1= lexp(-SP_S_eta);
                            SP_S_temp2= 1.0 / (2.0 + SP_S_eta * SP_S_eta);
                            SP_S_xi0  = SP_S_eta * SP_S_eta * SP_S_temp2;
                            SP_S_xi1  = 4.0 * (SP_S_eta * SP_S_temp2 * SP_S_temp2);
                            SP_S_xi2  = (8.0 * SP_S_temp2 - 12.0 * SP_S_xi0) * SP_S_temp2 * SP_S_temp2;
                            SP_S_a    = max(1.0e-40, SP_S_temp * SP_S_temp - gam2 * (SP_S_temp1 + SP_S_eta - 1.0 - (exp_ns) * (SP_S_eta + 1.0 + SP_S_xi0)));
                            SP_S_b    = 1.0 - 0.5 * (gam2 * (SP_S_temp1 - (exp_ns) * SP_S_xi2));
                            SP_S_c    = 2.0 * SP_S_temp + gam2 * (1.0 - SP_S_temp1 - (exp_ns) * (1.0 + SP_S_xi1));
                            SP_S_tau  = (phisf) - SP_S_eta + lln(SP_S_a / gam2);
                            `sigma1(SP_S_a, SP_S_b, SP_S_c, SP_S_tau, SP_S_eta, SP_S_x0)
                            SP_S_delta0 = lexp(SP_S_x0);
                            SP_S_delta1 = 1.0 / SP_S_delta0;
                            SP_S_delta0 = lexp(SP_S_x0 - phisf);
                            SP_S_temp   = 1.0 / (2.0 + SP_S_x0 * SP_S_x0);
                            SP_S_xi0    = SP_S_x0 * SP_S_x0 * SP_S_temp;
                            SP_S_xi1    = 4.0 * (SP_S_x0 * SP_S_temp * SP_S_temp);
                            SP_S_xi2    = (8.0 * SP_S_temp - 12.0 * SP_S_xi0) * SP_S_temp * SP_S_temp;
                            SP_S_temp   = vgfb1 - SP_S_x0;
                            SP_S_pC     = 2.0 * SP_S_temp + gam2 * (1.0 - SP_S_delta1 + SP_S_delta0 - (exp_ns) * (1.0 + SP_S_xi1));
                            SP_S_qC     = SP_S_temp * SP_S_temp - gam2 * (SP_S_delta1 + SP_S_x0 - 1.0 + SP_S_delta0 - (exp_ns) * (SP_S_x0 + 1.0 + SP_S_xi0));
                            SP_S_temp   = 2.0 - gam2 * (SP_S_delta1 + SP_S_delta0 - (exp_ns) * SP_S_xi2);
                            SP_S_temp   = SP_S_pC * SP_S_pC - 2.0 * (SP_S_qC * SP_S_temp);
                            sp_dd          = SP_S_x0 + 2.0 * (SP_S_qC / (SP_S_pC + sqrt(SP_S_temp)));
                        end
                    end
                end else begin
                    //FD initial Guess
                    zeta    = RT;
                    zeta2   = zeta * zeta;
                    u_crit  = phic_star - phisb0 * inv_Vt;
                    usf_FD  = vgfb1 - gam * sqrt(lexp(-u_crit) + u_crit -1);
                    SP_S_bx = (phisf) + 3.0;
                    SP_S_Z0 =  `MINF(usf_FD, SP_S_bx, 40);
                    a_fd = ((vgfb1-SP_S_Z0) * (vgfb1-SP_S_Z0) - zeta2 * (vgfbb-SP_S_Z0 + phic_star) * (vgfbb-SP_S_Z0+phic_star) - gam2 * (phic_star));
                    c_fd = 2 * (vgfb1 - SP_S_Z0 ) - 2 * zeta2 * (vgfbb - SP_S_Z0 + phic_star) ;
                    c_fd2 = c_fd * c_fd;
                    d_fd = 1 - zeta2;
                    if (a_fd < 0) begin
                        a_fd = 0;
                    end
                    tau_fd = phisf - SP_S_Z0  + lln(a_fd * inv_gam2);
                    v_fd = a_fd + c_fd;
                    v_fd2 = v_fd * v_fd ;
                    mu_fd = v_fd2 / tau_fd  + 0.5 * c_fd2 - a_fd * d_fd;
                    temp1_fd = (c_fd * v_fd) / mu_fd;
                    temp2_fd = ( `oneThird * c_fd2 - a_fd * d_fd) ;
                    u_first_r = (v_fd * a_fd) / (mu_fd + temp1_fd * temp2_fd);
                    u0_first_FD = SP_S_Z0  + u_first_r;
                    delta0_fd = lexp(u0_first_FD - phisf);
                    p_fd = 2 *(vgfb1-u0_first_FD)- 2 * zeta2 * (vgfbb-u0_first_FD + phic_star)+ gam2 * delta0_fd;
                    q_fd = (vgfb1-u0_first_FD) * (vgfb1-u0_first_FD) - zeta2 * (vgfbb-u0_first_FD + phic_star) * (vgfbb-u0_first_FD+phic_star)- gam2 * (phic_star+delta0_fd);
                    temp3_fd = 2 * q_fd * (2- 2 * zeta2 - gam2 * delta0_fd);
                    w_fd= (2 * q_fd) / (p_fd + sqrt(p_fd * p_fd - temp3_fd));
                    sp_dd  = u0_first_FD + w_fd;
                end
            end else begin
                //PD initial Guess
                if (abs(vgfb1) <= limit) begin
                    T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
                    sp_dd         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * T0); // sp-> sp_dd
                end else begin
                    if (vgfb1 < (-limit)) begin
                        SP_S_yg   = -vgfb1;
                        SP_S_ysub   = 1.25 * (SP_S_yg * inv_x1);
                        SP_S_eta  =  0.5 * (SP_S_ysub + 10.0 - sqrt((SP_S_ysub - 6.0) * (SP_S_ysub - 6.0) + 64.0));
                        SP_S_temp   = SP_S_yg - SP_S_eta;
                        SP_S_a      = SP_S_temp * SP_S_temp + gam2 * (SP_S_eta + 1.0);
                        SP_S_c      = 2.0 * SP_S_temp - gam2;
                        SP_S_tau    = -SP_S_eta + lln(SP_S_a * inv_gam2);
                        `sigma0(SP_S_a, SP_S_c, SP_S_tau, SP_S_eta, SP_S_y0)
                        SP_S_delta0 = lexp(SP_S_y0);
                        SP_S_delta1 = 1.0 / SP_S_delta0;
                        SP_S_temp   = 1.0 / (2.0 + SP_S_y0 * SP_S_y0);
                        SP_S_xi0    = SP_S_y0 * SP_S_y0 * SP_S_temp;
                        SP_S_xi1    = 4.0 * (SP_S_y0 * SP_S_temp * SP_S_temp);
                        SP_S_xi2    = (8.0 * SP_S_temp - 12.0 * SP_S_xi0) * SP_S_temp * SP_S_temp;
                        SP_S_temp   = SP_S_yg - SP_S_y0;
                        SP_S_temp1  = (exp_ns) * SP_S_delta1;
                        SP_S_pC     = 2.0 * SP_S_temp + gam2 * (SP_S_delta0 - 1.0 - SP_S_temp1 + (exp_ns) * (1.0 - SP_S_xi1));
                        SP_S_qC     = SP_S_temp * SP_S_temp - gam2 * (SP_S_delta0 - SP_S_y0 - 1.0 + SP_S_temp1 + (exp_ns) * (SP_S_y0 - 1.0 - SP_S_xi0));
                        SP_S_temp   = 2.0 - gam2 * (SP_S_delta0 + SP_S_temp1 - (exp_ns) * SP_S_xi2);
                        SP_S_temp   = SP_S_pC * SP_S_pC - 2.0 * (SP_S_qC * SP_S_temp);
                        SP_S_temp   = sqrt(SP_S_temp * SP_S_temp + 64e-8) - 8e-4;
                        sp_dd          = -SP_S_y0 - 2.0 * (SP_S_qC / (SP_S_pC + sqrt(SP_S_temp)));
                    end else begin
                        SP_xg1    = 1.0 / (1.25 + gam * 7.324648775608221e-001);
                        SP_S_A_fac= (x1 * 1.25 * SP_xg1 - 1.0) * SP_xg1;
                        SP_S_xbar = vgfb1 * inv_x1 * (1.0 + SP_S_A_fac * vgfb1);
                        SP_S_temp = lexp(-SP_S_xbar);
                        SP_S_w    = 1.0 - SP_S_temp;
                        SP_S_x1   = vgfb1 + gam2 * 0.5 - gam * sqrt(vgfb1 + gam2 * 0.25 - SP_S_w);
                        SP_S_bx   = (phisf) + 3.0;
                        SP_S_eta  = `MINF(SP_S_x1, SP_S_bx, 5.0) - 0.5 * (SP_S_bx - sqrt(SP_S_bx * SP_S_bx + 5.0));
                        SP_S_temp = vgfb1 - SP_S_eta;
                        SP_S_temp1= lexp(-SP_S_eta);
                        SP_S_temp2= 1.0 / (2.0 + SP_S_eta * SP_S_eta);
                        SP_S_xi0  = SP_S_eta * SP_S_eta * SP_S_temp2;
                        SP_S_xi1  = 4.0 * (SP_S_eta * SP_S_temp2 * SP_S_temp2);
                        SP_S_xi2  = (8.0 * SP_S_temp2 - 12.0 * SP_S_xi0) * SP_S_temp2 * SP_S_temp2;
                        SP_S_a    = max(1.0e-40, SP_S_temp * SP_S_temp - gam2 * (SP_S_temp1 + SP_S_eta - 1.0 - (exp_ns) * (SP_S_eta + 1.0 + SP_S_xi0)));
                        SP_S_b    = 1.0 - 0.5 * (gam2 * (SP_S_temp1 - (exp_ns) * SP_S_xi2));
                        SP_S_c    = 2.0 * SP_S_temp + gam2 * (1.0 - SP_S_temp1 - (exp_ns) * (1.0 + SP_S_xi1));
                        SP_S_tau  = (phisf) - SP_S_eta + lln(SP_S_a / gam2);
                        `sigma1(SP_S_a, SP_S_b, SP_S_c, SP_S_tau, SP_S_eta, SP_S_x0)
                        SP_S_delta0 = lexp(SP_S_x0);
                        SP_S_delta1 = 1.0 / SP_S_delta0;
                        SP_S_delta0 = lexp(SP_S_x0 - phisf);
                        SP_S_temp   = 1.0 / (2.0 + SP_S_x0 * SP_S_x0);
                        SP_S_xi0    = SP_S_x0 * SP_S_x0 * SP_S_temp;
                        SP_S_xi1    = 4.0 * (SP_S_x0 * SP_S_temp * SP_S_temp);
                        SP_S_xi2    = (8.0 * SP_S_temp - 12.0 * SP_S_xi0) * SP_S_temp * SP_S_temp;
                        SP_S_temp   = vgfb1 - SP_S_x0;
                        SP_S_pC     = 2.0 * SP_S_temp + gam2 * (1.0 - SP_S_delta1 + SP_S_delta0 - (exp_ns) * (1.0 + SP_S_xi1));
                        SP_S_qC     = SP_S_temp * SP_S_temp - gam2 * (SP_S_delta1 + SP_S_x0 - 1.0 + SP_S_delta0 - (exp_ns) * (SP_S_x0 + 1.0 + SP_S_xi0));
                        SP_S_temp   = 2.0 - gam2 * (SP_S_delta1 + SP_S_delta0 - (exp_ns) * SP_S_xi2);
                        SP_S_temp   = SP_S_pC * SP_S_pC - 2.0 * (SP_S_qC * SP_S_temp);
                        SP_S_temp   = sqrt(SP_S_temp * SP_S_temp + 64e-8) - 8e-4;
                        sp_dd          = SP_S_x0 + 2.0 * (SP_S_qC / (SP_S_pC + sqrt(SP_S_temp)));
                    end
                end
            end

            xs = sp_dd;
            limit1 = 1e-7;
            K11 = 2;
            SP_S_tempc =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2 ;
            T0 = -DVBD1_i * Leff / litl;

            PHIC =  (1.0 + LPE1_i / Leff)*(`P_Q_NIST1998 * NDEP_i * (TSI * TSI)) / (2 * epssi)+ VBSA;
            phic_s = PHIC-RC*(vgfbb*Vt)*CDSBS1_i+ (1+RC)*(phisb0);

            //First Iteration of final Poisson's expression
            if (abs(vgfb1)<= (limit1)) begin
                T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
                x7_s         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * T0); // sp-> sp_dd
            end else begin
                T0= (0.5 * (tanh(-5.0 * (vgfb1 - K11)) +  tanh(5.0 * (vgfb1 + K11)) ));
                sp_vfb       =vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * SP_S_tempc) * T0;

                T0  = lexp((xs * Vt - phic_s)/Vt);

                T2  = ln_one_plus_exp((xs * Vt - phic_s) / Vt) - ln_one_plus_exp((sp_vfb * Vt - phic_s)/Vt);
                T3  = -(phisb0 / Vt + T2/(1.0+RC));
                T4  = lexp(T3);
                T6  = lexp(-xs);
                T7  = xs * xs;
                T8  = 1.0 / (T7 + 2.0);
                T9  = lexp(-phisf);
                T10 = lexp(xs - phisf);

                fx   = (vgfb1 - xs) * (vgfb1 - xs) - RT * RT * (vgfbb + T3) * (vgfbb + T3) - gam2 * (T6 - T4 + xs + T3 + T10 - T9 * (xs + 1.0 + T8 * T7));
                f_x  = (2.0 * T0 * (vgfbb + T3) * RT * RT) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * vgfb1 + 2.0 * xs - gam2 * (T10 + T9 * (-2.0 * xs * T8 + 2.0 * xs * xs * xs * T8 * T8 - 1.0) - T6 - T0 / ((1.0 + RC) * (1.0 + T0)) + (T0 * T4) / ((1.0 + RC) * (1.0 + T0)) + 1.0);

                f_xx = 2.0 * RT * RT * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * RT * RT * T0 * T0 / ((1.0 + RC) * (1.0 + T0) * (1.0 + RC) * (1.0 + T0)) - gam2 * (T6 + T10 - 2.0 * T9 * T8 * (1.0 - T7 * T8 * (5.0 - 4.0 * T7 * T8)) - T0 / ((1.0 + RC) * (1.0 + T0)) * (1.0 - T0 / (1.0 + T0) - T4 + T0 * T4 / (1.0 + T0) * (1.0 + 1.0 / (1.0 + RC)))) - 2.0 * RT * RT * T0 * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0) * (1.0 + T0)) + 2.0;

                x7_s=xs-(fx/f_x)*(1.0 + ((fx*f_xx)/(2.0*f_x*f_x)));


            end

            //Second Iteration of final Poisson's expression
            xs=x7_s;
            if (abs(vgfb1)<= (limit1)) begin
                T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
                x7_s         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * T0); // sp-> sp_dd
            end else begin
                T0= (0.5 * (tanh(-5.0 * (vgfb1 - K11)) +  tanh(5.0 * (vgfb1 + K11)) ));
                sp_vfb       =vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * SP_S_tempc) * T0;

                T0  = lexp((xs * Vt - phic_s)/Vt);

                T2  = ln_one_plus_exp((xs * Vt - phic_s) / Vt) - ln_one_plus_exp((sp_vfb * Vt - phic_s)/Vt);
                T3  = -(phisb0 / Vt + T2/(1.0+RC));
                T4  = lexp(T3);
                T6  = lexp(-xs);
                T7  = xs * xs;
                T8  = 1.0 / (T7 + 2.0);
                T9  = lexp(-phisf);
                T10 = lexp(xs - phisf);

                fx   = (vgfb1 - xs) * (vgfb1 - xs) - RT * RT * (vgfbb + T3) * (vgfbb + T3) - gam2 * (T6 - T4 + xs + T3 + T10 - T9 * (xs + 1.0 + T8 * T7));
                f_x  = (2.0 * T0 * (vgfbb + T3) * RT * RT) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * vgfb1 + 2.0 * xs - gam2 * (T10 + T9 * (-2.0 * xs * T8 + 2.0 * xs * xs * xs * T8 * T8 - 1.0) - T6 - T0 / ((1.0 + RC) * (1.0 + T0)) + (T0 * T4) / ((1.0 + RC) * (1.0 + T0)) + 1.0);

                f_xx = 2.0 * RT * RT * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * RT * RT * T0 * T0 / ((1.0 + RC) * (1.0 + T0) * (1.0 + RC) * (1.0 + T0)) - gam2 * (T6 + T10 - 2.0 * T9 * T8 * (1.0 - T7 * T8 * (5.0 - 4.0 * T7 * T8)) - T0 / ((1.0 + RC) * (1.0 + T0)) * (1.0 - T0 / (1.0 + T0) - T4 + T0 * T4 / (1.0 + T0) * (1.0 + 1.0 / (1.0 + RC)))) - 2.0 * RT * RT * T0 * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0) * (1.0 + T0)) + 2.0;

                x7_s=xs-(fx/f_x)*(1.0 + ((fx*f_xx)/(2.0*f_x*f_x)));


            end

            //Third Iteration of final Poisson's expression
            xs=x7_s;
            if (abs(vgfb1)<= (limit1)) begin
                T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
                x7_s         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * T0);// sp-> sp_dd
            end else begin
                T0= (0.5 * (tanh(-5.0 * (vgfb1 - K11)) +  tanh(5.0 * (vgfb1 + K11)) ));
                sp_vfb       =vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * SP_S_tempc) * T0;

                T0  = lexp((xs * Vt - phic_s)/Vt);

                T2  = ln_one_plus_exp((xs * Vt - phic_s) / Vt) - ln_one_plus_exp((sp_vfb * Vt - phic_s)/Vt);
                T3  = -(phisb0 / Vt + T2/(1.0+RC));
                T4  = lexp(T3);
                T6  = lexp(-xs);
                T7  = xs * xs;
                T8  = 1.0 / (T7 + 2.0);
                T9  = lexp(-phisf);
                T10 = lexp(xs - phisf);

                fx   = (vgfb1 - xs) * (vgfb1 - xs) - RT * RT * (vgfbb + T3) * (vgfbb + T3) - gam2 * (T6 - T4 + xs + T3 + T10 - T9 * (xs + 1.0 + T8 * T7));
                f_x  = (2.0 * T0 * (vgfbb + T3) * RT * RT) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * vgfb1 + 2.0 * xs - gam2 * (T10 + T9 * (-2.0 * xs * T8 + 2.0 * xs * xs * xs * T8 * T8 - 1.0) - T6 - T0 / ((1.0 + RC) * (1.0 + T0)) + (T0 * T4) / ((1.0 + RC) * (1.0 + T0)) + 1.0);

                f_xx = 2.0 * RT * RT * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * RT * RT * T0 * T0 / ((1.0 + RC) * (1.0 + T0) * (1.0 + RC) * (1.0 + T0)) - gam2 * (T6 + T10 - 2.0 * T9 * T8 * (1.0 - T7 * T8 * (5.0 - 4.0 * T7 * T8)) - T0 / ((1.0 + RC) * (1.0 + T0)) * (1.0 - T0 / (1.0 + T0) - T4 + T0 * T4 / (1.0 + T0) * (1.0 + 1.0 / (1.0 + RC)))) - 2.0 * RT * RT * T0 * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0) * (1.0 + T0)) + 2.0;

                x7_s=xs-(fx/f_x)*(1.0 + ((fx*f_xx)/(2.0*f_x*f_x)));


            end

            // Drain current and Charge calculation part starts
            Vdsat_lim    =  3.912023005 * Vt;
            if (x7_s <= 0.0) begin
                qis          =  0.0;
                xgm          =  vgfb1 - x7_s;
                Voxm         =  xgm * Vt;
                Vdsat        =  Vdsat_lim;

                Dr = 1.0;

                Mnud = 1.0;
                Mnud1 = 1.0;
                Dvsat = 1.0;
                Dmob  = 1.0;
                Moc = 1.0;
                Mscbe = 1.0;
                Rdrain = RDrainGeo;
                Rsource = RSourceGeo;
            end else begin //vgfb1 >0

                tempc        =  1.0 / (2.0 + x7_s * x7_s);
                xi0s         =  x7_s * x7_s * tempc;
                delta_1s     =  lexp(x7_s);
                Es1          =  1.0 / delta_1s;
                delta_1s     =  lexp(x7_s - phisf);
                Ds           =  delta_1s - lexp(-phisf) * (x7_s + 1.0 + xi0s);
                Ps           =  (vgfb1-x7_s)*(vgfb1-x7_s)*(1/gam2) - Ds;
                Ps           =  hypsmooth(Ps - 1.0e-3, 1.0e-5) + 1.0e-3;
                sqms         =  sqrt(Ps);
                xgs          =  gam * sqrt(Ps + Ds);
                qis          =  gam2 * Ds * Vt / (xgs + gam * sqms);
                qbs          =  sqms * gam * Vt;
                Em           =  Es1;

                Dm           =  Ds;


                //Drain saturation voltage part implementation (Ref. BSIM4,BSIM-CMG)
                EeffFactor = 1.0e-8 / (epsratio * TOXE);
                Eeffs = EeffFactor * (qbs  + eta_mu * qis);

                //Ref: BSIM4 mobility model

                T2 = lexp(UCS_a * lln(0.5 * (1.0 + (qis / qbs))));

                T3 = (UA_a + UC_a * Vbsx1) * pow(Eeffs, EU_t) + UD_a / T2;
                T4 = 1.0 + T3;
                `Smooth(T4, 1.0, 0.0015, Dmobs)

                WeffWRFactor = 1.0 / (pow(Weff * 1.0e6, WR_i) * NF);

                `Smooth(Phist - Vbsx1, 0.05, 0.1, PhistVbs)
                sqrtPhistVbs = sqrt(PhistVbs);

                if (RDSMOD == 1) begin
                    Rdss = 0.0;
                end else begin
                    T0   = 1.0 + PRWG_i * qis;
                    T1   = PRWB_i * (sqrtPhistVbs - sqrtPhist);
                    T2   = 1.0 / T0 + T1;
                    T3   = T2 + sqrt(T2 * T2 + 0.01);
                    Rdss = (RDSWMIN_i + RDSW_i * T3) * WeffWRFactor * NF * rdstemp;
                    if (RDSMOD == 2) begin
                        Rdss = (RSourceGeo + (RDSWMIN_i + RDSW_i * T3) * WeffWRFactor * NF + RDrainGeo) * rdstemp;
                    end
                end

                Esat = 2.0 * VSAT_a / U0_a * Dmobs;
                EsatL = Esat * Leff;
                T6 = KSATIV_i * (qis + 2.0 * Vt);

                if (Rdss > 0.0) begin
                    WVCox = Weff * VSAT_a * Cox;
                    T0 = WVCox * Rdss;
                    Ta = 2.0 * T0;
                    Tb = T6 + EsatL + 3.0 * T6 * T0;
                    Tc = T6 * (EsatL + 2.0 * T6 * T0);
                    Vdsat = (Tb - sqrt(Tb * Tb - 2.0 * Ta * Tc)) / Ta;
                end else begin
                    Vdsat = EsatL * T6 / (EsatL + T6);
                end

                if (A0 == 0.0 && AGS == 0.0) begin
                    AbulkIV = 1.0;
                end else begin
                    T1  = Leff / (Leff + sqrt(XJ_i * Xdep));
                    AbulkIV = 1.0 + (A0 * T1 - AGS * T1 * pow(qis,AGS1) * Vt) / (1.0 + KETA * Vbsx1);
                    `Smooth(AbulkIV, 0.1, 0.0005, AbulkIV)
                end

                Vdsat   = hypsmooth(Vdsat - 1.0e-3, 1.0e-5) + 1.0e-3;
                Vdsat    = Vdsat / AbulkIV;
                T7      = pow((Vds / Vdsat) + 1.0e-6, 1.0 / DELTA_t);
                T8      = pow(1.0 + T7, -DELTA_t);
                Vdseff  = Vds * T8;
                vdeff   = (Vdseff +Vs1) * inv_Vt;

                /* Surface potential at Drain side  DD-MODEL*/
                phidf         =  2 * phib/n + vdeff;
                exp_nd     =  lexp(-phidf);
                limit       =  1.0e-3 * x1;

                T0 = -DVBD1_i * Leff / litl;
                T1 = DVBD0_i * (lexp(0.5*T0) + 2.0*lexp(T0)) * (Vds* inv_Vt + VSCE_i* inv_Vt);
                phic_star  = (1.0 + LPE1_i / Leff)*(`P_Q_NIST1998 * NDEP_i * TSI * TSI) / (2 * epssi * Vt) + VBSA/Vt - RC * (vgfbb)*CDSBS1_i + (1+RC)*T1;

                vg_FD = phic_star + gam * sqrt(lexp(-phic_star) + phic_star -1 ) ;

                if (phic_star < phidf) begin
                    if (vgfb1 < (vg_FD)) begin
                        //PD initial Guess
                        if (abs(vgfb1) <= limit) begin
                            T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
                            sp_dd         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_nd)) * gam * T0); // sp-> sp_dd
                        end else begin
                            if (vgfb1 < (-limit)) begin
                                SP_S_yg   = -vgfb1;
                                SP_S_ysub   = 1.25 * (SP_S_yg * inv_x1);
                                SP_S_eta  =  0.5 * (SP_S_ysub + 10.0 - sqrt((SP_S_ysub - 6.0) * (SP_S_ysub - 6.0) + 64.0));
                                SP_S_temp   = SP_S_yg - SP_S_eta;
                                SP_S_a      = SP_S_temp * SP_S_temp + gam2 * (SP_S_eta + 1.0);
                                SP_S_c      = 2.0 * SP_S_temp - gam2;
                                SP_S_tau    = -SP_S_eta + lln(SP_S_a * inv_gam2);
                                `sigma0(SP_S_a, SP_S_c, SP_S_tau, SP_S_eta, SP_S_y0)
                                SP_S_delta0 = lexp(SP_S_y0);
                                SP_S_delta1 = 1.0 / SP_S_delta0;
                                SP_S_temp   = 1.0 / (2.0 + SP_S_y0 * SP_S_y0);
                                SP_S_xi0    = SP_S_y0 * SP_S_y0 * SP_S_temp;
                                SP_S_xi1    = 4.0 * (SP_S_y0 * SP_S_temp * SP_S_temp);
                                SP_S_xi2    = (8.0 * SP_S_temp - 12.0 * SP_S_xi0) * SP_S_temp * SP_S_temp;
                                SP_S_temp   = SP_S_yg - SP_S_y0;
                                SP_S_temp1  = (exp_nd) * SP_S_delta1;
                                SP_S_pC     = 2.0 * SP_S_temp + gam2 * (SP_S_delta0 - 1.0 - SP_S_temp1 + (exp_nd) * (1.0 - SP_S_xi1));
                                SP_S_qC     = SP_S_temp * SP_S_temp - gam2 * (SP_S_delta0 - SP_S_y0 - 1.0 + SP_S_temp1 + (exp_nd) * (SP_S_y0 - 1.0 - SP_S_xi0));
                                SP_S_temp   = 2.0 - gam2 * (SP_S_delta0 + SP_S_temp1 - (exp_nd) * SP_S_xi2);
                                SP_S_temp   = SP_S_pC * SP_S_pC - 2.0 * (SP_S_qC * SP_S_temp);
                                sp_dd          = -SP_S_y0 - 2.0 * (SP_S_qC / (SP_S_pC + sqrt(SP_S_temp)));
                            end else begin
                                SP_xg1    = 1.0 / (1.25 + gam * 7.324648775608221e-001);
                                SP_S_A_fac= (x1 * 1.25 * SP_xg1 - 1.0) * SP_xg1;
                                SP_S_xbar = vgfb1 * inv_x1 * (1.0 + SP_S_A_fac * vgfb1);
                                SP_S_temp = lexp(-SP_S_xbar);
                                SP_S_w    = 1.0 - SP_S_temp;
                                SP_S_x1   = vgfb1 + gam2 * 0.5 - gam * sqrt(vgfb1 + gam2 * 0.25 - SP_S_w);
                                SP_S_bx   = (phidf) + 3.0;
                                SP_S_eta  = `MINF(SP_S_x1, SP_S_bx, 5.0) - 0.5 * (SP_S_bx - sqrt(SP_S_bx * SP_S_bx + 5.0));
                                SP_S_temp = vgfb1 - SP_S_eta;
                                SP_S_temp1= lexp(-SP_S_eta);
                                SP_S_temp2= 1.0 / (2.0 + SP_S_eta * SP_S_eta);
                                SP_S_xi0  = SP_S_eta * SP_S_eta * SP_S_temp2;
                                SP_S_xi1  = 4.0 * (SP_S_eta * SP_S_temp2 * SP_S_temp2);
                                SP_S_xi2  = (8.0 * SP_S_temp2 - 12.0 * SP_S_xi0) * SP_S_temp2 * SP_S_temp2;
                                SP_S_a    = max(1.0e-40, SP_S_temp * SP_S_temp - gam2 * (SP_S_temp1 + SP_S_eta - 1.0 - (exp_nd) * (SP_S_eta + 1.0 + SP_S_xi0)));
                                SP_S_b    = 1.0 - 0.5 * (gam2 * (SP_S_temp1 - (exp_nd) * SP_S_xi2));
                                SP_S_c    = 2.0 * SP_S_temp + gam2 * (1.0 - SP_S_temp1 - (exp_nd) * (1.0 + SP_S_xi1));
                                SP_S_tau  = (phidf) - SP_S_eta + lln(SP_S_a / gam2);
                                `sigma1(SP_S_a, SP_S_b, SP_S_c, SP_S_tau, SP_S_eta, SP_S_x0)
                                SP_S_delta0 = lexp(SP_S_x0);
                                SP_S_delta1 = 1.0 / SP_S_delta0;
                                SP_S_delta0 = lexp(SP_S_x0 - phidf);
                                SP_S_temp   = 1.0 / (2.0 + SP_S_x0 * SP_S_x0);
                                SP_S_xi0    = SP_S_x0 * SP_S_x0 * SP_S_temp;
                                SP_S_xi1    = 4.0 * (SP_S_x0 * SP_S_temp * SP_S_temp);
                                SP_S_xi2    = (8.0 * SP_S_temp - 12.0 * SP_S_xi0) * SP_S_temp * SP_S_temp;
                                SP_S_temp   = vgfb1 - SP_S_x0;
                                SP_S_pC     = 2.0 * SP_S_temp + gam2 * (1.0 - SP_S_delta1 + SP_S_delta0 - (exp_nd) * (1.0 + SP_S_xi1));
                                SP_S_qC     = SP_S_temp * SP_S_temp - gam2 * (SP_S_delta1 + SP_S_x0 - 1.0 + SP_S_delta0 - (exp_nd) * (SP_S_x0 + 1.0 + SP_S_xi0));
                                SP_S_temp   = 2.0 - gam2 * (SP_S_delta1 + SP_S_delta0 - (exp_nd) * SP_S_xi2);
                                SP_S_temp   = SP_S_pC * SP_S_pC - 2.0 * (SP_S_qC * SP_S_temp);
                                sp_dd          = SP_S_x0 + 2.0 * (SP_S_qC / (SP_S_pC + sqrt(SP_S_temp)));
                            end
                        end
                    end else begin
                       //FD initial Guess
                        zeta    = RT;
                        zeta2   = zeta * zeta;
                        u_crit  = phic_star - phisb0 * inv_Vt;
                        usf_FD  = vgfb1 - gam * sqrt(lexp(-u_crit) + u_crit -1) ;
                        SP_S_bx = (phidf) + 3.0;
                        SP_S_Z0 =  `MINF(usf_FD, SP_S_bx, 40.0);
                        a_fd = ((vgfb1-SP_S_Z0) * (vgfb1-SP_S_Z0) - zeta2 * (vgfbb-SP_S_Z0 + phic_star) * (vgfbb-SP_S_Z0+phic_star) - gam2 * (phic_star));
                        c_fd = 2 * (vgfb1 - SP_S_Z0 ) - 2 * zeta2 * (vgfbb - SP_S_Z0 + phic_star) ;
                        c_fd2 = c_fd * c_fd;
                        d_fd = 1 - zeta2;
                        if (a_fd < 0) begin
                            a_fd = 0;
                        end
                        tau_fd = phidf - SP_S_Z0  + lln(a_fd * inv_gam2);
                        v_fd = a_fd + c_fd;
                        v_fd2 = v_fd * v_fd ;
                        mu_fd = v_fd2 / tau_fd  + 0.5 * c_fd2 - a_fd * d_fd;
                        temp1_fd = (c_fd * v_fd) / mu_fd;
                        temp2_fd = ( `oneThird * c_fd2 - a_fd * d_fd) ;
                        u_first_r = (v_fd * a_fd) / (mu_fd + temp1_fd * temp2_fd);
                        u0_first_FD = SP_S_Z0  + u_first_r;
                        delta0_fd = lexp(u0_first_FD - phidf);
                        p_fd = 2.0 *(vgfb1-u0_first_FD)- 2.0 * zeta2 * (vgfbb-u0_first_FD + phic_star)+ gam2 * delta0_fd;
                        q_fd = (vgfb1-u0_first_FD) * (vgfb1-u0_first_FD) - zeta2 * (vgfbb-u0_first_FD + phic_star) * (vgfbb-u0_first_FD+phic_star)- gam2 * (phic_star+delta0_fd);
                        temp3_fd = 2.0 * q_fd * (2.0- 2.0 * zeta2 - gam2 * delta0_fd);
                        w_fd= (2.0 * q_fd) / (p_fd + sqrt(p_fd * p_fd - temp3_fd));
                        sp_dd  = u0_first_FD + w_fd;
                    end
                end else begin
                    //PD initial Guess
                    if (abs(vgfb1) <= limit) begin
                        T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
                        sp_dd         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_nd)) * gam * T0);// sp-> sp_dd
                    end else begin
                        if (vgfb1 < (-limit)) begin
                            SP_S_yg   = -vgfb1;
                            SP_S_ysub   = 1.25 * (SP_S_yg * inv_x1);
                            SP_S_eta  =  0.5 * (SP_S_ysub + 10.0 - sqrt((SP_S_ysub - 6.0) * (SP_S_ysub - 6.0) + 64.0));
                            SP_S_temp   = SP_S_yg - SP_S_eta;
                            SP_S_a      = SP_S_temp * SP_S_temp + gam2 * (SP_S_eta + 1.0);
                            SP_S_c      = 2.0 * SP_S_temp - gam2;
                            SP_S_tau    = -SP_S_eta + lln(SP_S_a * inv_gam2);
                            `sigma0(SP_S_a, SP_S_c, SP_S_tau, SP_S_eta, SP_S_y0)
                            SP_S_delta0 = lexp(SP_S_y0);
                            SP_S_delta1 = 1.0 / SP_S_delta0;
                            SP_S_temp   = 1.0 / (2.0 + SP_S_y0 * SP_S_y0);
                            SP_S_xi0    = SP_S_y0 * SP_S_y0 * SP_S_temp;
                            SP_S_xi1    = 4.0 * (SP_S_y0 * SP_S_temp * SP_S_temp);
                            SP_S_xi2    = (8.0 * SP_S_temp - 12.0 * SP_S_xi0) * SP_S_temp * SP_S_temp;
                            SP_S_temp   = SP_S_yg - SP_S_y0;
                            SP_S_temp1  = (exp_nd) * SP_S_delta1;
                            SP_S_pC     = 2.0 * SP_S_temp + gam2 * (SP_S_delta0 - 1.0 - SP_S_temp1 + (exp_nd) * (1.0 - SP_S_xi1));
                            SP_S_qC     = SP_S_temp * SP_S_temp - gam2 * (SP_S_delta0 - SP_S_y0 - 1.0 + SP_S_temp1 + (exp_nd) * (SP_S_y0 - 1.0 - SP_S_xi0));
                            SP_S_temp   = 2.0 - gam2 * (SP_S_delta0 + SP_S_temp1 - (exp_nd) * SP_S_xi2);
                            SP_S_temp   = SP_S_pC * SP_S_pC - 2.0 * (SP_S_qC * SP_S_temp);
                            sp_dd          = -SP_S_y0 - 2.0 * (SP_S_qC / (SP_S_pC + sqrt(SP_S_temp)));
                        end else begin
                            SP_xg1    = 1.0 / (1.25 + gam * 7.324648775608221e-001);
                            SP_S_A_fac= (x1 * 1.25 * SP_xg1 - 1.0) * SP_xg1;
                            SP_S_xbar = vgfb1 * inv_x1 * (1.0 + SP_S_A_fac * vgfb1);
                            SP_S_temp = lexp(-SP_S_xbar);
                            SP_S_w    = 1.0 - SP_S_temp;
                            SP_S_x1   = vgfb1 + gam2 * 0.5 - gam * sqrt(vgfb1 + gam2 * 0.25 - SP_S_w);
                            SP_S_bx   = (phidf) + 3.0;
                            SP_S_eta  = `MINF(SP_S_x1, SP_S_bx, 5.0) - 0.5 * (SP_S_bx - sqrt(SP_S_bx * SP_S_bx + 5.0));
                            SP_S_temp = vgfb1 - SP_S_eta;
                            SP_S_temp1= lexp(-SP_S_eta);
                            SP_S_temp2= 1.0 / (2.0 + SP_S_eta * SP_S_eta);
                            SP_S_xi0  = SP_S_eta * SP_S_eta * SP_S_temp2;
                            SP_S_xi1  = 4.0 * (SP_S_eta * SP_S_temp2 * SP_S_temp2);
                            SP_S_xi2  = (8.0 * SP_S_temp2 - 12.0 * SP_S_xi0) * SP_S_temp2 * SP_S_temp2;
                            SP_S_a    = max(1.0e-40, SP_S_temp * SP_S_temp - gam2 * (SP_S_temp1 + SP_S_eta - 1.0 - (exp_nd) * (SP_S_eta + 1.0 + SP_S_xi0)));
                            SP_S_b    = 1.0 - 0.5 * (gam2 * (SP_S_temp1 - (exp_nd) * SP_S_xi2));
                            SP_S_c    = 2.0 * SP_S_temp + gam2 * (1.0 - SP_S_temp1 - (exp_nd) * (1.0 + SP_S_xi1));
                            SP_S_tau  = (phidf) - SP_S_eta + lln(SP_S_a / gam2);
                            `sigma1(SP_S_a, SP_S_b, SP_S_c, SP_S_tau, SP_S_eta, SP_S_x0)
                            SP_S_delta0 = lexp(SP_S_x0);
                            SP_S_delta1 = 1.0 / SP_S_delta0;
                            SP_S_delta0 = lexp(SP_S_x0 - phidf);
                            SP_S_temp   = 1.0 / (2.0 + SP_S_x0 * SP_S_x0);
                            SP_S_xi0    = SP_S_x0 * SP_S_x0 * SP_S_temp;
                            SP_S_xi1    = 4.0 * (SP_S_x0 * SP_S_temp * SP_S_temp);
                            SP_S_xi2    = (8.0 * SP_S_temp - 12.0 * SP_S_xi0) * SP_S_temp * SP_S_temp;
                            SP_S_temp   = vgfb1 - SP_S_x0;
                            SP_S_pC     = 2.0 * SP_S_temp + gam2 * (1.0 - SP_S_delta1 + SP_S_delta0 - (exp_nd) * (1.0 + SP_S_xi1));
                            SP_S_qC     = SP_S_temp * SP_S_temp - gam2 * (SP_S_delta1 + SP_S_x0 - 1.0 + SP_S_delta0 - (exp_nd) * (SP_S_x0 + 1.0 + SP_S_xi0));
                            SP_S_temp   = 2.0 - gam2 * (SP_S_delta1 + SP_S_delta0 - (exp_nd) * SP_S_xi2);
                            SP_S_temp   = SP_S_pC * SP_S_pC - 2.0 * (SP_S_qC * SP_S_temp);
                            sp_dd          = SP_S_x0 + 2.0 * (SP_S_qC / (SP_S_pC + sqrt(SP_S_temp)));
                        end

                    end
                end

                xs = sp_dd;
                limit1 = 1e-7;
                K11 = 2.0;
                SP_S_tempc =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2 ;
                PHIC =  (1.0 + LPE1_i / Leff)*(`P_Q_NIST1998 * NDEP_i * (TSI * TSI)) / (2 * epssi) + VBSA;
                T0 = -DVBD1_i * Leff / litl;
                T1 = DVBD0_i * (lexp(0.5*T0) + 2.0*lexp(T0)) * (Vds* inv_Vt + VSCE_i* inv_Vt);
                phic_s =PHIC-RC*(vgfbb*Vt)*CDSBS1_i + (1+RC)*T1*Vt+ (1+RC)*(phisb0);

                //First Iteration of final Poisson's expression
                if (abs(vgfb1)<= (limit1)) begin
                    T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
                    x7_d         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * T0);
                end else begin
                    T0= (0.5 * (tanh(-5.0 * (vgfb1 - K11)) +  tanh(5.0 * (vgfb1 + K11)) ));
                    sp_vfb       =vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * SP_S_tempc) * T0;

                    T0  = lexp((xs * Vt - phic_s)/Vt);

                    T2  = ln_one_plus_exp((xs * Vt - phic_s) / Vt) - ln_one_plus_exp((sp_vfb * Vt - phic_s)/Vt);
                    T3  = -(phisb0 / Vt + T2/(1.0+RC));
                    T4  = lexp(T3);
                    T6  = lexp(-xs);
                    T7  = xs * xs;
                    T8  = 1.0 / (T7 + 2.0);
                    T9  = lexp(-phidf);
                    T10 = lexp(xs - phidf);

                    fx   = (vgfb1 - xs) * (vgfb1 - xs) - RT * RT * (vgfbb + T3) * (vgfbb + T3) - gam2 * (T6 - T4 + xs + T3 + T10 - T9 * (xs + 1.0 + T8 * T7));
                    f_x  = (2.0 * T0 * (vgfbb + T3) * RT * RT) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * vgfb1 + 2.0 * xs - gam2 * (T10 + T9 * (-2.0 * xs * T8 + 2.0 * xs * xs * xs * T8 * T8 - 1.0) - T6 - T0 / ((1.0 + RC) * (1.0 + T0)) + (T0 * T4) / ((1.0 + RC) * (1.0 + T0)) + 1.0);
                    f_xx = 2.0 * RT * RT * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * RT * RT * T0 * T0 / ((1.0 + RC) * (1.0 + T0) * (1.0 + RC) * (1.0 + T0)) - gam2 * (T6 + T10 - 2.0 * T9 * T8 * (1.0 - T7 * T8 * (5.0 - 4.0 * T7 * T8)) - T0 / ((1.0 + RC) * (1.0 + T0)) * (1.0 - T0 / (1.0 + T0) - T4 + T0 * T4 / (1.0 + T0) * (1.0 + 1.0 / (1.0 + RC)))) - 2.0 * RT * RT * T0 * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0) * (1.0 + T0)) + 2.0;

                    x7_d=xs-(fx/f_x)*(1.0 + ((fx*f_xx)/(2.0*f_x*f_x)));
                end

                //Second Iteration of final Poisson's expression
                xs=x7_d;
                if (abs(vgfb1)<= (limit1)) begin
                    T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
                    x7_d         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * T0);
                end else begin
                    T0= (0.5 * (tanh(-5.0 * (vgfb1 - K11)) +  tanh(5.0 * (vgfb1 + K11)) ));
                    sp_vfb       =vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_nd)) * gam * SP_S_tempc) * T0;

                    T0  = lexp((xs * Vt - phic_s)/Vt);

                    T2  = ln_one_plus_exp((xs * Vt - phic_s) / Vt) - ln_one_plus_exp((sp_vfb * Vt - phic_s)/Vt);
                    T3  = -(phisb0 / Vt + T2/(1.0+RC));
                    T4  = lexp(T3);
                    T6  = lexp(-xs);
                    T7  = xs * xs;
                    T8  = 1.0 / (T7 + 2.0);
                    T9  = lexp(-phidf);
                    T10 = lexp(xs - phidf);

                    fx   = (vgfb1 - xs) * (vgfb1 - xs) - RT * RT * (vgfbb + T3) * (vgfbb + T3) - gam2 * (T6 - T4 + xs + T3 + T10 - T9 * (xs + 1.0 + T8 * T7));
                    f_x  = (2.0 * T0 * (vgfbb + T3) * RT * RT) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * vgfb1 + 2.0 * xs - gam2 * (T10 + T9 * (-2.0 * xs * T8 + 2.0 * xs * xs * xs * T8 * T8 - 1.0) - T6 - T0 / ((1.0 + RC) * (1.0 + T0)) + (T0 * T4) / ((1.0 + RC) * (1.0 + T0)) + 1.0);
                    f_xx = 2.0 * RT * RT * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * RT * RT * T0 * T0 / ((1.0 + RC) * (1.0 + T0) * (1.0 + RC) * (1.0 + T0)) - gam2 * (T6 + T10 - 2.0 * T9 * T8 * (1.0 - T7 * T8 * (5.0 - 4.0 * T7 * T8)) - T0 / ((1.0 + RC) * (1.0 + T0)) * (1.0 - T0 / (1.0 + T0) - T4 + T0 * T4 / (1.0 + T0) * (1.0 + 1.0 / (1.0 + RC)))) - 2.0 * RT * RT * T0 * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0) * (1.0 + T0)) + 2.0;

                    x7_d=xs-(fx/f_x)*(1.0 + ((fx*f_xx)/(2.0*f_x*f_x)));
                end

                //Third Iteration of final Poisson's expression
                xs=x7_d;
                if (abs(vgfb1)<= (limit1)) begin
                    T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
                    x7_d         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * T0);
                end else begin
                    T0= (0.5 * (tanh(-5.0 * (vgfb1 - K11)) +  tanh(5.0 * (vgfb1 + K11)) ));
                    sp_vfb       =vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_nd)) * gam * SP_S_tempc) * T0;

                    T0  = lexp((xs * Vt - phic_s)/Vt);

                    T2  = ln_one_plus_exp((xs * Vt - phic_s) / Vt) - ln_one_plus_exp((sp_vfb * Vt - phic_s)/Vt);
                    T3  = -(phisb0 / Vt + T2/(1.0+RC));
                    T4  = lexp(T3);
                    T6  = lexp(-xs);
                    T7  = xs * xs;
                    T8  = 1.0 / (T7 + 2.0);
                    T9  = lexp(-phidf);
                    T10 = lexp(xs - phidf);

                    fx   = (vgfb1 - xs) * (vgfb1 - xs) - RT * RT * (vgfbb + T3) * (vgfbb + T3) - gam2 * (T6 - T4 + xs + T3 + T10 - T9 * (xs + 1.0 + T8 * T7));
                    f_x  = (2.0 * T0 * (vgfbb + T3) * RT * RT) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * vgfb1 + 2.0 * xs - gam2 * (T10 + T9 * (-2.0 * xs * T8 + 2.0 * xs * xs * xs * T8 * T8 - 1.0) - T6 - T0 / ((1.0 + RC) * (1.0 + T0)) + (T0 * T4) / ((1.0 + RC) * (1.0 + T0)) + 1.0);
                    f_xx = 2.0 * RT * RT * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * RT * RT * T0 * T0 / ((1.0 + RC) * (1.0 + T0) * (1.0 + RC) * (1.0 + T0)) - gam2 * (T6 + T10 - 2.0 * T9 * T8 * (1.0 - T7 * T8 * (5.0 - 4.0 * T7 * T8)) - T0 / ((1.0 + RC) * (1.0 + T0)) * (1.0 - T0 / (1.0 + T0) - T4 + T0 * T4 / (1.0 + T0) * (1.0 + 1.0 / (1.0 + RC)))) - 2.0 * RT * RT * T0 * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0) * (1.0 + T0)) + 2.0;

                    x7_d=xs-(fx/f_x)*(1.0 + ((fx*f_xx)/(2.0*f_x*f_x)));
                end


                x_ds         =  x7_d - x7_s;

                //Approximations for extremely small x7_ds: capacitance calculation
                Udse         =  (Vds)*inv_Vt;
                k_ds         =  lexp(-Udse);
                if (x_ds < 1.0e-10) begin
                    T0  = lexp((xs * Vt - phic_s) / Vt);

                    T2  = ln_one_plus_exp((xs * Vt - phic_s) / Vt) - ln_one_plus_exp((sp_vfb * Vt - phic_s) / Vt);
                    T3  = -(phisb0 / Vt + T2 / (1.0 + RC));
                    T4  = lexp(T3);
                    T5  = lexp(T3 + (xs * Vt - phic_s) / Vt);
                    T6  = lexp(-xs);
                    T7  = xs * xs;
                    T8  = 1.0 / (T7 + 2.0);

                    T10 = lexp(xs - phidf);
                    T11 = lexp(2.0 * (xs * Vt - phic_s) / Vt);
                    T12 = lexp(2.0 * (xs * Vt - phic_s) / Vt + T3);

                    pC   = -( (2.0 * T0 * (vgfbb + T3)*RT * RT)/((RC + 1.0) * (T0 + 1.0)) - 2.0 * vgfb1  + 2.0 * xs  - gam2 * (lexp(xs - Udse -phidf) + lexp(-Udse - phidf) * (-2.0 * xs * T8 + 2.0 * xs * xs * xs * T8 * T8 - 1.0) - T6 - T0 / ((RC + 1.0) * (T0 + 1.0)) + T5 / ((RC + 1.0) * (T0 + 1.0)) + 1.0) );
                    qC    =  gam2 *(1.0 - k_ds)* Ds;
                    tempc =  2.0 * RT * RT * T0 * (vgfbb + T3) / ((1+RC) * (1 + T0)) - 2.0 * RT * RT * T11 / ((1.0 + RC) * (1.0 + RC) * (1.0 + 2.0 * T0 + T11)) - gam2 * (T6 + lexp(xs -phidf - Udse) + lexp(-phidf - Udse) * ( -2.0 * T8 + 10.0 * xs * xs * T8 * T8 - 8.0 * xs * xs * xs * xs * T8 * T8 * T8) - T0 / ((1.0 + RC) * (1.0 + T0)) + T11 / ((1.0 + RC) * (1.0 + 2.0 * T0 + T11)) + T5 / ((1.0 + RC) * (1.0 + T0)) - T12 / ((1.0 + RC) * (1.0 + 2.0 * T0 + T11)) - T12 / ((1.0 + RC) * (1.0 + RC) * (1.0 + 2.0 * T0 + T11))) - 2.0 * RT * RT * T11 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + 2.0 * T0 + T11)) + 2.0;
                    tempc        =  pC * pC - 2.0 * (tempc * qC);

                    if (tempc >= 0) begin
                        x_ds         =  2.0 * (qC / (pC + sqrt(tempc)));
                    end
                    x7_d         = x7_s + x_ds;
                end
                dps          =  x_ds * Vt;

                xi0d         =  x7_d * x7_d / (2.0 + x7_d * x7_d);
                Ed           =  lexp(-x7_d);
                Dd           =  lexp(x7_d - phidf) - lexp(-phidf) * (x7_d + 1.0 + xi0d);
                Pd           = (vgfb1 - x7_d )*(vgfb1 - x7_d )*(1.0/gam2) -  Dd;
                Pd           =  hypsmooth(Pd - 1.0e-3, 1.0e-5) + 1.0e-3;
                sqd          =  sqrt(Pd);


                //--------------------------------------
                xgd          =  gam * sqrt(Pd + Dd);
                qid          =  gam2 * Dd * Vt / (xgd + gam * sqd);



                // Mid-point surface potential

                x_m          =  0.5 * (x7_s + x7_d);

                tempc         =  abs(Ed * Es1);
                Em           =  sqrt(tempc);

                D_bar        =  0.5 * (Ds + Dd);
                Dm           =  D_bar + 0.125 * (x_ds * x_ds * (Em - 2.0 * inv_gam2));
                Pm           =  (vgfb1-x_m )*(vgfb1-x_m )*(1.0/gam2) -  Dm ;
                xgm          =  gam * sqrt(Dm + Pm);
                Pm           =  hypsmooth(Pm - 1.0e-3, 1.0e-5) + 1.0e-3;
                sqm          =  sqrt(Pm);

                if (abs(dps) > 1e-35) begin
                    alpha_DD    =  (qis - qid) / dps;
                end
                qim          =  Vt * (gam2 * Dm / (xgm + gam * sqm));

                Voxm         =  xgm * Vt ;
                alpha1       =  alpha_DD;
                alpha1       = hypsmooth(alpha1 - 1.0e-3, 1.0e-5) + 1.0e-3;
                qim1         =  qim + Vt * alpha1;
                H_fact  = ( qim1 / alpha1);
            end

            // DD  Core Capacitances
            if (x7_s <= 0.0) begin
                QGi_AGBCP3        =  Voxm;

                QDi_AGBCP3        =  0.0;
                QBi_AGBCP3        =  QGi_AGBCP3;
                QSi_AGBCP3        =  0.0;
            end else begin
                Fj         =  0.5 * (dps / H_fact);
                Fj2               =  Fj * Fj;
                QGi_AGBCP3        =  Voxm + 0.5 * (dps * (Fj * `oneThird));
                tempc             =  alpha_DD * dps * `oneSixth;
                Qi_AGBCP3         =  qim + tempc * Fj;
                QDi_AGBCP3        =  0.5 * (qim - tempc * (1.0 - Fj - 0.2 * Fj2));
                QBi_AGBCP3        =  QGi_AGBCP3 - Qi_AGBCP3;
                QSi_AGBCP3        =  (QGi_AGBCP3 - QBi_AGBCP3 - QDi_AGBCP3);
            end

            WLCOX          = AGBCP2 * (`P_EPS0 * EPSROX / BSIMBULKTOXP);
            WLCOXVtinv     = WLCOX;
            QBi_AGBCP2     = - WLCOXVtinv * QBi_AGBCP3;
            if (sigvds > 0) begin
                QSi_AGBCP2 = -WLCOXVtinv * QSi_AGBCP3;
                QDi_AGBCP2 = -WLCOXVtinv * QDi_AGBCP3;
            end else begin
                QSi_AGBCP2 = -WLCOXVtinv * QDi_AGBCP3;
                QDi_AGBCP2 = -WLCOXVtinv * QSi_AGBCP3;
            end
            QGi_AGBCP2     = - (QBi_AGBCP2 + QSi_AGBCP2 + QDi_AGBCP2);
        end else begin
            QBi_AGBCP2 = 0.0;
            QDi_AGBCP2 = 0.0;
            Qi_AGBCP2  = 0.0;
            QSi_AGBCP2 = 0.0;
            QGi_AGBCP2 = 0.0;
        end

        // Charge expressions including fringing and overlap capacitances
        QB = devsign * (QBi + QBi_AGBCP2+ Qovb + Qbsj + Qbdj);
        QSI = devsign * (QSi + QSi_AGBCP2);
        QDI = devsign * (QDi + QDi_AGBCP2);
        QS  = devsign * (QSi + QSi_AGBCP2 + Qovs - Qbsj);
        QD  = devsign * (QDi + QDi_AGBCP2 + Qovd - Qbdj);
        QG = devsign * (QGi + QGi_AGBCP2 + Qovg);
        // Output
        // Intrinsic charges
        QBI = devsign * (QBi + QBi_AGBCP2);
        QGI = devsign * (QGi + QGi_AGBCP2);
        QGIM = devsign * QGi;
        QGIAGBCP2 = devsign * QGi_AGBCP2;

        QSIM = devsign * QSi;
        QSIAGBCP2 = devsign * QSi_AGBCP2;

        QDIM = devsign * QDi;
        QDIAGBCP2 = devsign * QDi_AGBCP2;

        //Gate Current model for SOIMOD=1
        AIGC_i = AIGC_i + AIGC1_i * (TRatio - 1.0);
        AIGS_i = AIGS_i + AIGS1_i * (TRatio - 1.0);
        AIGD_i = AIGD_i + AIGD1_i * (TRatio - 1.0);
        ALPHAGB1_i = ALPHAGB1_i + ALPHAGB1_T_i * (TRatio - 1.0);
        ALPHAGB2_i = ALPHAGB2_i + ALPHAGB2_T_i * (TRatio - 1.0);
        AIGBCP2_i  = AIGBCP2_i + AIGBCP2_T_i * (TRatio - 1.0);

        igb = 0.0; igcs = 0.0;
        igcd   = 0.0; igs    = 0.0; igd = 0.0;

        // Gate-to-body tunneling components
        if ((IGCMOD != 0) || (IGBMOD != 0)) begin
            Voxm1    = nVt * (vgfb - 0.5 *(x7_s + x7_d));
            T1      = sqrt(Voxm1 * Voxm1 + 1.0e-4);
            Voxmacc = 0.5 * (-Voxm1 + T1);
            Voxminv = 0.5 * (Voxm1 + T1);
            if (IGBMOD != 0) begin
                //Igbacc
                T1     = Voxm1 / VECB;
                Vaux_Igbacc = VECB * ln_one_plus_exp(-T1);
                if (VGB2 != 0) begin
                    T0 = 1- Voxmacc / VGB2;
                end else begin
                    T0 = 1;
                end
                if (T0 < 0.01) begin
                    T0 = 0.01;
                end

                T1 = (Leff * Weff / NSEG + AGBCPD / NF ) * AGB2 * ToxRatio;
                T2 = BGB2 * TOXE;

                T3 = T2 * (ALPHAGB2_i - BETAGB2_i * Voxmacc) / T0;
                T4 = lexp(T3);

                igbacc = T1 * Vg * Vaux_Igbacc * T4;
                igbacc = igbacc * igtemp;

                //Igbinv
                T1     = (Voxm1 - EIGBINV_i) / VECB;
                Vaux_Igbinv = VECB * ln_one_plus_exp(T1);

                if (VGB1 != 0) begin
                    T0 = 1- Voxminv / VGB1;
                end else begin
                    T0 = 1;
                end

                if (T0 < 0.01) begin
                    T0 = 0.01;
                end

                T1 = (Leff * Weff / NSEG + AGBCPD / NF ) * AGB1 * ToxRatio;
                T2 = BGB1 * TOXE;
                T3 = T2 * (ALPHAGB1_i - BETAGB1_i * Voxminv) / T0;
                T4 = lexp(T3);
                igbinv = T1 * Vg * Vaux_Igbinv * T4;
                igbinv = igbinv * igtemp;
                igb    = NF * (igbacc + igbinv);
                Vfb2 = vfb * nVt + EGGBCP2;
            end

            //Gate tunneling component in the AGBCP2 region
            if ((BODYMOD !=0 && $port_connected(b) != 0 && !(TNODEOUT && !$port_connected(t)) && MODAGBCP2 ==1) && AGBCP2 > 0) begin
                Vgb = devsign * V(gi, bi2);
                T0 = Vgb - Vfb2;
                T1 = sqrt(T0 * T0 + 1.0e-4);
                Vgp_eff = 0.5 * (-T0 + T1 - 1.0e-2);
                T11 = (TYPE == `ntype) ? AGBC2N : AGBC2P;
                T12 = (TYPE == `ntype) ? BGBC2N : BGBC2P;
                T2 = Vgb * Vgp_eff;
                T3 = AIGBCP2_i * CIGBCP2_i - BIGBCP2_i;
                T4 = BIGBCP2_i * CIGBCP2_i;
                T5 = (-T12) * TOXE * (AIGBCP2_i + T3 * Vgp_eff -T4 * Vgp_eff * Vgp_eff);
                T6 = lexp(T5);
                T11 = T11 * AGBCP2 * ToxRatio;
                Ig_agbcp2 = T11 * T2 * T6 * igtemp;
            end else begin
                Ig_agbcp2 = 0.0;
            end

            //Gate to Channel Current
            if (IGCMOD != 0) begin
            // Igcinv
                T1   = AIGC_i - BIGC_i * Voxminv;
                T2   = 1.0 + CIGC_i * Voxminv;
                T3   = Bechvb * T1 * T2;
                T4   = nq * nVt * (qia) * lexp(T3);
                igc0 = NF * Aechvb * T4 * (Vg + 0.5 * Vdsx - 0.5 * (Vs + Vd)) * igtemp;
                // Gate-current partitioning
                Vdseffx = sqrt(Vdseff * Vdseff + 0.01) - 0.1;
                T1      = PIGCD_i * Vdseffx;
                T1_exp  = lexp(-T1);
                T3      = T1 + T1_exp -1.0 + 1.0e-4;
                T4      = 1.0 - (T1 + 1.0) * T1_exp + 1.0e-4;
                T5      = T1 * T1 + 2.0e-4;
                if (sigvds > 0) begin
                    igcd = igc0 * T4 / T5;
                    igcs = igc0 * T3 / T5;
                end else begin
                    igcs = igc0 * T4 / T5;
                    igcd = igc0 * T3 / T5;
                end
                    //Gate to S/D Current
                // Igs
                T2      = Vgs_noswap - Vfbsdr;
                Vgs_eff = sqrt(T2 * T2 + 1.0e-4);
                if (IGCLAMP == 1) begin
                    T1 = hypsmooth((AIGS_i - BIGS_i * Vgs_eff), 1.0e-6);
                    if (CIGS_i < 0.01) begin
                        CIGS_i = 0.01;
                    end
                end else begin
                    T1 = AIGS_i - BIGS_i * Vgs_eff;
                end
                T2       = 1.0 + CIGS_i * Vgs_eff;
                T3       = BechvbEdge * T1 * T2;
                T4       = lexp(T3);
                igs_mult = igtemp * NF * AechvbEdges * DLCIG_i;
                igs      = igs_mult * Vgs_noswap * Vgs_eff * T4;
                // Igd
                T2      = Vgd_noswap - Vfbsdr;
                Vgd_eff = sqrt(T2 * T2 + 1.0e-4);
                if (IGCLAMP == 1) begin
                    T1 = hypsmooth((AIGD_i - BIGD_i * Vgd_eff), 1.0e-6);
                    if (CIGD_i < 0.01) begin
                        CIGD_i = 0.01;
                    end
                end else begin
                    T1 = AIGD_i - BIGD_i * Vgd_eff;
                end
                T2       = 1.0 + CIGD_i * Vgd_eff;
                T3       = BechvbEdge * T1 * T2;
                T4       = lexp(T3);
                igd_mult = igtemp * NF * AechvbEdged * DLCIGD_i;
                igd      = igd_mult * Vgd_noswap * Vgd_eff * T4;
            end
        end
        IGS  = devsign * igs;
        IGD  = devsign * igd;
        IGB  = devsign * igb;
        IGCS = devsign * igcs;
        IGCD = devsign * igcd;

        //Flicker Noise
        Nt      = 4.0 * Vt * `P_Q_NIST1998;
        Esatnoi = 2.0 * VSAT_a / ueff;
        if (EM <= 0.0) begin
            DelClm = 0.0;
        end else begin
            T0     = (diffVds / litl + EM) / Esatnoi;
            DelClm = litl * lln(T0);
            if (DelClm < 0.0) begin
                DelClm = 0.0;
            end
        end
        Nstar = Vt / `P_Q_NIST1998 * (Cox + Cdep + CIT_i);
        Nl    = 2.0 * nq * Cox * Vt * qid * Mnud1 * Mnud / `P_Q_NIST1998;
        T0a   = `P_Q_NIST1998 * `P_Q_NIST1998 * `P_Q_NIST1998 * Vt * abs(ids) * ueff;
        T0b   = `P_Q_NIST1998 * Vt * ids * ids;
        T0c   = NOIA + NOIB * Nl + NOIC * Nl * Nl;
        T0d   = (Nl + Nstar) * (Nl + Nstar);
        T0e   = NOIA * `P_Q_NIST1998 * Vt;

        if (LINTNOI >= Leff/2.0) begin
            $strobe("Warning: LINTNOI = %e is too large - Leff for noise is negative. Re-setting LINTNOI = 0.", LINTNOI);
            LINTNOI_i = 0.0;
        end else begin
            LINTNOI_i = LINTNOI;
        end
        if (NOIA > 0.0 || NOIB > 0.0 || NOIC > 0.0) begin
            Leffnoi   = Leff - 2.0 * LINTNOI_i;
            Leffnoisq = Leffnoi * Leffnoi;
            T0        = 1.0e10 * Cox * Leffnoisq;
            N0        = 2.0 * nq * Cox * Vt * qis * Mnud1 * Mnud / `P_Q_NIST1998;
            T1        = NOIA * lln((N0 + Nstar) / (Nl + Nstar));
            T2        = NOIB * (N0 - Nl);
            T3        = 0.5 * NOIC * (N0 * N0 - Nl * Nl);
            T4        = 1.0e10 * Leffnoisq * Weff * NF;
            Ssi       = T0a / T0 * (T1 + T2 + T3) + T0b / T4 * DelClm * T0c / T0d;
            T5        = Weff * NF * Leffnoi * 1.0e10 * Nstar * Nstar;
            Swi       = T0e / T5 * ids * ids;
            T6        = Swi + Ssi;
            if (T6 > 0.0) begin
                FNPowerAt1Hz = (Ssi * Swi) / T6/(1.0+NOIA1*pow((qis-qid),NOIAX));
            end else begin
                FNPowerAt1Hz = 0.0;
            end
        end else begin
            FNPowerAt1Hz = 0.0;
        end
        I(di, si) <+ flicker_noise(sigvds*FNPowerAt1Hz, EF, "1overf");

        //Thermal Noise
        T0         = qia / Esatnoi / Leff;
        T1         = T0 * T0;
        T3         = RNOIA * (1.0 + TNOIA * Leff * T1);
        T4         = RNOIB * (1.0 + TNOIB * Leff * T1);
        T5         = RNOIK * (1.0 + TNOIK * Leff * T1);
        ctnoi      = RNOIC * (1.0 + TNOIC * Leff * T1);
        betanoisq  = 3.0 * T3 * T3;
        betanoisq  = (betanoisq - 1.0) * lexp(-Leff / LP) + 1.0;
        betaLowId  = T5 * T5;
        thetanoisq = T4 * T4;
        cm_igid    = 0.0;
        Dptwg=Dvsat;
        case (TNOIMOD)
            0: begin
                QSi   = -NF * Weff * Leff * Cox * Vt * QSI;
                QDi   = -NF * Weff * Leff * Cox * Vt * QDI;
                T0    = ueff * abs(QSi + QDi);
                T1    = T0 * Rdsi + Leff * Leff;
                Gtnoi = (T0 / T1) * NTNOI;
                sidn  = Nt * Gtnoi;
                I(di, si) <+ white_noise(sidn, "id");
                V(N1) <+ 0.0;
            end
            1: begin
                Vtn   = 2.0 * nq * nVt;
                T0    = ueff * Dptwg * Moc * Cox * Vtn;
                T1    = 0.5 * (qis+qid);
                T3    = T1 + 0.5;
                T4    = T3 * T3;
                T5    = T4 * T3;
                T6    = (qis - qid);
                T7    = T6 * T6;
                T8    = T7 * T6;
                T9    = (6.0 * T1 + 0.5) * T7;
                Lvsat = Leff * Dptwg;
                T10   = Lvsat / Leff;
                T12   = 1.0 + (betaLowId * (Vdseff / Vdsat) / (TNOIK2 + qia));
                T12   = ((T12 - 1.0) * lexp(-Leff / LP)) + 1.0;
                `Smooth(T12, 0.0, 1.0e-1, T12)
                mid   = T0 * NF * Weff / Lvsat * (T1 * T12 + T7 * betanoisq / (12.0 * T3));
                mig   = Lvsat * T10 * T10 * (T1 / T4 - T9 / (60.0 * T4 * T4) + T7 * T7 / (144.0 * T4 * T5)) * 15.0 / 4.0 * thetanoisq / (NF * Weff * 12.0 * T0);
                migid = T10 * (T6 / (12.0 * T3) - T8 / (144.0 * T5)) * ctnoi / 0.395;
                sqid  = sqrt(Nt * mid);
                if (mig > 0.0) begin
                    sqig = sqrt(Nt / mig);
                    if (sqid > 0.0) begin
                        cm_igid = migid * sqig / sqid;
                    end else begin
                        cm_igid = 0.0;
                    end
                end else begin
                    sqig    = 0.0;
                    cm_igid = 0.0;
                end
                I(N2)     <+ white_noise(cm_igid, "corl");
                I(NI)     <+ white_noise(sqig * sqig * (1.0 - cm_igid), "corl");
                I(NI)     <+ -sqig * V(N2);
                I(NC)     <+ ddt(mig * Cox * Weff * NF * Leff * V(NC));
                I(di, si) <+ white_noise(sqid * sqid * (1.0 - cm_igid), "id");
                I(di, si) <+ sqid * V(N2);
                I(gi, si) <+ ddt(0.5 * ((1.0 + sigvds) * mig * Cox * Weff * NF * Leff * V(NC)));
                I(gi, di) <+ ddt(0.5 * ((1.0 - sigvds) * mig * Cox * Weff * NF * Leff * V(NC)));
            end
        endcase
        I(N2) <+ V(N2);
        I(NR) <+ V(NR);

        // Gate current shot noise
        if (IGCMOD != 0) begin
            I(gi, si) <+ white_noise(2.0 * `P_Q_NIST1998 * abs(igcs + igs), "igs");
            I(gi, di) <+ white_noise(2.0 * `P_Q_NIST1998 * abs(igcd + igd), "igd");
        end
        if (IGBMOD != 0) begin
            I(gi, bi) <+ white_noise(2.0 * `P_Q_NIST1998 * abs(igb), "igb");
        end

        if (EDGEFET == 1) begin
            phib_edge     = lln(NDEPEDGE_i / ni);
            Phist         = max(0.4 + Vt * phib_edge + PHIN_i, 0.4);
            sqrtPhist     = sqrt(Phist);


            T1DEP         = sqrt(2.0 * epssi / (`P_Q_NIST1998 * NDEPEDGE_i));
            NFACTOREDGE_t = NFACTOREDGE_i * hypsmooth((1.0 + TNFACTOREDGE_i * (TRatio - 1.0)), 1e-3);
            ETA0EDGE_t    = ETA0EDGE_i * (1.0 + TETA0EDGE_i * (TRatio - 1.0));
            `Smooth(Phist - Vbsx, 0.05, 0.1, PhistVbs)
            sqrtPhistVbs  = sqrt(PhistVbs);
            Xdep          = T1DEP * sqrtPhistVbs;
            Cdep          = epssi / Xdep;
            T2            = CB * CBOX / (CB + CBOX);
            T3            = (CDSCDEDGE_a + CSECSEDEDGE * Vesx - CBCBDEDGE * Vbsx) * Vdsx;
            T4            = CSECSE0EDGE * Vesx + CSECSE0PEDGE * Vesx * Vesx - CBCB0EDGE *Vbsx - CBCB0PEDGE *Vbsx*Vbsx  + Theta_SCE * (CDSCEDGE_i + CSECSEEDGE_i * Vesx + CSECSEPEDGE * Vesx * Vesx + CBCBEDGE_i *Vbsx + CBCBPEDGE *Vbsx * Vbsx+ T3);
            T1            =  (Cox + T2 + CITEDGE_i + NFACTOREDGE_t + T4) / (Cox + T2);
            `Smooth(T1, 1.0, 0.05, n)
            nVt       = n * Vt;
            inv_nVt   = 1.0 / nVt;
            vg    = Vg * inv_nVt;
            vs    = Vs * inv_nVt;
            vfb   = VFB_i * inv_nVt;
            vfbb  = VFBB_i * inv_nVt;
            ve = Ve * inv_nVt;

            dVth_VNUD = K1EDGE_i * (sqrtPhistVbs - sqrtPhist) - (K2EDGE_i) * Vbsx;
            dvth_dibl   = -(ETA0EDGE_t + ETABEDGE_i * Vbsx) * Vdsx;
            dvth_temp = (KT1EDGE_i + KT1LEDGE_i / Leff + KT2EDGE_i * Vbsx) * (pow(TRatio, KT1EXPEDGE_i) - 1.0);
            litl_edge = litl * (1.0 + DVT2EDGE * Vbsx);
            if (litl_edge > 0) begin
                T0       = DVT1EDGE * Leff / litl_edge;
                if (T0 < 40.0) begin
                    theta_sce_edge = 0.5 * DVT0EDGE / (cosh(T0) - 1.0);
                end else begin
                    theta_sce_edge = DVT0EDGE * lexp(-T0);
                end
            end else begin
                theta_sce_edge = 0.0;
            end
            dvth_sce  = theta_sce_edge * (Vbi_edge - Phist);
            // Vth correction for pocket implants
            if (DVTP0EDGE_i > 0.0) begin
                T0 = -DVTP1EDGE_i * Vdsx;
                if (T0 < -`EXPL_THRESHOLD) begin
                    T2 = `MIN_EXPL;
                end else begin
                    T2 = lexp(T0);
                end
                T3        = Leff + DVTP0EDGE_i * (1.0 + T2);
                dVth_ldop = -nVt * lln(Leff / T3);
            end else begin
                dVth_ldop = 0.0;
            end
            T4        = DVTP5EDGE_i + DVTP2EDGE_i / pow(Leff, DVTP3EDGE_i);
            dVth_ldop = dVth_ldop - T4 * tanh(DVTP4EDGE_i * Vdsx);

            Vth_shift = dVth_VNUD + dVth_ldop + dvth_dibl - dvth_temp + dvth_sce + DVTEDGE + vth0_stress_EDGE + vth0_well_edge ;
            vgfb      = vg - vfb - Vth_shift * inv_nVt;

            vgsfb = vg - Vbsx * inv_nVt - vfb - Vth_shift * inv_nVt;

            //Normalized terminal voltages for DDMOD
            vgfb1 = vg - vfb  - Vth_shift * inv_nVt;
            vgfbb = ve - vfbb;


            // Normalized body factor
            gam     = sqrt(2.0 * `P_Q_NIST1998 * epssi * NDEPEDGE_i * inv_nVt) / Cox;
            DGAMMAEDGE_i = DGAMMAEDGE * (1.0 + DGAMMAEDGEL * pow(Leff, -DGAMMAEDGELEXP));
            gam          = gam * (1.0 + DGAMMAEDGE_i);
            inv_gam = 1.0 / gam;
            gam2 = gam * gam;
            inv_gam2 = 1.0 / gam2;
            // DD Model Back potential solved independently for PD decoupled case.
            CB = epssi / TSI;
            CBOX = epsox / TBOX;
            RC= (CBOX +CDSBS_i) / CB ;
            RT = TOXE / TBOX ;
            gam_sb = gam / RT;
            x1_sb = 1.0 + gam_sb * `invSqrt2;
            limit_sb = 1.0e-7 * x1_sb;
            x1_csb         =  5.0/4.0;
            inv_xi_sb = (1.0/gam_sb);
            gam_sb2 = gam_sb*gam_sb;
            inv_xg1_sb  =  1.0 / (x1_csb + gam_sb * 7.324648775608221e-1);
            if (abs(vgfbb) <= limit_sb) begin
                pd_sb        =  ((-vgfbb ) * inv_xi_sb)*(1.0+gam_sb*((-vgfbb /(6.0*sqrt(2.0)*x1_sb*x1_sb))));
            end else begin
                if (vgfbb  < (-limit_sb)) begin
                    PD_yg    =  -vgfbb ;
                    PD_z     =  x1_csb * PD_yg  * inv_xi_sb;
                    PD_eta   =  0.5 * (PD_z  + 10.0 - sqrt((PD_z  - 6.0) * (PD_z  - 6.0) + 64.0));
                    PD_a     =  (PD_yg   - PD_eta) * (PD_yg   - PD_eta) + gam_sb2 * (PD_eta  + 1.0);
                    PD_c     =  2.0 * (PD_yg   - PD_eta) - gam_sb2;
                    PD_tau   =  lln(PD_a  / gam_sb2) - PD_eta ;
                    `sigma0(PD_a, PD_c, PD_tau, PD_eta, PD_y0)
                    PD_D0    =  lexp(PD_y0);
                    PD_temp  =  PD_yg  - PD_y0 ;
                    PD_p     =  2.0 * PD_temp  + gam_sb2 * (PD_D0  - 1.0);
                    PD_q     =  PD_temp  * PD_temp  + gam_sb2 * (PD_y0  + 1.0 - PD_D0 );
                    PD_xi    =  1.0 - gam_sb2 * 0.5 * PD_D0 ;
                    PD_temp  =  PD_p  * PD_p  - 4.0 * (PD_xi  * PD_q );
                    PD_w     =  2.0 * (PD_q  / (PD_p  + sqrt(PD_temp )));
                    pd_sb    = -(PD_y0  + PD_w );
                end else begin
                    PD_Afac  =  (x1_sb * x1_csb * inv_xg1_sb - 1.0) * inv_xg1_sb;
                    PD_xbar  =  vgfbb  * inv_xi_sb * (1.0 + PD_Afac * vgfbb );
                    PD_temp1 = lexp(-PD_xbar);
                    PD_w1    =  1.0 - PD_temp1;
                    PD_x0    =  vgfbb  + gam_sb2 * 0.5 - gam_sb * sqrt(vgfbb  + gam_sb2 * 0.25 - PD_w1 );
                    PD_D01   =  lexp(-PD_x0);
                    PD_p1    =  2.0 * (vgfbb - PD_x0 ) + gam_sb2 * (1.0 - PD_D01 );
                    PD_q1    =  (vgfbb  - PD_x0 ) * (vgfbb  - PD_x0 ) - gam_sb2 * (PD_x0  - 1.0 + PD_D01 );
                    PD_xi1   =  1.0 - gam_sb2 * 0.5 * PD_D01 ;
                    PD_temp1 =  PD_p1  * PD_p1  - 4.0 * (PD_xi1  * PD_q1 );
                    PD_u     =  2.0 * (PD_q1  / (PD_p1  + sqrt(PD_temp1 )));
                    pd_sb    =  PD_x0  + PD_u ;
                end
            end
            // One iteration given to correct value even at 10th decimal point
            if (abs(vgfbb)  < (limit_sb)) begin
                phisb0=((-vgfbb ) * inv_xi_sb)*(1.0+gam_sb*((-vgfbb /(6.0*sqrt(2.0)*x1_sb*x1_sb))));
                pd_sb=((-vgfbb ) * inv_xi_sb)*(1.0+gam_sb*((-vgfbb /(6.0*sqrt(2.0)*x1_sb*x1_sb))));
            end else begin
                fx = RT*RT*(vgfbb - pd_sb)*(vgfbb - pd_sb)*(1.0/gam)*(1.0/gam) -(lexp(-pd_sb) + pd_sb -1.0);
                f_x = lexp(-pd_sb) + (RT*RT*(2.0*pd_sb - 2.0*vgfbb))/(gam*gam) - 1.0;
                phisb0 =(pd_sb)-(fx /f_x );
            end
            phisb0=phisb0* nVt;

            // DD-MODEL core source side surface potential
            /* Surface potential at source side  DD-MODEL*/
            x1           =  1.0 + gam * `invSqrt2;
            inv_x1       =  1.0 /  x1;
            phisf         =  2.0 * phib/n + vs ;
            exp_ns     =  lexp(-phisf);
            limit       =  1.0e-3 * x1;
            T0 = -DVBD1_i * Leff / litl;
            T1 = DVBD0_i * (lexp(0.5*T0) + 2.0*lexp(T0)) * (0.0 + VSCE_i);
            phic_star  = (1.0 + LPE1_i / Leff)*(`P_Q_NIST1998 * NDEP_i * TSI * TSI) / (2.0 * epssi * nVt) + VBSA/nVt - RC * (vgfbb);
            vg_FD = phic_star + gam * sqrt(lexp(-phic_star) + phic_star -1.0) ;

            if (phic_star <phisf ) begin
                if (vgfb1 < (vg_FD)) begin
                    //PD initial Guess
                    if (abs(vgfb1) <= limit) begin
                        T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
                        sp_dd         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * T0);
                    end else begin
                        if (vgfb1 < (-limit)) begin
                            SP_S_yg   = -vgfb1;
                            SP_S_ysub   = 1.25 * (SP_S_yg * inv_x1);
                            SP_S_eta  =  0.5 * (SP_S_ysub + 10.0 - sqrt((SP_S_ysub - 6.0) * (SP_S_ysub - 6.0) + 64.0));
                            SP_S_temp   = SP_S_yg - SP_S_eta;
                            SP_S_a      = SP_S_temp * SP_S_temp + gam2 * (SP_S_eta + 1.0);
                            SP_S_c      = 2.0 * SP_S_temp - gam2;
                            SP_S_tau    = -SP_S_eta + lln(SP_S_a * inv_gam2);
                            `sigma0(SP_S_a, SP_S_c, SP_S_tau, SP_S_eta, SP_S_y0)
                            SP_S_delta0 = lexp(SP_S_y0);
                            SP_S_delta1 = 1.0 / SP_S_delta0;
                            SP_S_temp   = 1.0 / (2.0 + SP_S_y0 * SP_S_y0);
                            SP_S_xi0    = SP_S_y0 * SP_S_y0 * SP_S_temp;
                            SP_S_xi1    = 4.0 * (SP_S_y0 * SP_S_temp * SP_S_temp);
                            SP_S_xi2    = (8.0 * SP_S_temp - 12.0 * SP_S_xi0) * SP_S_temp * SP_S_temp;
                            SP_S_temp   = SP_S_yg - SP_S_y0;
                            SP_S_temp1  = (exp_ns) * SP_S_delta1;
                            SP_S_pC     = 2.0 * SP_S_temp + gam2 * (SP_S_delta0 - 1.0 - SP_S_temp1 + (exp_ns) * (1.0 - SP_S_xi1));
                            SP_S_qC     = SP_S_temp * SP_S_temp - gam2 * (SP_S_delta0 - SP_S_y0 - 1.0 + SP_S_temp1 + (exp_ns) * (SP_S_y0 - 1.0 - SP_S_xi0));
                            SP_S_temp   = 2.0 - gam2 * (SP_S_delta0 + SP_S_temp1 - (exp_ns) * SP_S_xi2);
                            SP_S_temp   = SP_S_pC * SP_S_pC - 2.0 * (SP_S_qC * SP_S_temp);
                            sp_dd          = -SP_S_y0 - 2.0 * (SP_S_qC / (SP_S_pC + sqrt(SP_S_temp)));
                        end else begin
                            SP_xg1    = 1.0 / (1.25 + gam * 7.324648775608221e-001);
                            SP_S_A_fac= (x1 * 1.25 * SP_xg1 - 1.0) * SP_xg1;
                            SP_S_xbar = vgfb1 * inv_x1 * (1.0 + SP_S_A_fac * vgfb1);
                            SP_S_temp = lexp(-SP_S_xbar);
                            SP_S_w    = 1.0 - SP_S_temp;
                            SP_S_x1   = vgfb1 + gam2 * 0.5 - gam * sqrt(vgfb1 + gam2 * 0.25 - SP_S_w);
                            SP_S_bx   = (phisf) + 3.0;
                            SP_S_eta  = `MINF(SP_S_x1, SP_S_bx, 5.0) - 0.5 * (SP_S_bx - sqrt(SP_S_bx * SP_S_bx + 5.0));
                            SP_S_temp = vgfb1 - SP_S_eta;
                            SP_S_temp1= lexp(-SP_S_eta);
                            SP_S_temp2= 1.0 / (2.0 + SP_S_eta * SP_S_eta);
                            SP_S_xi0  = SP_S_eta * SP_S_eta * SP_S_temp2;
                            SP_S_xi1  = 4.0 * (SP_S_eta * SP_S_temp2 * SP_S_temp2);
                            SP_S_xi2  = (8.0 * SP_S_temp2 - 12.0 * SP_S_xi0) * SP_S_temp2 * SP_S_temp2;
                            SP_S_a    = max(1.0e-40, SP_S_temp * SP_S_temp - gam2 * (SP_S_temp1 + SP_S_eta - 1.0 - (exp_ns) * (SP_S_eta + 1.0 + SP_S_xi0)));
                            SP_S_b    = 1.0 - 0.5 * (gam2 * (SP_S_temp1 - (exp_ns) * SP_S_xi2));
                            SP_S_c    = 2.0 * SP_S_temp + gam2 * (1.0 - SP_S_temp1 - (exp_ns) * (1.0 + SP_S_xi1));
                            SP_S_tau  = (phisf) - SP_S_eta + lln(SP_S_a / gam2);
                            `sigma1(SP_S_a, SP_S_b, SP_S_c, SP_S_tau, SP_S_eta, SP_S_x0)
                            SP_S_delta0 = lexp(SP_S_x0);
                            SP_S_delta1 = 1.0 / SP_S_delta0;
                            SP_S_delta0 = lexp(SP_S_x0 - phisf);
                            SP_S_temp   = 1.0 / (2.0 + SP_S_x0 * SP_S_x0);
                            SP_S_xi0    = SP_S_x0 * SP_S_x0 * SP_S_temp;
                            SP_S_xi1    = 4.0 * (SP_S_x0 * SP_S_temp * SP_S_temp);
                            SP_S_xi2    = (8.0 * SP_S_temp - 12.0 * SP_S_xi0) * SP_S_temp * SP_S_temp;
                            SP_S_temp   = vgfb1 - SP_S_x0;
                            SP_S_pC     = 2.0 * SP_S_temp + gam2 * (1.0 - SP_S_delta1 + SP_S_delta0 - (exp_ns) * (1.0 + SP_S_xi1));
                            SP_S_qC     = SP_S_temp * SP_S_temp - gam2 * (SP_S_delta1 + SP_S_x0 - 1.0 + SP_S_delta0 - (exp_ns) * (SP_S_x0 + 1.0 + SP_S_xi0));
                            SP_S_temp   = 2.0 - gam2 * (SP_S_delta1 + SP_S_delta0 - (exp_ns) * SP_S_xi2);
                            SP_S_temp   = SP_S_pC * SP_S_pC - 2.0 * (SP_S_qC * SP_S_temp);
                            sp_dd       = SP_S_x0 + 2.0 * (SP_S_qC / (SP_S_pC + sqrt(SP_S_temp)));
                        end
                    end
                end else begin
                    //FD initial Guess
                    zeta    = RT;
                    zeta2   = zeta * zeta;
                    u_crit  = phic_star - phisb0 * inv_nVt;
                    usf_FD  = vgfb1 - gam * sqrt(lexp(-u_crit) + u_crit -1.0) ;
                    SP_S_bx = (phisf) + 3.0;
                    SP_S_Z0 =  `MINF(usf_FD, SP_S_bx, 40.0);
                    a_fd = ((vgfb1-SP_S_Z0) * (vgfb1-SP_S_Z0) - zeta2 * (vgfbb-SP_S_Z0 + phic_star) * (vgfbb-SP_S_Z0+phic_star) - gam2 * (phic_star));
                    c_fd = 2.0 * (vgfb1 - SP_S_Z0 ) - 2.0 * zeta2 * (vgfbb - SP_S_Z0 + phic_star) ;
                    c_fd2 = c_fd * c_fd;
                    d_fd = 1.0 - zeta2;
                    if (a_fd < 0) begin
                        a_fd = 0.0;
                    end
                    tau_fd = phisf - SP_S_Z0  + lln(a_fd * inv_gam2);
                    v_fd = a_fd + c_fd;
                    v_fd2 = v_fd * v_fd;
                    mu_fd = v_fd2 / tau_fd  + 0.5 * c_fd2 - a_fd * d_fd;
                    temp1_fd = (c_fd * v_fd) / mu_fd;
                    temp2_fd = ( `oneThird * c_fd2 - a_fd * d_fd);
                    u_first_r = (v_fd * a_fd) / (mu_fd + temp1_fd * temp2_fd);
                    u0_first_FD = SP_S_Z0  + u_first_r;
                    delta0_fd = lexp(u0_first_FD - phisf);
                    p_fd = 2 *(vgfb1-u0_first_FD)- 2.0 * zeta2 * (vgfbb-u0_first_FD + phic_star)+ gam2 * delta0_fd;
                    q_fd = (vgfb1-u0_first_FD) * (vgfb1-u0_first_FD) - zeta2 * (vgfbb-u0_first_FD + phic_star) * (vgfbb-u0_first_FD+phic_star)- gam2 * (phic_star+delta0_fd);
                    temp3_fd = 2.0 * q_fd * (2.0- 2.0 * zeta2 - gam2 * delta0_fd);
                    w_fd= (2.0 * q_fd) / (p_fd + sqrt(p_fd * p_fd - temp3_fd));
                    sp_dd  = u0_first_FD + w_fd;
                end
            end else begin
                //PD initial Guess
                if (abs(vgfb1) <= limit) begin
                    T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
                    sp_dd         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * T0);
                end else begin
                    if (vgfb1 < (-limit)) begin
                        SP_S_yg   = -vgfb1;
                        SP_S_ysub   = 1.25 * (SP_S_yg * inv_x1);
                        SP_S_eta  =  0.5 * (SP_S_ysub + 10.0 - sqrt((SP_S_ysub - 6.0) * (SP_S_ysub - 6.0) + 64.0));
                        SP_S_temp   = SP_S_yg - SP_S_eta;
                        SP_S_a      = SP_S_temp * SP_S_temp + gam2 * (SP_S_eta + 1.0);
                        SP_S_c      = 2.0 * SP_S_temp - gam2;
                        SP_S_tau    = -SP_S_eta + lln(SP_S_a * inv_gam2);
                        `sigma0(SP_S_a, SP_S_c, SP_S_tau, SP_S_eta, SP_S_y0)
                        SP_S_delta0 = lexp(SP_S_y0);
                        SP_S_delta1 = 1.0 / SP_S_delta0;
                        SP_S_temp   = 1.0 / (2.0 + SP_S_y0 * SP_S_y0);
                        SP_S_xi0    = SP_S_y0 * SP_S_y0 * SP_S_temp;
                        SP_S_xi1    = 4.0 * (SP_S_y0 * SP_S_temp * SP_S_temp);
                        SP_S_xi2    = (8.0 * SP_S_temp - 12.0 * SP_S_xi0) * SP_S_temp * SP_S_temp;
                        SP_S_temp   = SP_S_yg - SP_S_y0;
                        SP_S_temp1  = (exp_ns) * SP_S_delta1;
                        SP_S_pC     = 2.0 * SP_S_temp + gam2 * (SP_S_delta0 - 1.0 - SP_S_temp1 + (exp_ns) * (1.0 - SP_S_xi1));
                        SP_S_qC     = SP_S_temp * SP_S_temp - gam2 * (SP_S_delta0 - SP_S_y0 - 1.0 + SP_S_temp1 + (exp_ns) * (SP_S_y0 - 1.0 - SP_S_xi0));
                        SP_S_temp   = 2.0 - gam2 * (SP_S_delta0 + SP_S_temp1 - (exp_ns) * SP_S_xi2);
                        SP_S_temp   = SP_S_pC * SP_S_pC - 2.0 * (SP_S_qC * SP_S_temp);
                        SP_S_temp   = sqrt(SP_S_temp * SP_S_temp + 64e-8) - 8e-4;
                        sp_dd          = -SP_S_y0 - 2.0 * (SP_S_qC / (SP_S_pC + sqrt(SP_S_temp)));
                    end else begin
                        SP_xg1    = 1.0 / (1.25 + gam * 7.324648775608221e-001);
                        SP_S_A_fac= (x1 * 1.25 * SP_xg1 - 1.0) * SP_xg1;
                        SP_S_xbar = vgfb1 * inv_x1 * (1.0 + SP_S_A_fac * vgfb1);
                        SP_S_temp = lexp(-SP_S_xbar);
                        SP_S_w    = 1.0 - SP_S_temp;
                        SP_S_x1   = vgfb1 + gam2 * 0.5 - gam * sqrt(vgfb1 + gam2 * 0.25 - SP_S_w);
                        SP_S_bx   = (phisf) + 3.0;
                        SP_S_eta  = `MINF(SP_S_x1, SP_S_bx, 5.0) - 0.5 * (SP_S_bx - sqrt(SP_S_bx * SP_S_bx + 5.0));
                        SP_S_temp = vgfb1 - SP_S_eta;
                        SP_S_temp1= lexp(-SP_S_eta);
                        SP_S_temp2= 1.0 / (2.0 + SP_S_eta * SP_S_eta);
                        SP_S_xi0  = SP_S_eta * SP_S_eta * SP_S_temp2;
                        SP_S_xi1  = 4.0 * (SP_S_eta * SP_S_temp2 * SP_S_temp2);
                        SP_S_xi2  = (8.0 * SP_S_temp2 - 12.0 * SP_S_xi0) * SP_S_temp2 * SP_S_temp2;
                        SP_S_a    = max(1.0e-40, SP_S_temp * SP_S_temp - gam2 * (SP_S_temp1 + SP_S_eta - 1.0 - (exp_ns) * (SP_S_eta + 1.0 + SP_S_xi0)));
                        SP_S_b    = 1.0 - 0.5 * (gam2 * (SP_S_temp1 - (exp_ns) * SP_S_xi2));
                        SP_S_c    = 2.0 * SP_S_temp + gam2 * (1.0 - SP_S_temp1 - (exp_ns) * (1.0 + SP_S_xi1));
                        SP_S_tau  = (phisf) - SP_S_eta + lln(SP_S_a / gam2);
                        `sigma1(SP_S_a, SP_S_b, SP_S_c, SP_S_tau, SP_S_eta, SP_S_x0)
                        SP_S_delta0 = lexp(SP_S_x0);
                        SP_S_delta1 = 1.0 / SP_S_delta0;
                        SP_S_delta0 = lexp(SP_S_x0 - phisf);
                        SP_S_temp   = 1.0 / (2.0 + SP_S_x0 * SP_S_x0);
                        SP_S_xi0    = SP_S_x0 * SP_S_x0 * SP_S_temp;
                        SP_S_xi1    = 4.0 * (SP_S_x0 * SP_S_temp * SP_S_temp);
                        SP_S_xi2    = (8.0 * SP_S_temp - 12.0 * SP_S_xi0) * SP_S_temp * SP_S_temp;
                        SP_S_temp   = vgfb1 - SP_S_x0;
                        SP_S_pC     = 2.0 * SP_S_temp + gam2 * (1.0 - SP_S_delta1 + SP_S_delta0 - (exp_ns) * (1.0 + SP_S_xi1));
                        SP_S_qC     = SP_S_temp * SP_S_temp - gam2 * (SP_S_delta1 + SP_S_x0 - 1.0 + SP_S_delta0 - (exp_ns) * (SP_S_x0 + 1.0 + SP_S_xi0));
                        SP_S_temp   = 2.0 - gam2 * (SP_S_delta1 + SP_S_delta0 - (exp_ns) * SP_S_xi2);
                        SP_S_temp   = SP_S_pC * SP_S_pC - 2.0 * (SP_S_qC * SP_S_temp);
                        SP_S_temp   = sqrt(SP_S_temp * SP_S_temp + 64e-8) - 8e-4;
                        sp_dd       = SP_S_x0 + 2.0 * (SP_S_qC / (SP_S_pC + sqrt(SP_S_temp)));
                    end
                end
            end

            xs = sp_dd;
            limit1 = 1.0e-7;
            K11 = 2.0;
            SP_S_tempc =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2 ;

            T0 = -DVBD1_i * Leff / litl;
            T1 = DVBD0_i * (lexp(0.5*T0) + 2.0*lexp(T0)) * (0.0 + VSCE_i);
            PHIC =  (1.0 + LPE1_i / Leff)*(`P_Q_NIST1998 * NDEP_i * (TSI * TSI)) / (2.0 * epssi)+ VBSA;
            phic_s = PHIC-RC*(vgfbb*nVt)*CDSBS1_i+ (1.0+RC)*(phisb0);

            //First Iteration of final Poisson's expression
            if (abs(vgfb1)<= (limit1)) begin
                T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
                x7_s         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * T0); // sp-> sp_dd
            end else begin
                T0= (0.5 * (tanh(-5.0 * (vgfb1 - K11)) +  tanh(5.0 * (vgfb1 + K11)) ));
                sp_vfb       =vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * SP_S_tempc) * T0;

                T0  = lexp((xs * nVt - phic_s)/nVt);
                T1  = lexp((sp_vfb * nVt - phic_s)/nVt);
                T2  = ln_one_plus_exp((xs * nVt - phic_s) / nVt) - ln_one_plus_exp((sp_vfb * nVt - phic_s)/nVt);
                T3  = -(phisb0 / nVt + T2/(1.0+RC));
                T4  = lexp(T3);
                T6  = lexp(-xs);
                T7  = xs * xs;
                T8  = 1.0 / (T7 + 2.0);
                T9  = lexp(-phisf);
                T10 = lexp(xs - phisf);

                fx   = (vgfb1 - xs) * (vgfb1 - xs) - RT * RT * (vgfbb + T3) * (vgfbb + T3) - gam2 * (T6 - T4 + xs + T3 + T10 - T9 * (xs + 1.0 + T8 * T7));
                f_x  = (2.0 * T0 * (vgfbb + T3) * RT * RT) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * vgfb1 + 2.0 * xs - gam2 * (T10 + T9 * (-2.0 * xs * T8 + 2.0 * xs * xs * xs * T8 * T8 - 1.0) - T6 - T0 / ((1.0 + RC) * (1.0 + T0)) + (T0 * T4) / ((1.0 + RC) * (1.0 + T0)) + 1.0);

                f_xx = 2.0 * RT * RT * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * RT * RT * T0 * T0 / ((1.0 + RC) * (1.0 + T0) * (1.0 + RC) * (1.0 + T0)) - gam2 * (T6 + T10 - 2.0 * T9 * T8 * (1.0 - T7 * T8 * (5.0 - 4.0 * T7 * T8)) - T0 / ((1.0 + RC) * (1.0 + T0)) * (1.0 - T0 / (1.0 + T0) - T4 + T0 * T4 / (1.0 + T0) * (1.0 + 1.0 / (1.0 + RC)))) - 2.0 * RT * RT * T0 * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0) * (1.0 + T0)) + 2.0;

                x7_s=xs-(fx/f_x)*(1.0 + ((fx*f_xx)/(2.0*f_x*f_x)));

            end

            //Second Iteration of final Poisson's expression
            xs=x7_s;
            if (abs(vgfb1)<= (limit1)) begin
                T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
                x7_s         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * T0); // sp-> sp_dd
            end else begin
                T0= (0.5 * (tanh(-5.0 * (vgfb1 - K11)) +  tanh(5.0 * (vgfb1 + K11)) ));
                sp_vfb       =vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * SP_S_tempc) * T0;

                T0  = lexp((xs * nVt - phic_s)/nVt);
                T1  = lexp((sp_vfb * nVt - phic_s)/nVt);
                T2  = ln_one_plus_exp((xs * nVt - phic_s) / nVt) - ln_one_plus_exp((sp_vfb * nVt - phic_s)/nVt);
                T3  = -(phisb0 / nVt + T2/(1.0+RC));
                T4  = lexp(T3);
                T6  = lexp(-xs);
                T7  = xs * xs;
                T8  = 1.0 / (T7 + 2.0);
                T9  = lexp(-phisf);
                T10 = lexp(xs - phisf);

                fx   = (vgfb1 - xs) * (vgfb1 - xs) - RT * RT * (vgfbb + T3) * (vgfbb + T3) - gam2 * (T6 - T4 + xs + T3 + T10 - T9 * (xs + 1.0 + T8 * T7));
                f_x  = (2.0 * T0 * (vgfbb + T3) * RT * RT) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * vgfb1 + 2.0 * xs - gam2 * (T10 + T9 * (-2.0 * xs * T8 + 2.0 * xs * xs * xs * T8 * T8 - 1.0) - T6 - T0 / ((1.0 + RC) * (1.0 + T0)) + (T0 * T4) / ((1.0 + RC) * (1.0 + T0)) + 1.0);

                f_xx = 2.0 * RT * RT * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * RT * RT * T0 * T0 / ((1.0 + RC) * (1.0 + T0) * (1.0 + RC) * (1.0 + T0)) - gam2 * (T6 + T10 - 2.0 * T9 * T8 * (1.0 - T7 * T8 * (5.0 - 4.0 * T7 * T8)) - T0 / ((1.0 + RC) * (1.0 + T0)) * (1.0 - T0 / (1.0 + T0) - T4 + T0 * T4 / (1.0 + T0) * (1.0 + 1.0 / (1.0 + RC)))) - 2.0 * RT * RT * T0 * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0) * (1.0 + T0)) + 2.0;

                x7_s=xs-(fx/f_x)*(1.0 + ((fx*f_xx)/(2.0*f_x*f_x)));

            end

            //Third Iteration of final Poisson's expression
            xs=x7_s;
            if (abs(vgfb1)<= (limit1)) begin
                T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
                x7_s         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * T0); // sp-> sp_dd
            end else begin
                T0= (0.5 * (tanh(-5.0 * (vgfb1 - K11)) +  tanh(5.0 * (vgfb1 + K11)) ));
                sp_vfb       =vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_ns)) * gam * SP_S_tempc) * T0;

                T0  = lexp((xs * nVt - phic_s)/nVt);
                T1  = lexp((sp_vfb * nVt - phic_s)/nVt);
                T2  = ln_one_plus_exp((xs * nVt - phic_s) / nVt) - ln_one_plus_exp((sp_vfb * nVt - phic_s)/nVt);
                T3  = -(phisb0 / nVt + T2/(1.0+RC));
                T4  = lexp(T3);
                T6  = lexp(-xs);
                T7  = xs * xs;
                T8  = 1.0 / (T7 + 2.0);
                T9  = lexp(-phisf);
                T10 = lexp(xs - phisf);

                fx   = (vgfb1 - xs) * (vgfb1 - xs) - RT * RT * (vgfbb + T3) * (vgfbb + T3) - gam2 * (T6 - T4 + xs + T3 + T10 - T9 * (xs + 1.0 + T8 * T7));
                f_x  = (2.0 * T0 * (vgfbb + T3) * RT * RT) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * vgfb1 + 2.0 * xs - gam2 * (T10 + T9 * (-2.0 * xs * T8 + 2.0 * xs * xs * xs * T8 * T8 - 1.0) - T6 - T0 / ((1.0 + RC) * (1.0 + T0)) + (T0 * T4) / ((1.0 + RC) * (1.0 + T0)) + 1.0);

                f_xx = 2.0 * RT * RT * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * RT * RT * T0 * T0 / ((1.0 + RC) * (1.0 + T0) * (1.0 + RC) * (1.0 + T0)) - gam2 * (T6 + T10 - 2.0 * T9 * T8 * (1.0 - T7 * T8 * (5.0 - 4.0 * T7 * T8)) - T0 / ((1.0 + RC) * (1.0 + T0)) * (1.0 - T0 / (1.0 + T0) - T4 + T0 * T4 / (1.0 + T0) * (1.0 + 1.0 / (1.0 + RC)))) - 2.0 * RT * RT * T0 * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0) * (1.0 + T0)) + 2.0;

                x7_s=xs-(fx/f_x)*(1.0 + ((fx*f_xx)/(2.0*f_x*f_x)));

            end

            // Drain current and Charge calculation part starts
            Vdsat_lim    =  3.912023005 * nVt;
            if (x7_s <= 0.0) begin
                qis          =  0.0;
                xgm          =  vgfb1 - x7_s;

                Vdsat        =  Vdsat_lim;

                Dr = 1.0;
                Nsat = 1.0;

                Mnud1 = 1.0;
                Dvsat = 1.0;
                Dmob  = 1.0;
                Moc = 1.0;
                Mscbe = 1.0;
                Rdrain = RDrainGeo;
                Rsource = RSourceGeo;
            end else begin //vgfb1 >0

                tempc         =  1.0 / (2.0 + x7_s * x7_s);
                xi0s         =  x7_s * x7_s * tempc;
                delta_1s     =  lexp(x7_s);
                Es1          =  1.0 / delta_1s;
                delta_1s     =  lexp(x7_s - phisf);
                Ds    =  delta_1s - lexp(-phisf) * (x7_s + 1.0 + xi0s);
                Ps    =  (vgfb1-x7_s)*(vgfb1-x7_s)*(1.0/gam2) - Ds;
                Ps    = hypsmooth(Ps - 1.0e-3, 1.0e-5) + 1.0e-3;
                sqms         =  sqrt(Ps);

                xgs          =  gam * sqrt(Ps + Ds);
                qis          =  gam2 * Ds * nVt / (xgs + gam * sqms);
                qbs        =  sqms * gam * nVt;
                Em           =  Es1;

                Dm           =  Ds;


                //Drain saturation voltage part implementation (Ref. BSIM4,BSIM-CMG)
                EeffFactor = 1.0e-8 / (epsratio * TOXE);
                Eeffs = EeffFactor * (qbs  + eta_mu * qis);

                // Ref: BSIM4 mobility model

                T2 = lexp(UCS_a * lln(0.5 * (1.0 + (qis / qbs))));

                T3 = (UA_a + UC_a * Vbsx) * pow(Eeffs, EU_t) + UD_a / T2;
                T4 = 1.0 + T3;
                `Smooth(T4, 1.0, 0.0015, Dmobs)

                WeffWRFactor = 1.0 / (pow(Weff * 1.0e6, WR_i) * NF);

                if (RDSMOD == 1) begin
                    Rdss = 0.0;
                end else begin
                    T0   = 1.0 + PRWG_i * qis;
                    T1   = PRWB_i * (sqrtPhistVbs - sqrtPhist);
                    T2   = 1.0 / T0 + T1;
                    T3   = T2 + sqrt(T2 * T2 + 0.01);
                    Rdss = (RDSWMIN_i + RDSW_i * T3) * WeffWRFactor * NF * rdstemp;
                    if (RDSMOD == 2) begin
                        Rdss = (RSourceGeo + (RDSWMIN_i + RDSW_i * T3) * WeffWRFactor * NF + RDrainGeo) * rdstemp;
                    end
                end

                Esat = 2.0 * VSAT_a / U0_a * Dmobs;
                EsatL = Esat * Leff;
                T6 = KSATIV_i * (qis + 2.0 * nVt);

                if (Rdss > 0.0) begin
                    WVCox = Weff * VSAT_a * Cox;
                    T0 = WVCox * Rdss;
                    Ta = 2.0 * T0;
                    Tb = T6 + EsatL + 3.0 * T6 * T0;
                    Tc = T6 * (EsatL + 2.0 * T6 * T0);
                    Vdsat = (Tb - sqrt(Tb * Tb - 2.0 * Ta * Tc)) / Ta;
                end else begin
                    Vdsat = EsatL * T6 / (EsatL + T6);
                end

                if (A0 == 0.0 && AGS == 0.0) begin
                    AbulkIV = 1.0;
                end else begin
                    T1  = Leff / (Leff + sqrt(XJ_i * Xdep));
                    AbulkIV = 1.0 + (A0 * T1 - AGS * T1 * pow(qis,AGS1) * nVt) / (1.0 + KETA * Vbsx);
                    `Smooth(AbulkIV, 0.1, 0.0005, AbulkIV)
                end

                Vdsat   = hypsmooth(Vdsat - 1.0e-3, 1.0e-5) + 1.0e-3;
                Vdsat    = Vdsat / AbulkIV;
                T7      = pow((Vds / Vdsat) + 1.0e-6, 1.0 / DELTA_t);
                T8      = pow(1.0 + T7, -DELTA_t);
                Vdseff  = Vds * T8;
                vdeff   = (Vdseff +Vs) * inv_nVt;

                /* Surface potential at Drain side  DD-MODEL*/
                phidf         =  2 * phib/n + vdeff;
                exp_nd     =  lexp(-phidf);
                limit       =  1.0e-3 * x1;
                T0 = -DVBD1_i * Leff / litl;
                T1 = DVBD0_i * (lexp(0.5*T0) + 2.0*lexp(T0)) * (Vds* inv_nVt + VSCE_i* inv_nVt);
                phic_star  = (1.0 + LPE1_i / Leff)*(`P_Q_NIST1998 * NDEP_i * TSI * TSI) / (2.0 * epssi * nVt) + VBSA/nVt - RC * (vgfbb)*CDSBS1_i + (1.0+RC)*T1;

                vg_FD = phic_star + gam * sqrt(lexp(-phic_star) + phic_star -1.0 );

                if (phic_star < phidf) begin
                    if (vgfb1 < (vg_FD)) begin
                        //PD initial Guess
                        if (abs(vgfb1) <= limit) begin
                            T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
                            sp_dd         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_nd)) * gam * T0);// sp-> sp_dd
                        end else begin
                            if (vgfb1 < (-limit)) begin
                                SP_S_yg   = -vgfb1;
                                SP_S_ysub   = 1.25 * (SP_S_yg * inv_x1);
                                SP_S_eta  =  0.5 * (SP_S_ysub + 10.0 - sqrt((SP_S_ysub - 6.0) * (SP_S_ysub - 6.0) + 64.0));
                                SP_S_temp   = SP_S_yg - SP_S_eta;
                                SP_S_a      = SP_S_temp * SP_S_temp + gam2 * (SP_S_eta + 1.0);
                                SP_S_c      = 2.0 * SP_S_temp - gam2;
                                SP_S_tau    = -SP_S_eta + lln(SP_S_a * inv_gam2);
                                `sigma0(SP_S_a, SP_S_c, SP_S_tau, SP_S_eta, SP_S_y0)
                                SP_S_delta0 = lexp(SP_S_y0);
                                SP_S_delta1 = 1.0 / SP_S_delta0;
                                SP_S_temp   = 1.0 / (2.0 + SP_S_y0 * SP_S_y0);
                                SP_S_xi0    = SP_S_y0 * SP_S_y0 * SP_S_temp;
                                SP_S_xi1    = 4.0 * (SP_S_y0 * SP_S_temp * SP_S_temp);
                                SP_S_xi2    = (8.0 * SP_S_temp - 12.0 * SP_S_xi0) * SP_S_temp * SP_S_temp;
                                SP_S_temp   = SP_S_yg - SP_S_y0;
                                SP_S_temp1  = (exp_nd) * SP_S_delta1;
                                SP_S_pC     = 2.0 * SP_S_temp + gam2 * (SP_S_delta0 - 1.0 - SP_S_temp1 + (exp_nd) * (1.0 - SP_S_xi1));
                                SP_S_qC     = SP_S_temp * SP_S_temp - gam2 * (SP_S_delta0 - SP_S_y0 - 1.0 + SP_S_temp1 + (exp_nd) * (SP_S_y0 - 1.0 - SP_S_xi0));
                                SP_S_temp   = 2.0 - gam2 * (SP_S_delta0 + SP_S_temp1 - (exp_nd) * SP_S_xi2);
                                SP_S_temp   = SP_S_pC * SP_S_pC - 2.0 * (SP_S_qC * SP_S_temp);
                                sp_dd          = -SP_S_y0 - 2.0 * (SP_S_qC / (SP_S_pC + sqrt(SP_S_temp)));
                            end else begin
                                SP_xg1    = 1.0 / (1.25 + gam * 7.324648775608221e-001);
                                SP_S_A_fac= (x1 * 1.25 * SP_xg1 - 1.0) * SP_xg1;
                                SP_S_xbar = vgfb1 * inv_x1 * (1.0 + SP_S_A_fac * vgfb1);
                                SP_S_temp = lexp(-SP_S_xbar);
                                SP_S_w    = 1.0 - SP_S_temp;
                                SP_S_x1   = vgfb1 + gam2 * 0.5 - gam * sqrt(vgfb1 + gam2 * 0.25 - SP_S_w);
                                SP_S_bx   = (phidf) + 3.0;
                                SP_S_eta  = `MINF(SP_S_x1, SP_S_bx, 5.0) - 0.5 * (SP_S_bx - sqrt(SP_S_bx * SP_S_bx + 5.0));
                                SP_S_temp = vgfb1 - SP_S_eta;
                                SP_S_temp1= lexp(-SP_S_eta);
                                SP_S_temp2= 1.0 / (2.0 + SP_S_eta * SP_S_eta);
                                SP_S_xi0  = SP_S_eta * SP_S_eta * SP_S_temp2;
                                SP_S_xi1  = 4.0 * (SP_S_eta * SP_S_temp2 * SP_S_temp2);
                                SP_S_xi2  = (8.0 * SP_S_temp2 - 12.0 * SP_S_xi0) * SP_S_temp2 * SP_S_temp2;
                                SP_S_a    = max(1.0e-40, SP_S_temp * SP_S_temp - gam2 * (SP_S_temp1 + SP_S_eta - 1.0 - (exp_nd) * (SP_S_eta + 1.0 + SP_S_xi0)));
                                SP_S_b    = 1.0 - 0.5 * (gam2 * (SP_S_temp1 - (exp_nd) * SP_S_xi2));
                                SP_S_c    = 2.0 * SP_S_temp + gam2 * (1.0 - SP_S_temp1 - (exp_nd) * (1.0 + SP_S_xi1));
                                SP_S_tau  = (phidf) - SP_S_eta + lln(SP_S_a / gam2);
                                `sigma1(SP_S_a, SP_S_b, SP_S_c, SP_S_tau, SP_S_eta, SP_S_x0)
                                SP_S_delta0 = lexp(SP_S_x0);
                                SP_S_delta1 = 1.0 / SP_S_delta0;
                                SP_S_delta0 = lexp(SP_S_x0 - phidf);
                                SP_S_temp   = 1.0 / (2.0 + SP_S_x0 * SP_S_x0);
                                SP_S_xi0    = SP_S_x0 * SP_S_x0 * SP_S_temp;
                                SP_S_xi1    = 4.0 * (SP_S_x0 * SP_S_temp * SP_S_temp);
                                SP_S_xi2    = (8.0 * SP_S_temp - 12.0 * SP_S_xi0) * SP_S_temp * SP_S_temp;
                                SP_S_temp   = vgfb1 - SP_S_x0;
                                SP_S_pC     = 2.0 * SP_S_temp + gam2 * (1.0 - SP_S_delta1 + SP_S_delta0 - (exp_nd) * (1.0 + SP_S_xi1));
                                SP_S_qC     = SP_S_temp * SP_S_temp - gam2 * (SP_S_delta1 + SP_S_x0 - 1.0 + SP_S_delta0 - (exp_nd) * (SP_S_x0 + 1.0 + SP_S_xi0));
                                SP_S_temp   = 2.0 - gam2 * (SP_S_delta1 + SP_S_delta0 - (exp_nd) * SP_S_xi2);
                                SP_S_temp   = SP_S_pC * SP_S_pC - 2.0 * (SP_S_qC * SP_S_temp);
                                sp_dd          = SP_S_x0 + 2.0 * (SP_S_qC / (SP_S_pC + sqrt(SP_S_temp)));
                            end
                        end
                    end else begin
                        //FD initial Guess
                        zeta    = RT;
                        zeta2   = zeta * zeta;
                        u_crit  = phic_star - phisb0 * inv_nVt;
                        usf_FD  = vgfb1 - gam * sqrt(lexp(-u_crit) + u_crit -1.0);
                        SP_S_bx = (phidf) + 3.0;
                        SP_S_Z0 =  `MINF(usf_FD, SP_S_bx, 40.0);
                        a_fd = ((vgfb1-SP_S_Z0) * (vgfb1-SP_S_Z0) - zeta2 * (vgfbb-SP_S_Z0 + phic_star) * (vgfbb-SP_S_Z0+phic_star) - gam2 * (phic_star));
                        c_fd = 2.0 * (vgfb1 - SP_S_Z0 ) - 2.0 * zeta2 * (vgfbb - SP_S_Z0 + phic_star) ;
                        c_fd2 = c_fd * c_fd;
                        d_fd = 1.0 - zeta2;
                        if (a_fd < 0) begin
                            a_fd = 0.0;
                        end
                        tau_fd = phidf - SP_S_Z0  + lln(a_fd * inv_gam2);
                        v_fd = a_fd + c_fd;
                        v_fd2 = v_fd * v_fd;
                        mu_fd = v_fd2 / tau_fd  + 0.5 * c_fd2 - a_fd * d_fd;
                        temp1_fd = (c_fd * v_fd) / mu_fd;
                        temp2_fd = ( `oneThird * c_fd2 - a_fd * d_fd);
                        u_first_r = (v_fd * a_fd) / (mu_fd + temp1_fd * temp2_fd);
                        u0_first_FD = SP_S_Z0  + u_first_r;
                        delta0_fd = lexp(u0_first_FD - phidf);
                        p_fd = 2.0 *(vgfb1-u0_first_FD)- 2.0 * zeta2 * (vgfbb-u0_first_FD + phic_star)+ gam2 * delta0_fd;
                        q_fd = (vgfb1-u0_first_FD) * (vgfb1-u0_first_FD) - zeta2 * (vgfbb-u0_first_FD + phic_star) * (vgfbb-u0_first_FD+phic_star)- gam2 * (phic_star+delta0_fd);
                        temp3_fd = 2.0 * q_fd * (2.0- 2.0 * zeta2 - gam2 * delta0_fd);
                        w_fd= (2.0 * q_fd) / (p_fd + sqrt(p_fd * p_fd - temp3_fd));
                        sp_dd  = u0_first_FD + w_fd;
                    end
                end else begin
                    //PD initial Guess
                    if (abs(vgfb1) <= limit) begin
                        T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
                        sp_dd         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_nd)) * gam * T0); // sp-> sp_dd
                    end else begin
                        if (vgfb1 < (-limit)) begin
                            SP_S_yg   = -vgfb1;
                            SP_S_ysub   = 1.25 * (SP_S_yg * inv_x1);
                            SP_S_eta  =  0.5 * (SP_S_ysub + 10.0 - sqrt((SP_S_ysub - 6.0) * (SP_S_ysub - 6.0) + 64.0));
                            SP_S_temp   = SP_S_yg - SP_S_eta;
                            SP_S_a      = SP_S_temp * SP_S_temp + gam2 * (SP_S_eta + 1.0);
                            SP_S_c      = 2.0 * SP_S_temp - gam2;
                            SP_S_tau    = -SP_S_eta + lln(SP_S_a * inv_gam2);
                            `sigma0(SP_S_a, SP_S_c, SP_S_tau, SP_S_eta, SP_S_y0)

                            SP_S_delta0 = lexp(SP_S_y0);
                            SP_S_delta1 = 1.0 / SP_S_delta0;
                            SP_S_temp   = 1.0 / (2.0 + SP_S_y0 * SP_S_y0);
                            SP_S_xi0    = SP_S_y0 * SP_S_y0 * SP_S_temp;
                            SP_S_xi1    = 4.0 * (SP_S_y0 * SP_S_temp * SP_S_temp);
                            SP_S_xi2    = (8.0 * SP_S_temp - 12.0 * SP_S_xi0) * SP_S_temp * SP_S_temp;
                            SP_S_temp   = SP_S_yg - SP_S_y0;
                            SP_S_temp1  = (exp_nd) * SP_S_delta1;
                            SP_S_pC     = 2.0 * SP_S_temp + gam2 * (SP_S_delta0 - 1.0 - SP_S_temp1 + (exp_nd) * (1.0 - SP_S_xi1));
                            SP_S_qC     = SP_S_temp * SP_S_temp - gam2 * (SP_S_delta0 - SP_S_y0 - 1.0 + SP_S_temp1 + (exp_nd) * (SP_S_y0 - 1.0 - SP_S_xi0));
                            SP_S_temp   = 2.0 - gam2 * (SP_S_delta0 + SP_S_temp1 - (exp_nd) * SP_S_xi2);
                            SP_S_temp   = SP_S_pC * SP_S_pC - 2.0 * (SP_S_qC * SP_S_temp);
                            sp_dd       = -SP_S_y0 - 2.0 * (SP_S_qC / (SP_S_pC + sqrt(SP_S_temp)));
                        end else begin
                            SP_xg1    = 1.0 / (1.25 + gam * 7.324648775608221e-001);
                            SP_S_A_fac= (x1 * 1.25 * SP_xg1 - 1.0) * SP_xg1;
                            SP_S_xbar = vgfb1 * inv_x1 * (1.0 + SP_S_A_fac * vgfb1);
                            SP_S_temp = lexp(-SP_S_xbar);
                            SP_S_w    = 1.0 - SP_S_temp;
                            SP_S_x1   = vgfb1 + gam2 * 0.5 - gam * sqrt(vgfb1 + gam2 * 0.25 - SP_S_w);
                            SP_S_bx   = (phidf) + 3.0;
                            SP_S_eta  = `MINF(SP_S_x1, SP_S_bx, 5.0) - 0.5 * (SP_S_bx - sqrt(SP_S_bx * SP_S_bx + 5.0));
                            SP_S_temp = vgfb1 - SP_S_eta;
                            SP_S_temp1= lexp(-SP_S_eta);
                            SP_S_temp2= 1.0 / (2.0 + SP_S_eta * SP_S_eta);
                            SP_S_xi0  = SP_S_eta * SP_S_eta * SP_S_temp2;
                            SP_S_xi1  = 4.0 * (SP_S_eta * SP_S_temp2 * SP_S_temp2);
                            SP_S_xi2  = (8.0 * SP_S_temp2 - 12.0 * SP_S_xi0) * SP_S_temp2 * SP_S_temp2;
                            SP_S_a    = max(1.0e-40, SP_S_temp * SP_S_temp - gam2 * (SP_S_temp1 + SP_S_eta - 1.0 - (exp_nd) * (SP_S_eta + 1.0 + SP_S_xi0)));
                            SP_S_b    = 1.0 - 0.5 * (gam2 * (SP_S_temp1 - (exp_nd) * SP_S_xi2));
                            SP_S_c    = 2.0 * SP_S_temp + gam2 * (1.0 - SP_S_temp1 - (exp_nd) * (1.0 + SP_S_xi1));
                            SP_S_tau  = (phidf) - SP_S_eta + lln(SP_S_a / gam2);
                            `sigma1(SP_S_a, SP_S_b, SP_S_c, SP_S_tau, SP_S_eta, SP_S_x0)
                            SP_S_delta0 = lexp(SP_S_x0);
                            SP_S_delta1 = 1.0 / SP_S_delta0;
                            SP_S_delta0 = lexp(SP_S_x0 - phidf);
                            SP_S_temp   = 1.0 / (2.0 + SP_S_x0 * SP_S_x0);
                            SP_S_xi0    = SP_S_x0 * SP_S_x0 * SP_S_temp;
                            SP_S_xi1    = 4.0 * (SP_S_x0 * SP_S_temp * SP_S_temp);
                            SP_S_xi2    = (8.0 * SP_S_temp - 12.0 * SP_S_xi0) * SP_S_temp * SP_S_temp;
                            SP_S_temp   = vgfb1 - SP_S_x0;
                            SP_S_pC     = 2.0 * SP_S_temp + gam2 * (1.0 - SP_S_delta1 + SP_S_delta0 - (exp_nd) * (1.0 + SP_S_xi1));
                            SP_S_qC     = SP_S_temp * SP_S_temp - gam2 * (SP_S_delta1 + SP_S_x0 - 1.0 + SP_S_delta0 - (exp_nd) * (SP_S_x0 + 1.0 + SP_S_xi0));
                            SP_S_temp   = 2.0 - gam2 * (SP_S_delta1 + SP_S_delta0 - (exp_nd) * SP_S_xi2);
                            SP_S_temp   = SP_S_pC * SP_S_pC - 2.0 * (SP_S_qC * SP_S_temp);
                            sp_dd          = SP_S_x0 + 2.0 * (SP_S_qC / (SP_S_pC + sqrt(SP_S_temp)));
                        end
                    end
                end

                xs = sp_dd;
                limit1 = 1e-7;
                K11 = 2.0;
                SP_S_tempc =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2 ;
                PHIC =  (1.0 + LPE1_i / Leff)*(`P_Q_NIST1998 * NDEP_i * (TSI * TSI)) / (2.0 * epssi) + VBSA;
                T0 = -DVBD1_i * Leff / litl;
                T1 = DVBD0_i * (lexp(0.5*T0) + 2.0*lexp(T0)) * (Vds* inv_nVt + VSCE_i* inv_nVt);
                phic_s =PHIC-RC*(vgfbb*nVt)*CDSBS1_i + (1.0+RC)*T1*nVt+ (1.0+RC)*(phisb0);

                //First Iteration of final Poisson's expression
                if (abs(vgfb1)<= (limit1)) begin
                    T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
                    x7_d         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_nd)) * gam * T0);
                end else begin
                    T0= (0.5 * (tanh(-5.0 * (vgfb1 - K11)) +  tanh(5.0 * (vgfb1 + K11)) ));
                    sp_vfb       =vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (lexp(-phidf))) * gam * SP_S_tempc) * T0;

                    T0  = lexp((xs * nVt - phic_s)/nVt);
                    T1  = lexp((sp_vfb * nVt - phic_s)/nVt);
                    T2  = ln_one_plus_exp((xs * nVt - phic_s) / nVt) - ln_one_plus_exp((sp_vfb * nVt - phic_s)/nVt);
                    T3  = -(phisb0 / nVt + T2/(1.0+RC));
                    T4  = lexp(T3);
                    T6  = lexp(-xs);
                    T7  = xs * xs;
                    T8  = 1.0 / (T7 + 2.0);
                    T9  = lexp(-phidf);
                    T10 = lexp(xs - phidf);

                    fx   = (vgfb1 - xs) * (vgfb1 - xs) - RT * RT * (vgfbb + T3) * (vgfbb + T3) - gam2 * (T6 - T4 + xs + T3 + T10 - T9 * (xs + 1.0 + T8 * T7));
                    f_x  = (2.0 * T0 * (vgfbb + T3) * RT * RT) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * vgfb1 + 2.0 * xs - gam2 * (T10 + T9 * (-2.0 * xs * T8 + 2.0 * xs * xs * xs * T8 * T8 - 1.0) - T6 - T0 / ((1.0 + RC) * (1.0 + T0)) + (T0 * T4) / ((1.0 + RC) * (1.0 + T0)) + 1.0);
                    f_xx = 2.0 * RT * RT * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * RT * RT * T0 * T0 / ((1.0 + RC) * (1.0 + T0) * (1.0 + RC) * (1.0 + T0)) - gam2 * (T6 + T10 - 2.0 * T9 * T8 * (1.0 - T7 * T8 * (5.0 - 4.0 * T7 * T8)) - T0 / ((1.0 + RC) * (1.0 + T0)) * (1.0 - T0 / (1.0 + T0) - T4 + T0 * T4 / (1.0 + T0) * (1.0 + 1.0 / (1.0 + RC)))) - 2.0 * RT * RT * T0 * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0) * (1.0 + T0)) + 2.0;

                    x7_d=xs-(fx/f_x)*(1.0 + ((fx*f_xx)/(2.0*f_x*f_x)));
                end

                //Second Iteration of final Poisson's expression
                xs=x7_d;
                if (abs(vgfb1)<= (limit1)) begin
                    T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
                    x7_d         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_nd)) * gam * T0);
                end else begin
                    T0= (0.5 * (tanh(-5.0 * (vgfb1 - K11)) +  tanh(5.0 * (vgfb1 + K11)) ));
                    sp_vfb       =vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (lexp(-phidf))) * gam * SP_S_tempc) * T0;

                    T0  = lexp((xs * nVt - phic_s)/nVt);
                    T1  = lexp((sp_vfb * nVt - phic_s)/nVt);
                    T2  = ln_one_plus_exp((xs * nVt - phic_s) / nVt) - ln_one_plus_exp((sp_vfb * nVt - phic_s)/nVt);
                    T3  = -(phisb0 / nVt + T2/(1.0+RC));
                    T4  = lexp(T3);
                    T6  = lexp(-xs);
                    T7  = xs * xs;
                    T8  = 1.0 / (T7 + 2.0);
                    T9  = lexp(-phidf);
                    T10 = lexp(xs - phidf);

                    fx   = (vgfb1 - xs) * (vgfb1 - xs) - RT * RT * (vgfbb + T3) * (vgfbb + T3) - gam2 * (T6 - T4 + xs + T3 + T10 - T9 * (xs + 1.0 + T8 * T7));
                    f_x  = (2.0 * T0 * (vgfbb + T3) * RT * RT) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * vgfb1 + 2.0 * xs - gam2 * (T10 + T9 * (-2.0 * xs * T8 + 2.0 * xs * xs * xs * T8 * T8 - 1.0) - T6 - T0 / ((1.0 + RC) * (1.0 + T0)) + (T0 * T4) / ((1.0 + RC) * (1.0 + T0)) + 1.0);
                    f_xx = 2.0 * RT * RT * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * RT * RT * T0 * T0 / ((1.0 + RC) * (1.0 + T0) * (1.0 + RC) * (1.0 + T0)) - gam2 * (T6 + T10 - 2.0 * T9 * T8 * (1.0 - T7 * T8 * (5.0 - 4.0 * T7 * T8)) - T0 / ((1.0 + RC) * (1.0 + T0)) * (1.0 - T0 / (1.0 + T0) - T4 + T0 * T4 / (1.0 + T0) * (1.0 + 1.0 / (1.0 + RC)))) - 2.0 * RT * RT * T0 * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0) * (1.0 + T0)) + 2.0;

                    x7_d=xs-(fx/f_x)*(1.0 + ((fx*f_xx)/(2.0*f_x*f_x)));
                end

                //Third Iteration of final Poisson's expression
                xs=x7_d;
                if (abs(vgfb1)<= (limit1)) begin
                    T0 =  inv_x1 * inv_x1 * `oneSixth * `invSqrt2;
                    x7_d         =  vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (exp_nd)) * gam * T0);
                end else begin
                    T0= (0.5 * (tanh(-5.0 * (vgfb1 - K11)) +  tanh(5.0 * (vgfb1 + K11)) ));
                    sp_vfb       =vgfb1 * inv_x1 * (1.0 + vgfb1 * (1.0 - (lexp(-phidf))) * gam * SP_S_tempc) * T0;

                    T0  = lexp((xs * nVt - phic_s)/nVt);
                    T1  = lexp((sp_vfb * nVt - phic_s)/nVt);
                    T2  = ln_one_plus_exp((xs * nVt - phic_s) / nVt) - ln_one_plus_exp((sp_vfb * nVt - phic_s)/nVt);
                    T3  = -(phisb0 / nVt + T2/(1.0+RC));
                    T4  = lexp(T3);
                    T6  = lexp(-xs);
                    T7  = xs * xs;
                    T8  = 1.0 / (T7 + 2.0);
                    T9  = lexp(-phidf);
                    T10 = lexp(xs - phidf);

                    fx   = (vgfb1 - xs) * (vgfb1 - xs) - RT * RT * (vgfbb + T3) * (vgfbb + T3) - gam2 * (T6 - T4 + xs + T3 + T10 - T9 * (xs + 1.0 + T8 * T7));
                    f_x  = (2.0 * T0 * (vgfbb + T3) * RT * RT) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * vgfb1 + 2.0 * xs - gam2 * (T10 + T9 * (-2.0 * xs * T8 + 2.0 * xs * xs * xs * T8 * T8 - 1.0) - T6 - T0 / ((1.0 + RC) * (1.0 + T0)) + (T0 * T4) / ((1.0 + RC) * (1.0 + T0)) + 1.0);
                    f_xx = 2.0 * RT * RT * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0)) - 2.0 * RT * RT * T0 * T0 / ((1.0 + RC) * (1.0 + T0) * (1.0 + RC) * (1.0 + T0)) - gam2 * (T6 + T10 - 2.0 * T9 * T8 * (1.0 - T7 * T8 * (5.0 - 4.0 * T7 * T8)) - T0 / ((1.0 + RC) * (1.0 + T0)) * (1.0 - T0 / (1.0 + T0) - T4 + T0 * T4 / (1.0 + T0) * (1.0 + 1.0 / (1.0 + RC)))) - 2.0 * RT * RT * T0 * T0 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + T0) * (1.0 + T0)) + 2.0;

                    x7_d=xs-(fx/f_x)*(1.0 + ((fx*f_xx)/(2.0*f_x*f_x)));
                end

                x_ds         =  x7_d - x7_s;

                //Approximations for extremely small x7_ds: capacitance calculation
                Udse         =  (Vds)*inv_nVt;
                k_ds         =  lexp(-Udse);
                if (x_ds < 1.0e-10) begin
                    T0  = lexp((xs * nVt - phic_s) / nVt);
                    T1  = lexp((sp_vfb * nVt - phic_s) / nVt);
                    T2  = ln_one_plus_exp((xs * nVt - phic_s) / nVt) - ln_one_plus_exp((sp_vfb * nVt - phic_s) / nVt);
                    T3  = -(phisb0 / nVt + T2 / (1.0 + RC));
                    T4  = lexp(T3);
                    T5  = lexp(T3 + (xs * nVt - phic_s) / nVt);
                    T6  = lexp(-xs);
                    T7  = xs * xs;
                    T8  = 1.0 / (T7 + 2.0);

                    T10 = lexp(xs - phidf);
                    T11 = lexp(2.0 * (xs * nVt - phic_s) / nVt);
                    T12 = lexp(2.0 * (xs * nVt - phic_s) / nVt + T3);

                    pC   = -( (2.0 * T0 * (vgfbb + T3)*RT * RT)/((RC + 1.0) * (T0 + 1.0)) - 2.0 * vgfb1  + 2.0 * xs  - gam2 * (lexp(xs - Udse -phidf) + lexp(-Udse - phidf) * (-2.0 * xs * T8 + 2.0 * xs * xs * xs * T8 * T8 - 1.0) - T6 - T0 / ((RC + 1.0) * (T0 + 1.0)) + T5 / ((RC + 1.0) * (T0 + 1.0)) + 1.0) );
                    qC    =  gam2 *(1.0 - k_ds)* Ds;
                    tempc =  2.0 * RT * RT * T0 * (vgfbb + T3) / ((1+RC) * (1 + T0)) - 2.0 * RT * RT * T11 / ((1.0 + RC) * (1.0 + RC) * (1.0 + 2.0 * T0 + T11)) - gam2 * (T6 + lexp(xs -phidf - Udse) + lexp(-phidf - Udse) * ( -2.0 * T8 + 10.0 * xs * xs * T8 * T8 - 8.0 * xs * xs * xs * xs * T8 * T8 * T8) - T0 / ((1.0 + RC) * (1.0 + T0)) + T11 / ((1.0 + RC) * (1.0 + 2.0 * T0 + T11)) + T5 / ((1.0 + RC) * (1.0 + T0)) - T12 / ((1.0 + RC) * (1.0 + 2.0 * T0 + T11)) - T12 / ((1.0 + RC) * (1.0 + RC) * (1.0 + 2.0 * T0 + T11))) - 2.0 * RT * RT * T11 * (vgfbb + T3) / ((1.0 + RC) * (1.0 + 2.0 * T0 + T11)) + 2;
                    tempc        =  pC * pC - 2.0 * (tempc * qC);
                    if (tempc >= 0) begin
                        x_ds         =  2.0 * (qC / (pC + sqrt(tempc)));
                    end
                    x7_d         = x7_s + x_ds;
                end
                dps          =  x_ds * nVt;
                xi0d         =  x7_d * x7_d / (2.0 + x7_d * x7_d);
                Ed           =  lexp(-x7_d);
                Dd           =  lexp(x7_d - phidf) - lexp(-phidf) * (x7_d + 1.0 + xi0d);
                Pd           = (vgfb1 - x7_d )*(vgfb1 - x7_d )*(1.0/gam2) -  Dd;
                Pd           =  hypsmooth(Pd - 1.0e-3, 1.0e-5) + 1.0e-3;
                sqd          =  sqrt(Pd);

                //--------------------------------------
                xgd          =  gam * sqrt(Pd + Dd);
                qid      =  gam2 * Dd * nVt / (xgd + gam * sqd);

                // Mid-point surface potential
                x_m          =  0.5 * (x7_s + x7_d);
                tempc         =  abs(Ed * Es1);
                Em           =  sqrt(tempc);
                D_bar        =  0.5 * (Ds + Dd);
                Dm           =  D_bar + 0.125 * (x_ds * x_ds * (Em - 2.0 * inv_gam2));
                Pm           =  (vgfb1-x_m )*(vgfb1-x_m )*(1.0/gam2) - Dm;
                xgm          =  gam * sqrt(Dm + Pm);
                Pm           =  hypsmooth(Pm - 1.0e-3, 1.0e-5) + 1.0e-3;
                sqm          =  sqrt(Pm);
                if (PDEMOD==1) begin
                //Poly depletion effect
                    pdef =2 * Cox * Cox * nVt /(`P_Q_NIST1998 * epssi * NGATE_i);
                    d0  =  1.0 - Em + 2.0 * (xgm * (1/gam2));
                    eta_p        =  1.0 / sqrt(1.0 + pdef * xgm);
                    tempc         =  eta_p / (eta_p + 1.0);
                    x_pm         =  pdef * (tempc * tempc *xgm  *xgm)*(Dm /(Dm  + Pm)) ;
                    p_pd         =  2.0 * (xgm - x_pm) + gam2 * (1.0 - Em + Dm);
                    q_pd         =  x_pm * (x_pm - 2.0 * xgm);
                    xi_pd        =  1.0 - 0.5 * (gam2 * (Em + Dm));
                    u_pd         =  q_pd * p_pd / (p_pd * p_pd - xi_pd * q_pd);
                    x_m          =  x_m + u_pd;
                    km           =  lexp(u_pd);
                    Em           =  Em / km;
                    Dm           =  Dm * km;
                    Pm           =  ( vgfb1-x_m+ u_pd )*( vgfb1-x_m+ u_pd)*(1/gam2) -  Dm/ km ;
                    xgm          =  gam * sqrt(Dm + Pm);
                    km0          =  1.0 - Em + 2.0 * (xgm * eta_p * inv_gam2);
                    x_ds         =  x_ds * km * (d0 + D_bar) / (km0 + km * D_bar);
                    dps          =  x_ds * nVt;
                    Pm           =  hypsmooth(Pm - 1.0e-3, 1.0e-5) + 1.0e-3;
                    sqm          =  sqrt(Pm);
                end
                if (abs(dps) > 1e-35) begin
                    alpha_DD    =  (qis - qid) / dps;
                end

                qim          =  nVt * (gam2 * Dm / (xgm + gam * sqm));



                qim1         =  qim + nVt * alpha_DD;
            end

            ids_edge     =  NF * (U0_a) * (WEDGE / Leff) * Cox * qim1 * dps * (DdL * Dvsatinv / (Dr)) * Moc;
            ids          =  ids + ids_edge;
        end
    //SOIMOD=1 ends here
    end else begin

        // psip: pinch-off voltage
        phib_n = phib / n;
        `PO_psip(vgfb, gam, 0.0, phib_n, psip)

        // Normalized inversion charge at source end of channel
        `BSIM_q(psip, phib_n, vs, gam, qs)

        // Average charge-surface potential slope, Ref: Charge-based MOS Transistor Modeling by C. Enz & E. Vittoz
        `Smooth(psip, 1.0, 2.0, psipclamp)
        sqrtpsip = sqrt(psipclamp);

        // Source side surface potential
        psiavg = psip - 2.0 * qs;
        `Smooth(psiavg, 1.0, 2.0, T0)
        nq = 1.0 + gam / (sqrtpsip + sqrt(T0));

        // Drain saturation voltage
        EeffFactor = 1.0e-8 / (epsratio * TOXE);
        T0 = nVt * (vgfb - psip - 2.0 * qs * (nq - 1.0));
        `Smooth(T0, 0.0, 0.1, qbs)

        // Source side qi and qb for Vdsat- normalized to Cox
        qis = 2.0 * nq * nVt * qs;
        Eeffs = EeffFactor * (qbs + eta_mu * qis);
        // Ref: BSIM4 mobility model
        T2 = pow(0.5 * (1.0 + (qis / qbs)), UCS_a);
        T3 = (UA_a + UC_a * Vbsx) * pow(Eeffs, EU_t) + UD_a / T2;
        T4 = 1.0 + T3;
        `Smooth(T4, 1.0, 0.0015, Dmobs)
        WeffWRFactor = 1.0 / (pow(Weff * 1.0e6, WR_i) * NF);

        if (RDSMOD == 1) begin
            Rdss = 0.0;
        end else begin
            T0   = 1.0 + PRWG_i * qis;
            T1   = PRWB_i * (sqrtPhistVbs - sqrtPhist);
            T2   = 1.0 / T0 + T1;
            T3   = T2 + sqrt(T2 * T2 + 0.01);
            if (RDSMOD == 0) begin
                Rdss = (RDSWMIN_i + RDSW_i * T3) * WeffWRFactor * NF * rdstemp;
            end else begin
                Rdss = (RSourceGeo + (RDSWMIN_i + RDSW_i * T3) * WeffWRFactor * NF + RDrainGeo) * rdstemp;
            end
        end

        T0  = pow(Dmobs, 1.0 / PSAT_a);
        T11 = PSATB_i * Vbsx;
        T12 = sqrt(0.1+T11*T11);
        T1  = 0.5*(1-T11+sqrt((1-T11)*(1-T11)+T12));
        T2  = 10.0 * PSATX * qs * T1 / (10.0 * PSATX + qs * T1);
        if (PTWG_a < 0.0) begin
            LambdaC = 2.0 * ((U0_a / T0) * nVt / (VSAT_a * Leff)) * (1.0 / (1.0 - PTWG_a * T2));
        end else begin
            LambdaC = 2.0 * ((U0_a / T0) * nVt / (VSAT_a * Leff)) * (1.0 + PTWG_a * T2);
        end

        // qdsat for external Rds
        if (Rdss > 0.0) begin
          // Accurate qdsat derived from consistent I-V
            T11 = Weff * 2.0 * nq * Cox * nVt * VSAT_a;
            T12 = T11 * LambdaC * Rdss / (2.0 * nVt);
            T0  = 0.5 * LambdaC * (qs * qs + qs) / (1.0 + 0.5 * LambdaC * (1.0 + qs));
            T1  = 2.0 * LambdaC * (qs - T0);
            T2  = sqrt(1.0 + T1 * T1);

            if (T1 != 0.0) begin
                ln_T1_T2 = asinh(T1);
                T3 = T2 + (1.0 / T1) * ln_T1_T2;
            end else begin
                T3 = T2 + (1.0 / T2);
            end
            T4 = T0 * T3 + T12 * T0 * (qs + T0 + 1.0) - LambdaC * ((qs * qs + qs) - (T0 * T0 + T0));
            if (T1 != 0.0) begin
                T5 = -2.0 * LambdaC * (T1 * T2 - ln_T1_T2) / (T1 * T1);
            end else begin
                T5 = -2.0 * LambdaC * (T1 / T2);
            end
            T6 = T0 * T5 + T3 + T12 * (qs + 2.0 * T0 + 1.0) + LambdaC * (2.0 * T0 + 1.0);
            T0 = T0 - T4 / T6;
            T1 = 2.0 * LambdaC * (qs - T0);
            T2 = sqrt(1.0 + T1 * T1);

            if (T1 != 0.0) begin
                ln_T1_T2 = asinh(T1);
                T3 = T2 + (1.0 / T1) * ln_T1_T2;
            end else begin
                T3 = T2 + (1.0 / T2);
            end
            T4 = T0 * T3 + T12 * T0 * (qs + T0 + 1.0) - LambdaC * ((qs * qs + qs) - (T0 * T0 + T0));
            if (T1 != 0.0) begin
                T5 = -2.0 * LambdaC * (T1 * T2 - ln_T1_T2) / (T1 * T1);
            end else begin
                T5 = -2.0 * LambdaC * (T1 / T2);
            end
            T6    = T0 * T5 + T3 + T12 * (qs + 2.0 * T0 + 1.0) + LambdaC * (2.0 * T0 + 1.0);
            qdsat = T0 - T4 / T6;
        end else begin
            // Accurate qdsat derived from consistent I-V
            T0 = 0.5 * LambdaC * (qs * qs + qs) / (1.0 + 0.5 * LambdaC * (1.0 + qs));
            T1 = 2.0 * LambdaC * (qs - T0);
            T2 = sqrt(1.0 + T1 * T1);

            if (T1 != 0.0) begin
                ln_T1_T2 = asinh(T1);
                T3 = T2 + (1.0 / T1) * ln_T1_T2;
            end else begin
                T3 = T2 + (1.0 / T2);
            end
            T4 = T0 * T3 - LambdaC * ((qs * qs + qs) - (T0 * T0 + T0));
            if (T1 != 0.0) begin
                T5 = -2.0 * LambdaC * (T1 * T2 - ln_T1_T2) / (T1 * T1);
            end else begin
                T5 = -2.0 * LambdaC * (T1 / T2);
            end
            T6 = T0 * T5 + T3 + LambdaC * (2.0 * T0 + 1.0);
            T0 = T0 - (T4 / T6);
            T1 = 2.0 * LambdaC * (qs - T0);
            T2 = sqrt(1.0 + T1 * T1);

            if (T1 != 0.0) begin
                ln_T1_T2 = asinh(T1);
                T3 = T2 + (1.0 / T1) * ln_T1_T2;
            end else begin
                T3 = T2 + (1.0 / T2);
            end
            T4 = T0 * T3 - LambdaC * ((qs * qs + qs) - (T0 * T0 + T0));
            if (T1 != 0.0) begin
                T5 = -2.0 * LambdaC * (T1 * T2 - ln_T1_T2) / (T1 * T1);
            end else begin
                T5 = -2.0 * LambdaC * (T1 / T2);
            end
            T6    = T0 * T5 + T3 + LambdaC * (2.0 * T0 + 1.0);
            qdsat = T0 - (T4 / T6);
        // qdsat for internal Rds, Ref: BSIM4
        end
        vdsat = psip - 2.0 * phib_n - (2.0 * qdsat + lln((qdsat * 2.0 * nq * inv_gam) * ((qdsat * 2.0 * nq * inv_gam) + (gam / (nq - 1.0)))));
        Vdsat = vdsat * nVt;
        // Normalized charge qdeff at drain end of channel
        // Vdssat clamped to avoid negative values during transient simulation

        if (A0 == 0.0 && AGS == 0.0) begin
            AbulkIV = 1.0;
        end else begin
            T1  = Leff / (Leff + sqrt(XJ_i * Xdep));
            AbulkIV = 1.0 + (A0 * T1 - AGS * T1 * pow(qs,AGS1) * nVt) / (1.0 + KETA * Vbsx);
            `Smooth(AbulkIV, 0.1, 0.0005, AbulkIV)
        end
        `Smooth(Vdsat - Vs, 0.0, 1.0e-3, Vdssat)
        Vdssat    = Vdssat / AbulkIV;
        T7      = pow((Vds / Vdssat) + 1.0e-6, 1.0 / DELTA_t);
        T8      = pow(1.0 + T7, -DELTA_t);
        Vdseff  = Vds * T8;
        vdeff   = (Vdseff + Vs) * inv_nVt;
        `BSIM_q(psip, phib_n, vdeff, gam, qdeff)


        // Reevaluation of nq to include qdeff
        psiavg = psip - qs - qdeff -1.0;
        `Smooth(psiavg, 1.0, 2.0, T0)
        T2 = sqrt(T0);
        nq = 1.0 + gam / (sqrtpsip + T2);

        // Inversion and bulk charge
        DQSD2 = (qs - qdeff) * (qs - qdeff);
        T0    = 1.0 / (1.0 + qs + qdeff);
        T1    = DQSD2 * T0;
        Qb    = vgfb - psip - (nq - 1.0) * (qs + qdeff + `Oneby3 * T1);
        T2    = `Oneby3 * nq;
        T3    = T1 * T0;
        Qs    = T2 * (2.0 * qs + qdeff + 0.5 * (1.0 + 0.8 * qs + 1.2 * qdeff) * T3);
        Qd    = T2 * (qs + 2.0 * qdeff + 0.5 * (1.0 + 1.2 * qs + 0.8 * qdeff) * T3);

        // Mobility degradation, Ref: BSIM4
        // Average charges (qba and qia) - normalized to Cox
        `Smooth(nVt * Qb, 0.0, 0.1, qba)
        qia   = nVt * (Qs + Qd);

        Eeffm = EeffFactor * (qba + eta_mu * qia);
        T2    = pow(0.5 * (1.0 + (qia / qba)), UCS_a);
        T3    = (UA_a + UC_a * Vbsx) * pow(Eeffm, EU_t) + UD_a / T2;
        T4    = 1.0 + T3;
        `Smooth(T4, 1.0, 0.0015, Dmob)
        // Output conductance
        Esat  = 2.0 * VSAT_a / (U0_a / Dmob);
        EsatL = Esat * Leff;
        if (PVAG_i > 0.0) begin
            PVAGfactor = 1.0 + PVAG_i * qia / EsatL;
        end else begin
            PVAGfactor = 1.0 / (1.0 - PVAG_i * qia / EsatL);
        end

        // Output conductance due to DIBL, Ref: BSIM4
        DIBLfactor = PDIBLC_a;
        diffVds    = Vds - Vdseff;
        Vgst2Vtm   = qia + 2.0 * nVt;
        if (DIBLfactor > 0.0) begin
            T3     = Vgst2Vtm / (Vdssat + Vgst2Vtm);
            T4     = hypsmooth((1.0 + PDIBLCB_i * Vbsx), 1.0e-3);
            T5     = 1.0 / T4;
            VaDIBL = Vgst2Vtm / DIBLfactor * T3 * PVAGfactor * T5;
            Moc    = 1.0 + diffVds / VaDIBL;
        end else begin
            Moc = 1.0;
        end

        // Degradation factor due to pocket implants, Ref: BSIM4
        if (FPROUT_i <= 0.0) begin
            Fp = 1.0;
        end else begin
            T9 = FPROUT_i * sqrt(Leff) / Vgst2Vtm;
            Fp = 1.0 / (1.0 + T9);
        end

        // Channel length modulation, Ref: BSIM4
        Vasat = Vdssat + EsatL;
        if (PCLM_a > 0.0) begin
            if (PCLMG < 0.0) begin
                T1 = PCLM_a / (1.0 - PCLMG * qia / EsatL) / Fp;
            end else begin
                T1 = PCLM_a * (1.0 + PCLMG * qia / EsatL) / Fp;
            end
            MdL = 1.0 + T1 * lln(1.0 + diffVds / T1 / Vasat);
        end else begin
            if (PCLMG < 0.0) begin
                T1 = PCLM_a / (1.0 - PCLMG * qia / EsatL) / Fp;
            end else begin
                T1 = PCLM_a * (1.0 + PCLMG * qia / EsatL) / Fp;
            end
            MdL = 1.0 + T1;
        end
        Moc = Moc * MdL;

        // Calculate Va_DITS, Ref: BSIM4
        T1 = lexp(PDITSD_i * Vds);
        if (PDITS_i > 0.0) begin
            T2      = 1.0 + PDITSL * Leff;
            VaDITS  = (1.0 + T2 * T1) / PDITS_i;
            VaDITS  = VaDITS * Fp;
        end else begin
            VaDITS  = `MAX_EXPL;
        end
        T4  = diffVds / VaDITS;
        T0  = 1.0 + T4;
        Moc = Moc * T0;

        // Calculate Va_SCBE, Ref: BSIM4
        if (PSCBE2_i > 0.0) begin
            if (diffVds > PSCBE1_i * litl / `EXPL_THRESHOLD) begin
                T0     = PSCBE1_i * litl / diffVds;
                VaSCBE = Leff * lexp(T0) / PSCBE2_i;
            end else begin
                VaSCBE = `MAX_EXPL * Leff/PSCBE2_i;
            end
        end else begin
            VaSCBE = `MAX_EXPL;
        end
        Mscbe = 1.0 + (diffVds / VaSCBE);
        Moc   = Moc * Mscbe;

        // Velocity saturation
        T0 = pow(Dmob, 1.0 / PSAT_a);
        T11 = PSATB_i * Vbsx;
        T12 = sqrt(0.1+T11*T11);
        T1  = 0.5*(1-T11+sqrt((1-T11)*(1-T11)+T12));
        T2  = 10.0 * PSATX * qia * T1 / (10.0 * PSATX + qia * T1);
        if (PTWG_a < 0.0) begin
            LambdaC = 2.0 * ((U0_a / T0) * nVt / (VSAT_a * Leff)) * (1.0 / (1.0 - PTWG_a * T2));
        end else begin
            LambdaC = 2.0 * ((U0_a / T0) * nVt / (VSAT_a * Leff)) * (1.0 + PTWG_a * T2);
        end
        T1 = 2.0 * LambdaC * (qs - qdeff);
        T2 = sqrt(1.0 + T1 * T1);
        if (T1 != 0.0) begin
            Dvsat = 0.5 * (T2 + (1.0 / T1) * asinh(T1));
        end else begin
            Dvsat = 0.5 * (T2 + (1.0 / T2));
        end
        Dptwg = Dvsat;
        // S/D series resistances, Ref: BSIM4
        Rsource = 0.0;
        Rdrain  = 0.0;
        if (RDSMOD == 1) begin
            Rdsi = 0.0;
            Dr   = 1.0;
            // Rs (Source side resistance for all fingers)
            T2      = Vgs_noswap - Vfbsdr;
            T3      = sqrt(T2 * T2 + 0.01);
            Vgs_eff = 0.5 * (T2 + T3);
            T5      = 1.0 + PRWG_i * Vgs_eff;
            T6      = (1.0 / T5) + PRWB_i * Vsb_noswap;
            T4      = 0.5 * (T6 + sqrt(T6 * T6 + 0.01));
            Rsource = rdstemp * (RSourceGeo + (RSWMIN_i + RSW_i * T4) * WeffWRFactor);
            // Rd (Drain side resistance for all fingers)
            T2      = Vgd_noswap - Vfbsdr;
            T3      = sqrt(T2 * T2 + 0.01);
            Vgd_eff = 0.5 * (T2 + T3);
            T5      = 1.0 + PRWG_i * Vgd_eff;
            T6      = (1.0 / T5) + PRWB_i * Vdb_noswap;
            T4      = 0.5 * (T6 + sqrt(T6 * T6 + 0.01));
            Rdrain  = rdstemp * (RDrainGeo + (RDWMIN_i + RDW_i * T4) * WeffWRFactor);
        end else begin
            // Ref: (1) BSIM4 (2) "Operation and Modeling of the MOS Transistor" by Yannis Tsividis
            T0      = 1.0 + PRWG_i * qia;
            T1      = PRWB_i * (sqrtPhistVbs - sqrtPhist);
            T2      = 1.0 / T0 + T1;
            T3      = 0.5 * (T2 + sqrt(T2 * T2 + 0.01));
            Rdsi    = rdstemp * (RDSWMIN_i + RDSW_i * T3) * WeffWRFactor * NF;
            Rdrain  = RDrainGeo;
            Rsource = RSourceGeo;
            Dr      = 1.0 + U0_a /(Dvsat * Dmob) * Cox * Weff / Leff * qia * Rdsi;
            if (RDSMOD == 2) begin
                Rdsi    = rdstemp * (RSourceGeo + (RDSWMIN_i + RDSW_i * T3) * WeffWRFactor * NF + RDrainGeo);
                Rdrain  = 0.0;
                Rsource = 0.0;
                Dr      = 1.0 + U0_a /(Dvsat * Dmob) * Cox * Weff / Leff * qia * Rdsi;
            end
        end

        // Non-saturation effect
        T0   = A1_t + A2_t / (qia + 2.0 * n * Vtm);
        DQSD = qs - qdeff;
        T1   = T0 * DQSD * DQSD;
        T2   = T1 + 1.0 - 0.001;
        T3   = -1.0 + 0.5 * (T2 + sqrt(T2 * T2 + 0.004));
        Nsat = 0.5 * (1.0 + sqrt(1.0 + T3));
        `Smooth2(Nsat, 1.0, 0.01, Nsat)

        // MNUD model to enhance Id-Vd fitting flexibility
        T0   = (qs + qdeff);
        T1   = (qs - qdeff);
        T2   = T1 / (T0 + M0_t);
        T3   = K0_t * T2 * T2;
        Mnud = 1.0 + T3;

        // MNUD1 to enhance the fitting flexibility for the gm/Id - similar approach used in BSIM-CMG
        T9    = C0_t / (max(0, C0SI_t + C0SISAT_t * T1 * T1) * T0 + 2.0 * n * Vtm);
        Mnud1 = lexp(-T9);
        Dtot  = Dmob * Dvsat * Dr;

        // Effective mobility including mobility degradation
        ueff = U0_a / Dtot;

        // I-V
        ids  = 2.0 * NF * nq * ueff * Weff / Leff * Cox * nVt * nVt * ((qs - qdeff) * (1.0 + qs + qdeff)) * Moc / Nsat * Mnud * Mnud1;
        ids  = ids * IDS0MULT;

        Gcrg = 0.0;
        if (RGATEMOD > 1) begin
            idsovvds = ueff * Weff / Leff * Cox * qia;
            T9       = XRCRG2 * Vt;
            T0       = T9 * ueff * Weff / Leff * Cox;
            Gcrg     = XRCRG1 * NF * (T0 + idsovvds);
            if (RGATEMOD == 2) begin
                Rgeltd = 1.0 / Grgeltd;
                if (Rgeltd < minr) begin
                    Rgeltd = minr ;
                    Grgeltd = 1.0 / Rgeltd;
                end
                T11  = Grgeltd + Gcrg;
                Gcrg = Grgeltd * Gcrg / T11;
            end
        end

        // Junction currents and capacitances
        //Diode and BJT Current
        wdiod = Weff / NSEG + PDBCP;
        wdios = Weff / NSEG + PSBCP;
        WsTsi = wdios * TSI;
        WdTsi = wdiod * TSI;

        NVtm1 = Vtm * NDIODE_i;
        T0 = Vbs_jct / NVtm1;
        ExpVbsNVtm = lexp(T0);

        NVtm2 = Vtm * NDIODE_i;
        T0 = Vbd_jct / NVtm2;
        ExpVbdNVtm = lexp(T0);


        T4 = `Eg300 / Vtm * (TRatio-1);

        //Ibs1 : Diffusion current as per SOI
        if (ISDIF_i == 0.0) begin
            Ibs1 = 0.0;
        end else begin
            T7 = XDIF_i * T4 / NDIODE_i;
            T1 = lexp(T7);
            JDIFS = ISDIF_i * T1;
            T0 = WsTsi * JDIFS;
            Ibs1 = T0 * (ExpVbsNVtm - 1);
        end

        //Ibd1 : Diffusion Current as per SOI
        if (IDDIF_i == 0.0) begin
            Ibd1 = 0.0;
        end else begin
            T7 = XDIF_i * T4 / NDIODE_i;
            T1 = lexp(T7);
            JDIFD = IDDIF_i * T1;
            T0 = WdTsi * JDIFD;
            Ibd1 = T0 * (ExpVbdNVtm - 1);
        end

        // Ibs2 and Ibd2: Recombination / Trap-assisted tunneling current
        if (ISREC_i == 0.0) begin
            Ibs2 = 0.0;
        end else begin
            T7 = XREC_i * T4 / NRECF0_i;
            T2 = lexp(T7);
            JRECS = ISREC_i * T2;
            //forward bias
            NVtmf = VTM00 * NRECF0_i * (1 + NTRECF_i * (TRatio - 1));
            NVtmr = VTM00 * NRECR0_i * (1 + NTRECR_i * (TRatio - 1));

            T0 = Vbs_jct / NVtmf;
            T10 = lexp(T0);

            //reverse bias
            if (( VREC0_i - Vbs_jct) < 1e-3) begin
                T1 = 1e3;
                T0 = - Vbs_jct / NVtmr * VREC0_i * T1;
                T11 = lexp(T0);
                T11 = -T11;
            end else begin
                T1 = 1 / (VREC0_i - Vbs_jct);
                T0 = -Vbs_jct / NVtmr * VREC0_i * T1;
                T11 = lexp(T0);

                T11 = -T11;
            end

            T3 = WsTsi * JRECS;
            Ibs2 = T3 * (T10 + T11);
        end

        if (IDREC_i == 0.0) begin
            Ibd2 = 0.0;
        end else begin
            T7 = XREC_i * T4 / NRECF0_i;
            T2 = lexp(T7);
            JRECD = IDREC_i * T2;
            NVtmf = VTM00 * NRECF0_i * (1 + NTRECF_i * (TRatio - 1));
            NVtmr = VTM00 * NRECR0_i * (1 + NTRECR_i * (TRatio - 1));

            T0 = Vbd_jct / NVtmf;
            T10 = lexp(T0);

            if (( VREC0D_i - Vbd_jct) < 1e-3) begin

                T1 = 1e3;
                T0 = - Vbd_jct / NVtmr * VREC0D_i * T1;
                T11 = lexp(T0);
                T11 = -T11;
            end else begin
                T1 = 1 / (VREC0D_i - Vbd_jct);
                T0 = -Vbd_jct / NVtmr * VREC0D_i * T1;
                T11 = lexp(T0);

                T11 = -T11;
            end

            T3 = WdTsi * JRECD;
            Ibd2 = T3 * (T10 + T11);
        end

        //Ibs3 and Ibd3 - Recombination current in neutral body
        WTsi = Weff / NSEG * TSI;

        if (ISBJT_i == 0.0 && IDBJT_i == 0.0 ) begin
            Ibs3 =0.0;
            Ibd3 =0.0;
            Ic = 0.0;
        end else begin
            T7 = XBJT_i * T4 / NDIODE_i;
            T0 = lexp(T7);
            Ahlis = AHLI_i * T0; /* high level injection */
            JBJTS = ISBJT_i * T0;
            T7 = XBJT_i * T4 / NDIODE_i;
            T0 = lexp(T7);
            Ahlid = AHLID_i * T0; /* high level injection */
            JBJTD = IDBJT_i * T0;
            //High level injection on Source Side
            Ehlis = Ahlis * (ExpVbsNVtm - 1);
            if (Ehlis < 1e-5) begin
                Ehlis = 0;
                EhlisFactor = 1;
            end else begin
                EhlisFactor = 1.0 / sqrt(1 + Ehlis);
            end

            // high level injection of drain side
            Ehlid = Ahlid * (ExpVbdNVtm - 1);
            if (Ehlid < 1e-5) begin
                Ehlid = 0;
                EhlidFactor = 1;
            end else begin
                EhlidFactor = 1.0 / sqrt(1 + Ehlid);
            end

            T0 = -0.5 * Leff * Leff / LN / LN;
            ALPHABJT = lexp(T0);
            T2 = 1 - ALPHABJT;
            T0 = LBJT0_i * (1.0 / Leff + 1.0 / LN);
            lratio = pow(T0,NBJT_i);

            Ien = WTsi * JBJTS * lratio;
            T1 = T0 * Ien;
            Ibs3 = T1 * (ExpVbsNVtm -1) * EhlisFactor;

            Ien = WTsi * JBJTD * lratio;
            T1 = T0 * Ien;
            Ibd3 = T1 * (ExpVbdNVtm -1) * EhlidFactor;

            //Terms for diffusion charge
            lratiodif = 1.0 + LDIF0 * pow(T0,NDIF_i);

            Iendif = WTsi * JBJTS * lratiodif;
            Ibsdif = Iendif * (ExpVbsNVtm - 1) * EhlisFactor;

            Iendif = WTsi * JBJTD * lratiodif;
            Ibddif = Iendif * (ExpVbdNVtm - 1) * EhlidFactor;

            //BJT collector Current Ic
            Vearly = VABJT_i + AELY_i * Leff;

            if (Vearly < 1)
                Vearly = 1;
            if (BJTOFF == 1) begin
                Ic = 0.0;
            end else begin
                // second order effects
                T0 = 1 + (Vbs_jct + Vbd_jct) / Vearly;
                T1 = Ehlis + Ehlid;
                T3 = sqrt(T0 * T0 + 4 * T1);
                T2 = (T0 + T3) / 2.0;

                if (T2 < 0.1) begin
                    E2ndFactor = 10.0;
                end else begin
                    E2ndFactor = 1.0 /T2;
                end
                T0 = ALPHABJT * Ien;
                Ic = NF * T0 * (ExpVbsNVtm - ExpVbdNVtm) * E2ndFactor;
            end
        end

        //Ibs4 and Ibd4 : tunneling
        if (ISTUN_i == 0.0 && IDTUN_i == 0.0) begin
            Ibs4 = 0.0;
            Ibd4 = 0.0;
        end else begin
            T7 = XTUN_i * (TRatio - 1);
            T0 = lexp(T7);
            JTUNS = ISTUN_i * T0;
            T7 = XTUND_i * (TRatio - 1);
            T0 = lexp(T7);

            JTUND = IDTUN_i * T0;
            NVtm2 = VTM00 * NTUN_i;
            if (( VTUN0_i - Vbs_jct) < 1e-3) begin

                T1 = 1e3;
                T0 = -Vbs_jct / NVtm2 * VTUN0_i * T1;
                T1 = lexp(T0);

                T3 = WsTsi * JTUNS;
                Ibs4 = T3 * (1 - T1);
            end else begin
                T1 = 1 / (VTUN0_i - Vbs_jct);
                T0 = -Vbs_jct / NVtm2 * VTUN0_i * T1;
                T1 = lexp(T0);

                T3 = WsTsi * JTUNS;
                Ibs4 = T3 * (1 - T1);
            end

            NVtm2 = VTM00 * NTUND_i;
            if (( VTUN0D_i - Vbd_jct) < 1e-3) begin

                T1 = 1e3;
                T0 = -Vbd_jct / NVtm2 * VTUN0D_i * T1;
                T1 = lexp(T0);

                T3 = WsTsi * JTUND;
                Ibd4 = T3 * (1 - T1);
            end else begin
                T1 = 1 / (VTUN0D_i - Vbd_jct);
                T0 = -Vbd_jct / NVtm2 * VTUN0D_i * T1;
                T1 = lexp(T0);

                T3 = WsTsi * JTUND;
                Ibd4 = T3 * (1 - T1);
            end
        end

        Ibs = NF * (Ibs1 + Ibs2 + Ibs3 + Ibs4);
        Ibd = NF * (Ibd1 + Ibd2 + Ibd3 + Ibd4);

        // GIDL and GISL currents, Ref: BSIM4 and BSIM-SOI
        igisl = 0.0;
        igidl = 0.0;
        if (GIDLMOD == 0) begin
            T0 = epsratio * TOXE;
            // GIDL
            if ((AGIDL_i <= 0.0) || (BGIDL_t <= 0.0) || (CGIDL_i < 0.0)) begin
                T6 = 0.0;
            end else begin
                T1 = (-Vgd_noswap - EGIDL_i + Vfbsdr) / T0;
                T1 = hypsmooth(T1, 1.0e-2);
                T2 = BGIDL_t / (T1 + 1.0e-3);
                if (CGIDL_i != 0.0) begin
                    T3 = Vdb_noswap * Vdb_noswap * Vdb_noswap;
                    T4 = CGIDL_i + abs(T3) + 1.0e-4;
                    T5 = hypsmooth(T3 / T4, 1.0e-6) - 1.0e-6;
                end else begin
                    T5 = 1.0;
                end
                T6 = AGIDL_i * wdiod * T1 * lexp(-T2) * T5;
            end
            igidl = T6;
            // GISL
            if ((AGISL_i <= 0.0) || (BGISL_t <= 0.0) || (CGISL_i < 0.0)) begin
                T6 = 0.0;
            end else begin
                T1 = (-Vgs_noswap - EGISL_i + Vfbsdr) / T0;
                T1 = hypsmooth(T1, 1.0e-2);
                T2 = BGISL_t / (T1 + 1.0e-3);
                if (CGISL_i != 0.0) begin
                    T3 = Vsb_noswap * Vsb_noswap * Vsb_noswap;
                    T4 = CGISL_i + abs(T3) + 1.0e-4;
                    T5 = hypsmooth(T3 / T4, 1.0e-6) - 1.0e-6;
                end else begin
                    T5 = 1.0;
                end
                T6 = AGISL_i * wdios * T1 * lexp(-T2) * T5;
            end
            igisl = T6;
        end else begin
            //GIDLMOD = 1
            T0 = epsratio * TOXE;
            Vgd_noswap_1    = RGISL_i * Vg - Vd;
            Vgs_noswap_1    = RGIDL_i * Vg - Vs;
            T2      = Vgs_noswap - Vfbsdr;
            Vgs_eff = sqrt(T2 * T2 + 1.0e-4);
            //GIDL
            if ((AGIDL_i <= 0.0) || (BGIDL_t <= 0.0)) begin
                T6 = 0.0;
            end else begin
                T1 = (-Vgd_noswap_1 - EGIDL_i + Vfbsdr) / T0;
                T1 = hypsmooth(T1, 1.0e-2);
                T2 = BGIDL_t / (T1 + 1.0e-3);

                if (KGIDL_i != 0.0) begin
                    T3 = -Vdb_noswap-FGIDL_i;
                    T4 = T3 + 1.0e-4;
                    T5 = hypsmooth(KGIDL_i / T4, 1.0e-6) - 1.0e-6;
                end else begin
                    T5 = 1.0;
                end
                T6 = AGIDL_i * wdiod * T1 * lexp(-T2) * lexp(T5);
            end
            igidl = T6;

            //GISL
            if ((AGISL_i <= 0.0) || (BGISL_t <= 0.0)) begin
                T6 = 0.0;
            end else begin
                T1 = (-Vgs_noswap_1 - EGISL_i + Vfbsdr) / T0;
                T1 = hypsmooth(T1, 1.0e-2);
                T2 = BGISL_t / (T1 + 1.0e-3);

                if (KGISL_i != 0.0) begin
                    T3 = -Vsb_noswap-FGISL_i;
                    T4 = T3 + 1.0e-4;
                    T5 = hypsmooth(KGISL_i / T4, 1.0e-6) - 1.0e-6;
                end else begin
                    T5 = 1.0;
                end
                T6 = AGISL_i * wdios * T1 * lexp(-T2) * lexp(T5);
            end
            igisl = T6;
        end

        IGIDL = devsign * NF * igidl;
        IGISL = devsign * NF * igisl;

        // Impact ionization currents, Ref: BSIM4 and BSIM-SOI
        //BULK MOSFET
        if (IIIMOD == 0) begin
            if ((ALPHA0_i <= 0.0) || (BETA0_t <= 0.0)) begin
                Iii = 0.0;
            end else if (diffVds > BETA0_t / `EXPL_THRESHOLD) begin
                T1  = -BETA0_t / diffVds;
                Iii = ALPHA0_i * diffVds * ids * lexp(T1) / Mscbe;
            end else begin
                Iii = ALPHA0_i * diffVds * ids * `MIN_EXPL / Mscbe;
            end

        //SOI
        end else if (IIIMOD == 1) begin
            if ((ALPHA0_i <= 0.0) || (BETA2_i == 0.0 && BETA1_i == 0.0 && BETA0_t == 0.0)) begin
                Iii = 0.0;
            end else begin
                Vdsatii0 = VDSATII0_i * (1.0 + TII * (TRatio - 1.0)) - (LII_i / Leff);
                T0 = ESATII_i * Leff;
                T1 = SII0_i * T0 / (1.0 + T0);

                T0 = 1.0 / (1.0 + hypsmooth((SII1_i * vgsfb * nVt), IIMOD2CLAMP1));
                T3 = T0 + SII2_i;
                T2 = hypsmooth((vgsfb * nVt * T3), IIMOD2CLAMP2);
                T3 = 1.0 / (1.0 + SIID_i * Vdsx);

                VgsStep = T1 * T2 * T3;
                Vdsatii = Vdsatii0 + VgsStep;
                Vdiff = Vdsx - Vdsatii;

                T0 = BETA2_i + BETA1_i * Vdiff + BETA0_t * Vdiff * Vdiff;
                T1 = sqrt(T0 * T0 + 1.0e-10);
                Ratio = -hypmax(-ALPHA0_i * lexp(Vdiff / T1), -10.0, IIMOD2CLAMP3);
                Iii = Ratio * (ids + FBJTII_i * sigvds * Ic);
            end

            //IIIMOD = 2
            //two components have the different impact ionization rate.
        end else begin
            if ((ALPHA0_i <= 0.0) || (BETA2_i == 0.0 && BETA1_i == 0.0 && BETA0_t == 0.0)) begin
                Iii = 0.0;
            end else begin
                //Idsmosfet
                Vdsatii0 = VDSATII0_i * (1.0 + TII * (TRatio - 1.0)) - (LII_i / Leff);
                T0 = ESATII_i * Leff;
                T1 = SII0_i * T0 / (1.0 + T0);

                T0 = 1.0 / (1.0 + hypsmooth((SII1_i * vgsfb * nVt), IIMOD2CLAMP1));
                T3 = T0 + SII2_i;
                T2 = hypsmooth((vgsfb * nVt * T3), IIMOD2CLAMP2);
                T3 = 1.0 / (1.0 + SIID_i * Vdsx);

                VgsStep = T1 * T2 * T3;
                Vdsatii = Vdsatii0 + VgsStep;
                Vdiff = Vdsx - Vdsatii;

                T0 = BETA2_i + BETA1_i * Vdiff + BETA0_t * Vdiff * Vdiff;
                T1 = sqrt(T0 * T0 + 1.0e-10);
                Ratio = -hypmax(-ALPHA0_i * lexp(Vdiff / T1), -10.0, IIMOD2CLAMP3);
                Idsmosfet = Ratio * ids;
            end
            //Iiibjt

            T0 = (CBJTII_i + EBJTII_i * Leff) / Leff;
            Vbc = VBCI_i * (1.0 + TVBCI * (TRatio - 1));

            if (sigvds > 0)
                T1 = Vbc - Vbd_jct;
            else
                T1 = Vbc - Vbs_jct;

            T2 = MBJTII_i - 1.0;

            if (T1 > 0.0)
                T3 = -ABJTII_i * pow(T1,T2);
            else
                T3 = 0.0;

            T4 = lexp(T3);
            Iiibjt = T0 * sigvds * Ic * T1 * T4;

            //Total Iii
            Iii = Idsmosfet + Iiibjt;
        end

        ISUB = Iii * devsign;


        // Gate currents, Ref: BSIM-SOI

        AIGC_i = AIGC_i + AIGC1_i * (TRatio - 1.0);
        AIGS_i = AIGS_i + AIGS1_i * (TRatio - 1.0);
        AIGD_i = AIGD_i + AIGD1_i * (TRatio - 1.0);
        ALPHAGB1_i = ALPHAGB1_i + ALPHAGB1_T_i * (TRatio - 1.0);
        ALPHAGB2_i = ALPHAGB2_i + ALPHAGB2_T_i * (TRatio - 1.0);
        AIGBCP2_i  = AIGBCP2_i + AIGBCP2_T_i * (TRatio - 1.0);

        igb = 0.0; igcs = 0.0;
        igcd   = 0.0; igs    = 0.0; igd = 0.0;

        // Gate-to-body tunneling components
        if ((IGCMOD != 0) || (IGBMOD != 0)) begin
            Voxm1    = nVt * (vgfb - psip + qs + qdeff);
            T1      = sqrt(Voxm1 * Voxm1 + 1.0e-4);
            Voxmacc = 0.5 * (-Voxm1 + T1);
            Voxminv = 0.5 * (Voxm1 + T1);

            if (IGBMOD != 0) begin
                //Igbacc
                T1     = Voxm1 / VECB;
                Vaux_Igbacc = VECB * ln_one_plus_exp(-T1);

                if (VGB2 != 0) begin
                    T0 = 1- Voxmacc / VGB2;
                end else begin
                    T0 = 1;
                end

                if (T0 < 0.01) begin
                    T0 = 0.01;
                end

                T1 = (Leff * Weff / NSEG + AGBCPD / NF ) * AGB2 * ToxRatio;
                T2 = BGB2 * TOXE;

                T3 = T2 * (ALPHAGB2_i - BETAGB2_i * Voxmacc) / T0;
                T4 = lexp(T3);

                igbacc = T1 * Vg * Vaux_Igbacc * T4;
                igbacc = igbacc * igtemp;

                //Igbinv
                T1     = (Voxm1 - EIGBINV_i) / VECB;
                Vaux_Igbinv = VECB * ln_one_plus_exp(T1);

                if (VGB1 != 0) begin
                    T0 = 1- Voxminv / VGB1;
                end else begin
                    T0 = 1;
                end

                if (T0 < 0.01) begin
                    T0 = 0.01;
                end

                T1 = (Leff * Weff / NSEG + AGBCPD / NF ) * AGB1 * ToxRatio;
                T2 = BGB1 * TOXE;

                T3 = T2 * (ALPHAGB1_i - BETAGB1_i * Voxminv) / T0;
                T4 = lexp(T3);

                igbinv = T1 * Vg * Vaux_Igbinv * T4;
                igbinv = igbinv * igtemp;

                igb    = NF * (igbacc + igbinv);

                Vfb2 = vfb * nVt + EGGBCP2;
            end

            //Gate tunneling component in the AGBCP2 region
            if ((BODYMOD !=0 && $port_connected(b) != 0 && !(TNODEOUT && !$port_connected(t)) && MODAGBCP2 ==1) && AGBCP2 > 0) begin
                Vgb = devsign * V(gi, bi2);
                T0 = Vgb - Vfb2;
                T1 = sqrt(T0 * T0 + 1.0e-4);
                Vgp_eff = 0.5 * (-T0 + T1 - 1.0e-2);
                T11 = (TYPE == `ntype) ? AGBC2N : AGBC2P;
                T12 = (TYPE == `ntype) ? BGBC2N : BGBC2P;
                T2 = Vgb * Vgp_eff;
                T3 = AIGBCP2_i * CIGBCP2_i - BIGBCP2_i;
                T4 = BIGBCP2_i * CIGBCP2_i;
                T5 = (-T12) * TOXE * (AIGBCP2_i + T3 * Vgp_eff -T4 * Vgp_eff * Vgp_eff);
                T6 = lexp(T5);
                T11 = T11 * AGBCP2 * ToxRatio;
                Ig_agbcp2 = T11 * T2 * T6 * igtemp;
            end else begin
                Ig_agbcp2 = 0.0;
            end


            if (IGCMOD != 0) begin
                // Igcinv
                T1   = AIGC_i - BIGC_i * Voxminv;
                T2   = 1.0 + CIGC_i * Voxminv;
                T3   = Bechvb * T1 * T2;
                T4   = nq * nVt * (qs + qdeff) * lexp(T3);
                igc0 = NF * Aechvb * T4 * (Vg + 0.5 * Vdsx - 0.5 * (Vs + Vd)) * igtemp;
                // Gate-current partitioning
                Vdseffx = sqrt(Vdseff * Vdseff + 0.01) - 0.1;
                T1      = PIGCD_i * Vdseffx;
                T1_exp  = lexp(-T1);
                T3      = T1 + T1_exp -1.0 + 1.0e-4;
                T4      = 1.0 - (T1 + 1.0) * T1_exp + 1.0e-4;
                T5      = T1 * T1 + 2.0e-4;
                if (sigvds > 0) begin
                    igcd = igc0 * T4 / T5;
                    igcs = igc0 * T3 / T5;
                end else begin
                    igcs = igc0 * T4 / T5;
                    igcd = igc0 * T3 / T5;
                end
                // Igs
                T2      = Vgs_noswap - Vfbsdr;
                Vgs_eff = sqrt(T2 * T2 + 1.0e-4);
                if (IGCLAMP == 1) begin
                    T1 = hypsmooth((AIGS_i - BIGS_i * Vgs_eff), 1.0e-6);
                    if (CIGS_i < 0.01) begin
                        CIGS_i = 0.01;
                    end
                end else begin
                    T1 = AIGS_i - BIGS_i * Vgs_eff;
                end
                T2       = 1.0 + CIGS_i * Vgs_eff;
                T3       = BechvbEdge * T1 * T2;
                T4       = lexp(T3);
                igs_mult = igtemp * NF * AechvbEdges * DLCIG_i;
                igs      = igs_mult * Vgs_noswap * Vgs_eff * T4;
                // Igd
                T2      = Vgd_noswap - Vfbsdr;
                Vgd_eff = sqrt(T2 * T2 + 1.0e-4);
                if (IGCLAMP == 1) begin
                    T1 = hypsmooth((AIGD_i - BIGD_i * Vgd_eff), 1.0e-6);
                    if (CIGD_i < 0.01) begin
                        CIGD_i = 0.01;
                    end
                end else begin
                    T1 = AIGD_i - BIGD_i * Vgd_eff;
                end
                T2       = 1.0 + CIGD_i * Vgd_eff;
                T3       = BechvbEdge * T1 * T2;
                T4       = lexp(T3);
                igd_mult = igtemp * NF * AechvbEdged * DLCIGD_i;
                igd      = igd_mult * Vgd_noswap * Vgd_eff * T4;
            end
        end
        IGS  = devsign * igs;
        IGD  = devsign * igd;
        IGB  = devsign * igb;
        IGCS = devsign * igcs;
        IGCD = devsign * igcd;

        // Junction capacitances (no swapping)
        // Source-to-bulk junction
        Czbs       = CJS_t * ASeff;
        Czbssw     = CJSWS_t * PSeff;
        Czbsswg    = CJSWGS_t * Weffcj * NF;
        czbs_p1    = pow(0.1, -MJS);

        if (MJS == 1) begin
            czbs_p2    = 1.5 - ln(0.1);
        end else begin
            czbs_p2    = 1.0 / (1.0 - MJS) * (1.0 - 0.05 * MJS * (1.0 + MJS) * czbs_p1);
        end
        czbssw_p1  = pow(0.1, -MJSWS);
        if (MJSWS == 1) begin
            czbssw_p2    = 1.5 - ln(0.1);
        end else begin
            czbssw_p2  = 1.0 / (1.0 - MJSWS) * (1.0 - 0.05 * MJSWS * (1.0 + MJSWS) * czbssw_p1);
        end
        czbsswg_p1 = pow(0.1, -MJSWGS);
        if (MJSWGS == 1) begin
            czbsswg_p2    = 1.5 - ln(0.1);
        end else begin
            czbsswg_p2 = 1.0 / (1.0 - MJSWGS) * (1.0 - 0.05 * MJSWGS * (1.0 + MJSWGS) * czbsswg_p1);
        end

        `JunCap(Czbs, Vbs_jct, PBS_t, MJS, czbs_p1, czbs_p2, Qbsj1)
        `JunCap(Czbssw, Vbs_jct, PBSWS_t, MJSWS, czbssw_p1, czbssw_p2, Qbsj2)
        `JunCap(Czbsswg, Vbs_jct, PBSWGS_t, MJSWGS, czbsswg_p1, czbsswg_p2, Qbsj3)

        Qbsj4 = TT * Ibsdif * NF;
        Qbsj = Qbsj1 + Qbsj2 + Qbsj3 + Qbsj4;

        // Drain-to-bulk junction
        Czbd       = CJD_t * ADeff;
        Czbdsw     = CJSWD_t * PDeff;
        Czbdswg    = CJSWGD_t * Weffcj * NF;
        czbd_p1    = pow(0.1, -MJD);

        if (MJD == 1) begin
            czbd_p2    = 1.5 - ln(0.1);
        end else begin
            czbd_p2    = 1.0 / (1.0 - MJD) * (1.0 - 0.05 * MJD * (1.0 + MJD) * czbd_p1);
        end
        czbdsw_p1  = pow(0.1, -MJSWD);
        if (MJSWD == 1) begin
            czbdsw_p2  = 1.5 - ln(0.1);
        end else begin
            czbdsw_p2  = 1.0 / (1.0 - MJSWD) * (1.0 - 0.05 * MJSWD * (1.0 + MJSWD) * czbdsw_p1);
        end
        czbdswg_p1 = pow(0.1, -MJSWGD);
        if (MJSWGD == 1) begin
            czbdswg_p2 = 1.5 - ln(0.1);
        end else begin
            czbdswg_p2 = 1.0 / (1.0 - MJSWGD) * (1.0 - 0.05 * MJSWGD * (1.0 + MJSWGD) * czbdswg_p1);
        end

        `JunCap(Czbd, Vbd_jct, PBD_t, MJD, czbd_p1, czbd_p2, Qbdj1)
        `JunCap(Czbdsw, Vbd_jct, PBSWD_t, MJSWD, czbdsw_p1, czbdsw_p2, Qbdj2)
        `JunCap(Czbdswg, Vbd_jct, PBSWGD_t, MJSWGD, czbdswg_p1, czbdswg_p2, Qbdj3)

        Qbdj4 = TT * Ibddif * NF;
        Qbdj = Qbdj1 + Qbdj2 + Qbdj3 + Qbdj4;

        // Sub-surface leakage drain current
        if (SSLMOD != 0) begin
            T1 = pow(NDEP_i / 1.0e23, SSLEXP1);
            T2 = pow(300.0 / DevTemp, SSLEXP2);
            T3 = (devsign*SSL5 * V(bi,si)) / Vt;
            SSL0_NT  = SSL0 * lexp(-T1 * T2);
            SSL1_NT  = SSL1 * T2 * T1;
            PHIB_SSL = SSL3 * tanh(lexp(devsign * SSL4 * (V(gi, bi) - VTH - V(si,bi))));
            Issl     = sigvds * NF * Weff * SSL0_NT * lexp(T3) * lexp(-SSL1_NT * Leff) * lexp(PHIB_SSL / Vt) * (lexp(SSL2 * Vdsx / Vt) - 1.0);
            I(di, si) <+ devsign * Issl;
        end

        // Harshit's new flicker noise model. Ref: H. Agarwal et. al., IEEE J-EDS, vol. 3, no. 4, April 2015.
        Nt      = 4.0 * Vt * `P_Q_NIST1998;
        Esatnoi = 2.0 * VSAT_a / ueff;
        if (EM <= 0.0) begin
            DelClm = 0.0;
        end else begin
            T0     = (diffVds / litl + EM) / Esatnoi;
            DelClm = litl * lln(T0);
            if (DelClm < 0.0) begin
                DelClm = 0.0;
            end
        end
        Nstar = Vt / `P_Q_NIST1998 * (Cox + Cdep + CIT_i);
        Nl    = 2.0 * nq * Cox * Vt * qdeff * Mnud1 * Mnud / `P_Q_NIST1998;
        T0a   = `P_Q_NIST1998 * `P_Q_NIST1998 * `P_Q_NIST1998 * Vt * abs(ids) * ueff;
        T0b   = `P_Q_NIST1998 * Vt * ids * ids;
        T0c   = NOIA + NOIB * Nl + NOIC * Nl * Nl;
        T0d   = (Nl + Nstar) * (Nl + Nstar);
        T0e   = NOIA * `P_Q_NIST1998 * Vt;
        if (FNOIMOD == 1) begin
            LH1 = LH;
            if (Leff > LH1) begin
                T0 = (Leff - LH1);
            end else begin
                LH1 = Leff;
                T0 = LH1;
            end
            if (LINTNOI >= T0 / 2.0) begin
                $strobe("Warning: LINTNOI = %e is too large - Leff for noise is negative. Re-setting LINTNOI = 0.", LINTNOI);
                LINTNOI_i = 0.0;
            end else begin
                LINTNOI_i = LINTNOI;
            end
            LeffnoiH = Leff;
            vgfbh  = (Vg - VFB_i) / Vt;
            gam_h  = sqrt(2.0 * `P_Q_NIST1998 * epssi * HNDEP / Vt) / Cox;
            phib_h = ln(HNDEP / ni);

            // Pinch-Off potential for halo region
            `PO_psip(vgfbh, gam_h, 0.0, phib_h, psiph)

            // Normalized inversion charge at source end of halo MOSFET
            `BSIM_q(psiph, phib_h, vs, gam_h, qsh)
            `Smooth(psiph, 1.0, 2.0, psiphclamp)
            nq_h = 1.0 + gam_h / (2.0 * sqrt(psiphclamp));

            // Setting mobility of halo region equal to the mobility of the channel. In general, U0H < ueff
            U0_i_h  = ueff;
            beta_h  = U0_i_h * Cox * Weff;
            beta_ch = ueff * Cox * Weff;

            // Normalized drain current for halo transistor. Eq. (14) of the paper
            i1 = ids * LH1 / (2.0 * nq_h * beta_h * Vt * Vt);

            // Normalized drain current for channel transistor. Eq. (15) of the paper
            i2 = ids * (LeffnoiH - LH1) / (2.0 * nq * beta_ch * nVt * nVt);
            T0 = (1.0 + 4.0 * (qsh * qsh + qsh - i1));
            if (T0 < 1.0) begin
                qdh = 0.0;
            end else begin
                // Drain charge of halo transistor. Eq. (16) of the paper
                qdh = -0.5 + 0.5 * sqrt(T0);
            end

            // Source charge of channel transistor. Eq. (17) of the paper
            qsch   = -0.5 + 0.5 * sqrt(1.0 + 4.0 * (qdeff * qdeff + qdeff + i2));
            gds_h  = 2.0 * nq_h * beta_h * Vt * qdh;
            gds_ch = 2.0 * nq * beta_ch * Vt * qdeff;
            gm_ch  = 2.0 * beta_ch * Vt * (qsch - qdeff);
            R_ch   = gds_h * (LeffnoiH - LH1);
            R_h    = gm_ch * LH1 + gds_ch * LH1;
            t_tot  = 1.0 / (R_ch + R_h) / (R_ch + R_h);
            CF_ch  = R_ch * R_ch * t_tot;
            CF_h   = R_h * R_h * t_tot;

            // Local noise source
            if (Leff != LH1) begin
                Np2       = 2.0 * nq * Cox * Vt * qsch / `P_Q_NIST1998;
                Leffnoi   = LeffnoiH - 2.0 * LINTNOI_i-LH1;
                Leffnoisq = Leffnoi * Leffnoi;
                // Channel transistor LNS
                T1     = 1.0e10 * Cox * Leffnoisq;
                T2     = NOIA * lln((Np2 + Nstar) / (Nl + Nstar));
                T3     = NOIB * (Np2 - Nl);
                T4     = 0.5 * NOIC * (Np2 * Np2 - Nl * Nl);
                T5     = 1.0e10 * Leffnoisq * Weff * NF;
                Ssi_ch = T0a / T1 * (T2 + T3 + T4) + T0b / T5 * DelClm * T0c / T0d;
                T6     = Weff * NF * Leffnoi * 1.0e10 * Nstar * Nstar;
                Swi_ch = T0e / T6 * ids * ids;
                T7 = Swi_ch + Ssi_ch;
                if (T7 > 0.0) begin
                    FNPowerAt1Hz_ch = (Ssi_ch * Swi_ch) / T7;
                end else begin
                    FNPowerAt1Hz_ch = 0.0;
                end
            end else begin
                FNPowerAt1Hz_ch = 0.0;
            end

            // Halo transistor LNS
            T8    = NOIA2 * `P_Q_NIST1998 * Vt;
            T9    = Weff * NF * LH1 * 1.0e10 * Nstar * Nstar;
            Swi_h = T8 / T9 * ids * ids;
            T10   = Swi_h;
            if (T10 > 0.0) begin
                FNPowerAt1Hz_h = Swi_h;
            end else begin
                FNPowerAt1Hz_h = 0.0;
            end
            // Overall noise
            FNPowerAt1Hz = FNPowerAt1Hz_ch * CF_ch + FNPowerAt1Hz_h * CF_h;
            I(di, si) <+ flicker_noise(sigvds*FNPowerAt1Hz, EF, "1overf");
        end else begin
            // Parameter checking
            if (LINTNOI >= Leff/2.0) begin
                $strobe("Warning: LINTNOI = %e is too large - Leff for noise is negative. Re-setting LINTNOI = 0.", LINTNOI);
                LINTNOI_i = 0.0;
            end else begin
                LINTNOI_i = LINTNOI;
            end
            if (NOIA > 0.0 || NOIB > 0.0 || NOIC > 0.0) begin
                Leffnoi   = Leff - 2.0 * LINTNOI_i;
                Leffnoisq = Leffnoi * Leffnoi;
                T0        = 1.0e10 * Cox * Leffnoisq;
                N0        = 2.0 * nq * Cox * Vt * qs * Mnud1 * Mnud / `P_Q_NIST1998;
                T1        = NOIA * lln((N0 + Nstar) / (Nl + Nstar));
                T2        = NOIB * (N0 - Nl);
                T3        = 0.5 * NOIC * (N0 * N0 - Nl * Nl);
                T4        = 1.0e10 * Leffnoisq * Weff * NF;
                Ssi       = T0a / T0 * (T1 + T2 + T3) + T0b / T4 * DelClm * T0c / T0d;
                T5        = Weff * NF * Leffnoi * 1.0e10 * Nstar * Nstar;
                Swi       = T0e / T5 * ids * ids;
                T6        = Swi + Ssi;
                if (T6 > 0.0) begin
                    FNPowerAt1Hz = (Ssi * Swi) / T6/(1.0+NOIA1*pow((qs-qdeff),NOIAX));
                end else begin
                    FNPowerAt1Hz = 0.0;
                end
            end else begin
                FNPowerAt1Hz = 0.0;
            end
            I(di, si) <+ flicker_noise(sigvds*FNPowerAt1Hz, EF, "1overf");
        end

        T0         = qia / Esatnoi / Leff;
        T1         = T0 * T0;
        T3         = RNOIA * (1.0 + TNOIA * Leff * T1);
        T4         = RNOIB * (1.0 + TNOIB * Leff * T1);
        T5         = RNOIK * (1.0 + TNOIK * Leff * T1);
        ctnoi      = RNOIC * (1.0 + TNOIC * Leff * T1);
        betanoisq  = 3.0 * T3 * T3;
        betanoisq  = (betanoisq - 1.0) * lexp(-Leff / LP) + 1.0;
        betaLowId  = T5 * T5;
        thetanoisq = T4 * T4;
        cm_igid    = 0.0;
        case (TNOIMOD)
            0: begin
                QSi   = -NF * Weff * Leff * Cox * Vt * Qs;
                QDi   = -NF * Weff * Leff * Cox * Vt * Qd;
                T0    = ueff * abs(QSi + QDi);
                T1    = T0 * Rdsi + Leff * Leff;
                Gtnoi = (T0 / T1) * NTNOI;
                sidn  = Nt * Gtnoi;
                I(di, si) <+ white_noise(sidn, "id");
            end
            1: begin
                Vtn   = 2.0 * nq * nVt;
                T0    = ueff * Dptwg * Moc * Cox * Vtn;
                T1    = 0.5 * (qs + qdeff);
                T3    = T1 + 0.5;
                T4    = T3 * T3;
                T5    = T4 * T3;
                T6    = (qs - qdeff);
                T7    = T6 * T6;
                T8    = T7 * T6;
                T9    = (6.0 * T1 + 0.5) * T7;
                Lvsat = Leff * Dptwg;
                T10   = Lvsat / Leff;
                T12   = 1.0 + (betaLowId * (Vdseff / Vdssat) / (TNOIK2 + qia));
                T12   = ((T12 - 1.0) * lexp(-Leff / LP)) + 1.0;
                `Smooth(T12, 0.0, 1.0e-1, T12)
                mid   = T0 * NF * Weff / Lvsat * (T1 * T12 + T7 * betanoisq / (12.0 * T3));
                mig   = Lvsat * T10 * T10 * (T1 / T4 - T9 / (60.0 * T4 * T4) + T7 * T7 / (144.0 * T4 * T5)) * 15.0 / 4.0 * thetanoisq / (NF * Weff * 12.0 * T0);
                migid = T10 * (T6 / (12.0 * T3) - T8 / (144.0 * T5)) * ctnoi / 0.395;
                sqid  = sqrt(Nt * mid);
                if (mig > 0.0) begin
                    sqig = sqrt(Nt / mig);
                    if (sqid > 0.0) begin
                        cm_igid = migid * sqig / sqid;
                    end else begin
                        cm_igid = 0.0;
                    end
                end else begin
                    sqig    = 0.0;
                    cm_igid = 0.0;
                end
                I(N2)     <+ white_noise(cm_igid, "corl");
                I(NI)     <+ white_noise(sqig * sqig * (1.0 - cm_igid), "corl");
                I(NI)     <+ -sqig * V(N2);
                I(NC)     <+ ddt(mig * Cox * Weff * NF * Leff * V(NC));
                I(di, si) <+ white_noise(sqid * sqid * (1.0 - cm_igid), "id");
                I(di, si) <+ sqid * V(N2);
                I(gi, si) <+ ddt(0.5 * ((1.0 + sigvds) * mig * Cox * Weff * NF * Leff * V(NC)));
                I(gi, di) <+ ddt(0.5 * ((1.0 - sigvds) * mig * Cox * Weff * NF * Leff * V(NC)));
            end
        endcase
        I(N2) <+ V(N2);
        I(NR) <+ V(NR);

        // Gate current shot noise
        if (IGCMOD != 0) begin
            I(gi, si) <+ white_noise(2.0 * `P_Q_NIST1998 * abs(igcs + igs), "igs");
            I(gi, di) <+ white_noise(2.0 * `P_Q_NIST1998 * abs(igcd + igd), "igd");
        end
        if (IGBMOD != 0) begin
            I(gi, bi) <+ white_noise(2.0 * `P_Q_NIST1998 * abs(igb), "igb");
        end

        // C-V model
        vgfbCV   = vgfb;

        invgamg2 = 0.0;

        if (CVMOD == 1) begin
            VFBCV_i = VFBCV_i + DELVTO;
            vg      = Vg * inv_Vt;
            vs      = Vs * inv_Vt;
            vfb     = VFBCV_i * inv_Vt;
            vgfbCV  = vg - vfb;
            phibCV    = lln(NDEPCV_i / ni);
            // Normalized body factor
            gamCV      = sqrt(2.0 * `P_Q_NIST1998 * epssi * NDEPCV_i * inv_Vt) / Cox;
            inv_gam  = 1.0 / gamCV;
            gamg2    = (2.0 * `P_Q_NIST1998 * epssi * NGATE_i) / (Cox * Cox * Vt);
            invgamg2 = (NGATE_i > 0.0) ? (1.0 / gamg2) : 0.0;
            DPD      = (NGATE_i > 0.0) ? (NDEPCV_i / NGATE_i) : 0.0;


            // psip: pinch-off voltage
            `PO_psip(vgfbCV, gamCV, DPD, phibCV, psip)

            // Normalized inversion charge at source end of channel
            `BSIM_q(psip, phibCV, vs, gamCV, qs)
            `Smooth(psip, 1.0, 2.0, psipclamp)
            sqrtpsip = sqrt(psipclamp);

            // Source side surface potential
            psiavg = psip - 2.0 * qs;
            `Smooth(psiavg, 1.0, 2.0, T0)
            nq = 1.0 + gamCV / (sqrtpsip + sqrt(T0));

            // Drain saturation voltage
            T0 = Vt * (vgfbCV - psip - 2.0 * qs * (nq - 1.0));
            `Smooth(T0, 0.0, 0.1, qbs)

            // Source side qi and qb for Vdsat (normalized to Cox)
            qis = 2.0 * nq * Vt * qs;
            Eeffs = EeffFactor * (qbs + eta_mu * qis);

            // Ref: BSIM4 mobility model
            T3 = (UA_a + UC_a * Vbsx) * pow(Eeffs, EU_t);
            T4 = 1.0 + T3;
            `Smooth(T4, 1.0, 0.0015, Dmobs)
            LambdaC_by2 = (U0_a / Dmobs) * Vt / (VSATCV_t * Lact);
            qdsat       = LambdaC_by2 * (qs * qs + qs) / (1.0 + LambdaC_by2 * (1.0 + qs));
            vdsatcv     = psip - 2.0 * phibCV - (2.0 * qdsat + lln((qdsat * 2.0 * nq * inv_gam) * ((qdsat * 2.0 * nq * inv_gam) + (gamCV / (nq - 1.0)))));
            VdsatCV     = vdsatcv * Vt;
            `Smooth(VdsatCV - Vs, 0.0, 1.0e-3, VdssatCV)
            if (A0CV == 0.0 && AGSCV == 0.0) begin
                AbulkCV = ABULK;
            end else begin
                T1    = Leff / (Leff + sqrt(XJ_i * Xdep));
                AbulkCV = 1.0 + (A0CV * T1 - AGSCV * T1 * qs * nVt) / (1.0 + KETACV * Vbsx);
                `Smooth(AbulkCV, 0.1, 0.0005, AbulkCV)
            end
            VdssatCV     = VdssatCV / AbulkCV;
            T7     = pow((Vds / VdssatCV) + 1.0e-6, 1.0 / DELTA_t);
            T8     = pow(1.0 + T7, -DELTA_t);
            Vdseff = Vds * T8;
            vdeff  = (Vdseff + Vs) * inv_Vt;
            `BSIM_q(psip, phibCV, vdeff, gamCV, qdeff)

            // Reevaluation of nq to include qdeff needed for gummel symmetry
            psiavg = psip - qs - qdeff - 1.0;
            `Smooth(psiavg, 1.0, 2.0, T0)
            T2 = sqrt(T0);
            T3 = 1.0 + DPD + gamCV / (sqrtpsip + T2);
            T4 = 0.5 + DPD * T2 * inv_gam;
            T5 = sqrt(T4 * T4 + T3 * (qs + qdeff) * invgamg2);
            nq = T3 / (T4 + T5);

            // C-V expressions including velocity saturation and CLM
            // Velocity saturation for C-V
            T0  = Vt * (vgfbCV - psip - 2.0 * qs * (nq - 1.0));
            `Smooth(T0, 0.0, 0.1, qbs)
            T1  = Vt * (vgfbCV - psip - 2.0 * qdeff * (nq - 1.0));
            `Smooth(T1, 0.0, 0.1, qbd)
            qb  = 0.5 * (qbs + qbd);
            qia = nq * Vt * (qs + qdeff);
            Eeffm = EeffFactor * (qb + eta_mu * qia);
            `PO_psip((vgfbCV + DELVFBACC * inv_Vt), gamCV, DPD, phibCV, psip)
            T3    = (UA_a + UC_a * Vbsx) * pow(Eeffm, EU_t);
            T4    = 1.0 + T3;
            `Smooth(T4, 1.0, 0.0015, Dmob)
            LambdaC = 2.0 * (U0_a / Dmob) * Vt / (VSATCV_t * Lact);
            dps     = qs - qdeff;
            T1      = 2.0 * (LambdaC * dps) * (LambdaC * dps);
            zsat    = sqrt(1.0 + T1);
            Dvsat   = 0.5 * (1.0 + zsat);
            // CLM for C-V
            Esat    = 2.0 * VSATCV_t / (U0_a / Dmob);
            EsatL   = Esat * Lact;
            Vasat   = VdssatCV + EsatL;
            diffVds = Vds - Vdseff;
        end
        if (PCLMCV_i != 0.0) begin
            MdL = 1.0 + PCLMCV_i * lln(1.0 + diffVds / PCLMCV_i / Vasat);
        end else begin
            MdL = 1.0;
        end
        //MdL = 1;
        MdL_2       = MdL * MdL;
        inv_MdL     = 1.0 / MdL;
        inv_MdL_2   = 1.0 / MdL_2;
        MdL_less_1  = MdL - 1.0;
        vgpqm = vgfbCV - psip;
        DQSD  = (qs - qdeff);
        DQSD2 = (qs - qdeff) * (qs - qdeff);
        sis   = vgpqm + 2.0 * qs;
        sid   = vgpqm + 2.0 * qdeff;
        `Smooth(sis, 0.0, 0.5, T1)
        `Smooth(sid, 0.0, 0.5, T2)
        Temps = sqrt(0.25 + T1 * invgamg2);
        Tempd = sqrt(0.25 + T2 * invgamg2);
        T1 = sis / (1.0 + 2.0 * Temps);
        T2 = sid / (1.0 + 2.0 * Tempd);
        T3 = Temps + Tempd;
        T4 = `Oneby3 * (DQSD2 / (T3 * T3 * T3));
        T5 = (AbulkCV * Dvsat * inv_MdL) / (1.0 + qs + qdeff);
        T6 = 0.8 * (T3 * T3 + Temps * Tempd) * T5;
        T7 = T6 + (2.0 * invgamg2);
        T8 = `Oneby3 * DQSD2 * T5;
        dqgeff = sid * (2.0 * Tempd - 1.0) / (2.0 * Tempd + 1.0);
        qbeff  = vgpqm - 2.0 * (nq - 1.0) * qdeff + dqgeff;
        Qb  = inv_MdL * (T1 + T2 + (T4 * T7 - nq * (qs + qdeff + T8))) + MdL_less_1 * qbeff;
        T9  = qs + qdeff;
        T10 = DQSD2 * T5 * T5;
        Qi  = nq * inv_MdL * (T9 + `Oneby3 * DQSD2 * T5) + 2.0 * nq * MdL_less_1 * qdeff;
        Qd1 = nq * inv_MdL_2 * (0.5 * T9 - (DQSD / 6.0) * (1.0 - DQSD * T5 - 0.2 * T10));
        Qd2 = nq * (MdL - inv_MdL) * qdeff;
        Qd  = Qd1 + Qd2;
        Qs  = Qi - Qd;

        // Quantum mechanical effects
        `Smooth(Vt * Qb, 0.0, 0.1, qbaCV)

        qiaCV      = Vt * (Qs + Qd);
        T0         = (qiaCV + ETAQM * qbaCV) / QM0;
        T1         = 1.0 + pow(T0, 0.7 * BDOS);
        XDCinv     = ADOS * 1.9e-9 / T1;
        Coxeffinv  = 3.9 * `P_EPS0 / (BSIMBULKTOXP * 3.9 / EPSROX + XDCinv / epsratio);
        QBi        =  -(NF * Wact * Lact + AGBCP) * (`P_EPS0 * EPSROX / BSIMBULKTOXP) * Vt * Qb;
        WLCOXVtinv = (NF * Wact * Lact + AGBCP) * Coxeffinv * Vt;
        QDi = -WLCOXVtinv * Qd;
        QSi = -WLCOXVtinv * Qs;

        //AGBCP2 Cap
        if (MODAGBCP2 == 1) begin
            VFBAGBCP2_i = VFBAGBCP2 + DELVTO;
            vg1      = Vg1 * inv_Vt;
            vs1      = Vs1 * inv_Vt;
            vfb     = VFBAGBCP2_i * inv_Vt;
            vgfbAGBCP2  = vg1 - vfb;
            phibAGBCP2  = lln(NDEPAGBCP2 / ni);
            // Normalized body factor
            gamAGBCP2      = sqrt(2.0 * `P_Q_NIST1998 * epssi * NDEPAGBCP2 * inv_Vt) / Cox;
            inv_gam  = 1.0 / gamAGBCP2;

            invgamg2 = 0.0;
            DPD      = 0.0;

            // psip: pinch-off voltage
            `PO_psip(vgfbAGBCP2, gamAGBCP2, DPD, phibAGBCP2, psip)

            // Normalized inversion charge at source end of channel
            `BSIM_q(psip, phibAGBCP2, vs1, gamAGBCP2, qs)
            `Smooth(psip, 1.0, 2.0, psipclamp)
            sqrtpsip = sqrt(psipclamp);

            // Source side surface potential
            psiavg = psip - 2.0 * qs;
            `Smooth(psiavg, 1.0, 2.0, T0)
            nq = 1.0 + gamAGBCP2 / (sqrtpsip + sqrt(T0));

            // Drain saturation voltage
            T0 = Vt * (vgfbAGBCP2 - psip - 2.0 * qs * (nq - 1.0));
            `Smooth(T0, 0.0, 0.1, qbs)

            // Source side qi and qb for Vdsat (normalized to Cox)
            qis = 2.0 * nq * Vt * qs;
            Eeffs = EeffFactor * (qbs + eta_mu * qis);

            // Ref: BSIM4 mobility model
            T3 = (UA_a + UC_a * Vbsx1) * pow(Eeffs, EU_t);
            T4 = 1.0 + T3;
            `Smooth(T4, 1.0, 0.0015, Dmobs)
            LambdaC_by2 = (U0_a / Dmobs) * Vt / (VSATCV_t * Lact);
            qdsat       = LambdaC_by2 * (qs * qs + qs) / (1.0 + LambdaC_by2 * (1.0 + qs));
            vdsatcv     = psip - 2.0 * phibAGBCP2 - (2.0 * qdsat + lln((qdsat * 2.0 * nq * inv_gam) * ((qdsat * 2.0 * nq * inv_gam) + (gamAGBCP2 / (nq - 1.0)))));
            VdsatCV     = vdsatcv * Vt;
            `Smooth(VdsatCV - Vs1, 0.0, 1.0e-3, VdssatCV)
            VdssatCV     = VdssatCV;
            T7     = pow((Vds / VdssatCV) + 1.0e-6, 1.0 / DELTA_t);
            T8     = pow(1.0 + T7, -DELTA_t);
            Vdseff = Vds * T8;
            vdeff  = (Vdseff + Vs1) * inv_Vt;
            `BSIM_q(psip, phibAGBCP2, vdeff, gamAGBCP2, qdeff)

            // Reevaluation of nq to include qdeff needed for gummel symmetry
            psiavg = psip - qs - qdeff - 1.0;
            `Smooth(psiavg, 1.0, 2.0, T0)
            T2 = sqrt(T0);
            T3 = 1.0 + DPD + gamAGBCP2 / (sqrtpsip + T2);
            T4 = 0.5 + DPD * T2 * inv_gam;
            T5 = sqrt(T4 * T4 + T3 * (qs + qdeff) * invgamg2);
            nq = T3 / (T4 + T5);

            MdL = 1;
            MdL_2       = MdL * MdL;
            inv_MdL     = 1.0 / MdL;
            inv_MdL_2   = 1.0 / MdL_2;
            MdL_less_1  = MdL - 1.0;
            vgpqm = vgfbAGBCP2 - psip;
            DQSD  = (qs - qdeff);
            DQSD2 = (qs - qdeff) * (qs - qdeff);
            sis   = vgpqm + 2.0 * qs;
            sid   = vgpqm + 2.0 * qdeff;
            `Smooth(sis, 0.0, 0.5, T1)
            `Smooth(sid, 0.0, 0.5, T2)
            Temps = sqrt(0.25 + T1 * invgamg2);
            Tempd = sqrt(0.25 + T2 * invgamg2);
            T1 = sis / (1.0 + 2.0 * Temps);
            T2 = sid / (1.0 + 2.0 * Tempd);
            T3 = Temps + Tempd;
            T4 = `Oneby3 * (DQSD2 / (T3 * T3 * T3));

            Dvsat = 0; //
            T5 = (Dvsat * inv_MdL) / (1.0 + qs + qdeff);
            T6 = 0.8 * (T3 * T3 + Temps * Tempd) * T5;
            T7 = T6 + (2.0 * invgamg2);
            T8 = `Oneby3 * DQSD2 * T5;
            dqgeff = sid * (2.0 * Tempd - 1.0) / (2.0 * Tempd + 1.0);
            qbeff  = vgpqm - 2.0 * (nq - 1.0) * qdeff + dqgeff;
            Qb  = inv_MdL * (T1 + T2 + (T4 * T7 - nq * (qs + qdeff + T8))) + MdL_less_1 * qbeff;
            T9  = qs + qdeff;
            T10 = DQSD2 * T5 * T5;
            Qi  = nq * inv_MdL * (T9 + `Oneby3 * DQSD2 * T5) + 2.0 * nq * MdL_less_1 * qdeff;
            Qd1 = nq * inv_MdL_2 * (0.5 * T9 - (DQSD / 6.0) * (1.0 - DQSD * T5 - 0.2 * T10));
            Qd2 = nq * (MdL - inv_MdL) * qdeff;
            Qd  = Qd1 + Qd2;

            WLCOX = AGBCP2 * (`P_EPS0 * EPSROX / BSIMBULKTOXP) * Vt;
            QBi_AGBCP2        = WLCOX * Qb;
            QDi_AGBCP2        = WLCOX * Qd;
            Qi_AGBCP2         = WLCOX * Qi;


        end else begin
            QBi_AGBCP2 = 0.0;
            QDi_AGBCP2 = 0.0;
            Qi_AGBCP2 = 0.0;

        end

        QDim        = QDi;
        QSim        = QSi;
        QBim        = QBi;
        QGim        = -(QBim + QSim + QDim);

        QDiagbcp2   = -(MODAGBCP2 * QDi_AGBCP2);
        QSiagbcp2   = -(MODAGBCP2 * Qi_AGBCP2 - MODAGBCP2 * QDi_AGBCP2);
        QBiagbcp2   = -(MODAGBCP2 * QBi_AGBCP2);
        QGiagbcp2   = -(QBiagbcp2 + QSiagbcp2 + QDiagbcp2);
        QDi        = -(-QDi + MODAGBCP2 * QDi_AGBCP2);
        QSi        = -(-QSi + MODAGBCP2 * Qi_AGBCP2 - MODAGBCP2 * QDi_AGBCP2);
        QBi        = -(-QBi + MODAGBCP2 * QBi_AGBCP2);
        QGi        = -(QBi + QSi + QDi);

        // Outer fringing capacitances
        if (!$param_given(CF)) begin
            CF_i = 2.0 * EPSROX * `P_EPS0 / `M_PI * lln(CFRCOEFF * (1.0 + 0.4e-6 / TOXE));
        end
        Cgsof = CGSO + CF_i;
        Cgdof = CGDO + CF_i;

        // Overlap capacitances
        if (COVMOD == 0) begin
            Qovs = -Wact * NF * Cgsof * Vgs_ov_noswap;
            Qovd = -Wact * NF * Cgdof * Vgd_ov_noswap;
        end else begin
            T0    = sqrt((Vgs_ov_noswap - Vfbsdr + `DELTA_1) * (Vgs_ov_noswap - Vfbsdr + `DELTA_1) + 4.0 * `DELTA_1);
            Vgsov = 0.5 * (Vgs_ov_noswap - Vfbsdr + `DELTA_1 - T0);
            T6    = Vgsov / pow(1.0 + pow((-Vgsov / CKAPPAS1), CKAPPAS2), 1.0 / CKAPPAS2);
            T1    = sqrt(1.0 - 4.0 * T6 / CKAPPAS_i);
            Qovs  = -Wact * NF * (Cgsof * Vgs_ov_noswap + CGSL_i * (Vgs_ov_noswap - Vfbsdr - Vgsov - 0.5 * CKAPPAS_i * (-1.0 + T1)));
            T0    = sqrt((Vgd_ov_noswap - Vfbsdr + `DELTA_1) * (Vgd_ov_noswap - Vfbsdr + `DELTA_1) + 4.0 * `DELTA_1);
            Vgdov = 0.5 * (Vgd_ov_noswap - Vfbsdr + `DELTA_1 - T0);
            T6    = Vgdov / pow(1.0 + pow((-Vgdov / CKAPPAD1), CKAPPAD2), 1.0 / CKAPPAD2);
            T2    = sqrt(1.0 - 4.0 * T6 / CKAPPAD_i);
            Qovd  = -Wact * NF * (Cgdof * Vgd_ov_noswap + CGDL_i * (Vgd_ov_noswap - Vfbsdr - Vgdov - 0.5 * CKAPPAD_i * (-1.0 + T2)));
        end
        Qovb = -devsign * NF * Lact * CGBO * V(gm, bi);
        Qovg = -(Qovs + Qovd + Qovb);


        //Backgate Charges --- related to new introduced substrate terminal
        LeffCVb = Lnew - 2.0 * dLCV - DLCB;
        LeffCVbg = LeffCVb + 2.0 * DLBG;
        if (NSUB_i > 0) begin
            T0 = lln(NDEP_i / NSUB_i);
            vfbb = -devsign * Vtm * T0;
        end else begin
            T0 = lln(-NDEP_i * NSUB_i / ni / ni);
            vfbb = -devsign * Vtm * T0;
        end

        Vesfb = Ves - vfbb;
        Cbox = 3.453133e-11 / TBOX;
        CboxWL = KB1_i * FBODY * Cbox * (Wact / NSEG * NF * LeffCVbg + AEBCP);
        Qe1 = CboxWL * (Vesfb - Vbs);
        Qsub = Qe1;


        //Sidewall Fringing Capacitance
        T0 = CSDESW * lln(CFRCOEFF * (1.0 + TSI / TBOX));
        T1 = PS - W;
        if (T1 > 0.0)
            csesw = T0 * T1;
        else
            csesw = 0.0;

        T1 = PD - W;
        if (T1 > 0.0)
            cdesw = T0 * T1;
        else
            cdesw = 0.0;


        // Extrinsic Bottom S/D to Substrate Charge
        csbox = Cbox * AS;
        csmin = CSDMIN * AS;
        cdbox = Cbox * AD;
        cdmin = CSDMIN * AD;

        //T10 is vse without type conversion
        //T11 is vde without type conversion
        T10 = -devsign * ves;
        T11 = -devsign * ved;

        if (CSDMIN != 0) begin
            T1 = -0.5 * (cdbox - cdmin) / ACEDB;
            T2 = lln(cosh(-ACEDB * T11 + BCEDB));
            T3 = 0.5 * (cdbox + cdmin) * T11;
            qde = T1 * T2 + T3;

            T1 = -0.5 * (csbox - csmin) / ACESB;
            T2 = lln(cosh(-ACESB * T10 + BCESB));
            T3 = 0.5 * (csbox + csmin) * T10;
            qse = T1 * T2 + T3;
        end else begin
            qse = csbox * T10;
            qde = cdbox * T11;
        end

        qse = qse + csesw * T10;
        qde = qde + cdesw * T11;

         // Edge FET model
        if (EDGEFET == 1) begin
            phib_edge     = lln(NDEPEDGE_i / ni);
            Phist         = max(0.4 + Vt * phib_edge + PHIN_i, 0.4);

            T1DEP         = sqrt(2.0 * epssi / (`P_Q_NIST1998 * NDEPEDGE_i));
            NFACTOREDGE_t = NFACTOREDGE_i * hypsmooth((1.0 + TNFACTOREDGE_i * (TRatio - 1.0)), 1e-3);
            ETA0EDGE_t    = ETA0EDGE_i * (1.0 + TETA0EDGE_i * (TRatio - 1.0));
            `Smooth(Phist - Vbsx, 0.05, 0.1, PhistVbs)
            sqrtPhistVbs  = sqrt(PhistVbs);
            Xdep          = T1DEP * sqrtPhistVbs;
            Cdep          = epssi / Xdep;
            cdsc          = CITEDGE_i + NFACTOREDGE_t + CDSCDEDGE_a * Vdsx - CDSCBEDGE_i * Vbsx;
            T1            = 1.0 + cdsc/Cox;
            `Smooth(T1, 1.0, 0.05, n)
            nVt       = n * Vt;
            inv_nVt   = 1.0 / nVt;
            vg        = Vg * inv_nVt;
            vs        = Vs * inv_nVt;
            vfb       = VFB_i * inv_nVt;
            dvth_dibl = -(ETA0EDGE_t + ETABEDGE_i * Vbsx) * Vdsx;
            dvth_temp = (KT1EDGE_i + KT1LEDGE_i / Leff + KT2EDGE_i * Vbsx) * (pow(TRatio, KT1EXPEDGE_i) - 1.0);
            litl_edge = litl * (1.0 + DVT2EDGE * Vbsx);
            if (litl_edge > 0) begin
                T0       = DVT1EDGE * Leff / litl_edge;
                if (T0 < 40.0) begin
                    theta_sce_edge = 0.5 * DVT0EDGE / (cosh(T0) - 1.0);
                end else begin
                    theta_sce_edge = DVT0EDGE * lexp(-T0);
                end
            end else begin
                theta_sce_edge = 0.0;
            end
            dvth_sce  = theta_sce_edge * (Vbi_edge - Phist);
            Vth_shift = dvth_dibl - dvth_temp + dvth_sce + DVTEDGE + vth0_stress_EDGE - (K2EDGE_i) * Vbsx + vth0_well_edge ;
            vgfb      = vg - vfb - Vth_shift * inv_nVt;
            // Normalized body factor
            DGAMMAEDGE_i = DGAMMAEDGE * (1.0 + DGAMMAEDGEL * pow(Leff, -DGAMMAEDGELEXP));
            gam_edge          = sqrt(2.0 * `P_Q_NIST1998 * epssi * NDEPEDGE_i * inv_nVt) / Cox;
            gam_edge          = gam_edge * (1.0 + DGAMMAEDGE_i);


            // psip: pinch-off voltage
            phib_n_edge  = phib_edge / n;
            `PO_psip(vgfb, gam_edge, 0.0, phib_n_edge, psip)
            `BSIM_q(psip, phib_n_edge, vs, gam_edge, qs_edge)

            // Approximate pinch-off voltage
            vdsatedge = 2.0 * nVt * qs_edge + 2.0 * nVt;
            Vdsatedge = vdsatedge;
            Vdsatedge = Vdsatedge + Vs;

            // Vdssat clamped to avoid negative values during transient simulation
            `Smooth(Vdsatedge - Vs, 0.0, 1.0e-3, Vdssate)
            T7     = pow((Vds / Vdssate) + 1.0e-6, 1.0 / DELTA_t);
            T8     = pow(1.0 + T7, -DELTA_t);
            Vdseff = Vds * T8;
            vdeff  = (Vdseff + Vs) * inv_nVt;
            `BSIM_q(psip, phib_n_edge, vdeff, gam_edge, qdeff_edge)

            // Nq calculation for Edge FET
            `Smooth(psip, 1.0, 2.0, psipclamp)
            sqrtpsip = sqrt(psipclamp);
            psiavg   = psip - qs_edge - qdeff_edge -1.0;
            `Smooth(psiavg, 1.0, 2.0, T0)
            T2       = sqrt(T0);
            nq_edge  = 1.0 + gam_edge / (sqrtpsip + T2);
            ids_edge = 2.0 * NF * nq_edge * ueff * WEDGE / Leff * Cox * nVt * nVt * ((qs_edge - qdeff_edge) * (1.0 + qs_edge + qdeff_edge)) * Moc;
            ids      = ids_edge + ids;

            // Flicker rnoise calculation for Edge FET
            noia_edge      = NOIA * NEDGE;
            noib_edge      = NOIB * NEDGE;
            noic_edge      = NOIC * NEDGE;
            Leffnoi_edge   = Leff-2.0 * LINTNOI_i;
            Leffnoisq_edge = Leffnoi_edge*Leffnoi_edge;
            Nstar = Vt / `P_Q_NIST1998 * (Cox + Cdep + CITEDGE_i);
            Nl    = 2.0 * nq_edge * Cox * Vt * qdeff_edge / `P_Q_NIST1998;
            T0a   = `P_Q_NIST1998 * `P_Q_NIST1998 * `P_Q_NIST1998 * Vt * abs(ids_edge) * ueff;
            T0b   = `P_Q_NIST1998 * Vt * ids_edge * ids_edge;
            T0c   = noia_edge + noib_edge * Nl + noic_edge * Nl * Nl;
            T0d   = (Nl + Nstar) * (Nl + Nstar);
            T0e   = noia_edge * `P_Q_NIST1998 * Vt;
            N0    = 2.0 * nq_edge * Cox * Vt * qs_edge / `P_Q_NIST1998;
            T1    = noia_edge * lln((N0 + Nstar) / (Nl + Nstar));
            T2    = noib_edge * (N0 - Nl);
            T3    = 0.5 * noic_edge * (N0 * N0 - Nl * Nl);
            T4    = 1.0e10 * Leffnoisq_edge * WEDGE * NF;
            Ssi   = T0a / T0 * (T1 + T2 + T3) + T0b / T4 * DelClm * T0c / T0d;
            T5    = WEDGE * NF * Leffnoi_edge * 1.0e10 * Nstar * Nstar;
            Swi   = T0e / T5 * ids_edge * ids_edge;
            T6    = Swi + Ssi;
            if (T6 > 0.0) begin
                T7 = (Ssi * Swi) / T6;
                T8 = 1.0 + NOIA1_EDGE * pow((qs_edge - qdeff_edge), NOIAX_EDGE);
                FNPowerAtedge = T7/T8;
            end else begin
                FNPowerAtedge = 0.0;
            end
            I(di, si) <+ flicker_noise(sigvds*FNPowerAtedge, EF, "1overf_edgefet");
        end
        // End of Edge FET parasitic device drain current model


        // Charge expressions including fringing and overlap capacitances
        QB = devsign * (QBi + Qovb + Qbsj + Qbdj);
        if (sigvds > 0) begin
            QSI = devsign * QSi;
            QSIM = devsign * QSim;
            QSIAGBCP2 = devsign * QSiagbcp2;
            QDI = devsign * QDi;
            QDIM = devsign * QDim;
            QDIAGBCP2 = devsign * QDiagbcp2;
            QS  = devsign * (QSi + Qovs - Qbsj);
            QD  = devsign * (QDi + Qovd - Qbdj);
        end else begin
            QSI = devsign * QDi;
            QSIM = devsign * QDim;
            QSIAGBCP2 = devsign * QDiagbcp2;
            QDI = devsign * QSi;
            QDIM = devsign * QSim;
            QDIAGBCP2 = devsign * QSiagbcp2;
            QS  = devsign * (QDi + Qovs - Qbsj);
            QD  = devsign * (QSi + Qovd - Qbdj);
        end
        QG = devsign * (QGi + Qovg);


        // Output
        // Intrinsic charges
        QBI = devsign * QBi;
        QGI = devsign * QGi;
        QGIM = devsign * QGim;
        QGIAGBCP2 = devsign * QGiagbcp2;

    end
    // QSI and QDI are defined above
    // Intrinsic capacitances
    CGSI = -ddx(QGI, V(si));
    CGDI = -ddx(QGI, V(di));
    CGBI = -ddx(QGI, V(bi));
    CGGI = ddx(QGI, V(gi));
    CSSI = ddx(QSI, V(si));
    CSDI = -ddx(QSI, V(di));
    CSBI = -ddx(QSI, V(bi));
    CSGI = -ddx(QSI, V(gi));
    CDSI = -ddx(QDI, V(si));
    CDDI = ddx(QDI, V(di));
    CDBI = -ddx(QDI, V(bi));
    CDGI = -ddx(QDI, V(gi));
    CBSI = -ddx(QBI, V(si));
    CBDI = -ddx(QBI, V(di));
    CBBI = ddx(QBI, V(bi));
    CBGI = -ddx(QBI, V(gi));

    // Total capacitances
    CGS = -ddx(QG, V(si));
    CGD = -ddx(QG, V(di));
    CGB = -ddx(QG, V(bi));
    CGG = CGGI + ddx(devsign * Qovg, V(gm));
    CSS = ddx(QS, V(si));
    CSD = -ddx(QS, V(di));
    CSB = CSBI - ddx((QS - QSI), V(bi));
    CSG = CSGI - ddx((QS - QSI), V(gm));
    CDS = -ddx(QD, V(si));
    CDD = ddx(QD, V(di));
    CDB = CDBI - ddx((QD - QDI), V(bi));
    CDG = CDGI - ddx((QD - QDI), V(gm));
    CBS = -ddx(QB, V(si));
    CBD = -ddx(QB, V(di));
    CBB = CBBI + ddx(QB, V(bi)) + ddx((devsign * Qovb), V(bi));
    CBG = -ddx(QB, V(gi)) - ddx((devsign * Qovb), V(gm));

    // Total extrinsic capacitance
    CGSEXT = -devsign * ddx(Qovg, V(si));  // Gate-to-source overlap + outer fringing
    CGDEXT = -devsign * ddx(Qovg, V(di));  // Gate-to-drain overlap + outer fringing
    CGBOV  = -devsign * ddx(Qovg, V(bi));  // Gate-to-body overlap

    // Total S/D junction capacitances
    CAPBS  = -devsign * ddx(Qbsj, V(si));
    CAPBD  = -devsign * (ddx(Qbdj, V(di)));

    // W & L
    WEFF   = Weff;  // Effective width for I-V
    LEFF   = Leff;  // Effective length for I-V
    WEFFCV = Wact;  // Effective width for C-V
    LEFFCV = Lact;  // Effective length for C-V
    IBS   = -devsign * Ibs;                          // Source junction current
    IBD   = -devsign * (Ibd);              // Drain junction current
    // Currents and derivatives
    if (sigvds > 0) begin
        IDS   = devsign * ids;                       // Intrinsic drain-to-source current
        IDEFF = IDS - (IGD + IGCD) + ISUB + IGIDL + IBD;   // Total drain current
        ISEFF = -IDS - (IGS + IGCS) + IGISL + IBS;         // Total source current
    end else begin
        IDS   = -devsign * ids;                      // Intrinsic drain-to-source current
        IDEFF = IDS - (IGD + IGCD) + IGIDL + IBD;          // Total drain current
        ISEFF = -IDS - (IGS + IGCS) + ISUB + IGISL + IBS;  // Total source current
    end
    IGEFF = IGB + IGS + IGCS + IGD + IGCD;           // Total gate tunneling current
    VDS   = V(di, si);                               // Drain-to-source voltage
    VGS   = V(gi, si);
    VBS   = -V(si, bi);                              // Source-to-body voltage
    VDSAT = Vdssat;                                  // Drain-to-source saturation voltage
    GM    = ddx(IDS, V(gi));                         // Transconductance
    GMBS  = ddx(IDS, V(bi));                         // Body transconductance
    if (sigvds > 0) begin
        GDS   = ddx(IDS, V(di));                     // Output conductance
    end else begin
        GDS   = ddx(-IDS, V(si));
    end

    // Loading variables
    I(gi, bi)  <+ ddt(QGIM);
    I(gi, bi2) <+ ddt(QGIAGBCP2);
    I(si, bi)  <+ ddt(QSIM);
    I(si, bi2) <+ ddt(QSIAGBCP2);
    I(di, bi)  <+ ddt(QDIM);
    I(di, bi2) <+ ddt(QDIAGBCP2);
    I(gm, si)  <+ ddt(-devsign * Qovs);
    I(gm, di)  <+ ddt(-devsign * Qovd);
    I(gm, bi)  <+ ddt(-devsign * Qovb);

    I(gi, bi2) <+ devsign * Ig_agbcp2;
    I(e, bi) <+ devsign * ddt(Qsub);

    I(di,e)  <+ ddt(qde);
    I(si,e)  <+ ddt(qse);


    // Drain-to-source current
    I(di, si) <+ devsign * sigvds * ids;

    if (IGBMOD != 0) begin
        I(gi, bi) <+ IGB;
    end
    if (IGCMOD != 0) begin
        I(gi, si) <+ (IGS + IGCS);
        I(gi, di) <+ (IGD + IGCD);
    end
    if (sigvds > 0) begin
        I(di, bi) <+ ISUB + IGIDL;
        I(si, bi) <+ IGISL;
    end else begin
        I(di, bi) <+ IGIDL;
        I(si, bi) <+ ISUB + IGISL;
    end



    if (RGATEMOD == 0) begin
        V(g, gm) <+ 0.0;
    end else begin: rgate
        real Ggate, Gnoise;
        if (RGATEMOD == 2) begin
            Ggate  = Gcrg;
            Gnoise = Gcrg * Gcrg / Grgeltd;
        end else begin
            Ggate  = Grgeltd;
            Gnoise = Grgeltd;
        end
        I(g, gm) <+ V(g, gm) * Ggate;
        I(g, gm) <+ white_noise(Nt * Gnoise, "rg");
    end

    // External S/D resistances
    if (RDSMOD !=2 && RDrainGeo > 0) begin
        gdpr = 1.0 / Rdrain;   // Note: gdpr considers all fingers
        I(d, di) <+ V(d, di) * gdpr;
    end else begin
        V(d, di) <+ 0.0;
    end

    if (RDSMOD !=2 && RDrainGeo > 0) begin
        I(d, di) <+ white_noise(Nt * gdpr, "rd");
    end

    if (RDSMOD !=2 && RSourceGeo > 0) begin
        gspr = 1.0 / Rsource;   // Note: gspr considers all fingers
        I(s, si) <+ V(s, si) * gspr;
    end else begin
        V(s, si) <+ 0.0;
    end

    if (RDSMOD !=2 && RSourceGeo > 0) begin
        I(s, si) <+ white_noise(Nt * gspr, "rs");
    end

    if (RGATEMOD == 3) begin
        I(gm, gi) <+ V(gm, gi) * Gcrg;
    end else begin
        V(gm, gi) <+ 0.0;
    end

    //Self-heating network
    if ((SHMOD != 0) && (RTH0 > 0.0)) begin
        Pdiss = devsign * sigvds * ids * V(di, si);
        if (RDSMOD !=2 && RDrainGeo >0) begin
            Pdiss = Pdiss + V(d, di) * V(d, di) / Rdrain;
        end
        if (RDSMOD !=2 && RSourceGeo >0) begin
            Pdiss = Pdiss + V(s, si) * V(s, si) / Rsource;
        end
        if (TNODEOUT && !$port_connected(t)) begin
            if ($port_connected(b)) begin // last terminal is 'b'
                I(b) <+ delTemp1 * gth + ddt(delTemp1 * cth) - Pdiss;
            end else begin  // 4-terminal mode ('t' is internal)
                Pwr(t) <+ delTemp1 * gth + ddt(delTemp1 * cth) - Pdiss;
            end
        end else begin
            Pwr(t) <+ delTemp1 * gth + ddt(delTemp1 * cth) - Pdiss;
        end
    end else begin
        if (TNODEOUT && !$port_connected(t)) begin
            if ($port_connected(b)) begin // last terminal is 'b'
                V(b) <+ 0.0;//
            end else begin // 4-terminal mode ('t' is internal)
                Temp(t) <+ 0.0;
            end
        end else begin
            Temp(t) <+ 0.0;
        end
    end


    //Body Contact resistance
    RBODYEXT = NRB * RBSH;
    if ((BODYMOD == 0) || ($port_connected(b) == 0)) begin
        V(b, bi) <+ 0;
        V(b, bi2) <+ 0;
    end else begin
        if (TNODEOUT && !$port_connected(t)) begin
            V(bi, bi2) <+ 0.0;
        end else begin
            //Linear Body Resistor
            if (BODYMOD == 1) begin
                RBODYINT = FRBODY * RBODY
                    * RHALO / (2.0 * RBODY + RHALO * LEFF)
                    * WEFF / NSEG / NF;
                if (RBODYINT < 1e-3) begin
                    if (RBODYEXT <= 1e-3)
                        T0 = 1.0 / 1e-3;
                    else
                        T0 = 1.0 / RBODYEXT;
                    gbody = T0;
                end else begin
                    gbody = 1.0 / (RBODYINT + RBODYEXT);
                end
            //Non-linear Body resistor
            end else begin
                UB_t = UB_i * pow(TRatio,UBTE_i);
                QB1 = -(QBi + Qbsj + Qbdj) + Qsub;
                Qbody = `P_Q_NIST1998 * NEFF_i * TSI * WEFF *LEFF - QB1;
                T0 = UB_t * Qbody;
                T1 = WEFF * WEFF;
                gbodyINT = NF * T0/T1;
                RBODYINT = 1 / gbodyINT;
                if (RBODYINT < 1e-3) begin
                    if (RBODYEXT <= 1e-3)
                        T0 = 1.0 / 1e-3;
                    else
                        T0 = 1.0 / RBODYEXT;
                    gbody = T0;
                end else begin
                    gbody = 1.0 / (RBODYINT + RBODYEXT);
                end
            end
        end
    end

    if (NBC == 2) begin
        gbody = 2.0 * gbody;
    end

    if (RBODYAGBCP2 < 1e-3) begin
        T0 = 1.0 / 1e-3;
        gbodyagbcp2 = T0;
    end else begin
        gbodyagbcp2 = 1.0 / RBODYAGBCP2;
    end


    if ($port_connected(b)) begin
        if ((TNODEOUT == 0) || ($port_connected(t))) begin
            I(b, bi) <+ V(b, bi) * gbody;
            I(b, bi2) <+ V(b, bi2) * gbodyagbcp2;
        end
    end



    // Diode currents and capacitances
    I(bi, si) <+ devsign * Ibs + V(bi, si) * gmin;
    I(bi, di) <+ devsign * Ibd + V(bi, di) * gmin;
    I(bi, si) <+ devsign * ddt(Qbsj);
    I(bi, di) <+ devsign * ddt(Qbdj);
    if ( (BODYMOD !=0) && ($port_connected (b) == 1) && (!((TNODEOUT == 1) && ($port_connected(t) == 0))) && (MODAGBCP2 == 1) ) begin
        I(bi2, si) <+ V(bi2, si) * gmin;
        I(bi2, di) <+ V(bi2, di) * gmin;
    end

end
endmodule
