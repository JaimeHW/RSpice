// To enhance the fitting flexibility for the gm/Id
`MPRnb( C0             ,0.0            ,"V"            ,"Lateral NUD1 voltage parameter" )
`MPRnb( LC0            ,0.0            ,"V*m"          ,"Length dependence of C0" )
`MPRnb( WC0            ,0.0            ,"V*m"          ,"Width dependence of C0" )
`MPRnb( PC0            ,0.0            ,"V*m^2"        ,"Area dependence of C0" )
`MPRnb( C01            ,0.0            ,"1/K"          ,"Temperature dependence of lateral NUD1 voltage parameter" )
`MPRnb( LC01           ,0.0            ,"m/K"          ,"Length dependence of C01" )
`MPRnb( WC01           ,0.0            ,"m/K"          ,"Width dependence of C01" )
`MPRnb( PC01           ,0.0            ,"m^2/K"        ,"Area dependence of C01" )
`MPRnb( C0SI           ,1.0            ,"V"            ,"Correction factor for strong inversion used in Mnud1. After binning it should be within (0 : inf)" )
`MPRnb( LC0SI          ,0.0            ,"V*m"          ,"Length dependence of C0SI" )
`MPRnb( WC0SI          ,0.0            ,"V*m"          ,"Width dependence of C0SI" )
`MPRnb( PC0SI          ,0.0            ,"V*m^2"        ,"Area dependence of C0SI" )
`MPRnb( C0SI1          ,0.0            ,"1/K"          ,"Temperature dependence of C0SI1" )
`MPRnb( LC0SI1         ,0.0            ,"m/K"          ,"Length dependence of C0SI1" )
`MPRnb( WC0SI1         ,0.0            ,"m/K"          ,"Width dependence of C0SI1" )
`MPRnb( PC0SI1         ,0.0            ,"m^2/K"        ,"Area dependence of C0SI1" )
`MPRnb( C0SISAT        ,0.0            ,"V"            ,"Correction factor for strong inversion used in Mnud1" )
`MPRnb( LC0SISAT       ,0.0            ,"V*m"          ,"Length dependence of C0SISAT" )
`MPRnb( WC0SISAT       ,0.0            ,"V*m"          ,"Width dependence of C0SISAT" )
`MPRnb( PC0SISAT       ,0.0            ,"V*m^2"        ,"Area dependence of C0SISAT" )
`MPRnb( C0SISAT1       ,0.0            ,"1/K"          ,"Temperature dependence of C0SISAT1" )
`MPRnb( LC0SISAT1      ,0.0            ,"m/K"          ,"Length dependence of C0SISAT1" )
`MPRnb( WC0SISAT1      ,0.0            ,"m/K"          ,"Width dependence of C0SISAT1" )
`MPRnb( PC0SISAT1      ,0.0            ,"m^2/K"        ,"Area dependence of C0SISAT1" )

// Minimum resistance value
`MPRcz( minr          ,$simparam("minr", 1m) ,"Ohm"    ,"minr is the value below which the simulator expects elimination of source/drain resistance and it will improve simulation efficiency without significantly altering the results.")




// Flexibility of tuning Cgg in strong inversion
`MPRco( ABULK          ,1.0             ,""           ,1.0         ,2.0          ,"For flexibility of tuning Cgg in strong inversion" )

// AbulkIV and AbulkCV parameters //
`MPRnb( A0            ,0.0           ,""                                         ,"Coefficient of depletion width dependence in AbulkIV for Id-Vd flexibility" )
`MPRnb( AGS           ,0.0           ,""                                         ,"Coefficient of Source Charge dependence in AbulkIV for Id-Vd flexibility" )
`MPRoz( AGS1          ,1.0           ,""                                         ,"qs nonlinear term for Id-Vd flexibility" )
`MPRcz( KETA          ,0.0           ,""                                         ,"Coefficient of back-bias dependence in AbulkIV for Id-Vd flexibility" )
`MPRnb( A0CV          ,A0            ,""                                         ,"Coefficient of depletion width dependence in AbulkCV for Capacitance flexibility" )
`MPRnb( AGSCV         ,AGS           ,""                                         ,"Coefficient of Source Charge dependence in AbulkCV for Capacitance flexibility" )
`MPRcz( KETACV        ,KETA          ,""                                         ,"Coefficient of back-bias dependence in AbulkCV for Capacitance flexibility" )

//Body contact resistance
`MPRnb( RBODY          ,0.0            ,"ohm/square"                       ,"Intrinsic body contact sheet resistance" )
`IPRnb( FRBODY         ,1.0            ,""                                 ,"layout dependent body-resistance coefficient" )
`MPRnb( RBSH           ,0.0            ,"ohm/square"                       ,"Extrinsic body contact sheet resistance" )
`IPRnb( NRB            ,1.0            ,""                                 ,"Number of squares in body" )
`MPRnb( RHALO          ,1e15           ,"ohm/m"                            ,"body halo sheet resistance" )

`MPRoz( UB             ,67.0e-3        ,"m^2/V/s"                           ,"Mobility of majority carriers in body." )
`MPRnb( LUB            ,0.0            ,"m^3/V/s"                           ,"Length dependence of UB" )
`MPRnb( WUB            ,0.0            ,"m^3/V/s"                           ,"Width dependence of UB" )
`MPRnb( PUB            ,0.0            ,"m^4/V/s"                           ,"Area dependence of UB" )

`MPRnb( UBTE            ,1.0            ,""                                 ,"Mobility temperature exponent" )
`MPRnb( LUBTE           ,0.0            ,"m"                                ,"Length dependence of UBTE" )
`MPRnb( WUBTE           ,0.0            ,"m"                                ,"Width dependence of UBTE" )
`MPRnb( PUBTE           ,0.0            ,"m^2"                              ,"Area dependence of UBTE" )

`MPRnb( NEFF            ,5e24           ,"1/m^3"                            ,"Effective substrate doping" )
`MPRnb( LNEFF           ,0.0            ,"1/m^2"                            ,"Length dependence of NEFF" )
`MPRnb( WNEFF           ,0.0            ,"1/m^2"                            ,"Width dependence of NEFF" )
`MPRnb( PNEFF           ,0.0            ,"1/m"                              ,"Area dependence of NEFF" )

`IPRoo( NSEG           ,1              ,""           ,0, inf                ,"Number segments for width partitioning" )

`MPRnb( RBODYAGBCP2    ,1e-3           ,"ohm"                               ,"Body resistance for AGBCP2 FET" )

//Change in effective width due to body contact
`IPRnb( NBC            ,0.0            ,""                                 ,"Number of body contact isolation edge 1 = TBODY, 2 = HBODY" )
`MPRnb( DWBC           ,0.0            ,"m"                                ,"Width offset for body contact isolation edge" )

//Body contact parasitics
`IPRnb( PDBCP          ,0.0            ,"m"                                ,"Perimeter length for bc parasitics at drain side" )
`IPRnb( PSBCP          ,0.0            ,"m"                                ,"Perimeter length for bc parasitics at source side" )
`IPRnb( AGBCP          ,0.0            ,"m^2"                              ,"Gate to body overlap area for bc parasitics" )
`IPRnb( AGBCP2         ,2e-12            ,"m^2"                              ,"Parasitic Gate to body overlap area for bc parasitics /* v4.1 improvement on BC" )
`IPRnb( AGBCPD         ,AGBCP          ,"m^2"                              ,"Gate to body overlap area for bc parasitics in DC" )
`IPRnb( AEBCP          ,0.0            ,"m^2"                              ,"Substrate to body overlap area for bc parasitics" )
`MPRnb( EGGBCP2        ,1.12           ,"eV"                                ,"Bandgap in Agbcp2 region" )

//Substrate (back gate)
`MPRnb( NSUB           ,6.0e22         ,"m^-3"                            ,"Substrate doping concentration with polarity" )
`MPRnb( LNSUB          ,0.0            ,"m^-2"                             ,"Length dependence of nsub" )
`MPRnb( WNSUB          ,0.0            ,"m^-2"                                 ,"Width dependence of nsub" )
`MPRnb( PNSUB          ,0.0            ,"m^-1"                                 ,"Cross-term dependence of nsub" )
`MPRnb( FBODY          ,1.0            ,""                                 ,"Scaling factor for body charge" )

`MPRnb( KB1            ,1.0            ,""                                 ,"Scaling factor for backgate charge" )
`MPRnb( LKB1           ,0.0            ,"m"                                 ,"Length dependence of kb1" )
`MPRnb( WKB1           ,0.0            ,"m"                                 ,"Width dependence of kb1" )
`MPRnb( PKB1           ,0.0            ,"m^2"                                 ,"Cross-term dependence of kb1" )
`MPRnb( DLBG           ,0.0            ,"m"                                ,"Length offset fitting parameter for backgate charge" )
`MPRnb( DLCB           ,0.0            ,"m"                                ,"Length offset fitting parameter for body charge" )

//Sidewall Fringing Capacitance
`MPRnb( CSDESW         ,0.0            ,"F/m"                              ,"Source/drain sidewall fringing capacitance per unit length" )


//Extrinsic Bottom S/D to Substrate Charge
