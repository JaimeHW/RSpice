`MPRoo( ACESB           ,2.0            ,""        ,0.0, inf               ,"First fitting parameter for drain to bottom capacitance" )
`MPRnb( BCESB           ,0.0            ,"V"                               ,"Second fitting parameter for drain to bottom capacitance" )
`MPRoo( ACEDB           ,ACESB          ,""       ,0.0, inf                ,"First fitting parameter for drain to bottom capacitance" )
`MPRnb( BCEDB           ,BCESB          ,"V"                               ,"Second fitting parameter for drain to bottom capacitance" )

