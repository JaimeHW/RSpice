    "project_sources": {
      "schema_version": 2,
      "bundles": [
        {
          "id": "53ff43be-ae4e-4c3d-9ede-97e271b187d1",
          "owner": {
            "kind": "code-workspace",
            "language": "verilog-a"
          },
          "language": "verilog-a",
          "root": {
            "id": "649c0b86-9259-5f32-b75b-baf68e38cf70",
            "file_name": "sensor_bridge.va",
            "language": "verilog-a",
            "content": "`include \"constants.vams\"\nmodule sensor_bridge(out, inp, inn);\n  parameter real gain = 100.0 from (0:inf);\n  analog V(out) <+ gain * (V(inp)-V(inn));\nendmodule",
            "revision": 1,
            "validated_identity": {
              "revision": 1,
              "content_digest": "d1a67da01a646d974c23ff6cdd990c12e9b724cba05537ee0d9d116b86c2136d"
            }
          },
          "revision": 1,
          "validated_identity": {
            "revision": 1,
            "content_digest": "b43b6e90837ad3f9a323ad867faf550327b6048d13350d039d05ae40a841e261"
          }
        },
        {
          "id": "e5ee106a-8a44-4e6f-9d93-62eb300000f5",
          "owner": {
            "kind": "code-workspace",
            "language": "rspice-automation"
          },
          "language": "rspice-automation",
          "root": {
            "id": "c4b9e687-b0f7-56a8-8eb5-1c2853e4d002",
            "file_name": "characterize.py",
            "language": "rspice-automation",
            "content": "from rspice import Project, ArtifactFormat\nproject = Project.open(\".\")\nplan = project.run_plans.load(\"runplan.rspice.yaml\")\npreview = plan.validate(target=\"local\", fail_closed=True)\nrun = preview.execute()\nrun.requirements.evaluate(profile=\"release\")\nrun.compare(baseline=\"main\", waveforms=True)\nrun.export([ArtifactFormat.JUNIT, ArtifactFormat.JSON, ArtifactFormat.PDF])\n",
            "revision": 1
          },
          "files": [
            {
              "id": "8e9dd53c-dcea-44ee-96bc-cd1a9b28a9bb",
              "logical_path": "permissions.toml",
              "content": "project_files = \"read\"\nartifact_directory = \"write\"\nnetwork = \"deny\"\nprocess_spawn = \"deny\"\nenvironment = [\"RSPICE_LICENSE_TOKEN\"]\nsecret_logging = \"redact\"\n",
              "revision": 1
            },
            {
              "id": "b83efeb1-6318-45a2-9cac-6eb9c2b2744f",
              "logical_path": "requirements.lock",
              "content": "format = \"rspice-python-lock/v3\"\npython = \">=3.14.0,<3.15.0\"\nrspice-api = \">=1.0.0,<2.0.0\"\nbrowser-runtime = \"=314.0.2\"\nenvironment_digest = \"sha256:d445b1443965be4e6b1b191ee023176dbd35430ac3cd00603458384ea03b8518\"\n",
              "revision": 1
            },
            {
              "id": "425ddddb-91b0-484a-88a9-9c2aaafd6974",
              "logical_path": "runplan.rspice.yaml",
              "content": "schema: rspice.run-plan/v1\nname: Lab characterization\nsource: top.sp\nanalyses: [op, tran, ac, noise]\ncorners: all-qualified\nrequirements: release\nartifacts: [junit, summary-json, verification-pdf]\n",
              "revision": 1
            }
          ],
          "dependencies": [
            {
              "importer": "characterize.py",
              "imported": "permissions.toml"
            },
            {
              "importer": "characterize.py",
              "imported": "requirements.lock"
            },
            {
              "importer": "characterize.py",
              "imported": "runplan.rspice.yaml"
            }
          ],
          "roles": [
            {
              "logical_path": "characterize.py",
              "role": "automation-entry"
            },
            {
              "logical_path": "runplan.rspice.yaml",
              "role": "automation-run-plan"
            },
            {
              "logical_path": "requirements.lock",
              "role": "automation-environment-lock"
            },
            {
              "logical_path": "permissions.toml",
              "role": "automation-permission-manifest"
            }
          ],
          "revision": 1
        }
      ]
    },
    "netlist_source_path": null
  },
