+ xl=-2.0e-8
+ alpha0=6.0e-9 alpha1=0.8 beta0=12
+ agidl=4.0e-10 bgidl=2.1e9 cgidl=0.4 egidl=0.9
+ agisl=3.0e-10 bgisl=2.2e9 cgisl=0.5 egisl=1.0
