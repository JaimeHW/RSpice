+ jss=1.2e-7 jsws=2.0e-13 jswgs=1.0e-13 njs=1.05 xtis=3
+ ijthsfwd=0.02 ijthsrev=0.02
+ cjs=8.0e-4 mjs=0.42 pbs=0.85 cjsws=6.0e-11 mjsws=0.3 pbsws=0.75
