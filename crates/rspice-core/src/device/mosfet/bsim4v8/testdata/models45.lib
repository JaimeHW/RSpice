+ dvtp0=1.0e-8 dvtp1=0.12 dsub=0.095 eta0=0.0042 etab=-0.05
+ minv=0.05 voff=-0.11 voffl=1.0e-9 nfactor=1.7
+ cdsc=4.0e-4 cdscb=1.0e-5 cdscd=1.0e-5 cit=1.0e-5
+ mobmod=0 u0=0.045 ua=5.0e-10 ub=1.3e-18 uc=8.0e-11 ud=1.0e15 eu=1.67
